# name: MEOS_SPANSET_LE
# description: spanset_le — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spansetles(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR spansetles TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|'{[1, 5), [10, 15)}'
2|'{[3, 7)}'|'{[3, 7)}'

CREATE SINK spansetles_out(spansetles.id UINT64, r INT32) TYPE File;
SELECT id, SPANSET_LE(a, b) AS r FROM spansetles INTO spansetles_out;
----
1,1
2,1

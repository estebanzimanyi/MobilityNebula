# name: MEOS_RIGHT_SPAN_INT
# description: right_span_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightspanints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR rightspanints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK rightspanints_out(rightspanints.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_SPAN_INT(a, b) AS r FROM rightspanints INTO rightspanints_out;
----
1,0
2,0

# name: MEOS_SET_SPANS
# description: SET_SPANS returns the array of singleton spans of a set (an int set chosen to prove the subtype-agnostic function).
# groups: [Function, MEOS, Set, Span]
CREATE LOGICAL SOURCE setspanss(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR setspanss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{2, 4}'

CREATE SINK setspanss_out(setspanss.id UINT64, r VARSIZED) TYPE File;
SELECT id, SET_SPANS(a) AS r FROM setspanss INTO setspanss_out;
----
1,{[1,2),[3,4),[5,6)}
2,{[2,3),[4,5)}

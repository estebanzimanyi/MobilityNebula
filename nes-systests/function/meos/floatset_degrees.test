# name: MEOS_FLOATSET_DEGREES
# description: floatset_degrees — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatsetdegreess(id UINT64, a VARSIZED, norm BOOLEAN);
CREATE PHYSICAL SOURCE FOR floatsetdegreess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|false
2|'{3.5, 5.5, 9.5}'|false

CREATE SINK floatsetdegreess_out(floatsetdegreess.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSET_DEGREES(a, norm) AS r FROM floatsetdegreess INTO floatsetdegreess_out;
----
1,{85.94366926962348, 200.53522829578813, 315.12678732195275}
2,{200.53522829578813, 315.12678732195275, 544.309905374282}

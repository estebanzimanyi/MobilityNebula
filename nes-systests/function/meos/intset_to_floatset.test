# name: MEOS_INTSET_TO_FLOATSET
# description: intset_to_floatset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intsettofloatsets(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR intsettofloatsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{3, 5, 9}'

CREATE SINK intsettofloatsets_out(intsettofloatsets.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTSET_TO_FLOATSET(a) AS r FROM intsettofloatsets INTO intsettofloatsets_out;
----
1,{1,3,5}
2,{3,5,9}

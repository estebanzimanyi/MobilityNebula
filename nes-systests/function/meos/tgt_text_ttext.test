# name: MEOS_TGT_TEXT_TTEXT
# description: tgt_text_ttext — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tgttextttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tgttextttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'XYZ'
2|'DEF'|1609545600|'XYZ'

CREATE SINK tgttextttexts_out(tgttextttexts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TGT_TEXT_TTEXT(value, ts, arg) AS r FROM tgttextttexts INTO tgttextttexts_out;
----
1,t@2021-01-01,00:00:00+00
2,t@2021-01-02,00:00:00+00

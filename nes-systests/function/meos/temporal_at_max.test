# name: MEOS_TEMPORAL_AT_MAX_EXP_Aggregation
# description: Windowed TEMPORAL_AT_MAX_EXP.
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE temporax(gid UINT64, reading FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR temporax TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|10.5|1609459200
1|22.7|1609459201
1|18.3|1609459202
2|5.0|1609459200
2|99.9|1609459201

CREATE SINK temporax_out(temporax.gid UINT64, temporax.r VARSIZED) TYPE File;
SELECT gid, TEMPORAL_AT_MAX_EXP(reading, ts) AS r FROM temporax GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO temporax_out;

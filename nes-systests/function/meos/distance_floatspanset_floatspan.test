# name: MEOS_DISTANCE_FLOATSPANSET_FLOATSPAN
# description: distance_floatspanset_floatspan — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancefloatspanss(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR distancefloatspanss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'|'[1.5, 5.5)'
2|'{[3.5, 7.5)}'|'[3.5, 9.5)'

CREATE SINK distancefloatspanss_out(distancefloatspanss.id UINT64, r FLOAT64) TYPE File;
SELECT id, DISTANCE_FLOATSPANSET_FLOATSPAN(a, b) AS r FROM distancefloatspanss INTO distancefloatspanss_out;
----
1,0.0
2,0.0

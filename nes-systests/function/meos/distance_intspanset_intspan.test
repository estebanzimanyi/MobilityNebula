CREATE LOGICAL SOURCE distanceintspansets(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR distanceintspansets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

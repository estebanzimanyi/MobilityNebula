# name: MEOS_BIGINT_GET_BIN
# description: bigint_get_bin — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE bigintgetbins(id UINT64, value INT64, arg0 INT64, arg1 INT64);
CREATE PHYSICAL SOURCE FOR bigintgetbins TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|7|5|0
2|12|5|0

CREATE SINK bigintgetbins_out(bigintgetbins.id UINT64, r INT64) TYPE File;
SELECT id, BIGINT_GET_BIN(value, arg0, arg1) AS r FROM bigintgetbins INTO bigintgetbins_out;

# name: MEOS_NSEGMENT_ROUTE
# description: nsegment_route — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE nsegmentroutes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR nsegmentroutes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NSegment(1, 0.2, 0.8)'
2|'NSegment(1, 0.5, 0.7)'

CREATE SINK nsegmentroutes_out(nsegmentroutes.id UINT64, r INT64) TYPE File;
SELECT id, NSEGMENT_ROUTE(a) AS r FROM nsegmentroutes INTO nsegmentroutes_out;
----
1,1
2,1

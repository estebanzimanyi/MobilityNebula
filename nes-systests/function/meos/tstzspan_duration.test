# name: MEOS_TSTZSPAN_DURATION
# description: tstzspan_duration — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzspandurations(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzspandurations TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)'
2|'[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)'

CREATE SINK tstzspandurations_out(tstzspandurations.id UINT64, r VARSIZED) TYPE File;
SELECT id, TSTZSPAN_DURATION(a) AS r FROM tstzspandurations INTO tstzspandurations_out;
----
1,9,days
2,15,days

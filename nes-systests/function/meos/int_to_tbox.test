# name: MEOS_INT_TO_TBOX
# description: int_to_tbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE inttotboxs(id UINT64, value INT32);
CREATE PHYSICAL SOURCE FOR inttotboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5
2|8

CREATE SINK inttotboxs_out(inttotboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, INT_TO_TBOX(value) AS r FROM inttotboxs INTO inttotboxs_out;
----
1,TBOXINT X([5, 6))
2,TBOXINT X([8, 9))

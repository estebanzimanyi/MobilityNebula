# name: MEOS_SPAN_GE
# description: span_ge — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spanges(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR spanges TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|'[1, 5)'
2|'[3, 9)'|'[3, 9)'

CREATE SINK spanges_out(spanges.id UINT64, r INT32) TYPE File;
SELECT id, SPAN_GE(a, b) AS r FROM spanges INTO spanges_out;
----
1,1
2,1

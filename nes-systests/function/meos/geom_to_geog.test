# name: MEOS_GEOM_TO_GEOG
# description: geom_to_geog — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomtogeogs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geomtogeogs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(1 1, 2 2)'
2|'SRID=4326;Linestring(3 3, 4 4, 5 5)'

CREATE SINK geomtogeogs_out(geomtogeogs.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEOM_TO_GEOG(a) AS r FROM geomtogeogs INTO geomtogeogs_out;
----
1,0102000020E610000002000000000000000000F03F000000000000F03F00000000000000400000000000000040
2,0102000020E610000003000000000000000000084000000000000008400000000000001040000000000000104000000000000014400000000000001440

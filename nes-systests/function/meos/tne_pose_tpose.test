# name: MEOS_TNE_POSE_TPOSE
# description: tne_pose_tpose — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tneposetposes(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tneposetposes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|0.5|1609459200|'Pose(Point(1 1), 0.5)'
2|2.0|2.0|1.0|1609545600|'Pose(Point(2 2), 1.0)'

CREATE SINK tneposetposes_out(tneposetposes.id UINT64, r VARSIZED) TYPE File;
SELECT id, TNE_POSE_TPOSE(x, y, theta, ts, arg) AS r FROM tneposetposes INTO tneposetposes_out;

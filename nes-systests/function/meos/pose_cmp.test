# name: MEOS_POSE_CMP
# description: pose_cmp — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posecmps(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR posecmps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'|'Pose(Point(2 2), 1.0)'
2|'Pose(Point(2 2), 1.0)'|'Pose(Point(1 1), 0.5)'

CREATE SINK posecmps_out(posecmps.id UINT64, r INT32) TYPE File;
SELECT id, POSE_CMP(a, b) AS r FROM posecmps INTO posecmps_out;
----
1,240
2,-240

# name: MEOS_TNUMBER_TWAVG
# groups: [Function, MEOS, Aggregation]
CREATE LOGICAL SOURCE tntw(gid UINT64, reading FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tntw TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|10.5|1609459200
1|22.7|1609459201
2|5.0|1609459200

CREATE SINK tntw_out(tntw.gid UINT64, tntw.r FLOAT64) TYPE File;
SELECT gid, TNUMBER_TWAVG(reading, ts) AS r FROM tntw GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tntw_out;
----
1,16.6
2,5.0

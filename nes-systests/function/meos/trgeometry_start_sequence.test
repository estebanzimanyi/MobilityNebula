# name: MEOS_TRGEOMETRY_START_SEQUENCE_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE trss(gid UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR trss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|0.1|1609459200
1|2.0|2.0|0.2|1609459201
1|3.0|3.0|0.3|1609459202
2|5.0|5.0|0.5|1609459200
2|6.0|6.0|0.6|1609459201

CREATE SINK trss_out(trss.gid UINT64, trss.r VARSIZED) TYPE File;
SELECT gid, TRGEOMETRY_START_SEQUENCE(x, y, theta, ts) AS r FROM trss GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO trss_out;

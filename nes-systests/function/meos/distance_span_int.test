# name: MEOS_DISTANCE_SPAN_INT
# description: distance_span_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancespanints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR distancespanints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK distancespanints_out(distancespanints.id UINT64, r INT32) TYPE File;
SELECT id, DISTANCE_SPAN_INT(a, b) AS r FROM distancespanints INTO distancespanints_out;
----
1,0
2,0

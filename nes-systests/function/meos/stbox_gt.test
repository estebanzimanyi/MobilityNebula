# name: MEOS_STBOX_GT
# description: STBOX_GT over two per-vehicle extent STBoxes (VARSIZED stbox text). Box A=((1,1),(3,3)); B=((2,2),(4,4)).
# groups: [Function, MEOS, SpatioTemporal, Box, Codegen]
CREATE LOGICAL SOURCE sbcgt(id UINT64, boxa VARSIZED, boxb VARSIZED);
CREATE PHYSICAL SOURCE FOR sbcgt TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|STBOX X((1,1),(3,3))|STBOX X((2,2),(4,4))
2|STBOX X((1,1),(3,3))|STBOX X((10,10),(11,11))

CREATE SINK sbcgt_out(sbcgt.id UINT64, r BOOLEAN) TYPE File;
SELECT id, STBOX_GT(boxa, boxb) AS r FROM sbcgt INTO sbcgt_out;
----
1,0
2,0

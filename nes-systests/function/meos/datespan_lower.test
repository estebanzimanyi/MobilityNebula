# name: MEOS_DATESPAN_LOWER
# description: datespan_lower — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE datespanlowers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR datespanlowers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01, 2020-01-10)'
2|'[2020-01-05, 2020-01-20)'

CREATE SINK datespanlowers_out(datespanlowers.id UINT64, r INT32) TYPE File;
SELECT id, DATESPAN_LOWER(a) AS r FROM datespanlowers INTO datespanlowers_out;

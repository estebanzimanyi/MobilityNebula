# name: MEOS_FLOATSPAN_WIDTH
# description: floatspan_width — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspanwidths(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatspanwidths TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'
2|'[3.5, 9.5)'

CREATE SINK floatspanwidths_out(floatspanwidths.id UINT64, r FLOAT64) TYPE File;
SELECT id, FLOATSPAN_WIDTH(a) AS r FROM floatspanwidths INTO floatspanwidths_out;
----
1,4.0
2,6.0

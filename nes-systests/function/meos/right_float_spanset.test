# name: MEOS_RIGHT_FLOAT_SPANSET
# description: right_float_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightfloatspansets(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR rightfloatspansets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'|3.5
2|'{[3.5, 7.5)}'|7.5

CREATE SINK rightfloatspansets_out(rightfloatspansets.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_FLOAT_SPANSET(a, b) AS r FROM rightfloatspansets INTO rightfloatspansets_out;
----
1,0
2,1

CREATE LOGICAL SOURCE distancespansetints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR distancespansetints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|3

# name: MEOS_GEO_SET_SRID
# description: geo_set_srid — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geosetsrids(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geosetsrids TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(1 1)'
2|'SRID=4326;Point(2 2)'

CREATE SINK geosetsrids_out(geosetsrids.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEO_SET_SRID(a) AS r FROM geosetsrids INTO geosetsrids_out;
----
1,0101000020E6100000000000000000F03F000000000000F03F
2,0101000020E610000000000000000000400000000000000040

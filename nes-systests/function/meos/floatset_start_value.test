# name: MEOS_FLOATSET_START_VALUE
# description: floatset_start_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatsetstartvalues(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatsetstartvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'
2|'{3.5, 5.5, 9.5}'

CREATE SINK floatsetstartvalues_out(floatsetstartvalues.id UINT64, r FLOAT64) TYPE File;
SELECT id, FLOATSET_START_VALUE(a) AS r FROM floatsetstartvalues INTO floatsetstartvalues_out;
----
1,1.5
2,3.5

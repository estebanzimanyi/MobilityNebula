# name: MEOS_INTSPANSET_WIDTH
# description: intspanset_width — total width of an int spanset.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intspansetwidths(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR intspansetwidths TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'
2|'{[3, 7)}'

CREATE SINK intspansetwidths_out(intspansetwidths.id UINT64, r INT32) TYPE File;
SELECT id, INTSPANSET_WIDTH(a) AS r FROM intspansetwidths INTO intspansetwidths_out;
----
1,9
2,4

# name: MEOS_TPOSE_POINTS
# description: tpose_points — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tposepointss(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tposepointss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|0.5|1609459200
2|2.0|2.0|1.0|1609545600

CREATE SINK tposepointss_out(tposepointss.id UINT64, r VARSIZED) TYPE File;
SELECT id, TPOSE_POINTS(x, y, theta, ts) AS r FROM tposepointss INTO tposepointss_out;
----
1,{"POINT(1 1)"}
2,{"POINT(2 2)"}

# name: MEOS_TEMPORAL_NUM_SEQUENCES_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE tns(gid UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tns TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200
1|2.0|2.0|1609459201
1|3.0|3.0|1609459202
2|5.0|5.0|1609459200
2|6.0|6.0|1609459201

CREATE SINK tns_out(tns.gid UINT64, tns.r INT32) TYPE File;
SELECT gid, TEMPORAL_NUM_SEQUENCES(lon, lat, ts) AS r FROM tns GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tns_out;
----
1,1
2,1

# name: MEOS_CONTAINS_SET_TEXT
# description: contains_set_text — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containssettexts(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR containssettexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'|'AAA'
2|'{"BBB", "DDD"}'|'BBB'

CREATE SINK containssettexts_out(containssettexts.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINS_SET_TEXT(a, arg) AS r FROM containssettexts INTO containssettexts_out;
----
1,1
2,1

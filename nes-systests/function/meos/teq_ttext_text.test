# name: MEOS_TEQ_TTEXT_TEXT
# description: teq_ttext_text — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE teqttexttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR teqttexttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'XYZ'
2|'DEF'|1609545600|'XYZ'

CREATE SINK teqttexttexts_out(teqttexttexts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEQ_TTEXT_TEXT(value, ts, arg) AS r FROM teqttexttexts INTO teqttexttexts_out;
----
1,f@2021-01-01,00:00:00+00
2,f@2021-01-02,00:00:00+00

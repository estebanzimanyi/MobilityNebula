# name: MEOS_UNION_SET_INT
# description: union_set_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionsetints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR unionsetints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK unionsetints_out(unionsetints.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_SET_INT(a, b) AS r FROM unionsetints INTO unionsetints_out;
----
1,{1,3,5}
2,{3,5,7,9}

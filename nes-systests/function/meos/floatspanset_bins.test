# name: MEOS_FLOATSPANSET_BINS
# description: floatspanset_bins — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspansetbinss(id UINT64, a VARSIZED, x0 FLOAT64, x1 FLOAT64);
CREATE PHYSICAL SOURCE FOR floatspansetbinss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 20.5)}'|5.0|0.0
2|'{[3.5, 25.5)}'|5.0|0.0

CREATE SINK floatspansetbinss_out(floatspansetbinss.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSPANSET_BINS(a, x0, x1) AS r FROM floatspansetbinss INTO floatspansetbinss_out;
----
1,{[1.5,5),[5,10),[10,15),[15,20),[20,20.5)}
2,{[3.5,5),[5,10),[10,15),[15,20),[20,25),[25,25.5)}

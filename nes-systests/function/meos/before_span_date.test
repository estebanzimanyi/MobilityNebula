# name: MEOS_BEFORE_SPAN_DATE
# description: before_span_date — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE beforespandates(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR beforespandates TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01, 2020-01-10)'|'2020-01-03'
2|'[2020-01-05, 2020-01-20)'|'2020-06-15'

CREATE SINK beforespandates_out(beforespandates.id UINT64, r INT32) TYPE File;
SELECT id, BEFORE_SPAN_DATE(a, b) AS r FROM beforespandates INTO beforespandates_out;
----
1,0
2,1

# name: MEOS_NPOINT_HASH_EXTENDED
# description: npoint_hash_extended — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointhashextendeds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR npointhashextendeds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Npoint(1,0.5)'
2|'Npoint(2,0.5)'

CREATE SINK npointhashextendeds_out(npointhashextendeds.id UINT64, r INT64) TYPE File;
SELECT id, NPOINT_HASH_EXTENDED(a) AS r FROM npointhashextendeds INTO npointhashextendeds_out;

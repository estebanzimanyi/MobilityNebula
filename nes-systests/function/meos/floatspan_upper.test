# name: MEOS_FLOATSPAN_UPPER
# description: floatspan_upper — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspanuppers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatspanuppers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'
2|'[3.5, 9.5)'

CREATE SINK floatspanuppers_out(floatspanuppers.id UINT64, r FLOAT64) TYPE File;
SELECT id, FLOATSPAN_UPPER(a) AS r FROM floatspanuppers INTO floatspanuppers_out;
----
1,5.5
2,9.5

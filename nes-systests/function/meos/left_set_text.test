# name: MEOS_LEFT_SET_TEXT
# description: left_set_text — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE leftsettexts(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR leftsettexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'|'AAA'
2|'{"BBB", "DDD"}'|'BBB'

CREATE SINK leftsettexts_out(leftsettexts.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_SET_TEXT(a, arg) AS r FROM leftsettexts INTO leftsettexts_out;
----
1,0
2,0

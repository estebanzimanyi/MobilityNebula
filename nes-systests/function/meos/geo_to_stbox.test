# name: MEOS_GEO_TO_STBOX
# description: geo_to_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geotostboxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geotostboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(1 1)'
2|'SRID=4326;Point(2 2)'

CREATE SINK geotostboxs_out(geotostboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEO_TO_STBOX(a) AS r FROM geotostboxs INTO geotostboxs_out;
----
1,SRID=4326;STBOX X((1,1),(1,1))
2,SRID=4326;STBOX X((2,2),(2,2))

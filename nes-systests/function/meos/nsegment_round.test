# name: MEOS_NSEGMENT_ROUND
# description: nsegment_round — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE nsegmentrounds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR nsegmentrounds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NSegment(1, 0.2, 0.8)'
2|'NSegment(1, 0.5, 0.7)'

CREATE SINK nsegmentrounds_out(nsegmentrounds.id UINT64, r VARSIZED) TYPE File;
SELECT id, NSEGMENT_ROUND(a) AS r FROM nsegmentrounds INTO nsegmentrounds_out;
----
1,NSegment(1 0.2 0.8)
2,NSegment(1 0.5 0.7)

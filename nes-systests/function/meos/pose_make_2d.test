# name: MEOS_POSE_MAKE_2D
# description: pose_make_2d — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posemake2ds(id UINT64, value FLOAT64, arg0 FLOAT64, arg1 FLOAT64, arg2 INT32);
CREATE PHYSICAL SOURCE FOR posemake2ds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|0.5|0
2|2.0|2.0|1.0|0

CREATE SINK posemake2ds_out(posemake2ds.id UINT64, r VARSIZED) TYPE File;
SELECT id, POSE_MAKE_2D(value, arg0, arg1, arg2) AS r FROM posemake2ds INTO posemake2ds_out;
----
1,POSE (0101000000000000000000F03F000000000000F03F, 0.5)
2,POSE (010100000000000000000000400000000000000040, 1)

# name: MEOS_INTSPAN_BINS
# description: intspan_bins — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intspanbinss(id UINT64, a VARSIZED, x0 INT32, x1 INT32);
CREATE PHYSICAL SOURCE FOR intspanbinss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 20)'|5|0
2|'[3, 25)'|5|0

CREATE SINK intspanbinss_out(intspanbinss.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTSPAN_BINS(a, x0, x1) AS r FROM intspanbinss INTO intspanbinss_out;
----
1,{[0,5),[5,10),[10,15),[15,20),[20,25)}
2,{[0,5),[5,10),[10,15),[15,20),[20,25),[25,30)}

# name: MEOS_TEXTSET_START_VALUE
# description: textset_start_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textsetstartvalues(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR textsetstartvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'
2|'{"BBB", "DDD"}'

CREATE SINK textsetstartvalues_out(textsetstartvalues.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXTSET_START_VALUE(a) AS r FROM textsetstartvalues INTO textsetstartvalues_out;
----
1,"AAA"
2,"BBB"

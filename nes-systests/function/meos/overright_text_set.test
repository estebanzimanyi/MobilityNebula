# name: MEOS_OVERRIGHT_TEXT_SET
# description: overright_text_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overrighttextsets(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR overrighttextsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'|'AAA'
2|'{"BBB", "DDD"}'|'BBB'

CREATE SINK overrighttextsets_out(overrighttextsets.id UINT64, r INT32) TYPE File;
SELECT id, OVERRIGHT_TEXT_SET(a, arg) AS r FROM overrighttextsets INTO overrighttextsets_out;
----
1,1
2,1

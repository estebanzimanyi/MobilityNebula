# name: MEOS_MultTnumberTnumber
# description: MULT_TNUMBER_TNUMBER over two per-vehicle tfloat hex-WKB inputs (P=1->3, Q=10->20), returning the temporal product P*Q as a VARSIZED hex-WKB tfloat.
# groups: [Function, MEOS, TemporalNumber, CrossStream]
CREATE LOGICAL SOURCE mtn(id UINT64, ta VARSIZED, tb VARSIZED);
CREATE PHYSICAL SOURCE FOR mtn TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|0121000E0200000003000000000000F03F00A0AD30CA5A020000000000000008408024CC30CA5A0200|0121000E0200000003000000000000244000A0AD30CA5A020000000000000034408024CC30CA5A0200

CREATE SINK mtn_out(mtn.id UINT64, r VARSIZED) TYPE File;
SELECT id, MULT_TNUMBER_TNUMBER(ta, tb) AS r FROM mtn INTO mtn_out;

# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE trgeometryaftertims(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR trgeometryaftertims TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|0.0|0.0|0.0|1609459200|'2019-01-01 00:00:00+00'
2|1.0|1.0|0.5|1609545600|'2019-01-01 00:00:00+00'

CREATE SINK trgeometryaftertims_out(trgeometryaftertims.id UINT64, r VARSIZED) TYPE File;
SELECT id, TRGEOMETRY_AFTER_TIMESTAMPTZ(x, y, theta, ts, arg) AS r FROM trgeometryaftertims INTO trgeometryaftertims_out;

# name: MEOS_BIGINTSPAN_BINS
# description: bigintspan_bins — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE bigintspanbinss(id UINT64, a VARSIZED, x0 INT64, x1 INT64);
CREATE PHYSICAL SOURCE FOR bigintspanbinss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 20)'|5|0
2|'[3, 25)'|5|0

CREATE SINK bigintspanbinss_out(bigintspanbinss.id UINT64, r VARSIZED) TYPE File;
SELECT id, BIGINTSPAN_BINS(a, x0, x1) AS r FROM bigintspanbinss INTO bigintspanbinss_out;
----
1,{[0,5),[5,10),[10,15),[15,20),[20,25)}
2,{[0,5),[5,10),[10,15),[15,20),[20,25),[25,30)}

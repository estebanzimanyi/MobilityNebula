# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tdistancetgeogeos(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tdistancetgeogeos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200|'SRID=4326;Point(1 1)'
2|2.0|2.0|1609545600|'SRID=4326;Point(2 2)'

CREATE SINK tdistancetgeogeos_out(tdistancetgeogeos.id UINT64, r VARSIZED) TYPE File;
SELECT id, TDISTANCE_TGEO_GEO(lon, lat, ts, arg) AS r FROM tdistancetgeogeos INTO tdistancetgeogeos_out;

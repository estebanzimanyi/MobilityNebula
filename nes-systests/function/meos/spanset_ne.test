# name: MEOS_SPANSET_NE
# description: spanset_ne — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spansetnes(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR spansetnes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|'{[1, 5), [10, 15)}'
2|'{[3, 7)}'|'{[3, 7)}'

CREATE SINK spansetnes_out(spansetnes.id UINT64, r INT32) TYPE File;
SELECT id, SPANSET_NE(a, b) AS r FROM spansetnes INTO spansetnes_out;
----
1,0
2,0

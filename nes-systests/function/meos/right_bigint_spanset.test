# name: MEOS_RIGHT_BIGINT_SPANSET
# description: right_bigint_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightbigintspansets(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR rightbigintspansets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|3
2|'{[3, 7)}'|7

CREATE SINK rightbigintspansets_out(rightbigintspansets.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_BIGINT_SPANSET(a, b) AS r FROM rightbigintspansets INTO rightbigintspansets_out;

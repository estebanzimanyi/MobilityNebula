# name: MEOS_TTEXT_INITCAP
# description: ttext_initcap — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE ttextinitcaps(id UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR ttextinitcaps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200
2|'DEF'|1609545600

CREATE SINK ttextinitcaps_out(ttextinitcaps.id UINT64, r VARSIZED) TYPE File;
SELECT id, TTEXT_INITCAP(value, ts) AS r FROM ttextinitcaps INTO ttextinitcaps_out;

# name: MEOS_TEMPORAL_TPRECISION
# description: temporal_tprecision — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE temporaltprecisions(id UINT64, value FLOAT64, ts UINT64, arg0 VARSIZED, arg1 VARSIZED);
CREATE PHYSICAL SOURCE FOR temporaltprecisions TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200|'1 day'|'2020-01-01 00:00:00+00'
2|8.5|1609545600|'2 days'|'2020-01-01 00:00:00+00'

CREATE SINK temporaltprecisions_out(temporaltprecisions.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEMPORAL_TPRECISION(value, ts, arg0, arg1) AS r FROM temporaltprecisions INTO temporaltprecisions_out;

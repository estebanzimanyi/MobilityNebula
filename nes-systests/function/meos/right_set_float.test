# name: MEOS_RIGHT_SET_FLOAT
# description: right_set_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightsetfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR rightsetfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|3.5
2|'{3.5, 5.5, 9.5}'|7.5

CREATE SINK rightsetfloats_out(rightsetfloats.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_SET_FLOAT(a, b) AS r FROM rightsetfloats INTO rightsetfloats_out;
----
1,0
2,0

# name: MEOS_CBUFFERSET_END_VALUE
# description: cbufferset_end_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbuffersetendvalues(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR cbuffersetendvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Cbuffer(Point(1 1),0.5)", "Cbuffer(Point(2 2),0.5)"}'
2|'{"Cbuffer(Point(3 3),1.0)", "Cbuffer(Point(4 4),0.5)"}'

CREATE SINK cbuffersetendvalues_out(cbuffersetendvalues.id UINT64, r VARSIZED) TYPE File;
SELECT id, CBUFFERSET_END_VALUE(a) AS r FROM cbuffersetendvalues INTO cbuffersetendvalues_out;
----
1,Cbuffer(010100000000000000000000400000000000000040,0.5)
2,Cbuffer(010100000000000000000010400000000000001040,0.5)

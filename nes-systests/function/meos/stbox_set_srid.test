# name: MEOS_STBOX_SET_SRID
# description: stbox_set_srid — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxsetsrids(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxsetsrids TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;STBOX X((4.3 50.8),(4.4 50.9))'
2|'SRID=4326;STBOX X((4.1 50.7),(4.2 50.8))'

CREATE SINK stboxsetsrids_out(stboxsetsrids.id UINT64, r VARSIZED) TYPE File;
SELECT id, STBOX_SET_SRID(a) AS r FROM stboxsetsrids INTO stboxsetsrids_out;
----
1,SRID=4326;STBOX X((4.3,50.8),(4.4,50.9))
2,SRID=4326;STBOX X((4.1,50.7),(4.2,50.8))

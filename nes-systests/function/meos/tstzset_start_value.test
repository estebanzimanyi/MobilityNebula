CREATE LOGICAL SOURCE tstzsetstartvalues(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzsetstartvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01 00:00:00+00, 2020-01-05 00:00:00+00}'
2|'{2020-01-03 00:00:00+00, 2020-01-08 00:00:00+00}'

CREATE SINK tstzsetstartvalues_out(tstzsetstartvalues.id UINT64, r INT64) TYPE File;
SELECT id, TSTZSET_START_VALUE(a) AS r FROM tstzsetstartvalues INTO tstzsetstartvalues_out;

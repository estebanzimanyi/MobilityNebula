# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzspansetuppers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzspansetuppers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)}'
2|'{[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)}'

CREATE SINK tstzspansetuppers_out(tstzspansetuppers.id UINT64, r INT64) TYPE File;
SELECT id, TSTZSPANSET_UPPER(a) AS r FROM tstzspansetuppers INTO tstzspansetuppers_out;

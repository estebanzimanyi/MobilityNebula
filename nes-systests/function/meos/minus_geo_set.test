# name: MEOS_MINUS_GEO_SET
# description: minus_geo_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minusgeosets(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR minusgeosets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Point(1 1)", "Point(2 2)"}'|'Point(9 9)'
2|'{"Point(3 3)", "Point(4 4)"}'|'Point(8 8)'

CREATE SINK minusgeosets_out(minusgeosets.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_GEO_SET(a, arg) AS r FROM minusgeosets INTO minusgeosets_out;
----
1,{"POINT(9 9)"}
2,{"POINT(8 8)"}

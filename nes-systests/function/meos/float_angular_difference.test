# name: MEOS_FLOAT_ANGULAR_DIFFERENCE
# description: float_angular_difference — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatangulardiffers(id UINT64, value FLOAT64, arg0 FLOAT64);
CREATE PHYSICAL SOURCE FOR floatangulardiffers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|30.0|45.0
2|350.0|10.0

CREATE SINK floatangulardiffers_out(floatangulardiffers.id UINT64, r FLOAT64) TYPE File;
SELECT id, FLOAT_ANGULAR_DIFFERENCE(value, arg0) AS r FROM floatangulardiffers INTO floatangulardiffers_out;
----
1,15.0
2,20.0

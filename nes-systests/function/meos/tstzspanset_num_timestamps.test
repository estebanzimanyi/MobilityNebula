# name: MEOS_TSTZSPANSET_NUM_TIMESTAMPS
# description: tstzspanset_num_timestamps — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzspansetnumtimes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzspansetnumtimes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)}'
2|'{[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)}'

CREATE SINK tstzspansetnumtimes_out(tstzspansetnumtimes.id UINT64, r INT32) TYPE File;
SELECT id, TSTZSPANSET_NUM_TIMESTAMPS(a) AS r FROM tstzspansetnumtimes INTO tstzspansetnumtimes_out;

# name: MEOS_TPOINT_MINUS_ELEVATION
# description: TPOINT_MINUS_ELEVATION removes from a 3D temporal point (a hex-WKB tgeompoint instant) the parts within an elevation (Z) span, emitted as hex-WKB.
# groups: [Function, MEOS, SpatioTemporal]
CREATE LOGICAL SOURCE tpointminuselevations(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR tpointminuselevations TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|012E00110101000080000000000000F03F000000000000F03F00000000000014400060C286073E0200|'[20, 30]'

CREATE SINK tpointminuselevations_out(tpointminuselevations.id UINT64, r VARSIZED) TYPE File;
SELECT id, TPOINT_MINUS_ELEVATION(a, b) AS r FROM tpointminuselevations INTO tpointminuselevations_out;
----
1,012E00110101000080000000000000F03F000000000000F03F00000000000014400060C286073E0200

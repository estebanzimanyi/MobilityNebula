# name: MEOS_DISTANCE_INTSPAN_INTSPAN
# description: distance_intspan_intspan — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distanceintspanints(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR distanceintspanints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|'[1, 5)'
2|'[3, 9)'|'[3, 9)'

CREATE SINK distanceintspanints_out(distanceintspanints.id UINT64, r INT32) TYPE File;
SELECT id, DISTANCE_INTSPAN_INTSPAN(a, b) AS r FROM distanceintspanints INTO distanceintspanints_out;
----
1,0

# name: MEOS_UNION_BIGINT_SET
# description: union_bigint_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionbigintsets(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR unionbigintsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK unionbigintsets_out(unionbigintsets.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_BIGINT_SET(a, b) AS r FROM unionbigintsets INTO unionbigintsets_out;

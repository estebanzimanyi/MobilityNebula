# name: MEOS_TemporalEDWithinTGeometry
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, EDWithin]
CREATE LOGICAL SOURCE adtt(id UINT32, lonA FLOAT64, latA FLOAT64, tsA UINT64, lonB FLOAT64, latB FLOAT64, tsB UINT64);
CREATE PHYSICAL SOURCE FOR adtt TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200|4.3658|50.6456|1609459200
2|4.3658|50.6456|1609459200|4.4000|50.7000|1609459200

CREATE SINK adtt_out(adtt.id UINT32, within INT32) TYPE File;
SELECT id, TEMPORAL_ADWITHIN_TGEOMETRY(lonA, latA, tsA, lonB, latB, tsB, FLOAT64(0.001)) AS within FROM adtt INTO adtt_out;

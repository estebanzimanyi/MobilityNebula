# name: MEOS_DATESPAN_UPPER
# description: datespan_upper — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE datespanuppers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR datespanuppers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01, 2020-01-10)'
2|'[2020-01-05, 2020-01-20)'

CREATE SINK datespanuppers_out(datespanuppers.id UINT64, r INT32) TYPE File;
SELECT id, DATESPAN_UPPER(a) AS r FROM datespanuppers INTO datespanuppers_out;

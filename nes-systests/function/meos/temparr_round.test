# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE temparrrounds(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR temparrrounds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);

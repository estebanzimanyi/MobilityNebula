# name: MEOS_SPAN_CMP
# description: span_cmp — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spancmps(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR spancmps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|'[1, 5)'
2|'[3, 9)'|'[3, 9)'

CREATE SINK spancmps_out(spancmps.id UINT64, r INT32) TYPE File;
SELECT id, SPAN_CMP(a, b) AS r FROM spancmps INTO spancmps_out;
----
1,0
2,0

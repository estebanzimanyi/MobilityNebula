# name: MEOS_BEFORE_TEMPORAL_TSTZSPAN
# description: before_temporal_tstzspan (temporal, tstzspan) time topological relationship.
# groups: [Function, MEOS, Temporal, Topological, Codegen]
CREATE LOGICAL SOURCE beforetempo(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR beforetempo TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.0|1609459200
2|5.0|1609632000

CREATE SINK beforetempo_out(beforetempo.id UINT64, r BOOLEAN) TYPE File;
SELECT id, BEFORE_TEMPORAL_TSTZSPAN(value, ts, '[2021-01-01 00:00:00+00, 2021-01-02 00:00:00+00)') AS r FROM beforetempo INTO beforetempo_out;
----
1,0
2,0

# name: MEOS_GEOM_DIFFERENCE2D
# description: geom_difference2d — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomdifference2ds(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geomdifference2ds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(0 0, 2 2)'|'SRID=4326;Linestring(0 2, 2 0)'
2|'SRID=4326;Linestring(0 0, 3 3)'|'SRID=4326;Linestring(1 0, 1 3)'

CREATE SINK geomdifference2ds_out(geomdifference2ds.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEOM_DIFFERENCE2D(a, arg) AS r FROM geomdifference2ds INTO geomdifference2ds_out;
----

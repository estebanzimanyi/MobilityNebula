# name: MEOS_FLOATSPAN_DEGREES
# description: floatspan_degrees — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspandegreess(id UINT64, a VARSIZED, norm BOOLEAN);
CREATE PHYSICAL SOURCE FOR floatspandegreess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'|false
2|'[3.5, 9.5)'|false

CREATE SINK floatspandegreess_out(floatspandegreess.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSPAN_DEGREES(a, norm) AS r FROM floatspandegreess INTO floatspandegreess_out;
----
1,[85.94366926962348, 315.12678732195275)
2,[200.53522829578813, 544.309905374282)

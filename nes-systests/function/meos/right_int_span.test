# name: MEOS_RIGHT_INT_SPAN
# description: right_int_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightintspans(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR rightintspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK rightintspans_out(rightintspans.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_INT_SPAN(a, b) AS r FROM rightintspans INTO rightintspans_out;
----
1,0
2,0

# name: MEOS_TGEOMETRY_TO_TGEOGRAPHY
# description: tgeometry_to_tgeography — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tgeometrytotgeogras(id UINT64, geomWkt VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR tgeometrytotgeogras TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(4.35 50.85)'|1609459200
2|'SRID=4326;Point(4.36 50.86)'|1609545600

CREATE SINK tgeometrytotgeogras_out(tgeometrytotgeogras.id UINT64, r VARSIZED) TYPE File;
SELECT id, TGEOMETRY_TO_TGEOGRAPHY(geomWkt, ts) AS r FROM tgeometrytotgeogras INTO tgeometrytotgeogras_out;

# name: MEOS_TGE_TTEXT_TEXT
# description: tge_ttext_text — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tgettexttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tgettexttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'XYZ'
2|'DEF'|1609545600|'XYZ'

CREATE SINK tgettexttexts_out(tgettexttexts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TGE_TTEXT_TEXT(value, ts, arg) AS r FROM tgettexttexts INTO tgettexttexts_out;
----
1,f@2021-01-01,00:00:00+00
2,f@2021-01-02,00:00:00+00

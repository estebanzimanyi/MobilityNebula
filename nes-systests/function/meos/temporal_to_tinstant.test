# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE temporaltotinstants(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR temporaltotinstants TYPE File SET('|' AS PARSER.FIELD_DELIMITER);

# name: MEOS_TEXTCAT_TEXT_TTEXT
# description: textcat_text_ttext — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textcattextttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR textcattextttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'XYZ'
2|'DEF'|1609545600|'XYZ'

CREATE SINK textcattextttexts_out(textcattextttexts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXTCAT_TEXT_TTEXT(value, ts, arg) AS r FROM textcattextttexts INTO textcattextttexts_out;
----
1,"XYZABC"@2021-01-01,00:00:00+00
2,"XYZDEF"@2021-01-02,00:00:00+00

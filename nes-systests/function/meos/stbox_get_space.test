# name: MEOS_STBOX_GET_SPACE
# description: stbox_get_space — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxgetspaces(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxgetspaces TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'
2|'STBOX X((3,3),(7,7))'

CREATE SINK stboxgetspaces_out(stboxgetspaces.id UINT64, r VARSIZED) TYPE File;
SELECT id, STBOX_GET_SPACE(a) AS r FROM stboxgetspaces INTO stboxgetspaces_out;
----
1,STBOX X((1 1) (5 5))
2,STBOX X((3 3) (7 7))

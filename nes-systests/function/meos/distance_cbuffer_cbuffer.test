# name: MEOS_DISTANCE_CBUFFER_CBUFFER
# description: distance_cbuffer_cbuffer — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancecbuffercbus(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR distancecbuffercbus TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'|'Cbuffer(Point(2 2),0.5)'
2|'Cbuffer(Point(2 2),0.5)'|'Cbuffer(Point(1 1),1.0)'

CREATE SINK distancecbuffercbus_out(distancecbuffercbus.id UINT64, r FLOAT64) TYPE File;
SELECT id, DISTANCE_CBUFFER_CBUFFER(a, b) AS r FROM distancecbuffercbus INTO distancecbuffercbus_out;
----
1,0.0
2,0.0

# name: MEOS_TEMPORAL_SHIFT_TIME
# description: temporal_shift_time — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE temporalshifttimes(id UINT64, value FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR temporalshifttimes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200|'1 day'
2|8.5|1609545600|'1 day'

CREATE SINK temporalshifttimes_out(temporalshifttimes.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEMPORAL_SHIFT_TIME(value, ts, arg) AS r FROM temporalshifttimes INTO temporalshifttimes_out;

# name: MEOS_TSTZSET_VALUES
# description: tstzset_values — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzsetvaluess(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzsetvaluess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01, 2020-01-05}'
2|'{2020-01-03, 2020-01-08}'

CREATE SINK tstzsetvaluess_out(tstzsetvaluess.id UINT64, r VARSIZED) TYPE File;
SELECT id, TSTZSET_VALUES(a) AS r FROM tstzsetvaluess INTO tstzsetvaluess_out;

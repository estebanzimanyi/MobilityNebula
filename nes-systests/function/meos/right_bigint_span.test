# name: MEOS_RIGHT_BIGINT_SPAN
# description: right_bigint_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightbigintspans(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR rightbigintspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK rightbigintspans_out(rightbigintspans.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_BIGINT_SPAN(a, b) AS r FROM rightbigintspans INTO rightbigintspans_out;
----

# name: MEOS_TSTZSPAN_SHIFT_SCALE
# description: tstzspan_shift_scale (interval shift/duration).
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzspanss(id UINT64, lit VARSIZED, shf VARSIZED, dur VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzspanss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2021-01-01 00:00:00+00, 2021-01-05 00:00:00+00)'|'1 day'|'10 days'

CREATE SINK tstzspanss_out(tstzspanss.id UINT64, r VARSIZED) TYPE File;
SELECT id, TSTZSPAN_SHIFT_SCALE(lit, shf, dur) AS r FROM tstzspanss INTO tstzspanss_out;
----
1,[2021-01-02,00:00:00+00,2021-01-12,00:00:00+00)

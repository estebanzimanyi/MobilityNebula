# name: MEOS_TGT_TTEXT_TEXT
# description: tgt_ttext_text — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tgtttexttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tgtttexttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'XYZ'
2|'DEF'|1609545600|'XYZ'

CREATE SINK tgtttexttexts_out(tgtttexttexts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TGT_TTEXT_TEXT(value, ts, arg) AS r FROM tgtttexttexts INTO tgtttexttexts_out;
----
1,f@2021-01-01,00:00:00+00
2,f@2021-01-02,00:00:00+00

# name: MEOS_INTERSECTION_SET_GEO
# description: intersection_set_geo — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectionsetgeos(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR intersectionsetgeos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Point(1 1)", "Point(2 2)"}'|'Point(1 1)'
2|'{"Point(3 3)", "Point(4 4)"}'|'Point(3 3)'

CREATE SINK intersectionsetgeos_out(intersectionsetgeos.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERSECTION_SET_GEO(a, arg) AS r FROM intersectionsetgeos INTO intersectionsetgeos_out;
----
1,{"POINT(1 1)"}
2,{"POINT(3 3)"}

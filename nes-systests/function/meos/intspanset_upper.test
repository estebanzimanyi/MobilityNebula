# name: MEOS_INTSPANSET_UPPER
# description: intspanset_upper — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intspansetuppers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR intspansetuppers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'
2|'{[3, 7)}'

CREATE SINK intspansetuppers_out(intspansetuppers.id UINT64, r INT32) TYPE File;
SELECT id, INTSPANSET_UPPER(a) AS r FROM intspansetuppers INTO intspansetuppers_out;
----
1,15
2,7

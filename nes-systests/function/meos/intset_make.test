# name: MEOS_INTSET_MAKE_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE intsetmakes(gid UINT64, value INT32, ts UINT64);
CREATE PHYSICAL SOURCE FOR intsetmakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1|1609459200
1|2|1609459201
1|3|1609459202
2|5|1609459200
2|6|1609459201

CREATE SINK intsetmakes_out(intsetmakes.gid UINT64, intsetmakes.r VARSIZED) TYPE File;
SELECT gid, INTSET_MAKE(value, ts) AS r FROM intsetmakes GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO intsetmakes_out;

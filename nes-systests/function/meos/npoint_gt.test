# name: MEOS_NPOINT_GT
# description: npoint_gt — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointgts(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR npointgts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NPoint(1, 0.5)'|'NPoint(1, 0.7)'
2|'NPoint(1, 0.7)'|'NPoint(1, 0.5)'

CREATE SINK npointgts_out(npointgts.id UINT64, r INT32) TYPE File;
SELECT id, NPOINT_GT(a, b) AS r FROM npointgts INTO npointgts_out;
----
1,0
2,1

# name: MEOS_CBUFFER_LE
# description: cbuffer_le — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbufferles(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR cbufferles TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'|'Cbuffer(Point(2 2),0.5)'
2|'Cbuffer(Point(2 2),0.5)'|'Cbuffer(Point(1 1),1.0)'

CREATE SINK cbufferles_out(cbufferles.id UINT64, r INT32) TYPE File;
SELECT id, CBUFFER_LE(a, b) AS r FROM cbufferles INTO cbufferles_out;
----
1,1
2,0

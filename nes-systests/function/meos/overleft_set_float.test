# name: MEOS_OVERLEFT_SET_FLOAT
# description: overleft_set_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overleftsetfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR overleftsetfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|3.5
2|'{3.5, 5.5, 9.5}'|7.5

CREATE SINK overleftsetfloats_out(overleftsetfloats.id UINT64, r INT32) TYPE File;
SELECT id, OVERLEFT_SET_FLOAT(a, b) AS r FROM overleftsetfloats INTO overleftsetfloats_out;

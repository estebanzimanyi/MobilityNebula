# name: MEOS_GEOM_ARRAY_UNION_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE gau(gid UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR gau TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'010100000000004C0AC9B24E400000D8DE3D984340'|1609459200
1|'01010000000000902F231C4540000052BBD7545640'|1609459201

CREATE SINK gau_out(gau.gid UINT64, gau.r VARSIZED) TYPE File;
SELECT gid, GEOM_ARRAY_UNION(value, ts) AS r FROM gau GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO gau_out;

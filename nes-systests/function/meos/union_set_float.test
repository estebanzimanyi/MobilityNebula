# name: MEOS_UNION_SET_FLOAT
# description: union_set_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionsetfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR unionsetfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|3.5
2|'{3.5, 5.5, 9.5}'|7.5

CREATE SINK unionsetfloats_out(unionsetfloats.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_SET_FLOAT(a, b) AS r FROM unionsetfloats INTO unionsetfloats_out;
----
1,{1.5,3.5,5.5}
2,{3.5,5.5,7.5,9.5}

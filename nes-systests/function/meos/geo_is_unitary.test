# name: MEOS_GEO_IS_UNITARY
# description: geo_is_unitary — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geoisunitarys(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geoisunitarys TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(1 1, 2 2)'
2|'SRID=4326;Linestring(3 3, 4 4, 5 5)'

CREATE SINK geoisunitarys_out(geoisunitarys.id UINT64, r BOOLEAN) TYPE File;
SELECT id, GEO_IS_UNITARY(a) AS r FROM geoisunitarys INTO geoisunitarys_out;
----
1,1
2,1

# name: MEOS_INT64_CMP
# description: int64_cmp — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE int64cmps(id UINT64, value INT64, arg0 INT64);
CREATE PHYSICAL SOURCE FOR int64cmps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|3|5
2|5|3

CREATE SINK int64cmps_out(int64cmps.id UINT64, r INT32) TYPE File;
SELECT id, INT64_CMP(value, arg0) AS r FROM int64cmps INTO int64cmps_out;
----
1,-1
2,1

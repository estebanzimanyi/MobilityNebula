# name: MEOS_ADJACENT_TEMPORAL_TSTZSPAN
# description: adjacent_temporal_tstzspan (temporal, tstzspan) time topological relationship.
# groups: [Function, MEOS, Temporal, Topological, Codegen]
CREATE LOGICAL SOURCE adjacenttem(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR adjacenttem TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.0|1609459200
2|5.0|1609632000

CREATE SINK adjacenttem_out(adjacenttem.id UINT64, r BOOLEAN) TYPE File;
SELECT id, ADJACENT_TEMPORAL_TSTZSPAN(value, ts, '[2021-01-01 00:00:00+00, 2021-01-02 00:00:00+00)') AS r FROM adjacenttem INTO adjacenttem_out;
----
1,1
2,0

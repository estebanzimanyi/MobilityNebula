# name: MEOS_TTEXT_LOWER
# description: ttext_lower — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE ttextlowers(id UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR ttextlowers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200
2|'DEF'|1609545600

CREATE SINK ttextlowers_out(ttextlowers.id UINT64, r VARSIZED) TYPE File;
SELECT id, TTEXT_LOWER(value, ts) AS r FROM ttextlowers INTO ttextlowers_out;
----
1,"abc"@2021-01-01,00:00:00+00
2,"def"@2021-01-02,00:00:00+00

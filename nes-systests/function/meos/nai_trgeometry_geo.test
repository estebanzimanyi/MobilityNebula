# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE naitrgeometrygeos(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR naitrgeometrygeos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|0.0|0.0|0.0|1609459200|'Point(1 1)'
2|1.0|1.0|0.5|1609545600|'Point(2 2)'

CREATE SINK naitrgeometrygeos_out(naitrgeometrygeos.id UINT64, r VARSIZED) TYPE File;
SELECT id, NAI_TRGEOMETRY_GEO(x, y, theta, ts, arg) AS r FROM naitrgeometrygeos INTO naitrgeometrygeos_out;

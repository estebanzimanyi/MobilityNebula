# name: MEOS_UNION_GEO_SET
# description: union_geo_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE uniongeosets(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR uniongeosets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Point(1 1)", "Point(2 2)"}'|'Point(1 1)'
2|'{"Point(3 3)", "Point(4 4)"}'|'Point(3 3)'

CREATE SINK uniongeosets_out(uniongeosets.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_GEO_SET(a, arg) AS r FROM uniongeosets INTO uniongeosets_out;
----
1,{"POINT(1 1)", "POINT(2 2)"}
2,{"POINT(3 3)", "POINT(4 4)"}

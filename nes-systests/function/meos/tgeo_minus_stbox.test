# name: MEOS_TGEO_MINUS_STBOX
# description: tgeo_minus_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tgeominusstboxs(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tgeominusstboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200|'SRID=4326;STBOX X((40,40),(60,60))'
2|2.0|2.0|1609545600|'SRID=4326;STBOX X((40,40),(60,60))'

CREATE SINK tgeominusstboxs_out(tgeominusstboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, TGEO_MINUS_STBOX(lon, lat, ts, arg) AS r FROM tgeominusstboxs INTO tgeominusstboxs_out;
----
1,POINT(1 1)@2021-01-01 00:00:00+00
2,POINT(2 2)@2021-01-02 00:00:00+00

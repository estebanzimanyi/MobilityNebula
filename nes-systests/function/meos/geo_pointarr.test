# name: MEOS_GEO_POINTARR
# description: GEO_POINTARR returns the array of points of a (multi)point geometry.
# groups: [Function, MEOS, Geo]
CREATE LOGICAL SOURCE geopointarrs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geopointarrs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'MULTIPOINT(1 1,2 2,3 3)'

CREATE SINK geopointarrs_out(geopointarrs.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEO_POINTARR(a) AS r FROM geopointarrs INTO geopointarrs_out;
----
1,{0101000000000000000000F03F000000000000F03F,010100000000000000000000400000000000000040,010100000000000000000008400000000000000840}

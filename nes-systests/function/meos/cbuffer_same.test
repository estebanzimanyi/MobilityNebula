# name: MEOS_CBUFFER_SAME
# description: cbuffer_same — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbuffersames(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR cbuffersames TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'|'Cbuffer(Point(2 2),0.5)'
2|'Cbuffer(Point(2 2),0.5)'|'Cbuffer(Point(1 1),1.0)'

CREATE SINK cbuffersames_out(cbuffersames.id UINT64, r INT32) TYPE File;
SELECT id, CBUFFER_SAME(a, b) AS r FROM cbuffersames INTO cbuffersames_out;
----
1,0
2,0

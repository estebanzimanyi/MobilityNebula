# name: MEOS_TBOX_XMAX
# description: tbox_xmax — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxxmaxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxxmaxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'

CREATE SINK tboxxmaxs_out(tboxxmaxs.id UINT64, r FLOAT64) TYPE File;
SELECT id, TBOX_XMAX(a) AS r FROM tboxxmaxs INTO tboxxmaxs_out;
----
1,5.0
2,7.0

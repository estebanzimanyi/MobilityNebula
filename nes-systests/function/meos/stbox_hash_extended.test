# name: MEOS_STBOX_HASH_EXTENDED
# description: stbox_hash_extended — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxhashextendeds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxhashextendeds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;STBOX X((1 1),(2 2))'
2|'SRID=4326;STBOX X((3 3),(4 4))'

CREATE SINK stboxhashextendeds_out(stboxhashextendeds.id UINT64, r INT64) TYPE File;
SELECT id, STBOX_HASH_EXTENDED(a) AS r FROM stboxhashextendeds INTO stboxhashextendeds_out;
----
1,3309199718770715088
2,-5382943103673082334

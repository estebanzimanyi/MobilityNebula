# name: MEOS_TGEO_VALUES
# description: tgeo_values — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tgeovaluess(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tgeovaluess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200
2|2.0|2.0|1609545600

CREATE SINK tgeovaluess_out(tgeovaluess.id UINT64, r VARSIZED) TYPE File;
SELECT id, TGEO_VALUES(lon, lat, ts) AS r FROM tgeovaluess INTO tgeovaluess_out;

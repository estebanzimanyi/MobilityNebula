# name: MEOS_GEOM_PERIMETER
# description: geom_perimeter — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomperimeters(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geomperimeters TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(1 1, 2 2)'
2|'SRID=4326;Linestring(3 3, 4 4, 5 5)'

CREATE SINK geomperimeters_out(geomperimeters.id UINT64, r FLOAT64) TYPE File;
SELECT id, GEOM_PERIMETER(a) AS r FROM geomperimeters INTO geomperimeters_out;
----
1,0.0
2,0.0

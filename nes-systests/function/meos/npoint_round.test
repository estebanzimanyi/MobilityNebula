# name: MEOS_NPOINT_ROUND
# description: npoint_round — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointrounds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR npointrounds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NPoint(1, 0.5)'
2|'NPoint(1, 0.7)'

CREATE SINK npointrounds_out(npointrounds.id UINT64, r VARSIZED) TYPE File;
SELECT id, NPOINT_ROUND(a) AS r FROM npointrounds INTO npointrounds_out;
----
1,NPoint(1,0.5)
2,NPoint(1,0.7)

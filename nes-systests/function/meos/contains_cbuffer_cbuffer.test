# name: MEOS_CONTAINS_CBUFFER_CBUFFER
# description: contains_cbuffer_cbuffer — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containscbuffercbus(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR containscbuffercbus TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'|'Cbuffer(Point(2 2),0.5)'
2|'Cbuffer(Point(2 2),0.5)'|'Cbuffer(Point(1 1),1.0)'

CREATE SINK containscbuffercbus_out(containscbuffercbus.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINS_CBUFFER_CBUFFER(a, b) AS r FROM containscbuffercbus INTO containscbuffercbus_out;
----
1,0
2,0

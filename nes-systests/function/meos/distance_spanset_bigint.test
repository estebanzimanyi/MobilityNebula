# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancespansetbigs(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR distancespansetbigs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|3
2|'{[3, 7)}'|7

CREATE SINK distancespansetbigs_out(distancespansetbigs.id UINT64, r INT64) TYPE File;
SELECT id, DISTANCE_SPANSET_BIGINT(a, b) AS r FROM distancespansetbigs INTO distancespansetbigs_out;

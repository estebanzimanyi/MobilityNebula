# name: MEOS_NAD_TPOSE_TPOSE_hex
# description: Per-event nad_tpose_tpose over two hex-WKB tpose temporals (direct-call NadTposeTpose, FLOAT64). Complements the tpose_to_tpoint composition test (which exercises nad_tgeo_tgeo).
# groups: [Function, MEOS, Pose, CrossStream, Codegen]
CREATE LOGICAL SOURCE hxsrc(id UINT64, ta VARSIZED, tb VARSIZED);
CREATE PHYSICAL SOURCE FOR hxsrc TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|0138000E02000000030100000000000000000000000000000000000000000000000000A0AD30CA5A02000100000000000000000000000000000040000000000000000000444107CB5A0200|0138000E02000000030100000000000008400000000000000000000000000000000000A0AD30CA5A02000100000000000008400000000000000040000000000000000000444107CB5A0200

CREATE SINK hxsrc_out(hxsrc.id UINT64, r FLOAT64) TYPE File;
SELECT id, NAD_TPOSE_TPOSE(ta, tb) AS r FROM hxsrc INTO hxsrc_out;
----
1,3.0

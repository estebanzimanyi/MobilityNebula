# name: MEOS_NSEGMENT_CMP
# description: nsegment_cmp — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE nsegmentcmps(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR nsegmentcmps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NSegment(1, 0.2, 0.8)'|'NSegment(1, 0.5, 0.7)'
2|'NSegment(1, 0.5, 0.7)'|'NSegment(1, 0.2, 0.8)'

CREATE SINK nsegmentcmps_out(nsegmentcmps.id UINT64, r INT32) TYPE File;
SELECT id, NSEGMENT_CMP(a, b) AS r FROM nsegmentcmps INTO nsegmentcmps_out;
----
1,-1
2,1

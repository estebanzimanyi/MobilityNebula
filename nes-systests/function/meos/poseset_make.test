# name: MEOS_POSESET_MAKE_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE psm(gid UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR psm TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'POSE (0101000020E40E00008836BF83634F56405855CA527BBF4840, -0.001015174923595)'|1609459200
1|'POSE (0101000020E40E0000F0A6A47B91EE3440E473DD0625293FC0, -0.001774393180286)'|1609459201

CREATE SINK psm_out(psm.gid UINT64, psm.r VARSIZED) TYPE File;
SELECT gid, POSESET_MAKE(value, ts) AS r FROM psm GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO psm_out;

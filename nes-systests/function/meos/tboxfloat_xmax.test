# name: MEOS_TBOXFLOAT_XMAX
# description: tboxfloat_xmax — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxfloatxmaxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxfloatxmaxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'

CREATE SINK tboxfloatxmaxs_out(tboxfloatxmaxs.id UINT64, r FLOAT64) TYPE File;
SELECT id, TBOXFLOAT_XMAX(a) AS r FROM tboxfloatxmaxs INTO tboxfloatxmaxs_out;
----
1,5.0
2,7.0

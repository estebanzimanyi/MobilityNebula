# name: MEOS_CONTAINED_CBUFFER_SET
# description: contained_cbuffer_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containedcbufferses(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR containedcbufferses TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Cbuffer(Point(1 1),0.5)", "Cbuffer(Point(2 2),0.5)"}'|'Cbuffer(Point(1 1),0.5)'
2|'{"Cbuffer(Point(3 3),1.0)", "Cbuffer(Point(4 4),0.5)"}'|'Cbuffer(Point(3 3),1.0)'

CREATE SINK containedcbufferses_out(containedcbufferses.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_CBUFFER_SET(a, arg) AS r FROM containedcbufferses INTO containedcbufferses_out;
----
1,1
2,1

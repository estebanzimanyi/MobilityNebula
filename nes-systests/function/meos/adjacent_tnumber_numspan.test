# name: MEOS_ADJACENT_TNUMBER_NUMSPAN
# description: adjacent_tnumber_numspan (tnumber, number span) value topological adjacency.
# groups: [Function, MEOS, TNumber, Topological, Codegen]
CREATE LOGICAL SOURCE adjacenttnu(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR adjacenttnu TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.0|1609459200
2|9.0|1609459200

CREATE SINK adjacenttnu_out(adjacenttnu.id UINT64, r BOOLEAN) TYPE File;
SELECT id, ADJACENT_TNUMBER_NUMSPAN(value, ts, '[3.0, 7.0)') AS r FROM adjacenttnu INTO adjacenttnu_out;
----
1,0
2,0

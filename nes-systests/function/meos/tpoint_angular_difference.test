# name: MEOS_TPOINT_ANGULAR_DIFFERENCE_EXP
# groups: [Function, MEOS, Aggregation]
CREATE LOGICAL SOURCE tpointv(gid UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tpointv TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.0|50.0|1609459200
1|4.1|50.1|1609459201
2|5.0|51.0|1609459200
2|5.1|51.1|1609459201

CREATE SINK tpointv_out(tpointv.gid UINT64, tpointv.r VARSIZED) TYPE File;
SELECT gid, TPOINT_ANGULAR_DIFFERENCE(lon, lat, ts) AS r FROM tpointv GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tpointv_out;

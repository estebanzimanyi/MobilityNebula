# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE numspantimestamptzs(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR numspantimestamptzs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'|'2020-01-03 00:00:00+00'
2|'[3.5, 9.5)'|'2020-06-15 12:00:00+00'

CREATE SINK numspantimestamptzs_out(numspantimestamptzs.id UINT64, r VARSIZED) TYPE File;
SELECT id, NUMSPAN_TIMESTAMPTZ_TO_TBOX(a, arg) AS r FROM numspantimestamptzs INTO numspantimestamptzs_out;
----
1,TBOXFLOAT XT([1.5, 5.5),[2020-01-03 00:00:00+00, 2020-01-03 00:00:00+00])
2,TBOXFLOAT XT([3.5, 9.5),[2020-06-15 12:00:00+00, 2020-06-15 12:00:00+00])

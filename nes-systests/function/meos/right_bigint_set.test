# name: MEOS_RIGHT_BIGINT_SET
# description: right_bigint_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightbigintsets(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR rightbigintsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK rightbigintsets_out(rightbigintsets.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_BIGINT_SET(a, b) AS r FROM rightbigintsets INTO rightbigintsets_out;

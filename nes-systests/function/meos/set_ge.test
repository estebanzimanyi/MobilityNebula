# name: MEOS_SET_GE
# description: set_ge — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE setges(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR setges TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|'{1, 3, 5}'
2|'{3, 5, 9}'|'{3, 5, 9}'

CREATE SINK setges_out(setges.id UINT64, r INT32) TYPE File;
SELECT id, SET_GE(a, b) AS r FROM setges INTO setges_out;
----
1,1
2,1

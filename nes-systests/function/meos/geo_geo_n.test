# name: MEOS_GEO_GEO_N
# description: geo_geo_n — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geogeons(id UINT64, a VARSIZED, arg INT32);
CREATE PHYSICAL SOURCE FOR geogeons TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(0 0, 2 2)'|1
2|'SRID=4326;Linestring(0 0, 3 3)'|1

CREATE SINK geogeons_out(geogeons.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEO_GEO_N(a, arg) AS r FROM geogeons INTO geogeons_out;
----
1,0102000020E6100000020000000000000000000000000000000000000000000000000000400000000000000040
2,0102000020E6100000020000000000000000000000000000000000000000000000000008400000000000000840

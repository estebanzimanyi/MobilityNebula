CREATE LOGICAL SOURCE temporaltimestampss(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR temporaltimestampss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);

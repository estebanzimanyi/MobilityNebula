# name: MEOS_DISTANCE_SPANSET_DATE
# description: distance_spanset_date — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancespansetdats(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR distancespansetdats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01, 2020-01-10)}'|'2020-01-03'
2|'{[2020-01-05, 2020-01-20)}'|'2020-06-15'

CREATE SINK distancespansetdats_out(distancespansetdats.id UINT64, r INT32) TYPE File;
SELECT id, DISTANCE_SPANSET_DATE(a, b) AS r FROM distancespansetdats INTO distancespansetdats_out;
----
1,0
2,148

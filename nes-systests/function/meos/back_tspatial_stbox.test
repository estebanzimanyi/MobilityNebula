# name: MEOS_BACK_TSPATIAL_STBOX
# description: back_tspatial_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE backtspatialstboxs(id UINT64, lon FLOAT64, lat FLOAT64, z FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR backtspatialstboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|2.0|1609459200|'SRID=4326;STBOX Z((0 0 0),(5 5 5))'
2|2.0|2.0|3.0|1609545600|'SRID=4326;STBOX Z((1 1 1),(6 6 6))'

CREATE SINK backtspatialstboxs_out(backtspatialstboxs.id UINT64, r INT32) TYPE File;
SELECT id, BACK_TSPATIAL_STBOX(lon, lat, z, ts, arg) AS r FROM backtspatialstboxs INTO backtspatialstboxs_out;

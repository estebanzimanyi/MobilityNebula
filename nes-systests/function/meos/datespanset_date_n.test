# name: MEOS_DATESPANSET_DATE_N
# description: datespanset_date_n — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE datespansetdatens(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR datespansetdatens TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01, 2020-01-10)}'
2|'{[2020-01-05, 2020-01-20)}'

CREATE SINK datespansetdatens_out(datespansetdatens.id UINT64, r INT32) TYPE File;
SELECT id, DATESPANSET_DATE_N(a) AS r FROM datespansetdatens INTO datespansetdatens_out;

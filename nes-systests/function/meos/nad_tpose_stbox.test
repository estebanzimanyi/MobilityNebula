# name: MEOS_NAD_TPOSE_STBOX
# groups: [Function, MEOS, Codegen]
CREATE LOGICAL SOURCE ndps(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR ndps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.0|50.0|0.5|1609459200
2|5.0|51.0|0.3|1609459200

CREATE SINK ndps_out(ndps.id UINT64, r FLOAT64) TYPE File;
SELECT id, NAD_TPOSE_STBOX(x, y, theta, ts, 'STBOX X((1,1),(3,3))') AS r FROM ndps INTO ndps_out;

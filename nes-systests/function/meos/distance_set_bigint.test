CREATE LOGICAL SOURCE distancesetbigints(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR distancesetbigints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

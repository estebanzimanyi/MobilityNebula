# name: MEOS_ADJACENT_SPAN_INT
# description: adjacent_span_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE adjacentspanints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR adjacentspanints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK adjacentspanints_out(adjacentspanints.id UINT64, r INT32) TYPE File;
SELECT id, ADJACENT_SPAN_INT(a, b) AS r FROM adjacentspanints INTO adjacentspanints_out;

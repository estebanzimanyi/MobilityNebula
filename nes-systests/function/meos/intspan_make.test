# name: MEOS_INTSPAN_MAKE
# description: intspan_make — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intspanmakes(id UINT64, value INT32, arg0 INT32, arg1 BOOLEAN, arg2 BOOLEAN);
CREATE PHYSICAL SOURCE FOR intspanmakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1|5|true|false
2|2|8|true|false

CREATE SINK intspanmakes_out(intspanmakes.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTSPAN_MAKE(value, arg0, arg1, arg2) AS r FROM intspanmakes INTO intspanmakes_out;
----
1,[1,5)
2,[2,8)

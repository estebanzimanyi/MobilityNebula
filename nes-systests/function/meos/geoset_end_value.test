# name: MEOS_GEOSET_END_VALUE
# description: geoset_end_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geosetendvalues(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geosetendvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Point(1 1)", "Point(2 2)"}'
2|'{"Point(3 3)", "Point(4 4)"}'

CREATE SINK geosetendvalues_out(geosetendvalues.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEOSET_END_VALUE(a) AS r FROM geosetendvalues INTO geosetendvalues_out;
----
1,010100000000000000000000400000000000000040
2,010100000000000000000010400000000000001040

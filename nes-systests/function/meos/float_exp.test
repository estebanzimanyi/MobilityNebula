# name: MEOS_FLOAT_EXP
# description: float_exp — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatexps(id UINT64, value FLOAT64);
CREATE PHYSICAL SOURCE FOR floatexps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|2.0
2|0.5

CREATE SINK floatexps_out(floatexps.id UINT64, r FLOAT64) TYPE File;
SELECT id, FLOAT_EXP(value) AS r FROM floatexps INTO floatexps_out;
----
1,7.389056
2,1.648721

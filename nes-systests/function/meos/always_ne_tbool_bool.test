# name: MEOS_ALWAYS_NE_TBOOL_BOOL
# groups: [Function, MEOS, TemporalBoolean, Comparison, Codegen]
CREATE LOGICAL SOURCE tbfne(id UINT64, value BOOLEAN, ts UINT64, flag BOOLEAN);
CREATE PHYSICAL SOURCE FOR tbfne TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|true|1609459200|true
2|false|1609545600|true

CREATE SINK tbfne_out(tbfne.id UINT64, r INT32) TYPE File;
SELECT id, ALWAYS_NE_TBOOL_BOOL(value, ts, flag) AS r FROM tbfne INTO tbfne_out;
----
1,0
2,1

# name: MEOS_INTSPAN_UPPER
# description: intspan_upper — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intspanuppers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR intspanuppers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'
2|'[3, 9)'

CREATE SINK intspanuppers_out(intspanuppers.id UINT64, r INT32) TYPE File;
SELECT id, INTSPAN_UPPER(a) AS r FROM intspanuppers INTO intspanuppers_out;
----
1,5
2,9

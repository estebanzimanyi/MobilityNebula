# name: MEOS_TPOSE_VALUE_N
# description: tpose_value_n — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tposevaluens(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tposevaluens TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|0.5|1609459200
2|2.0|2.0|1.0|1609545600

CREATE SINK tposevaluens_out(tposevaluens.id UINT64, r VARSIZED) TYPE File;
SELECT id, TPOSE_VALUE_N(x, y, theta, ts) AS r FROM tposevaluens INTO tposevaluens_out;

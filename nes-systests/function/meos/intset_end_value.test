# name: MEOS_INTSET_END_VALUE
# description: intset_end_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intsetendvalues(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR intsetendvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{3, 5, 9}'

CREATE SINK intsetendvalues_out(intsetendvalues.id UINT64, r INT32) TYPE File;
SELECT id, INTSET_END_VALUE(a) AS r FROM intsetendvalues INTO intsetendvalues_out;
----
1,5
2,9

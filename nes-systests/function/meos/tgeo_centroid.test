# name: MEOS_TGEO_CENTROID_EXP_Aggregation
# description: Windowed TGEO_CENTROID.
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE tgeo_cex(gid UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tgeo_cex TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.0|50.0|1609459200
1|4.1|50.1|1609459201
1|4.2|50.2|1609459202
2|5.0|51.0|1609459200
2|5.1|51.1|1609459201

CREATE SINK tgeo_cex_out(tgeo_cex.gid UINT64, tgeo_cex.r VARSIZED) TYPE File;
SELECT gid, TGEO_CENTROID(lon, lat, ts) AS r FROM tgeo_cex GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tgeo_cex_out;

CREATE LOGICAL SOURCE tfloatminusvalues(id UINT64, value FLOAT64, ts UINT64, arg FLOAT64);
CREATE PHYSICAL SOURCE FOR tfloatminusvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);

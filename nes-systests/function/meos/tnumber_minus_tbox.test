CREATE LOGICAL SOURCE tnumberminustboxs(id UINT64, value INT32, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tnumberminustboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5|1609459200|'TBOXINT XT([100, 200],[2025-01-01, 2026-01-01])'
2|8|1609545600|'TBOXINT XT([100, 200],[2025-01-01, 2026-01-01])'

CREATE SINK tnumberminustboxs_out(tnumberminustboxs.id UINT64, r VARSIZED) TYPE File;

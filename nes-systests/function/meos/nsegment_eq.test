# name: MEOS_NSEGMENT_EQ
# description: nsegment_eq — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE nsegmenteqs(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR nsegmenteqs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NSegment(1, 0.2, 0.8)'|'NSegment(1, 0.5, 0.7)'
2|'NSegment(1, 0.5, 0.7)'|'NSegment(1, 0.2, 0.8)'

CREATE SINK nsegmenteqs_out(nsegmenteqs.id UINT64, r INT32) TYPE File;
SELECT id, NSEGMENT_EQ(a, b) AS r FROM nsegmenteqs INTO nsegmenteqs_out;
----
1,0
2,0

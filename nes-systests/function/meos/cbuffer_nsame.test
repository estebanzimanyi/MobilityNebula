# name: MEOS_CBUFFER_NSAME
# description: cbuffer_nsame — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbuffernsames(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR cbuffernsames TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'|'Cbuffer(Point(2 2),0.5)'
2|'Cbuffer(Point(2 2),0.5)'|'Cbuffer(Point(1 1),1.0)'

CREATE SINK cbuffernsames_out(cbuffernsames.id UINT64, r INT32) TYPE File;
SELECT id, CBUFFER_NSAME(a, b) AS r FROM cbuffernsames INTO cbuffernsames_out;
----
1,1
2,1

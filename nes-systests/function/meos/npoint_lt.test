# name: MEOS_NPOINT_LT
# description: npoint_lt — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointlts(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR npointlts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NPoint(1, 0.5)'|'NPoint(1, 0.7)'
2|'NPoint(1, 0.7)'|'NPoint(1, 0.5)'

CREATE SINK npointlts_out(npointlts.id UINT64, r INT32) TYPE File;
SELECT id, NPOINT_LT(a, b) AS r FROM npointlts INTO npointlts_out;
----
1,1
2,0

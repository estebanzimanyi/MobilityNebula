# name: MEOS_NPOINT_GE
# description: npoint_ge — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointges(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR npointges TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NPoint(1, 0.5)'|'NPoint(1, 0.7)'
2|'NPoint(1, 0.7)'|'NPoint(1, 0.5)'

CREATE SINK npointges_out(npointges.id UINT64, r INT32) TYPE File;
SELECT id, NPOINT_GE(a, b) AS r FROM npointges INTO npointges_out;
----
1,0
2,1

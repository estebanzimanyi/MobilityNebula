# name: MEOS_TEMPORAL_TIME
# description: temporal_time — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE temporaltimes(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR temporaltimes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200
2|8.5|1609545600

CREATE SINK temporaltimes_out(temporaltimes.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEMPORAL_TIME(value, ts) AS r FROM temporaltimes INTO temporaltimes_out;

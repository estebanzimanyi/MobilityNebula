# name: MEOS_NAD_TCBUFFER_STBOX
# groups: [Function, MEOS, Codegen]
CREATE LOGICAL SOURCE ndcs(id UINT64, lon FLOAT64, lat FLOAT64, radius FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR ndcs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.0|50.0|10.0|1609459200
2|5.0|51.0|5.0|1609459200

CREATE SINK ndcs_out(ndcs.id UINT64, r FLOAT64) TYPE File;
SELECT id, NAD_TCBUFFER_STBOX(lon, lat, radius, ts, 'STBOX X((1,1),(3,3))') AS r FROM ndcs INTO ndcs_out;

# name: MEOS_UNION_SET_POSE
# description: union_set_pose — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionsetposes(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR unionsetposes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Pose(Point(1 1),0.5)", "Pose(Point(2 2),1.0)"}'|'Pose(Point(1 1),0.5)'
2|'{"Pose(Point(3 3),0.3)", "Pose(Point(4 4),0.5)"}'|'Pose(Point(3 3),0.3)'

CREATE SINK unionsetposes_out(unionsetposes.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_SET_POSE(a, arg) AS r FROM unionsetposes INTO unionsetposes_out;
----
1,{"POSE (010100000000000000000000400000000000000040, 1)", "POSE (0101000000000000000000F03F000000000000F03F, 0.5)"}
2,{"POSE (010100000000000000000008400000000000000840, 0.3)", "POSE (010100000000000000000010400000000000001040, 0.5)"}

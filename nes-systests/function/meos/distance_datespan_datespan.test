# name: MEOS_DISTANCE_DATESPAN_DATESPAN
# description: distance_datespan_datespan — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancedatespandas(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR distancedatespandas TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01, 2020-01-10)'|'[2020-01-01, 2020-01-10)'
2|'[2020-01-05, 2020-01-20)'|'[2020-01-05, 2020-01-20)'

CREATE SINK distancedatespandas_out(distancedatespandas.id UINT64, r INT32) TYPE File;
SELECT id, DISTANCE_DATESPAN_DATESPAN(a, b) AS r FROM distancedatespandas INTO distancedatespandas_out;
----
1,0
2,0

# name: MEOS_MINUS_FLOAT_SPAN
# description: minus_float_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minusfloatspans(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR minusfloatspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|7
2|'[10, 15)'|2

CREATE SINK minusfloatspans_out(minusfloatspans.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_FLOAT_SPAN(a, b) AS r FROM minusfloatspans INTO minusfloatspans_out;
----
1,{[7,7]}
2,{[2,2]}

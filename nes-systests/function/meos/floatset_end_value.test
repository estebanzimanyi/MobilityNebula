# name: MEOS_FLOATSET_END_VALUE
# description: floatset_end_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatsetendvalues(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatsetendvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'
2|'{3.5, 5.5, 9.5}'

CREATE SINK floatsetendvalues_out(floatsetendvalues.id UINT64, r FLOAT64) TYPE File;
SELECT id, FLOATSET_END_VALUE(a) AS r FROM floatsetendvalues INTO floatsetendvalues_out;
----
1,5.5
2,9.5

# name: MEOS_STBOX_SPACE_TILES
# description: stbox_space_tiles — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxspacetiless(id UINT64, a VARSIZED, x0 FLOAT64, x1 FLOAT64, x2 FLOAT64, x3 VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxspacetiless TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((0,0),(10,10))'|5.0|5.0|0.0|'Point(0 0)'
2|'STBOX X((0,0),(8,8))'|4.0|4.0|0.0|'Point(0 0)'

CREATE SINK stboxspacetiless_out(stboxspacetiless.id UINT64, r VARSIZED) TYPE File;
SELECT id, STBOX_SPACE_TILES(a, x0, x1, x2, x3) AS r FROM stboxspacetiless INTO stboxspacetiless_out;
----
1,{STBOX X((0,0),(5,5)), STBOX X((5,0),(10,5)), STBOX X((10,0),(15,5)), STBOX X((0,5),(5,10)), STBOX X((5,5),(10,10)), STBOX X((10,5),(15,10)), STBOX X((0,10),(5,15)), STBOX X((5,10),(10,15)), STBOX X((10,10),(15,15))}
2,{STBOX X((0,0),(4,4)), STBOX X((4,0),(8,4)), STBOX X((8,0),(12,4)), STBOX X((0,4),(4,8)), STBOX X((4,4),(8,8)), STBOX X((8,4),(12,8)), STBOX X((0,8),(4,12)), STBOX X((4,8),(8,12)), STBOX X((8,8),(12,12))}

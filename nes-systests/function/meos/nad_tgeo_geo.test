# name: MEOS_NAD_TGEO_GEO
# groups: [Function, MEOS, Codegen]
CREATE LOGICAL SOURCE ndgg(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR ndgg TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.0|50.0|1609459200
2|5.0|51.0|1609459200

CREATE SINK ndgg_out(ndgg.id UINT64, r FLOAT64) TYPE File;
SELECT id, NAD_TGEO_GEO(lon, lat, ts, 'SRID=4326;POINT(0 0)') AS r FROM ndgg INTO ndgg_out;
----
1,50.159745
2,51.244512

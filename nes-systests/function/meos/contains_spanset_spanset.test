# name: MEOS_CONTAINS_SPANSET_SPANSET
# description: contains_spanset_spanset over two text literals; type-generic MEOS topology predicate, INT32.
# groups: [Function, MEOS, SpanSet, Codegen]
CREATE LOGICAL SOURCE qsrc(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR qsrc TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|'{[2, 4)}'
2|'{[1, 5), [10, 15)}'|'{[20, 25)}'

CREATE SINK qsrc_out(qsrc.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINS_SPANSET_SPANSET(a, b) AS r FROM qsrc INTO qsrc_out;
----
1,1
2,0

# name: MEOS_TTEXT_UPPER
# description: ttext_upper — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE ttextuppers(id UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR ttextuppers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200
2|'DEF'|1609545600

CREATE SINK ttextuppers_out(ttextuppers.id UINT64, r VARSIZED) TYPE File;
SELECT id, TTEXT_UPPER(value, ts) AS r FROM ttextuppers INTO ttextuppers_out;
----
1,"ABC"@2021-01-01,00:00:00+00
2,"DEF"@2021-01-02,00:00:00+00

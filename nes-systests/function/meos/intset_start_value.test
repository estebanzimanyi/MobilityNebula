# name: MEOS_INTSET_START_VALUE
# description: intset_start_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intsetstartvalues(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR intsetstartvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{3, 5, 9}'

CREATE SINK intsetstartvalues_out(intsetstartvalues.id UINT64, r INT32) TYPE File;
SELECT id, INTSET_START_VALUE(a) AS r FROM intsetstartvalues INTO intsetstartvalues_out;
----
1,1
2,3

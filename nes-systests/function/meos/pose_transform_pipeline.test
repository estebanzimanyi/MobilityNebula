# name: MEOS_POSE_TRANSFORM_PIPELINE
# description: pose_transform_pipeline — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posetransformpipels(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR posetransformpipels TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Pose(Point(4.35 50.85),0.5)'
2|'SRID=4326;Pose(Point(4.36 50.86),0.3)'

CREATE SINK posetransformpipels_out(posetransformpipels.id UINT64, r VARSIZED) TYPE File;
SELECT id, POSE_TRANSFORM_PIPELINE(a) AS r FROM posetransformpipels INTO posetransformpipels_out;
----
1,POSE (0101000020110F00007520CA233F8E1D4139B68ECE3C285941 0.5)
2,POSE (0101000020110F00006A1260EBA39F1D412211D0A6F5295941 0.3)

# name: MEOS_TEXTSET_LOWER
# description: textset_lower — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textsetlowers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR textsetlowers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'
2|'{"BBB", "DDD"}'

CREATE SINK textsetlowers_out(textsetlowers.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXTSET_LOWER(a) AS r FROM textsetlowers INTO textsetlowers_out;
----
1,{"aaa","bbb","ccc"}
2,{"bbb","ddd"}

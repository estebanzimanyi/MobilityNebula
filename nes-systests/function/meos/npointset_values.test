# name: MEOS_NPOINTSET_VALUES
# description: npointset_values — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointsetvaluess(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR npointsetvaluess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Npoint(1,0.5)", "Npoint(2,0.5)"}'
2|'{"Npoint(1,0.7)", "Npoint(3,0.5)"}'

CREATE SINK npointsetvaluess_out(npointsetvaluess.id UINT64, r VARSIZED) TYPE File;
SELECT id, NPOINTSET_VALUES(a) AS r FROM npointsetvaluess INTO npointsetvaluess_out;
----
1,{NPoint(1,0.5), NPoint(2,0.5)}
2,{NPoint(1,0.7), NPoint(3,0.5)}

CREATE LOGICAL SOURCE containsspanbigints(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR containsspanbigints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3

# name: MEOS_GEOSET_VALUE_N
# description: geoset_value_n — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geosetvaluens(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geosetvaluens TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Point(1 1)", "Point(2 2)"}'
2|'{"Point(3 3)", "Point(4 4)"}'

CREATE SINK geosetvaluens_out(geosetvaluens.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEOSET_VALUE_N(a) AS r FROM geosetvaluens INTO geosetvaluens_out;
----
1,0101000000000000000000F03F000000000000F03F
2,010100000000000000000008400000000000000840

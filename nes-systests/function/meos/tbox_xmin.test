# name: MEOS_TBOX_XMIN
# description: tbox_xmin — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxxmins(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxxmins TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'

CREATE SINK tboxxmins_out(tboxxmins.id UINT64, r FLOAT64) TYPE File;
SELECT id, TBOX_XMIN(a) AS r FROM tboxxmins INTO tboxxmins_out;
----
1,1.0
2,3.0

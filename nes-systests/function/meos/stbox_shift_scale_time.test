# name: MEOS_STBOX_SHIFT_SCALE_TIME
# description: stbox_shift_scale_time — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxshiftscaletims(id UINT64, a VARSIZED, arg0 VARSIZED, arg1 VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxshiftscaletims TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX XT(((1,1),(5,5)),[2020-01-01, 2020-01-05])'|'1 day'|'1 day'
2|'STBOX XT(((3,3),(7,7)),[2020-01-03, 2020-01-07])'|'2 days'|'2 days'

CREATE SINK stboxshiftscaletims_out(stboxshiftscaletims.id UINT64, r VARSIZED) TYPE File;
SELECT id, STBOX_SHIFT_SCALE_TIME(a, arg0, arg1) AS r FROM stboxshiftscaletims INTO stboxshiftscaletims_out;

# name: MEOS_DATESPANSET_DATES
# description: datespanset_dates — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE datespansetdatess(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR datespansetdatess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01, 2020-01-10)}'
2|'{[2020-01-05, 2020-01-20)}'

CREATE SINK datespansetdatess_out(datespansetdatess.id UINT64, r VARSIZED) TYPE File;
SELECT id, DATESPANSET_DATES(a) AS r FROM datespansetdatess INTO datespansetdatess_out;
----
1,{2020-01-01, 2020-01-10}
2,{2020-01-05, 2020-01-20}

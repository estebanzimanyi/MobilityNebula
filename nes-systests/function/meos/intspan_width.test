# name: MEOS_INTSPAN_WIDTH
# description: intspan_width — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intspanwidths(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR intspanwidths TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'
2|'[3, 9)'

CREATE SINK intspanwidths_out(intspanwidths.id UINT64, r INT32) TYPE File;
SELECT id, INTSPAN_WIDTH(a) AS r FROM intspanwidths INTO intspanwidths_out;
----
1,4
2,6

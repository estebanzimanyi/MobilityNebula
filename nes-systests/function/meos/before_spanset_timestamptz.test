# name: MEOS_BEFORE_SPANSET_TIMESTAMPTZ
# description: before_spanset_timestamptz — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE beforespansettimess(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR beforespansettimess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)}'|'2020-01-03 00:00:00+00'
2|'{[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)}'|'2020-06-15 12:00:00+00'

CREATE SINK beforespansettimess_out(beforespansettimess.id UINT64, r INT32) TYPE File;
SELECT id, BEFORE_SPANSET_TIMESTAMPTZ(a, b) AS r FROM beforespansettimess INTO beforespansettimess_out;
----
1,0
2,1

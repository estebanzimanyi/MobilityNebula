CREATE PHYSICAL SOURCE FOR tstzspansettodatess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)}'
2|'{[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)}'

CREATE SINK tstzspansettodatess_out(tstzspansettodatess.id UINT64, r VARSIZED) TYPE File;

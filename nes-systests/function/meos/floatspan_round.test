# name: MEOS_FLOATSPAN_ROUND
# description: floatspan_round — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspanrounds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatspanrounds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'
2|'[3.5, 9.5)'

CREATE SINK floatspanrounds_out(floatspanrounds.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSPAN_ROUND(a) AS r FROM floatspanrounds INTO floatspanrounds_out;
----
1,[1.5,5.5)
2,[3.5,9.5)

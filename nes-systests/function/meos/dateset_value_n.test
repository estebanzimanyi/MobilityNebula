# name: MEOS_DATESET_VALUE_N
# description: dateset_value_n — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE datesetvaluens(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR datesetvaluens TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01, 2020-01-05, 2020-01-10}'
2|'{2020-01-03, 2020-01-08}'

CREATE SINK datesetvaluens_out(datesetvaluens.id UINT64, r INT32) TYPE File;
SELECT id, DATESET_VALUE_N(a) AS r FROM datesetvaluens INTO datesetvaluens_out;

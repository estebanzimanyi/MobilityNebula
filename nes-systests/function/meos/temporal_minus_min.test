# name: MEOS_TEMPORAL_MINUS_MIN_EXP
# groups: [Function, MEOS, Aggregation]
CREATE LOGICAL SOURCE temporaw(gid UINT64, reading FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR temporaw TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|10.5|1609459200
1|22.7|1609459201
2|5.0|1609459200
2|7.5|1609459201

CREATE SINK temporaw_out(temporaw.gid UINT64, temporaw.r VARSIZED) TYPE File;
SELECT gid, TEMPORAL_MINUS_MIN_EXP(reading, ts) AS r FROM temporaw GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO temporaw_out;

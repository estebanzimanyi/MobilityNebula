# name: MEOS_TINT_VALUE_BINS
# description: tint_value_bins — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tintvaluebinss(id UINT64, value INT32, ts UINT64, x0 INT32, x1 INT32);
CREATE PHYSICAL SOURCE FOR tintvaluebinss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5|1609459200|5|0
2|8|1609545600|5|0

CREATE SINK tintvaluebinss_out(tintvaluebinss.id UINT64, r VARSIZED) TYPE File;
SELECT id, TINT_VALUE_BINS(value, ts, x0, x1) AS r FROM tintvaluebinss INTO tintvaluebinss_out;

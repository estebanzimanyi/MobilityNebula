# name: MEOS_FLOATSPANSET_FLOOR
# description: floatspanset_floor — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspansetfloors(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatspansetfloors TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'
2|'{[3.5, 7.5)}'

CREATE SINK floatspansetfloors_out(floatspansetfloors.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSPANSET_FLOOR(a) AS r FROM floatspansetfloors INTO floatspansetfloors_out;

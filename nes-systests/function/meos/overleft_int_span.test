# name: MEOS_OVERLEFT_INT_SPAN
# description: overleft_int_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overleftintspans(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR overleftintspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK overleftintspans_out(overleftintspans.id UINT64, r INT32) TYPE File;
SELECT id, OVERLEFT_INT_SPAN(a, b) AS r FROM overleftintspans INTO overleftintspans_out;
----
1,1
2,1

# name: MEOS_UNION_SET_GEO
# description: union_set_geo — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionsetgeos(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR unionsetgeos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Point(1 1)", "Point(2 2)"}'|'Point(1 1)'
2|'{"Point(3 3)", "Point(4 4)"}'|'Point(3 3)'

CREATE SINK unionsetgeos_out(unionsetgeos.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_SET_GEO(a, arg) AS r FROM unionsetgeos INTO unionsetgeos_out;
----
1,{"POINT(1 1)", "POINT(2 2)"}
2,{"POINT(3 3)", "POINT(4 4)"}

# name: MEOS_UNION_SPAN_INT
# description: union_span_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionspanints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR unionspanints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK unionspanints_out(unionspanints.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_SPAN_INT(a, b) AS r FROM unionspanints INTO unionspanints_out;

# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancedatesetdats(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR distancedatesetdats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01, 2020-01-05, 2020-01-10}'|'{2020-01-01, 2020-01-05, 2020-01-10}'
2|'{2020-01-03, 2020-01-08}'|'{2020-01-03, 2020-01-08}'

CREATE SINK distancedatesetdats_out(distancedatesetdats.id UINT64, r INT32) TYPE File;
SELECT id, DISTANCE_DATESET_DATESET(a, b) AS r FROM distancedatesetdats INTO distancedatesetdats_out;

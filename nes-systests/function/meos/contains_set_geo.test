# name: MEOS_CONTAINS_SET_GEO
# description: contains_set_geo — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containssetgeos(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR containssetgeos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Point(1 1)", "Point(2 2)"}'|'Point(1 1)'
2|'{"Point(3 3)", "Point(4 4)"}'|'Point(3 3)'

CREATE SINK containssetgeos_out(containssetgeos.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINS_SET_GEO(a, arg) AS r FROM containssetgeos INTO containssetgeos_out;
----
1,1
2,1

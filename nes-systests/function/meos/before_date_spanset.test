# name: MEOS_BEFORE_DATE_SPANSET
# description: before_date_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE beforedatespansets(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR beforedatespansets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01, 2020-01-10)}'|'2020-01-03'
2|'{[2020-01-05, 2020-01-20)}'|'2020-06-15'

CREATE SINK beforedatespansets_out(beforedatespansets.id UINT64, r INT32) TYPE File;
SELECT id, BEFORE_DATE_SPANSET(a, b) AS r FROM beforedatespansets INTO beforedatespansets_out;
----
1,0
2,0

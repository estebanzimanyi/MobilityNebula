# name: MEOS_POSE_SAME
# description: pose_same — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posesames(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR posesames TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'|'Pose(Point(2 2), 1.0)'
2|'Pose(Point(2 2), 1.0)'|'Pose(Point(1 1), 0.5)'

CREATE SINK posesames_out(posesames.id UINT64, r INT32) TYPE File;
SELECT id, POSE_SAME(a, b) AS r FROM posesames INTO posesames_out;
----
1,0
2,0

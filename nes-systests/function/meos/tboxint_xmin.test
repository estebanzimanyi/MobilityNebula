# name: MEOS_TBOXINT_XMIN
# description: tboxint_xmin — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxintxmins(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxintxmins TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXINT XT([1, 5],[2020-01-01, 2020-01-05])'
2|'TBOXINT XT([3, 7],[2020-01-03, 2020-01-07])'

CREATE SINK tboxintxmins_out(tboxintxmins.id UINT64, r INT32) TYPE File;
SELECT id, TBOXINT_XMIN(a) AS r FROM tboxintxmins INTO tboxintxmins_out;
----
1,1
2,3

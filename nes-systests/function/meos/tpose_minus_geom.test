# name: MEOS_TPOSE_MINUS_GEOM
# description: tpose_minus_geom — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tposeminusgeoms(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tposeminusgeoms TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|0.5|1609459200|'Point(40 40)'
2|2.0|2.0|1.0|1609545600|'Point(50 50)'

CREATE SINK tposeminusgeoms_out(tposeminusgeoms.id UINT64, r VARSIZED) TYPE File;
SELECT id, TPOSE_MINUS_GEOM(x, y, theta, ts, arg) AS r FROM tposeminusgeoms INTO tposeminusgeoms_out;

# name: MEOS_TPOINT_MINUS_VALUE
# description: tpoint_minus_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tpointminusvalues(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tpointminusvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200|'SRID=4326;Point(40 40)'
2|2.0|2.0|1609545600|'SRID=4326;Point(50 50)'

CREATE SINK tpointminusvalues_out(tpointminusvalues.id UINT64, r VARSIZED) TYPE File;
SELECT id, TPOINT_MINUS_VALUE(lon, lat, ts, arg) AS r FROM tpointminusvalues INTO tpointminusvalues_out;

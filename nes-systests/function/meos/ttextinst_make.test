# name: MEOS_TTEXTINST_MAKE
# description: ttextinst_make — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE ttextinstmakes(id UINT64, a VARSIZED, arg0 INT64);
CREATE PHYSICAL SOURCE FOR ttextinstmakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|631152000000000
2|'DEF'|631238400000000

CREATE SINK ttextinstmakes_out(ttextinstmakes.id UINT64, r VARSIZED) TYPE File;
SELECT id, TTEXTINST_MAKE(a, arg0) AS r FROM ttextinstmakes INTO ttextinstmakes_out;

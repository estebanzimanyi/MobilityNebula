# name: MEOS_FLOATSPANSET_ROUND
# description: floatspanset_round — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspansetrounds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatspansetrounds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'
2|'{[3.5, 7.5)}'

CREATE SINK floatspansetrounds_out(floatspansetrounds.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSPANSET_ROUND(a) AS r FROM floatspansetrounds INTO floatspansetrounds_out;
----
1,{[1.5,5.5),[10.5,15.5)}
2,{[3.5,7.5)}

# name: MEOS_NAD_STBOX_GEO
# description: nad_stbox_geo — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE nadstboxgeos(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR nadstboxgeos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'|'Point(1 1)'
2|'STBOX X((3,3),(7,7))'|'Point(2 2)'

CREATE SINK nadstboxgeos_out(nadstboxgeos.id UINT64, r FLOAT64) TYPE File;
SELECT id, NAD_STBOX_GEO(a, arg) AS r FROM nadstboxgeos INTO nadstboxgeos_out;
----
1,0.0
2,1.414214

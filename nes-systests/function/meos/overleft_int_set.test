# name: MEOS_OVERLEFT_INT_SET
# description: overleft_int_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overleftintsets(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR overleftintsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK overleftintsets_out(overleftintsets.id UINT64, r INT32) TYPE File;
SELECT id, OVERLEFT_INT_SET(a, b) AS r FROM overleftintsets INTO overleftintsets_out;
----
1,1
2,1

# name: MEOS_OVERLEFT_BIGINT_SPAN
# description: overleft_bigint_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overleftbigintspans(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR overleftbigintspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK overleftbigintspans_out(overleftbigintspans.id UINT64, r INT32) TYPE File;
SELECT id, OVERLEFT_BIGINT_SPAN(a, b) AS r FROM overleftbigintspans INTO overleftbigintspans_out;

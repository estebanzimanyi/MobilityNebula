# name: MEOS_CONTAINED_TBOX_TBOX
# description: contained_tbox_tbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containedtboxtboxs(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR containedtboxtboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'

CREATE SINK containedtboxtboxs_out(containedtboxtboxs.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_TBOX_TBOX(a, b) AS r FROM containedtboxtboxs INTO containedtboxtboxs_out;
----
1,0
2,0

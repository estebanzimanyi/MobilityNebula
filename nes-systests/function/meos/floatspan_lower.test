# name: MEOS_FLOATSPAN_LOWER
# description: floatspan_lower — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspanlowers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatspanlowers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'
2|'[3.5, 9.5)'

CREATE SINK floatspanlowers_out(floatspanlowers.id UINT64, r FLOAT64) TYPE File;
SELECT id, FLOATSPAN_LOWER(a) AS r FROM floatspanlowers INTO floatspanlowers_out;
----
1,1.5
2,3.5

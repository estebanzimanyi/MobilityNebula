# name: MEOS_ALWAYS_GE_TEXT_TTEXT
# description: always_ge_text_ttext — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE alwaysgetextttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR alwaysgetextttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'ABC'
2|'DEF'|1609545600|'DEF'

CREATE SINK alwaysgetextttexts_out(alwaysgetextttexts.id UINT64, r INT32) TYPE File;
SELECT id, ALWAYS_GE_TEXT_TTEXT(value, ts, arg) AS r FROM alwaysgetextttexts INTO alwaysgetextttexts_out;

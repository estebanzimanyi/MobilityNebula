# name: MEOS_OVERBEFORE_TEMPORAL_TSTZSPAN
# description: overbefore_temporal_tstzspan (temporal, tstzspan) time topological relationship.
# groups: [Function, MEOS, Temporal, Topological, Codegen]
CREATE LOGICAL SOURCE overbeforet(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR overbeforet TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.0|1609459200
2|5.0|1609632000

CREATE SINK overbeforet_out(overbeforet.id UINT64, r BOOLEAN) TYPE File;
SELECT id, OVERBEFORE_TEMPORAL_TSTZSPAN(value, ts, '[2021-01-01 00:00:00+00, 2021-01-02 00:00:00+00)') AS r FROM overbeforet INTO overbeforet_out;
----
1,1
2,0

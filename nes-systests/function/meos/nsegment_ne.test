# name: MEOS_NSEGMENT_NE
# description: nsegment_ne — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE nsegmentnes(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR nsegmentnes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NSegment(1, 0.2, 0.8)'|'NSegment(1, 0.5, 0.7)'
2|'NSegment(1, 0.5, 0.7)'|'NSegment(1, 0.2, 0.8)'

CREATE SINK nsegmentnes_out(nsegmentnes.id UINT64, r INT32) TYPE File;
SELECT id, NSEGMENT_NE(a, b) AS r FROM nsegmentnes INTO nsegmentnes_out;
----
1,1
2,1

# name: MEOS_TBOX_TMAX_INC
# description: tbox_tmax_inc — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxtmaxincs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxtmaxincs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'

CREATE SINK tboxtmaxincs_out(tboxtmaxincs.id UINT64, r BOOLEAN) TYPE File;
SELECT id, TBOX_TMAX_INC(a) AS r FROM tboxtmaxincs INTO tboxtmaxincs_out;
----
1,1
2,1

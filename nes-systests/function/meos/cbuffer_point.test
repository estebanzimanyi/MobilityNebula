# name: MEOS_CBUFFER_POINT
# description: cbuffer_point — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbufferpoints(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR cbufferpoints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'
2|'Cbuffer(Point(2 2),0.5)'

CREATE SINK cbufferpoints_out(cbufferpoints.id UINT64, r VARSIZED) TYPE File;
SELECT id, CBUFFER_POINT(a) AS r FROM cbufferpoints INTO cbufferpoints_out;
----
1,0101000000000000000000F03F000000000000F03F
2,010100000000000000000000400000000000000040

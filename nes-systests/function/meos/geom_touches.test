# name: MEOS_GEOM_TOUCHES
# description: geom_touches — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomtouchess(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geomtouchess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(0 0, 2 2)'|'SRID=4326;Linestring(0 2, 2 0)'
2|'SRID=4326;Linestring(0 0, 3 3)'|'SRID=4326;Linestring(1 0, 1 3)'

CREATE SINK geomtouchess_out(geomtouchess.id UINT64, r INT32) TYPE File;
SELECT id, GEOM_TOUCHES(a, arg) AS r FROM geomtouchess INTO geomtouchess_out;
----
1,0
2,0

# name: MEOS_INTERSECTION_SET_SET
# description: intersection_set_set over two text literals; type-generic MEOS set-algebra returning the result span/set/spanset text (VARSIZED).
# groups: [Function, MEOS, Set, Codegen]
CREATE LOGICAL SOURCE uset(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR uset TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5, 7}'|'{3, 5, 9}'
2|'{2, 4, 6}'|'{4}'

CREATE SINK uset_out(uset.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERSECTION_SET_SET(a, b) AS r FROM uset INTO uset_out;
----
1,{3,5}
2,{4}

# name: MEOS_SET_GT
# description: set_gt — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE setgts(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR setgts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|'{1, 3, 5}'
2|'{3, 5, 9}'|'{3, 5, 9}'

CREATE SINK setgts_out(setgts.id UINT64, r INT32) TYPE File;
SELECT id, SET_GT(a, b) AS r FROM setgts INTO setgts_out;
----
1,0
2,0

# name: MEOS_SPAN_LT
# description: span_lt — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spanlts(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR spanlts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|'[1, 5)'
2|'[3, 9)'|'[3, 9)'

CREATE SINK spanlts_out(spanlts.id UINT64, r INT32) TYPE File;
SELECT id, SPAN_LT(a, b) AS r FROM spanlts INTO spanlts_out;
----
1,0
2,0

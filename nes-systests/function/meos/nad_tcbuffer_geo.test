# name: MEOS_NAD_TCBUFFER_GEO
# groups: [Function, MEOS, Codegen]
CREATE LOGICAL SOURCE ndcg(id UINT64, lon FLOAT64, lat FLOAT64, radius FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR ndcg TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.0|50.0|10.0|1609459200
2|5.0|51.0|5.0|1609459200

CREATE SINK ndcg_out(ndcg.id UINT64, r FLOAT64) TYPE File;
SELECT id, NAD_TCBUFFER_GEO(lon, lat, radius, ts, 'POINT(0 0)') AS r FROM ndcg INTO ndcg_out;

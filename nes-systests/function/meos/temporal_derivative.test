# name: MEOS_TEMPORAL_DERIVATIVE_EXP
# groups: [Function, MEOS, Aggregation]
CREATE LOGICAL SOURCE temporv(gid UINT64, reading FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR temporv TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|10.5|1609459200
1|22.7|1609459201
2|5.0|1609459200
2|7.5|1609459201

CREATE SINK temporv_out(temporv.gid UINT64, temporv.r VARSIZED) TYPE File;
SELECT gid, TEMPORAL_DERIVATIVE_EXP(reading, ts) AS r FROM temporv GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO temporv_out;

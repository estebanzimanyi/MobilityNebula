# name: MEOS_TGEO_TYPE
# description: tgeo_type — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tgeotypes(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tgeotypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200
2|8.5|1609545600

CREATE SINK tgeotypes_out(tgeotypes.id UINT64, r INT32) TYPE File;
SELECT id, TGEO_TYPE(value, ts) AS r FROM tgeotypes INTO tgeotypes_out;

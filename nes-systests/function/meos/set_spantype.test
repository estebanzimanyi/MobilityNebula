# name: MEOS_SET_SPANTYPE
# description: set_spantype — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE setspantypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR setspantypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{2, 4}'

CREATE SINK setspantypes_out(setspantypes.id UINT64, r INT32) TYPE File;
SELECT id, SET_SPANTYPE(a) AS r FROM setspantypes INTO setspantypes_out;
----
1,1
2,1

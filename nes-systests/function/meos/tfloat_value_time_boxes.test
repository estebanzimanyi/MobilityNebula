CREATE LOGICAL SOURCE tfloatvaluetimeboxs(id UINT64, value FLOAT64, ts UINT64, x0 FLOAT64, x1 VARSIZED, x2 FLOAT64, x3 VARSIZED);
CREATE PHYSICAL SOURCE FOR tfloatvaluetimeboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200|2.0|'1 day'|0.0|'2020-01-01 00:00:00+00'
2|8.5|1609545600|2.0|'2 days'|0.0|'2020-01-01 00:00:00+00'

CREATE SINK tfloatvaluetimeboxs_out(tfloatvaluetimeboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, TFLOAT_VALUE_TIME_BOXES(value, ts, x0, x1, x2, x3) AS r FROM tfloatvaluetimeboxs INTO tfloatvaluetimeboxs_out;

# name: MEOS_BEARING_POINT_POINT
# description: bearing_point_point — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE bearingpointpoints(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR bearingpointpoints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(0 0)'|'SRID=4326;Point(1 1)'
2|'SRID=4326;Point(0 0)'|'SRID=4326;Point(2 2)'

CREATE SINK bearingpointpoints_out(bearingpointpoints.id UINT64, r FLOAT64) TYPE File;
SELECT id, BEARING_POINT_POINT(a, arg) AS r FROM bearingpointpoints INTO bearingpointpoints_out;
----
1,0.785398
2,0.785398

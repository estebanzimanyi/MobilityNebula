# name: MEOS_TemporalEDisjointTGeometry
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, EDisjoint]
CREATE LOGICAL SOURCE edt(id UINT32, lonA FLOAT64, latA FLOAT64, tsA UINT64, lonB FLOAT64, latB FLOAT64, tsB UINT64);
CREATE PHYSICAL SOURCE FOR edt TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

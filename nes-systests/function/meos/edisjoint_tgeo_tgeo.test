CREATE SINK edt_out(edt.id UINT32, disjoint INT32) TYPE File;
SELECT id, EDISJOINT_TGEO_TGEO(lonA, latA, tsA, lonB, latB, tsB) AS disjoint FROM edt INTO edt_out;

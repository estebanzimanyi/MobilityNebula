# name: MEOS_NPOINT_EQ
# description: npoint_eq — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointeqs(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR npointeqs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NPoint(1, 0.5)'|'NPoint(1, 0.7)'
2|'NPoint(1, 0.7)'|'NPoint(1, 0.5)'

CREATE SINK npointeqs_out(npointeqs.id UINT64, r INT32) TYPE File;
SELECT id, NPOINT_EQ(a, b) AS r FROM npointeqs INTO npointeqs_out;
----
1,0
2,0

CREATE LOGICAL SOURCE tnumbertypes(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tnumbertypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);

# name: MEOS_RIGHT_SPANSET_SPAN
# description: right_spanset_span over two text literals; type-generic MEOS topology predicate, INT32.
# groups: [Function, MEOS, SpanSet, Codegen]
CREATE LOGICAL SOURCE psrc(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR psrc TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|'[2, 4)'
2|'{[1, 5), [10, 15)}'|'[20, 25)'

CREATE SINK psrc_out(psrc.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_SPANSET_SPAN(a, b) AS r FROM psrc INTO psrc_out;
----
1,0
2,0

# name: MEOS_STBOX_TMAX_INC
# description: stbox_tmax_inc — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxtmaxincs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxtmaxincs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX XT(((1,1),(5,5)),[2020-01-01, 2020-01-05])'
2|'STBOX XT(((3,3),(7,7)),[2020-01-03, 2020-01-07])'

CREATE SINK stboxtmaxincs_out(stboxtmaxincs.id UINT64, r BOOLEAN) TYPE File;
SELECT id, STBOX_TMAX_INC(a) AS r FROM stboxtmaxincs INTO stboxtmaxincs_out;
----
1,1
2,1

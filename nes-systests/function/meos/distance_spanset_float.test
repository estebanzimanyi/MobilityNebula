# name: MEOS_DISTANCE_SPANSET_FLOAT
# description: distance_spanset_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancespansetflos(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR distancespansetflos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'|3.5
2|'{[3.5, 7.5)}'|7.5

CREATE SINK distancespansetflos_out(distancespansetflos.id UINT64, r FLOAT64) TYPE File;
SELECT id, DISTANCE_SPANSET_FLOAT(a, b) AS r FROM distancespansetflos INTO distancespansetflos_out;
----
1,0.0
2,0.0

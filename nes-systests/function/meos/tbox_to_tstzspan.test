# name: MEOS_TBOX_TO_TSTZSPAN
# description: tbox_to_tstzspan — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxtotstzspans(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxtotstzspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'

CREATE SINK tboxtotstzspans_out(tboxtotstzspans.id UINT64, r VARSIZED) TYPE File;
SELECT id, TBOX_TO_TSTZSPAN(a) AS r FROM tboxtotstzspans INTO tboxtotstzspans_out;
----
1,[2020-01-01,00:00:00+00,2020-01-05,00:00:00+00]
2,[2020-01-03,00:00:00+00,2020-01-07,00:00:00+00]

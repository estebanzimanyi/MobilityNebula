# name: MEOS_OVERBEFORE_SET_TIMESTAMPTZ
# description: overbefore_set_timestamptz — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overbeforesettimess(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR overbeforesettimess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01 00:00:00+00, 2020-01-05 00:00:00+00}'|'2020-01-03 00:00:00+00'
2|'{2020-01-03 00:00:00+00, 2020-01-08 00:00:00+00}'|'2020-06-15 12:00:00+00'

CREATE SINK overbeforesettimess_out(overbeforesettimess.id UINT64, r INT32) TYPE File;
SELECT id, OVERBEFORE_SET_TIMESTAMPTZ(a, b) AS r FROM overbeforesettimess INTO overbeforesettimess_out;

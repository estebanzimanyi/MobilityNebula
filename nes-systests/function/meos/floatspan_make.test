# name: MEOS_FLOATSPAN_MAKE
# description: floatspan_make — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspanmakes(id UINT64, value FLOAT64, arg0 FLOAT64, arg1 BOOLEAN, arg2 BOOLEAN);
CREATE PHYSICAL SOURCE FOR floatspanmakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.5|5.5|true|false
2|2.5|8.5|true|false

CREATE SINK floatspanmakes_out(floatspanmakes.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSPAN_MAKE(value, arg0, arg1, arg2) AS r FROM floatspanmakes INTO floatspanmakes_out;
----
1,[1.5,5.5)
2,[2.5,8.5)

# name: MEOS_INTSPAN_TO_FLOATSPAN
# description: intspan_to_floatspan — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intspantofloatspans(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR intspantofloatspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'
2|'[3, 9)'

CREATE SINK intspantofloatspans_out(intspantofloatspans.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTSPAN_TO_FLOATSPAN(a) AS r FROM intspantofloatspans INTO intspantofloatspans_out;
----
1,[1,4]
2,[3,8]

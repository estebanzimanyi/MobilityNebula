# name: MEOS_BIGINTSPAN_MAKE
# description: bigintspan_make — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE bigintspanmakes(id UINT64, value INT64, arg0 INT64, arg1 BOOLEAN, arg2 BOOLEAN);
CREATE PHYSICAL SOURCE FOR bigintspanmakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1|5|true|false

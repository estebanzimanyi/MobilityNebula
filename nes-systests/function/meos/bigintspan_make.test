CREATE SINK bigintspanmakes_out(bigintspanmakes.id UINT64, r VARSIZED) TYPE File;
SELECT id, BIGINTSPAN_MAKE(value, arg0, arg1, arg2) AS r FROM bigintspanmakes INTO bigintspanmakes_out;

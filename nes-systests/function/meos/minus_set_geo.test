# name: MEOS_MINUS_SET_GEO
# description: minus_set_geo — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minussetgeos(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR minussetgeos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Point(1 1)", "Point(2 2)"}'|'Point(1 1)'
2|'{"Point(3 3)", "Point(4 4)"}'|'Point(3 3)'

CREATE SINK minussetgeos_out(minussetgeos.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_SET_GEO(a, arg) AS r FROM minussetgeos INTO minussetgeos_out;
----
1,{"POINT(2 2)"}
2,{"POINT(4 4)"}

# name: MEOS_ADJACENT_SPANSET_TIMESTAMPTZ
# description: adjacent_spanset_timestamptz — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE adjacentspansettims(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR adjacentspansettims TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)}'|'2020-01-03 00:00:00+00'
2|'{[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)}'|'2020-06-15 12:00:00+00'

CREATE SINK adjacentspansettims_out(adjacentspansettims.id UINT64, r INT32) TYPE File;
SELECT id, ADJACENT_SPANSET_TIMESTAMPTZ(a, b) AS r FROM adjacentspansettims INTO adjacentspansettims_out;

# name: MEOS_STBOX_ZMAX
# description: stbox_zmax — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxzmaxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxzmaxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'
2|'STBOX X((3,3),(7,7))'

CREATE SINK stboxzmaxs_out(stboxzmaxs.id UINT64, r FLOAT64) TYPE File;
SELECT id, STBOX_ZMAX(a) AS r FROM stboxzmaxs INTO stboxzmaxs_out;
----
1,0.0
2,0.0

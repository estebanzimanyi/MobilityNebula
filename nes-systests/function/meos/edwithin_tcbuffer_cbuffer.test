# name: MEOS_TEMPORAL_EDWITHIN_TCBUFFER_CBUFFER
# groups: [Function, MEOS, SpatioTemporal, TCbuffer, Codegen]
CREATE LOGICAL SOURCE edcc(id UINT64, lon FLOAT64, lat FLOAT64, radius FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR edcc TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|10.0|1609459200
2|4.4|50.7|5.0|1609545600

CREATE SINK edcc_out(edcc.id UINT64, r INT32) TYPE File;
SELECT id, EDWITHIN_TCBUFFER_CBUFFER(lon, lat, radius, ts, 'Cbuffer(Point(4.4 50.7),1.0)', FLOAT64(0.5)) AS r FROM edcc INTO edcc_out;

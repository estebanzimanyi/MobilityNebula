# name: MEOS_MINUS_FLOAT_SPANSET
# description: minus_float_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minusfloatspansets(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR minusfloatspansets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|7
2|'{[20, 25), [30, 35)}'|40

CREATE SINK minusfloatspansets_out(minusfloatspansets.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_FLOAT_SPANSET(a, b) AS r FROM minusfloatspansets INTO minusfloatspansets_out;

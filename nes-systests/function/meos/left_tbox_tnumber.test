# name: MEOS_LEFT_TBOX_TNUMBER
# groups: [Function, MEOS, TemporalNumber, Box, Codegen]
CREATE LOGICAL SOURCE tbn05(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tbn05 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|2.0|1577880000
2|100.0|1735689600

CREATE SINK tbn05_out(tbn05.id UINT64, r BOOLEAN) TYPE File;
SELECT id, LEFT_TBOX_TNUMBER('TBOXFLOAT XT([1, 3],[2020-01-01, 2020-01-02])', value, ts) AS r FROM tbn05 INTO tbn05_out;
----
1,0
2,1

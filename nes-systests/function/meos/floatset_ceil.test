# name: MEOS_FLOATSET_CEIL
# description: floatset_ceil — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatsetceils(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatsetceils TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'
2|'{3.5, 5.5, 9.5}'

CREATE SINK floatsetceils_out(floatsetceils.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSET_CEIL(a) AS r FROM floatsetceils INTO floatsetceils_out;
----
1,{2,4,6}
2,{4,6,10}

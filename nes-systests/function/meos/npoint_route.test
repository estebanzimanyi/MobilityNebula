# name: MEOS_NPOINT_ROUTE
# description: npoint_route — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointroutes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR npointroutes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NPoint(1, 0.5)'
2|'NPoint(1, 0.7)'

CREATE SINK npointroutes_out(npointroutes.id UINT64, r INT64) TYPE File;
SELECT id, NPOINT_ROUTE(a) AS r FROM npointroutes INTO npointroutes_out;
----
1,1
2,1

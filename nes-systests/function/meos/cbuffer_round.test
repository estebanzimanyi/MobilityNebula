# name: MEOS_CBUFFER_ROUND
# description: cbuffer_round — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbufferrounds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR cbufferrounds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'
2|'Cbuffer(Point(2 2),0.5)'

CREATE SINK cbufferrounds_out(cbufferrounds.id UINT64, r VARSIZED) TYPE File;
SELECT id, CBUFFER_ROUND(a) AS r FROM cbufferrounds INTO cbufferrounds_out;
----
1,Cbuffer(0101000000000000000000F03F000000000000F03F,1)
2,Cbuffer(010100000000000000000000400000000000000040,0.5)

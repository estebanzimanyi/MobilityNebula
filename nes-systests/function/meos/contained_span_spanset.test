# name: MEOS_CONTAINED_SPAN_SPANSET
# description: contained_span_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containedspanspanss(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR containedspanspanss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|'{[1, 5), [10, 15)}'
2|'[3, 9)'|'{[3, 7)}'

CREATE SINK containedspanspanss_out(containedspanspanss.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_SPAN_SPANSET(a, b) AS r FROM containedspanspanss INTO containedspanspanss_out;
----
1,1
2,0

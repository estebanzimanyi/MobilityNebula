# name: MEOS_INTSET_SHIFT_SCALE
# description: intset_shift_scale — shift+scale a span/set/spanset (hasshift=haswidth=true).
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intsetss(id UINT64, lit VARSIZED, sh INT32, wd INT32);
CREATE PHYSICAL SOURCE FOR intsetss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 7}'|10|20

CREATE SINK intsetss_out(intsetss.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTSET_SHIFT_SCALE(lit, sh, wd) AS r FROM intsetss INTO intsetss_out;
----
1,{11,18,32}

# name: MEOS_SPATIALSET_TYPE
# description: spatialset_type — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spatialsettypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spatialsettypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{2, 4}'

CREATE SINK spatialsettypes_out(spatialsettypes.id UINT64, r INT32) TYPE File;
SELECT id, SPATIALSET_TYPE(a) AS r FROM spatialsettypes INTO spatialsettypes_out;
----
1,0
2,0

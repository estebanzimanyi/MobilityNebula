# name: MEOS_NPOINT_TO_NSEGMENT
# description: npoint_to_nsegment — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointtonsegments(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR npointtonsegments TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NPoint(1, 0.5)'
2|'NPoint(1, 0.7)'

CREATE SINK npointtonsegments_out(npointtonsegments.id UINT64, r VARSIZED) TYPE File;
SELECT id, NPOINT_TO_NSEGMENT(a) AS r FROM npointtonsegments INTO npointtonsegments_out;
----
1,NSegment(1 0.5 0.5)
2,NSegment(1 0.7 0.7)

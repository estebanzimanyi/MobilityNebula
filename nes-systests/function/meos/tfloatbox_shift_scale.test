# name: MEOS_TFLOATBOX_SHIFT_SCALE
# description: tfloatbox_shift_scale — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tfloatboxshiftscals(id UINT64, a VARSIZED, arg0 FLOAT64, arg1 FLOAT64, arg2 BOOLEAN, arg3 BOOLEAN);
CREATE PHYSICAL SOURCE FOR tfloatboxshiftscals TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'|2.0|2.0|true|true
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'|2.0|2.0|true|true

CREATE SINK tfloatboxshiftscals_out(tfloatboxshiftscals.id UINT64, r VARSIZED) TYPE File;
SELECT id, TFLOATBOX_SHIFT_SCALE(a, arg0, arg1, arg2, arg3) AS r FROM tfloatboxshiftscals INTO tfloatboxshiftscals_out;
----
1,TBOXFLOAT XT([3 5] [2020-01-01 00:00:00+00 2020-01-05 00:00:00+00])
2,TBOXFLOAT XT([5 7] [2020-01-03 00:00:00+00 2020-01-07 00:00:00+00])

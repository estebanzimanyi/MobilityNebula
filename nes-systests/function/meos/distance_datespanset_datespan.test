# name: MEOS_DISTANCE_DATESPANSET_DATESPAN
# description: distance_datespanset_datespan — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancedatespanses(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR distancedatespanses TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01, 2020-01-10)}'|'[2020-01-01, 2020-01-10)'
2|'{[2020-01-05, 2020-01-20)}'|'[2020-01-05, 2020-01-20)'

CREATE SINK distancedatespanses_out(distancedatespanses.id UINT64, r INT32) TYPE File;
SELECT id, DISTANCE_DATESPANSET_DATESPAN(a, b) AS r FROM distancedatespanses INTO distancedatespanses_out;
----
1,0
2,0

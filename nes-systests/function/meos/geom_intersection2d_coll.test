# name: MEOS_GEOM_INTERSECTION2D_COLL
# description: geom_intersection2d_coll — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomintersection2ds(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geomintersection2ds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(0 0, 2 2)'|'SRID=4326;Linestring(0 2, 2 0)'
2|'SRID=4326;Linestring(0 0, 3 3)'|'SRID=4326;Linestring(1 0, 1 3)'

CREATE SINK geomintersection2ds_out(geomintersection2ds.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEOM_INTERSECTION2D_COLL(a, arg) AS r FROM geomintersection2ds INTO geomintersection2ds_out;
----
1,0101000020E6100000000000000000F03F000000000000F03F
2,0101000020E6100000000000000000F03F000000000000F03F

# name: MEOS_TCOVERS_TCBUFFER_TCBUFFER_hex
# description: Per-event tcovers_tcbuffer_tcbuffer over two hex-WKB tcb temporals (B3 hex-combinator wave). Inputs carried as VARSIZED hex-WKB, reconstructed via temporal_from_hexwkb.
# groups: [Function, MEOS, Cbuffer, CrossStream, Codegen]
CREATE LOGICAL SOURCE hxsrc(id UINT64, ta VARSIZED, tb VARSIZED);
CREATE PHYSICAL SOURCE FOR hxsrc TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|013B000E020000000300000000000000000000000000000000000000000000F03F00A0AD30CA5A020000000000000000000000000000000040000000000000F03F00444107CB5A0200|013B000E0200000003000000000000F03F0000000000000000000000000000F03F00A0AD30CA5A0200000000000000F03F0000000000000040000000000000F03F00444107CB5A0200

CREATE SINK hxsrc_out(hxsrc.id UINT64, r VARSIZED) TYPE File;
SELECT id, TCOVERS_TCBUFFER_TCBUFFER(ta, tb) AS r FROM hxsrc INTO hxsrc_out;

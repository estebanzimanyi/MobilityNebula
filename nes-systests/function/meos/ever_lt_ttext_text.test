CREATE SINK everltttexttexts_out(everltttexttexts.id UINT64, r INT32) TYPE File;
SELECT id, EVER_LT_TTEXT_TEXT(value, ts, arg) AS r FROM everltttexttexts INTO everltttexttexts_out;

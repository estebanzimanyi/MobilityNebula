CREATE LOGICAL SOURCE everltttexttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR everltttexttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

# name: MEOS_AFTER_SET_DATE
# description: after_set_date — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE aftersetdates(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR aftersetdates TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01, 2020-01-05, 2020-01-10}'|'2020-01-03'
2|'{2020-01-03, 2020-01-08}'|'2020-06-15'

CREATE SINK aftersetdates_out(aftersetdates.id UINT64, r INT32) TYPE File;
SELECT id, AFTER_SET_DATE(a, b) AS r FROM aftersetdates INTO aftersetdates_out;
----
1,0
2,0

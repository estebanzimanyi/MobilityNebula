# name: MEOS_SPANSET_LT
# description: spanset_lt — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spansetlts(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR spansetlts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|'{[1, 5), [10, 15)}'
2|'{[3, 7)}'|'{[3, 7)}'

CREATE SINK spansetlts_out(spansetlts.id UINT64, r INT32) TYPE File;
SELECT id, SPANSET_LT(a, b) AS r FROM spansetlts INTO spansetlts_out;
----
1,0
2,0

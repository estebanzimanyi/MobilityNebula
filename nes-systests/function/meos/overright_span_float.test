# name: MEOS_OVERRIGHT_SPAN_FLOAT
# description: overright_span_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overrightspanfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR overrightspanfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'|3.5
2|'[3.5, 9.5)'|7.5

CREATE SINK overrightspanfloats_out(overrightspanfloats.id UINT64, r INT32) TYPE File;
SELECT id, OVERRIGHT_SPAN_FLOAT(a, b) AS r FROM overrightspanfloats INTO overrightspanfloats_out;
----
1,0
2,0

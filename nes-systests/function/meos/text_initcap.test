# name: MEOS_TEXT_INITCAP
# description: text_initcap — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textinitcaps(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR textinitcaps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Hello World'
2|'foo bar'

CREATE SINK textinitcaps_out(textinitcaps.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXT_INITCAP(a) AS r FROM textinitcaps INTO textinitcaps_out;
----
1,"Hello World"
2,"Foo Bar"

# name: MEOS_TEXTCAT_TTEXT_TTEXT
# description: textcat_ttext_ttext — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textcatttextttexts(id UINT64, value VARSIZED, ts UINT64, value2 VARSIZED, ts2 UINT64);
CREATE PHYSICAL SOURCE FOR textcatttextttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'DEF'|1609459200
2|'GHI'|1609545600|'JKL'|1609545600

CREATE SINK textcatttextttexts_out(textcatttextttexts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXTCAT_TTEXT_TTEXT(value, ts, value2, ts2) AS r FROM textcatttextttexts INTO textcatttextttexts_out;
----
1,"ABCDEF"@2021-01-01,00:00:00+00
2,"GHIJKL"@2021-01-02,00:00:00+00

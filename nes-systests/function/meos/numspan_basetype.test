# name: MEOS_NUMSPAN_BASETYPE
# description: numspan_basetype — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE numspanbasetypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR numspanbasetypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 20)'
2|'[3, 25)'

CREATE SINK numspanbasetypes_out(numspanbasetypes.id UINT64, r INT32) TYPE File;
SELECT id, NUMSPAN_BASETYPE(a) AS r FROM numspanbasetypes INTO numspanbasetypes_out;
----
1,0
2,0

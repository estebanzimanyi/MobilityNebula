# name: MEOS_SPAN_TO_SPANSET
# description: span_to_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spantospansets(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spantospansets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'
2|'[3.5, 9.5)'

CREATE SINK spantospansets_out(spantospansets.id UINT64, r VARSIZED) TYPE File;
SELECT id, SPAN_TO_SPANSET(a) AS r FROM spantospansets INTO spantospansets_out;
----
1,{[1.5,5.5)}
2,{[3.5,9.5)}

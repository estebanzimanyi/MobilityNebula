# name: MEOS_POSE_LE
# description: pose_le — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE poseles(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR poseles TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'|'Pose(Point(2 2), 1.0)'
2|'Pose(Point(2 2), 1.0)'|'Pose(Point(1 1), 0.5)'

CREATE SINK poseles_out(poseles.id UINT64, r INT32) TYPE File;
SELECT id, POSE_LE(a, b) AS r FROM poseles INTO poseles_out;
----
1,0
2,1

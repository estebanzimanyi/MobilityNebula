# name: MEOS_TRGEOMETRY_GEOM
# description: trgeometry_geom — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE trgeometrygeoms(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR trgeometrygeoms TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

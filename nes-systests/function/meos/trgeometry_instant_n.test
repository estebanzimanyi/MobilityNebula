# name: MEOS_TRGEOMETRY_INSTANT_N
# description: TRGEOMETRY_INSTANT_N returns the n-th instant of a temporal rigid geometry (built per event from x,y,theta,ts; n=1 yields the single instant), emitted as hex-WKB.
# groups: [Function, MEOS, Rgeometry]
CREATE LOGICAL SOURCE trgeometryinstantns(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64, arg0 INT32);
CREATE PHYSICAL SOURCE FOR trgeometryinstantns TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|0.0|0.0|0.0|1609459200|1
2|1.0|1.0|0.5|1609545600|1

CREATE SINK trgeometryinstantns_out(trgeometryinstantns.id UINT64, r VARSIZED) TYPE File;
SELECT id, TRGEOMETRY_INSTANT_N(x, y, theta, ts, arg0) AS r FROM trgeometryinstantns INTO trgeometryinstantns_out;
----
1,013E00010103000000010000000500000000000000000000000000000000000000000000000000F03F0000000000000000000000000000F03F000000000000F03F0000000000000000000000000000F03F000000000000000000000000000000000100000000000000000000000000000000000000000000000000A0AD30CA5A0200
2,013E00010103000000010000000500000000000000000000000000000000000000000000000000F03F0000000000000000000000000000F03F000000000000F03F0000000000000000000000000000F03F0000000000000000000000000000000001000000000000F03F000000000000F03F000000000000E03F0000854EDE5A0200

# name: MEOS_NSEGMENT_TO_STBOX
# description: nsegment_to_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE nsegmenttostboxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR nsegmenttostboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NSegment(1, 0.2, 0.8)'
2|'NSegment(1, 0.5, 0.7)'

CREATE SINK nsegmenttostboxs_out(nsegmenttostboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, NSEGMENT_TO_STBOX(a) AS r FROM nsegmenttostboxs INTO nsegmenttostboxs_out;

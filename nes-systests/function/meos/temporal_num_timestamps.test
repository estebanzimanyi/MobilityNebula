# name: MEOS_TEMPORAL_NUM_TIMESTAMPS_Aggregation
# description: Windowed TEMPORAL_NUM_TIMESTAMPS over per-(window,group) tgeompoint.
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE temporamps(gid UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR temporamps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200
1|2.0|2.0|1609459201
1|3.0|3.0|1609459202
2|5.0|5.0|1609459200
2|6.0|6.0|1609459201

CREATE SINK temporamps_out(temporamps.gid UINT64, temporamps.r INT32) TYPE File;
SELECT gid, TEMPORAL_NUM_TIMESTAMPS(lon, lat, ts) AS r FROM temporamps GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO temporamps_out;
----
1,3
2,2

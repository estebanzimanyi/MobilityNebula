# name: MEOS_MINUS_SET_INT
# description: minus_set_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minussetints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR minussetints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK minussetints_out(minussetints.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_SET_INT(a, b) AS r FROM minussetints INTO minussetints_out;
----
1,{1,5}
2,{3,5,9}

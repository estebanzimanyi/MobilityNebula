# name: MEOS_TNPOINT_TCENTROID_TRANSFN
# description: Windowed TNPOINT_TCENTROID_TRANSFN -> aggregate Temporal (hex-WKB) via the per-op SkipList tagg transfn; VARSIZED value, timestamp windowing-only.
# groups: [Function, MEOS, Aggregation]
CREATE LOGICAL SOURCE ctnc(vehicle_id UINT64, value VARSIZED, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR ctnc TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|NPoint(1, 0.3)@2020-01-01 00:00:00+00|1609459200
1|NPoint(1, 0.7)@2020-01-01 00:30:00+00|1609462800

CREATE SINK ctnc_out(ctnc.vehicle_id UINT64, ctnc.r VARSIZED) TYPE File;
SELECT vehicle_id, TNPOINT_TCENTROID_TRANSFN(value, timestamp) AS r FROM ctnc GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO ctnc_out;

# name: MEOS_POSE_TO_STBOX
# description: pose_to_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posetostboxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR posetostboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'
2|'Pose(Point(2 2), 1.0)'

CREATE SINK posetostboxs_out(posetostboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, POSE_TO_STBOX(a) AS r FROM posetostboxs INTO posetostboxs_out;
----
1,STBOX X((1,1),(1,1))
2,STBOX X((2,2),(2,2))

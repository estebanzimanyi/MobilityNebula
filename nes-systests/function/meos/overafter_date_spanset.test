# name: MEOS_OVERAFTER_DATE_SPANSET
# description: overafter_date_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overafterdatespanss(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR overafterdatespanss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01, 2020-01-10)}'|'2020-01-03'
2|'{[2020-01-05, 2020-01-20)}'|'2020-06-15'

CREATE SINK overafterdatespanss_out(overafterdatespanss.id UINT64, r INT32) TYPE File;
SELECT id, OVERAFTER_DATE_SPANSET(a, b) AS r FROM overafterdatespanss INTO overafterdatespanss_out;
----
1,1
2,1

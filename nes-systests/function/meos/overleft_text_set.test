# name: MEOS_OVERLEFT_TEXT_SET
# description: overleft_text_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overlefttextsets(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR overlefttextsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'|'AAA'
2|'{"BBB", "DDD"}'|'BBB'

CREATE SINK overlefttextsets_out(overlefttextsets.id UINT64, r INT32) TYPE File;
SELECT id, OVERLEFT_TEXT_SET(a, arg) AS r FROM overlefttextsets INTO overlefttextsets_out;
----
1,1
2,1

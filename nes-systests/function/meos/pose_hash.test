# name: MEOS_POSE_HASH
# description: pose_hash — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posehashs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR posehashs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'
2|'Pose(Point(2 2), 1.0)'

CREATE SINK posehashs_out(posehashs.id UINT64, r INT32) TYPE File;
SELECT id, POSE_HASH(a) AS r FROM posehashs INTO posehashs_out;
----
1,-1727742402
2,1872703042

# name: MEOS_TFLOATBOX_EXPAND
# description: tfloatbox_expand — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tfloatboxexpands(id UINT64, box VARSIZED, dist FLOAT64);
CREATE PHYSICAL SOURCE FOR tfloatboxexpands TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'|1.0
2|'TBOXFLOAT XT([2, 4],[2020-01-03, 2020-01-04])'|2.0

CREATE SINK tfloatboxexpands_out(tfloatboxexpands.id UINT64, r VARSIZED) TYPE File;
SELECT id, TFLOATBOX_EXPAND(box, dist) AS r FROM tfloatboxexpands INTO tfloatboxexpands_out;
----
1,TBOXFLOAT,XT([0,6],[2020-01-01,00:00:00+00,2020-01-05,00:00:00+00])
2,TBOXFLOAT,XT([0,6],[2020-01-03,00:00:00+00,2020-01-04,00:00:00+00])

# name: MEOS_GEOM_TO_CBUFFER
# description: geom_to_cbuffer — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomtocbuffers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geomtocbuffers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(1 1, 2 2)'
2|'SRID=4326;Linestring(3 3, 4 4, 5 5)'

CREATE SINK geomtocbuffers_out(geomtocbuffers.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEOM_TO_CBUFFER(a) AS r FROM geomtocbuffers INTO geomtocbuffers_out;
----
1,Cbuffer(0101000020E6100000000000000000F83F000000000000F83F,0.707106781186548)
2,Cbuffer(0101000020E610000000000000000010400000000000001040,1.414213562373095)

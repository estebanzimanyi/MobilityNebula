# name: MEOS_SPANSET_UPPER_INC
# description: spanset_upper_inc — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spansetupperincs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spansetupperincs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'
2|'{[3, 7)}'

CREATE SINK spansetupperincs_out(spansetupperincs.id UINT64, r BOOLEAN) TYPE File;
SELECT id, SPANSET_UPPER_INC(a) AS r FROM spansetupperincs INTO spansetupperincs_out;
----
1,0
2,0

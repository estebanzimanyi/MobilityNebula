# name: MEOS_OVERRIGHT_SET_INT
# description: overright_set_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overrightsetints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR overrightsetints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK overrightsetints_out(overrightsetints.id UINT64, r INT32) TYPE File;
SELECT id, OVERRIGHT_SET_INT(a, b) AS r FROM overrightsetints INTO overrightsetints_out;
----
1,0
2,0

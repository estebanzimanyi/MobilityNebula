# name: MEOS_GBOX_TO_STBOX
# description: GBOX_TO_STBOX converts a PostGIS GBOX (a VARSIZED gbox text literal, e.g. a STBOX_TO_GBOX output) to its spatiotemporal STBox. Row 1 is a 2D box; row 2 carries a Z dimension.
# groups: [Function, MEOS, SpatioTemporal, Box]
CREATE LOGICAL SOURCE gts(id UINT64, box VARSIZED);
CREATE PHYSICAL SOURCE FOR gts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|GBOX X((1,1),(3,3))
2|GBOX Z((1,1,1),(3,3,5))

CREATE SINK gts_out(gts.id UINT64, r VARSIZED) TYPE File;
SELECT id, GBOX_TO_STBOX(box) AS r FROM gts INTO gts_out;
----
1,STBOX,X((1,1),(3,3))
2,STBOX,Z((1,1,1),(3,3,5))

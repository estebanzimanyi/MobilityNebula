# name: MEOS_CONTAINED_STBOX_TSPATIAL
# groups: [Function, MEOS, SpatioTemporal, Box, Codegen]
CREATE LOGICAL SOURCE stp06(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR stp06 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200
2|2.0|2.0|1577836800

CREATE SINK stp06_out(stp06.id UINT64, r BOOLEAN) TYPE File;
SELECT id, CONTAINED_STBOX_TSPATIAL('SRID=4326;STBOX XT(((1,1),(3,3)),[2020-01-01,2020-01-02])', lon, lat, ts) AS r FROM stp06 INTO stp06_out;
----
1,0
2,0

CREATE LOGICAL SOURCE temporalbasetypes(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR temporalbasetypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);

# name: MEOS_GEO_SPLIT_EACH_N_STBOXES
# description: geo_split_each_n_stboxes — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geospliteachnstboxs(id UINT64, a VARSIZED, x0 INT32);
CREATE PHYSICAL SOURCE FOR geospliteachnstboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(0 0, 2 2, 4 4)'|2
2|'SRID=4326;Linestring(1 1, 3 3)'|2

CREATE SINK geospliteachnstboxs_out(geospliteachnstboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEO_SPLIT_EACH_N_STBOXES(a, x0) AS r FROM geospliteachnstboxs INTO geospliteachnstboxs_out;
----
1,{SRID=4326;STBOX X((0,0),(4,4))}
2,{SRID=4326;STBOX X((1,1),(3,3))}

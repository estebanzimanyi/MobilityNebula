# name: MEOS_POSE_TO_POINT
# description: pose_to_point — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posetopoints(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR posetopoints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'
2|'Pose(Point(2 2), 1.0)'

CREATE SINK posetopoints_out(posetopoints.id UINT64, r VARSIZED) TYPE File;
SELECT id, POSE_TO_POINT(a) AS r FROM posetopoints INTO posetopoints_out;
----
1,0101000000000000000000F03F000000000000F03F
2,010100000000000000000000400000000000000040

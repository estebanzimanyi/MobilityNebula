# name: MEOS_CONTAINED_NPOINT_SET
# description: contained_npoint_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containednpointsets(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR containednpointsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Npoint(1,0.5)", "Npoint(2,0.5)"}'|'Npoint(1,0.5)'
2|'{"Npoint(1,0.7)", "Npoint(3,0.5)"}'|'Npoint(1,0.7)'

CREATE SINK containednpointsets_out(containednpointsets.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_NPOINT_SET(a, arg) AS r FROM containednpointsets INTO containednpointsets_out;
----
1,1
2,1

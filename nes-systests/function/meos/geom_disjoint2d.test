# name: MEOS_GEOM_DISJOINT2D
# description: geom_disjoint2d — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomdisjoint2ds(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geomdisjoint2ds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(0 0, 2 2)'|'SRID=4326;Linestring(0 2, 2 0)'
2|'SRID=4326;Linestring(0 0, 3 3)'|'SRID=4326;Linestring(1 0, 1 3)'

CREATE SINK geomdisjoint2ds_out(geomdisjoint2ds.id UINT64, r INT32) TYPE File;
SELECT id, GEOM_DISJOINT2D(a, arg) AS r FROM geomdisjoint2ds INTO geomdisjoint2ds_out;
----
1,0
2,0

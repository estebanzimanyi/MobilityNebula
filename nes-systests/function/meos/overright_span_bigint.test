CREATE LOGICAL SOURCE overrightspanbigins(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR overrightspanbigins TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

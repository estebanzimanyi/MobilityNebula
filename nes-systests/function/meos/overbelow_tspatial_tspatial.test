# name: MEOS_OVERBELOW_TSPATIAL_TSPATIAL
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, EDisjoint]
CREATE LOGICAL SOURCE ts14(id UINT32, lonA FLOAT64, latA FLOAT64, tsA UINT64, lonB FLOAT64, latB FLOAT64, tsB UINT64);
CREATE PHYSICAL SOURCE FOR ts14 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200|4.4000|50.7000|1609459200
2|4.3658|50.6456|1609459200|4.3658|50.6456|1609459200

CREATE SINK ts14_out(ts14.id UINT32, r BOOLEAN) TYPE File;
SELECT id, OVERBELOW_TSPATIAL_TSPATIAL(lonA, latA, tsA, lonB, latB, tsB) AS r FROM ts14 INTO ts14_out;

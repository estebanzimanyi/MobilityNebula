# name: MEOS_ALWAYS_GE_TTEXT_TEXT
# description: always_ge_ttext_text — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE alwaysgettexttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR alwaysgettexttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'ABC'
2|'DEF'|1609545600|'DEF'

CREATE SINK alwaysgettexttexts_out(alwaysgettexttexts.id UINT64, r INT32) TYPE File;
SELECT id, ALWAYS_GE_TTEXT_TEXT(value, ts, arg) AS r FROM alwaysgettexttexts INTO alwaysgettexttexts_out;

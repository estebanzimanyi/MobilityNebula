# name: MEOS_TNUMBER_TO_TBOX
# description: tnumber_to_tbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tnumbertotboxs(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tnumbertotboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200
2|8.5|1609545600

CREATE SINK tnumbertotboxs_out(tnumbertotboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, TNUMBER_TO_TBOX(value, ts) AS r FROM tnumbertotboxs INTO tnumbertotboxs_out;
----
1,TBOXFLOAT XT([5.5, 5.5],[2021-01-01 00:00:00+00, 2021-01-01 00:00:00+00])
2,TBOXFLOAT XT([8.5, 8.5],[2021-01-02 00:00:00+00, 2021-01-02 00:00:00+00])

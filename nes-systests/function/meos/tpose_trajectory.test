# name: MEOS_TPOSE_TRAJECTORY
# description: tpose_trajectory — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tposetrajectorys(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tposetrajectorys TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|0.5|1609459200
2|2.0|2.0|1.0|1609545600

CREATE SINK tposetrajectorys_out(tposetrajectorys.id UINT64, r VARSIZED) TYPE File;
SELECT id, TPOSE_TRAJECTORY(x, y, theta, ts) AS r FROM tposetrajectorys INTO tposetrajectorys_out;

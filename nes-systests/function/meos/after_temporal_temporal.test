2|4.3658|50.6456|1609459200|4.3658|50.6456|1609459200

CREATE SINK tt01_out(tt01.id UINT32, r BOOLEAN) TYPE File;
SELECT id, AFTER_TEMPORAL_TEMPORAL(lonA, latA, tsA, lonB, latB, tsB) AS r FROM tt01 INTO tt01_out;

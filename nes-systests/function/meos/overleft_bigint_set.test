# name: MEOS_OVERLEFT_BIGINT_SET
# description: overleft_bigint_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overleftbigintsets(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR overleftbigintsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK overleftbigintsets_out(overleftbigintsets.id UINT64, r INT32) TYPE File;
SELECT id, OVERLEFT_BIGINT_SET(a, b) AS r FROM overleftbigintsets INTO overleftbigintsets_out;

# name: MEOS_SPAN_TO_TBOX
# description: span_to_tbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spantotboxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spantotboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'
2|'[3.5, 9.5)'

CREATE SINK spantotboxs_out(spantotboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, SPAN_TO_TBOX(a) AS r FROM spantotboxs INTO spantotboxs_out;
----
1,TBOXFLOAT X([1.5, 5.5))
2,TBOXFLOAT X([3.5, 9.5))

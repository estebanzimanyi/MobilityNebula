# name: MEOS_TEMPORAL_TSAMPLE_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE tts(gid UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200
1|1.0|1.0|1609459230
1|5.0|5.0|1609459260
1|5.0|5.0|1609459290
2|2.0|2.0|1609459200
2|8.0|8.0|1609459260

CREATE SINK tts_out(tts.gid UINT64, tts.r VARSIZED) TYPE File;
SELECT gid, TEMPORAL_TSAMPLE(lon, lat, ts, '1 minute', '2021-01-01', 3) AS r FROM tts GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tts_out;

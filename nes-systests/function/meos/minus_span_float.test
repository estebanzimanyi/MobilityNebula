# name: MEOS_MINUS_SPAN_FLOAT
# description: minus_span_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minusspanfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR minusspanfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|7
2|'[10, 15)'|2

CREATE SINK minusspanfloats_out(minusspanfloats.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_SPAN_FLOAT(a, b) AS r FROM minusspanfloats INTO minusspanfloats_out;
----
1,{[1,5)}
2,{[10,15)}

CREATE SINK temporalinserts_out(temporalinserts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEMPORAL_INSERT(value, ts, value2, ts2, flag) AS r FROM temporalinserts INTO temporalinserts_out;

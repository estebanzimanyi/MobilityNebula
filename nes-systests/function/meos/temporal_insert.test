# name: MEOS_TEMPORAL_INSERT
# description: temporal_insert — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE temporalinserts(id UINT64, value INT32, ts UINT64, value2 INT32, ts2 UINT64, flag BOOLEAN);
CREATE PHYSICAL SOURCE FOR temporalinserts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

# name: MEOS_CONTAINED_INT_SET
# description: contained_int_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containedintsets(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR containedintsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK containedintsets_out(containedintsets.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_INT_SET(a, b) AS r FROM containedintsets INTO containedintsets_out;
----
1,1
2,0

# name: MEOS_ADJACENT_TBOX_TBOX
# description: adjacent_tbox_tbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE adjacenttboxtboxs(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR adjacenttboxtboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'

CREATE SINK adjacenttboxtboxs_out(adjacenttboxtboxs.id UINT64, r INT32) TYPE File;
SELECT id, ADJACENT_TBOX_TBOX(a, b) AS r FROM adjacenttboxtboxs INTO adjacenttboxtboxs_out;

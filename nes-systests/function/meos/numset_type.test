# name: MEOS_NUMSET_TYPE
# description: numset_type — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE numsettypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR numsettypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{2, 4}'

CREATE SINK numsettypes_out(numsettypes.id UINT64, r INT32) TYPE File;
SELECT id, NUMSET_TYPE(a) AS r FROM numsettypes INTO numsettypes_out;
----
1,1
2,1

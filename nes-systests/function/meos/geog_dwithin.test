# name: MEOS_GEOG_DWITHIN
# description: geog_dwithin — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geogdwithins(id UINT64, a VARSIZED, arg VARSIZED, dist FLOAT64);
CREATE PHYSICAL SOURCE FOR geogdwithins TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(0 0)'|'SRID=4326;Point(0 0)'|1000.0
2|'SRID=4326;Point(0 0)'|'SRID=4326;Point(1 1)'|1000.0

CREATE SINK geogdwithins_out(geogdwithins.id UINT64, r INT32) TYPE File;
SELECT id, GEOG_DWITHIN(a, arg, dist) AS r FROM geogdwithins INTO geogdwithins_out;
----
1,1
2,0

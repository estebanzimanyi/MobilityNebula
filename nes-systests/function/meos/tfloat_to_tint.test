# name: MEOS_TFLOAT_TO_TINT
# groups: [Function, MEOS, TemporalNumber, Codegen]
CREATE LOGICAL SOURCE tf2i(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tf2i TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|2.7|1609459200
2|10.2|1609545600

CREATE SINK tf2i_out(tf2i.id UINT64, r INT32) TYPE File;
SELECT id, TFLOAT_TO_TINT(value, ts) AS r FROM tf2i INTO tf2i_out;
----
1,2
2,10

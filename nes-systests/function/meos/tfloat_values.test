# name: MEOS_TFLOAT_VALUES
# description: tfloat_values — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tfloatvaluess(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tfloatvaluess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200
2|8.5|1609545600

CREATE SINK tfloatvaluess_out(tfloatvaluess.id UINT64, r VARSIZED) TYPE File;
SELECT id, TFLOAT_VALUES(value, ts) AS r FROM tfloatvaluess INTO tfloatvaluess_out;
----
1,{5.500000}
2,{8.500000}

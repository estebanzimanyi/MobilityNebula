# name: MEOS_TEXT_UNION_TRANSFN
# description: Windowed TEXT_UNION_TRANSFN -> aggregate container (text) over a stream of VARSIZED literals; timestamp is windowing-only.
# groups: [Function, MEOS, Set, Span, Aggregation]
CREATE LOGICAL SOURCE ctxu(vehicle_id UINT64, value VARSIZED, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR ctxu TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|ABC|1609459200
1|DEF|1609462800

CREATE SINK ctxu_out(ctxu.vehicle_id UINT64, ctxu.r VARSIZED) TYPE File;
SELECT vehicle_id, TEXT_UNION_TRANSFN(value, timestamp) AS r FROM ctxu GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO ctxu_out;
----
1,{"ABC", "DEF"}

# name: MEOS_GEOM_CONVEX_HULL
# description: geom_convex_hull — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomconvexhulls(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geomconvexhulls TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(1 1, 2 2)'
2|'SRID=4326;Linestring(3 3, 4 4, 5 5)'

CREATE SINK geomconvexhulls_out(geomconvexhulls.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEOM_CONVEX_HULL(a) AS r FROM geomconvexhulls INTO geomconvexhulls_out;

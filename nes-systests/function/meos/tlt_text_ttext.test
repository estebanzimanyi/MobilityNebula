# name: MEOS_TLT_TEXT_TTEXT
# description: tlt_text_ttext — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tlttextttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tlttextttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'XYZ'
2|'DEF'|1609545600|'XYZ'

CREATE SINK tlttextttexts_out(tlttextttexts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TLT_TEXT_TTEXT(value, ts, arg) AS r FROM tlttextttexts INTO tlttextttexts_out;
----
1,f@2021-01-01,00:00:00+00
2,f@2021-01-02,00:00:00+00

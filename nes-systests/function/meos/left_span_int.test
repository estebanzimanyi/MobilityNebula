# name: MEOS_LEFT_SPAN_INT
# description: left_span_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE leftspanints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR leftspanints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK leftspanints_out(leftspanints.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_SPAN_INT(a, b) AS r FROM leftspanints INTO leftspanints_out;
----
1,0
2,0

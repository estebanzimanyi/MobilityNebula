# name: MEOS_STBOX_TMIN
# description: stbox_tmin — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxtmins(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxtmins TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX XT(((1,1),(5,5)),[2020-01-01, 2020-01-05])'
2|'STBOX XT(((3,3),(7,7)),[2020-01-03, 2020-01-07])'

CREATE SINK stboxtmins_out(stboxtmins.id UINT64, r INT64) TYPE File;
SELECT id, STBOX_TMIN(a) AS r FROM stboxtmins INTO stboxtmins_out;
----
1,631152000000000
2,631324800000000

# name: MEOS_SPANSET_HASH
# description: spanset_hash — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spansethashs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spansethashs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'
2|'{[3, 7)}'

CREATE SINK spansethashs_out(spansethashs.id UINT64, r INT32) TYPE File;
SELECT id, SPANSET_HASH(a) AS r FROM spansethashs INTO spansethashs_out;
----
1,-614296983
2,-1599920599

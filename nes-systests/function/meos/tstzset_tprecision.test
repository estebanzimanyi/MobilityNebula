# name: MEOS_TSTZSET_TPRECISION
# description: tstzset_tprecision — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzsettprecisions(id UINT64, a VARSIZED, arg0 VARSIZED, arg1 VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzsettprecisions TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01 00:00:00+00, 2020-01-05 00:00:00+00}'|'1 day'|'2020-01-01 00:00:00+00'
2|'{2020-01-03 00:00:00+00, 2020-01-08 00:00:00+00}'|'2 days'|'2020-01-01 00:00:00+00'

CREATE SINK tstzsettprecisions_out(tstzsettprecisions.id UINT64, r VARSIZED) TYPE File;
SELECT id, TSTZSET_TPRECISION(a, arg0, arg1) AS r FROM tstzsettprecisions INTO tstzsettprecisions_out;
----
1,{"2020-01-01,00:00:00+00","2020-01-05,00:00:00+00"}

# name: MEOS_CONTAINS_SPANSET_FLOAT
# description: contains_spanset_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containsspansetflos(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR containsspansetflos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'|3.5
2|'{[3.5, 7.5)}'|7.5

CREATE SINK containsspansetflos_out(containsspansetflos.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINS_SPANSET_FLOAT(a, b) AS r FROM containsspansetflos INTO containsspansetflos_out;
----
1,1
2,0

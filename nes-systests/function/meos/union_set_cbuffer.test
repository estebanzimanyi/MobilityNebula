# name: MEOS_UNION_SET_CBUFFER
# description: union_set_cbuffer — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionsetcbuffers(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR unionsetcbuffers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Cbuffer(Point(1 1),0.5)", "Cbuffer(Point(2 2),0.5)"}'|'Cbuffer(Point(1 1),0.5)'
2|'{"Cbuffer(Point(3 3),1.0)", "Cbuffer(Point(4 4),0.5)"}'|'Cbuffer(Point(3 3),1.0)'

CREATE SINK unionsetcbuffers_out(unionsetcbuffers.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_SET_CBUFFER(a, arg) AS r FROM unionsetcbuffers INTO unionsetcbuffers_out;

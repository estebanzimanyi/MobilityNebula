# name: MEOS_TGEOINST_MAKE
# description: tgeoinst_make — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tgeoinstmakes(id UINT64, a VARSIZED, arg0 INT64);
CREATE PHYSICAL SOURCE FOR tgeoinstmakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(1 1)'|631152000000000
2|'SRID=4326;Point(2 2)'|631238400000000

CREATE SINK tgeoinstmakes_out(tgeoinstmakes.id UINT64, r VARSIZED) TYPE File;
SELECT id, TGEOINST_MAKE(a, arg0) AS r FROM tgeoinstmakes INTO tgeoinstmakes_out;
----
1,POINT(1 1)@2020-01-01 00:00:00+00
2,POINT(2 2)@2020-01-02 00:00:00+00

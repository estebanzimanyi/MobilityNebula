# name: MEOS_LEFT_SPAN_FLOAT
# description: left_span_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE leftspanfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR leftspanfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'|3.5
2|'[3.5, 9.5)'|7.5

CREATE SINK leftspanfloats_out(leftspanfloats.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_SPAN_FLOAT(a, b) AS r FROM leftspanfloats INTO leftspanfloats_out;
----
1,0
2,0

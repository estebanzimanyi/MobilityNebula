# name: MEOS_DATESPAN_MAKE
# description: datespan_make — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE datespanmakes(id UINT64, value INT32, arg0 INT32, arg1 BOOLEAN, arg2 BOOLEAN);
CREATE PHYSICAL SOURCE FOR datespanmakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|100|200|true|false
2|150|300|true|false

CREATE SINK datespanmakes_out(datespanmakes.id UINT64, r VARSIZED) TYPE File;
SELECT id, DATESPAN_MAKE(value, arg0, arg1, arg2) AS r FROM datespanmakes INTO datespanmakes_out;

# name: MEOS_NPOINT_SRID
# description: npoint_srid — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointsrids(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR npointsrids TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NPoint(1, 0.5)'
2|'NPoint(1, 0.7)'

CREATE SINK npointsrids_out(npointsrids.id UINT64, r INT32) TYPE File;
SELECT id, NPOINT_SRID(a) AS r FROM npointsrids INTO npointsrids_out;
----
1,5676
2,5676

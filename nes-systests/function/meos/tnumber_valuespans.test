CREATE SINK tnumbervaluespanss_out(tnumbervaluespanss.id UINT64, r VARSIZED) TYPE File;
SELECT id, TNUMBER_VALUESPANS(value, ts) AS r FROM tnumbervaluespanss INTO tnumbervaluespanss_out;

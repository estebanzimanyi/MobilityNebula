# name: MEOS_TNUMBER_VALUESPANS
# description: tnumber_valuespans — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tnumbervaluespanss(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tnumbervaluespanss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

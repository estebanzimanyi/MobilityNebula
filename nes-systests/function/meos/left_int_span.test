# name: MEOS_LEFT_INT_SPAN
# description: left_int_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE leftintspans(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR leftintspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK leftintspans_out(leftintspans.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_INT_SPAN(a, b) AS r FROM leftintspans INTO leftintspans_out;
----
1,0
2,0

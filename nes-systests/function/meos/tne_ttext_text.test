# name: MEOS_TNE_TTEXT_TEXT
# description: tne_ttext_text — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tnettexttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tnettexttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'XYZ'
2|'DEF'|1609545600|'XYZ'

CREATE SINK tnettexttexts_out(tnettexttexts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TNE_TTEXT_TEXT(value, ts, arg) AS r FROM tnettexttexts INTO tnettexttexts_out;
----
1,t@2021-01-01,00:00:00+00
2,t@2021-01-02,00:00:00+00

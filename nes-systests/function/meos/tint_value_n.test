# name: MEOS_TINT_VALUE_N
# description: tint_value_n — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tintvaluens(id UINT64, value INT32, ts UINT64);
CREATE PHYSICAL SOURCE FOR tintvaluens TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

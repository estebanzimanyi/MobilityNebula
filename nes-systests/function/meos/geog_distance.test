# name: MEOS_GEOG_DISTANCE
# description: geog_distance — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geogdistances(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geogdistances TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(0 0)'|'SRID=4326;Point(1 1)'
2|'SRID=4326;Point(0 0)'|'SRID=4326;Point(2 2)'

CREATE SINK geogdistances_out(geogdistances.id UINT64, r FLOAT64) TYPE File;
SELECT id, GEOG_DISTANCE(a, arg) AS r FROM geogdistances INTO geogdistances_out;
----
1,156899.568291
2,313775.709429

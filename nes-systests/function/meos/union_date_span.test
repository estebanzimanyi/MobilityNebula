# name: MEOS_UNION_DATE_SPAN
# description: union_date_span value-mixed set/span/spanset algebra.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE uniondatespan(id UINT64, lit VARSIZED, val INT32);
CREATE PHYSICAL SOURCE FOR uniondatespan TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01, 2020-01-10)'|7307

CREATE SINK uniondatespan_out(uniondatespan.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_DATE_SPAN(lit, val) AS r FROM uniondatespan INTO uniondatespan_out;
----
1,{[2020-01-01,2020-01-10)}

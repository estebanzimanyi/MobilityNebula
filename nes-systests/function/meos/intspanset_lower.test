# name: MEOS_INTSPANSET_LOWER
# description: intspanset_lower — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intspansetlowers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR intspansetlowers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'
2|'{[3, 7)}'

CREATE SINK intspansetlowers_out(intspansetlowers.id UINT64, r INT32) TYPE File;
SELECT id, INTSPANSET_LOWER(a) AS r FROM intspansetlowers INTO intspansetlowers_out;

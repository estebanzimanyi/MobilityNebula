CREATE SINK tnpointpositionss_out(tnpointpositionss.id UINT64, r VARSIZED) TYPE File;
SELECT id, TNPOINT_POSITIONS(rid, frac, ts) AS r FROM tnpointpositionss INTO tnpointpositionss_out;

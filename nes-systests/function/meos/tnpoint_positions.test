# name: MEOS_TNPOINT_POSITIONS
# description: tnpoint_positions — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tnpointpositionss(id UINT64, rid INT64, frac FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tnpointpositionss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

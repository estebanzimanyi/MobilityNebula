# name: MEOS_TEXTCAT_TEXTSET_TEXT
# description: textcat_textset_text — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textcattextsettexts(id UINT64, ts1 VARSIZED, t2 VARSIZED);
CREATE PHYSICAL SOURCE FOR textcattextsettexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB"}'|'XYZ'
2|'{"CC"}'|'DD'

CREATE SINK textcattextsettexts_out(textcattextsettexts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXTCAT_TEXTSET_TEXT(ts1, t2) AS r FROM textcattextsettexts INTO textcattextsettexts_out;
----
1,{"AAAXYZ","BBBXYZ"}
2,{"CCDD"}

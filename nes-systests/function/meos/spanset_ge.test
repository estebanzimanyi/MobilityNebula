# name: MEOS_SPANSET_GE
# description: spanset_ge — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spansetges(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR spansetges TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|'{[1, 5), [10, 15)}'
2|'{[3, 7)}'|'{[3, 7)}'

CREATE SINK spansetges_out(spansetges.id UINT64, r INT32) TYPE File;
SELECT id, SPANSET_GE(a, b) AS r FROM spansetges INTO spansetges_out;
----
1,1
2,1

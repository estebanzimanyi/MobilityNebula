# name: MEOS_SET_LT
# description: set_lt — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE setlts(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR setlts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|'{1, 3, 5}'
2|'{3, 5, 9}'|'{3, 5, 9}'

CREATE SINK setlts_out(setlts.id UINT64, r INT32) TYPE File;
SELECT id, SET_LT(a, b) AS r FROM setlts INTO setlts_out;
----
1,0
2,0

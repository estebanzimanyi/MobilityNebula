# name: MEOS_INTERSECTION_INT_SET
# description: intersection_int_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectionintsets(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR intersectionintsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{2, 4, 6}'|4

CREATE SINK intersectionintsets_out(intersectionintsets.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERSECTION_INT_SET(a, b) AS r FROM intersectionintsets INTO intersectionintsets_out;

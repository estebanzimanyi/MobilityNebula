# name: MEOS_CBUFFERARR_TO_GEOM_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE cag(gid UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR cag TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(0101000020E40E0000A08DCEF25B9E4C40CAB8AFD95FDC58C0,1.075729370117223)'|1609459200
1|'Cbuffer(0101000020E40E000066C5829E455945C0E8082FC8D3252640,7.250194549560689)'|1609459201

CREATE SINK cag_out(cag.gid UINT64, cag.r VARSIZED) TYPE File;
SELECT gid, CBUFFERARR_TO_GEOM(value, ts) AS r FROM cag GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO cag_out;

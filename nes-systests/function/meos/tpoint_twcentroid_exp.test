# name: MEOS_TpointTwcentroidExp_Aggregation
# description: Windowed tgeompoint mini-trip grown on the in-process expandable Temporal* (appendInstant); TPOINT_TWCENTROID emits a geometry value as canonical hex-EWKB.
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, Aggregation]
CREATE LOGICAL SOURCE tptw(vehicle_id UINT64, lon FLOAT64, lat FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR tptw TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200
1|4.3700|50.6500|1609459201
1|4.3750|50.6550|1609459202

CREATE SINK tptw_out(tptw.vehicle_id UINT64, tptw.twc VARSIZED) TYPE File;
SELECT vehicle_id, TPOINT_TWCENTROID(lon, lat, timestamp) AS twc FROM tptw GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO tptw_out;

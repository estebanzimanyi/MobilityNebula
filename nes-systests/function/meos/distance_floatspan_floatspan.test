# name: MEOS_DISTANCE_FLOATSPAN_FLOATSPAN
# description: distance_floatspan_floatspan — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancefloatspanfs(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR distancefloatspanfs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'|'[1.5, 5.5)'
2|'[3.5, 9.5)'|'[3.5, 9.5)'

CREATE SINK distancefloatspanfs_out(distancefloatspanfs.id UINT64, r FLOAT64) TYPE File;
SELECT id, DISTANCE_FLOATSPAN_FLOATSPAN(a, b) AS r FROM distancefloatspanfs INTO distancefloatspanfs_out;
----
1,0.0
2,0.0

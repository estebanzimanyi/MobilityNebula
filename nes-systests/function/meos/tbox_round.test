# name: MEOS_TBOX_ROUND
# description: tbox_round — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxrounds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxrounds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'

CREATE SINK tboxrounds_out(tboxrounds.id UINT64, r VARSIZED) TYPE File;
SELECT id, TBOX_ROUND(a) AS r FROM tboxrounds INTO tboxrounds_out;
----
1,TBOXFLOAT XT([1, 5],[2020-01-01 00:00:00+00, 2020-01-05 00:00:00+00])
2,TBOXFLOAT XT([3, 7],[2020-01-03 00:00:00+00, 2020-01-07 00:00:00+00])

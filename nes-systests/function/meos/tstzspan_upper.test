# name: MEOS_TSTZSPAN_UPPER
# description: tstzspan_upper — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzspanuppers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzspanuppers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)'
2|'[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)'

CREATE SINK tstzspanuppers_out(tstzspanuppers.id UINT64, r INT64) TYPE File;
SELECT id, TSTZSPAN_UPPER(a) AS r FROM tstzspanuppers INTO tstzspanuppers_out;

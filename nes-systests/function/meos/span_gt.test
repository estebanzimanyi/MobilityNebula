# name: MEOS_SPAN_GT
# description: span_gt — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spangts(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR spangts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|'[1, 5)'
2|'[3, 9)'|'[3, 9)'

CREATE SINK spangts_out(spangts.id UINT64, r INT32) TYPE File;
SELECT id, SPAN_GT(a, b) AS r FROM spangts INTO spangts_out;
----
1,0
2,0

# name: MEOS_OVERBEFORE_SPAN_DATE
# description: overbefore_span_date — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overbeforespandates(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR overbeforespandates TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01, 2020-01-10)'|'2020-01-03'
2|'[2020-01-05, 2020-01-20)'|'2020-06-15'

CREATE SINK overbeforespandates_out(overbeforespandates.id UINT64, r INT32) TYPE File;
SELECT id, OVERBEFORE_SPAN_DATE(a, b) AS r FROM overbeforespandates INTO overbeforespandates_out;
----
1,0
2,1

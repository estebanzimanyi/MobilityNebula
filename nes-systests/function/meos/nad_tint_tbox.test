# name: MEOS_NAD_TINT_TBOX
# groups: [Function, MEOS, Codegen]
CREATE LOGICAL SOURCE ntb(id UINT64, value INT32, ts UINT64);
CREATE PHYSICAL SOURCE FOR ntb TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|10|1609459200
2|3|1609459200

CREATE SINK ntb_out(ntb.id UINT64, r INT32) TYPE File;
SELECT id, NAD_TINT_TBOX(value, ts, 'TBOXINT X([1, 5])') AS r FROM ntb INTO ntb_out;

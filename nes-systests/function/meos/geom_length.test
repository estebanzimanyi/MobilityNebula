# name: MEOS_GEOM_LENGTH
# description: geom_length — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomlengths(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geomlengths TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(1 1, 2 2)'
2|'SRID=4326;Linestring(3 3, 4 4, 5 5)'

CREATE SINK geomlengths_out(geomlengths.id UINT64, r FLOAT64) TYPE File;
SELECT id, GEOM_LENGTH(a) AS r FROM geomlengths INTO geomlengths_out;
----
1,1.414214
2,2.828427

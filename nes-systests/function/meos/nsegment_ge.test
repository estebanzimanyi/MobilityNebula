# name: MEOS_NSEGMENT_GE
# description: nsegment_ge — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE nsegmentges(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR nsegmentges TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NSegment(1, 0.2, 0.8)'|'NSegment(1, 0.5, 0.7)'
2|'NSegment(1, 0.5, 0.7)'|'NSegment(1, 0.2, 0.8)'

CREATE SINK nsegmentges_out(nsegmentges.id UINT64, r INT32) TYPE File;
SELECT id, NSEGMENT_GE(a, b) AS r FROM nsegmentges INTO nsegmentges_out;
----
1,0
2,1

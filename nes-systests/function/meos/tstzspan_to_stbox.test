# name: MEOS_TSTZSPAN_TO_STBOX
# description: tstzspan_to_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzspantostboxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzspantostboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)'
2|'[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)'

CREATE SINK tstzspantostboxs_out(tstzspantostboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, TSTZSPAN_TO_STBOX(a) AS r FROM tstzspantostboxs INTO tstzspantostboxs_out;
----
1,STBOX T([2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00))
2,STBOX T([2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00))

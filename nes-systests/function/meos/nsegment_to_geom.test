# name: MEOS_NSEGMENT_TO_GEOM
# description: nsegment_to_geom — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE nsegmenttogeoms(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR nsegmenttogeoms TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NSegment(1, 0.2, 0.8)'
2|'NSegment(1, 0.5, 0.7)'

CREATE SINK nsegmenttogeoms_out(nsegmenttogeoms.id UINT64, r VARSIZED) TYPE File;
SELECT id, NSEGMENT_TO_GEOM(a) AS r FROM nsegmenttogeoms INTO nsegmenttogeoms_out;

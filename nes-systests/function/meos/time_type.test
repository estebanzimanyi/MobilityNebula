# name: MEOS_TIME_TYPE
# description: time_type — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE timetypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR timetypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 20)'
2|'[3, 25)'

CREATE SINK timetypes_out(timetypes.id UINT64, r INT32) TYPE File;
SELECT id, TIME_TYPE(a) AS r FROM timetypes INTO timetypes_out;
----
1,0
2,0

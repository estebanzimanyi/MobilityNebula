# name: MEOS_TTEXT_START_VALUE
# description: ttext_start_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE ttextstartvalues(id UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR ttextstartvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200
2|'DEF'|1609545600

CREATE SINK ttextstartvalues_out(ttextstartvalues.id UINT64, r VARSIZED) TYPE File;
SELECT id, TTEXT_START_VALUE(value, ts) AS r FROM ttextstartvalues INTO ttextstartvalues_out;
----
1,"ABC"
2,"DEF"

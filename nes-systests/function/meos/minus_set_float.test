# name: MEOS_MINUS_SET_FLOAT
# description: minus_set_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minussetfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR minussetfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|3.5
2|'{3.5, 5.5, 9.5}'|7.5

CREATE SINK minussetfloats_out(minussetfloats.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_SET_FLOAT(a, b) AS r FROM minussetfloats INTO minussetfloats_out;
----
1,{1.5,5.5}
2,{3.5,5.5,9.5}

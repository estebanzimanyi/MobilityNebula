# name: MEOS_LEFT_FLOAT_SET
# description: left_float_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE leftfloatsets(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR leftfloatsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|3.5
2|'{3.5, 5.5, 9.5}'|7.5

CREATE SINK leftfloatsets_out(leftfloatsets.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_FLOAT_SET(a, b) AS r FROM leftfloatsets INTO leftfloatsets_out;
----
1,0
2,0

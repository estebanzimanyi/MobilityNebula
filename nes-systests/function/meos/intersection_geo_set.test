# name: MEOS_INTERSECTION_GEO_SET
# description: intersection_geo_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectiongeosets(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR intersectiongeosets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Point(1 1)", "Point(2 2)"}'|'Point(1 1)'
2|'{"Point(3 3)", "Point(4 4)"}'|'Point(3 3)'

CREATE SINK intersectiongeosets_out(intersectiongeosets.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERSECTION_GEO_SET(a, arg) AS r FROM intersectiongeosets INTO intersectiongeosets_out;
----
1,{"POINT(1 1)"}
2,{"POINT(3 3)"}

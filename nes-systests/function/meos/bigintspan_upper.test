# name: MEOS_BIGINTSPAN_UPPER
# description: bigintspan_upper — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE bigintspanuppers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR bigintspanuppers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'
2|'[3, 9)'

CREATE SINK bigintspanuppers_out(bigintspanuppers.id UINT64, r INT64) TYPE File;
SELECT id, BIGINTSPAN_UPPER(a) AS r FROM bigintspanuppers INTO bigintspanuppers_out;
----
1,5
2,9

# name: MEOS_CBUFFERSET_MAKE_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE cbsm(gid UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR cbsm TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(0101000020E40E0000A08DCEF25B9E4C40CAB8AFD95FDC58C0,1.075729370117223)'|1609459200
1|'Cbuffer(0101000020E40E000066C5829E455945C0E8082FC8D3252640,7.250194549560689)'|1609459201

CREATE SINK cbsm_out(cbsm.gid UINT64, cbsm.r VARSIZED) TYPE File;
SELECT gid, CBUFFERSET_MAKE(value, ts) AS r FROM cbsm GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO cbsm_out;

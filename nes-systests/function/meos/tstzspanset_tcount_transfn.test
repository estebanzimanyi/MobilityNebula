# name: MEOS_TSTZSPANSET_TCOUNT_TRANSFN
# description: Windowed TSTZSPANSET_TCOUNT_TRANSFN -> aggregate Temporal (hex-WKB) via the per-op SkipList tagg transfn; VARSIZED value, timestamp windowing-only.
# groups: [Function, MEOS, Aggregation]
CREATE LOGICAL SOURCE ctssc(vehicle_id UINT64, value VARSIZED, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR ctssc TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|{[2020-01-01 00:00:00+00, 2020-01-01 01:00:00+00)}|1609459200
1|{[2020-01-01 02:00:00+00, 2020-01-01 03:00:00+00)}|1609462800

CREATE SINK ctssc_out(ctssc.vehicle_id UINT64, ctssc.r VARSIZED) TYPE File;
SELECT vehicle_id, TSTZSPANSET_TCOUNT_TRANSFN(value, timestamp) AS r FROM ctssc GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO ctssc_out;

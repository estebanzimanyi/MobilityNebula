# name: MEOS_UNION_DATE_SET
# description: union_date_set value-mixed set/span/spanset algebra.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE uniondateset(id UINT64, lit VARSIZED, val INT32);
CREATE PHYSICAL SOURCE FOR uniondateset TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01, 2020-01-05}'|7307

CREATE SINK uniondateset_out(uniondateset.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_DATE_SET(lit, val) AS r FROM uniondateset INTO uniondateset_out;
----
1,{2020-01-01,2020-01-03,2020-01-05}

# name: MEOS_DISTANCE_SET_FLOAT
# description: distance_set_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancesetfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR distancesetfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|3.5
2|'{3.5, 5.5, 9.5}'|7.5

CREATE SINK distancesetfloats_out(distancesetfloats.id UINT64, r FLOAT64) TYPE File;
SELECT id, DISTANCE_SET_FLOAT(a, b) AS r FROM distancesetfloats INTO distancesetfloats_out;
----
1,0.0
2,0.0

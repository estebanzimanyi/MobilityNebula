# name: MEOS_OVERRIGHT_INT_SPAN
# description: overright_int_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overrightintspans(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR overrightintspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK overrightintspans_out(overrightintspans.id UINT64, r INT32) TYPE File;
SELECT id, OVERRIGHT_INT_SPAN(a, b) AS r FROM overrightintspans INTO overrightintspans_out;
----
1,1
2,1

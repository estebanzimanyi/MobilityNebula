# name: MEOS_CONTAINED_FLOAT_SPANSET
# description: contained_float_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containedfloatspans(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR containedfloatspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'|3.5
2|'{[3.5, 7.5)}'|7.5

CREATE SINK containedfloatspans_out(containedfloatspans.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_FLOAT_SPANSET(a, b) AS r FROM containedfloatspans INTO containedfloatspans_out;
----
1,1
2,0

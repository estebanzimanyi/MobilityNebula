# name: MEOS_UNION_SPAN_SPAN
# description: union_span_span over two text literals; type-generic MEOS set-algebra returning the result span/set/spanset text (VARSIZED).
# groups: [Function, MEOS, Span, Codegen]
CREATE LOGICAL SOURCE uspn(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR uspn TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|'[3, 9)'
2|'[2, 8)'|'[4, 6)'

CREATE SINK uspn_out(uspn.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_SPAN_SPAN(a, b) AS r FROM uspn INTO uspn_out;
----
1,{[1,9)}
2,{[2,8)}

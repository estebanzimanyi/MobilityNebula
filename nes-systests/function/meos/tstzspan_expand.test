# name: MEOS_TSTZSPAN_EXPAND
# description: tstzspan_expand — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzspanexpands(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzspanexpands TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)'|'1 day'
2|'[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)'|'2 days 3 hours'

CREATE SINK tstzspanexpands_out(tstzspanexpands.id UINT64, r VARSIZED) TYPE File;
SELECT id, TSTZSPAN_EXPAND(a, arg) AS r FROM tstzspanexpands INTO tstzspanexpands_out;
----
1,[2019-12-31,00:00:00+00,2020-01-11,00:00:00+00)
2,[2020-01-02,21:00:00+00,2020-01-22,03:00:00+00)

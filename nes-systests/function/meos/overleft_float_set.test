# name: MEOS_OVERLEFT_FLOAT_SET
# description: overleft_float_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overleftfloatsets(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR overleftfloatsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|3.5
2|'{3.5, 5.5, 9.5}'|7.5

CREATE SINK overleftfloatsets_out(overleftfloatsets.id UINT64, r INT32) TYPE File;
SELECT id, OVERLEFT_FLOAT_SET(a, b) AS r FROM overleftfloatsets INTO overleftfloatsets_out;
----
1,1
2,1

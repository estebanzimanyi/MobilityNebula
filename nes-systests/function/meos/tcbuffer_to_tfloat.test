# name: MEOS_TCBUFFER_TO_TFLOAT
# groups: [Function, MEOS, Codegen]
CREATE LOGICAL SOURCE cb2f(id UINT64, lon FLOAT64, lat FLOAT64, radius FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR cb2f TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.0|50.0|10.0|1609459200
2|5.0|51.0|5.0|1609459200

CREATE SINK cb2f_out(cb2f.id UINT64, r FLOAT64) TYPE File;
SELECT id, TCBUFFER_TO_TFLOAT(lon, lat, radius, ts) AS r FROM cb2f INTO cb2f_out;
----
1,10.0
2,5.0

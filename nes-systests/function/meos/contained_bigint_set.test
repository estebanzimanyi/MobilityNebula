# name: MEOS_CONTAINED_BIGINT_SET
# description: contained_bigint_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containedbigintsets(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR containedbigintsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK containedbigintsets_out(containedbigintsets.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_BIGINT_SET(a, b) AS r FROM containedbigintsets INTO containedbigintsets_out;

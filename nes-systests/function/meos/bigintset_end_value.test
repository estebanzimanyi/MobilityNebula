# name: MEOS_BIGINTSET_END_VALUE
# description: bigintset_end_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE bigintsetendvalues(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR bigintsetendvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{3, 5, 9}'

CREATE SINK bigintsetendvalues_out(bigintsetendvalues.id UINT64, r INT64) TYPE File;
SELECT id, BIGINTSET_END_VALUE(a) AS r FROM bigintsetendvalues INTO bigintsetendvalues_out;
----
1,5
2,9

# name: MEOS_TEMPORAL_DURATION
# description: temporal_duration — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE temporaldurations(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR temporaldurations TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

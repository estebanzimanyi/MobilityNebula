# name: MEOS_POSE_EQ
# description: pose_eq — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE poseeqs(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR poseeqs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'|'Pose(Point(2 2), 1.0)'
2|'Pose(Point(2 2), 1.0)'|'Pose(Point(1 1), 0.5)'

CREATE SINK poseeqs_out(poseeqs.id UINT64, r INT32) TYPE File;
SELECT id, POSE_EQ(a, b) AS r FROM poseeqs INTO poseeqs_out;
----
1,0
2,0

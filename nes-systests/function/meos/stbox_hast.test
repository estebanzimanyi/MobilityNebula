# name: MEOS_STBOX_HAST
# description: stbox_hast — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxhasts(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxhasts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'
2|'STBOX X((3,3),(7,7))'

CREATE SINK stboxhasts_out(stboxhasts.id UINT64, r BOOLEAN) TYPE File;
SELECT id, STBOX_HAST(a) AS r FROM stboxhasts INTO stboxhasts_out;
----
1,0
2,0

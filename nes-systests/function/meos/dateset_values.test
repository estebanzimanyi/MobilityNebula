# name: MEOS_DATESET_VALUES
# description: dateset_values — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE datesetvaluess(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR datesetvaluess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01, 2020-01-05}'
2|'{2020-01-03, 2020-01-08}'

CREATE SINK datesetvaluess_out(datesetvaluess.id UINT64, r VARSIZED) TYPE File;
SELECT id, DATESET_VALUES(a) AS r FROM datesetvaluess INTO datesetvaluess_out;
----
1,{7305,7309}
2,{7307,7312}

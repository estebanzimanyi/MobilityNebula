# name: MEOS_DATESPANSET_BINS
# description: datespanset_bins — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE datespansetbinss(id UINT64, a VARSIZED, x0 VARSIZED, x1 VARSIZED);
CREATE PHYSICAL SOURCE FOR datespansetbinss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01, 2020-01-10)}'|'1 day'|'2020-01-01'
2|'{[2020-01-05, 2020-01-20)}'|'2 days'|'2020-01-01'

CREATE SINK datespansetbinss_out(datespansetbinss.id UINT64, r VARSIZED) TYPE File;
SELECT id, DATESPANSET_BINS(a, x0, x1) AS r FROM datespansetbinss INTO datespansetbinss_out;

1,{[2020-01-01, 2020-01-02), [2020-01-02, 2020-01-03), [2020-01-03, 2020-01-04), [2020-01-04, 2020-01-05), [2020-01-05, 2020-01-06), [2020-01-06, 2020-01-07), [2020-01-07, 2020-01-08), [2020-01-08, 2020-01-09), [2020-01-09, 2020-01-10)}
2,{[2020-01-05, 2020-01-07), [2020-01-07, 2020-01-09), [2020-01-09, 2020-01-11), [2020-01-11, 2020-01-13), [2020-01-13, 2020-01-15), [2020-01-15, 2020-01-17), [2020-01-17, 2020-01-19), [2020-01-19, 2020-01-20)}

# name: MEOS_BIGINTSPANSET_BINS
# description: bigintspanset_bins — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE bigintspansetbinss(id UINT64, a VARSIZED, x0 INT64, x1 INT64);
CREATE PHYSICAL SOURCE FOR bigintspansetbinss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 20)}'|5|0
2|'{[3, 25)}'|5|0

CREATE SINK bigintspansetbinss_out(bigintspansetbinss.id UINT64, r VARSIZED) TYPE File;
SELECT id, BIGINTSPANSET_BINS(a, x0, x1) AS r FROM bigintspansetbinss INTO bigintspansetbinss_out;
----
1,{[1,5),[5,10),[10,15),[15,20)}
2,{[3,5),[5,10),[10,15),[15,20),[20,25)}

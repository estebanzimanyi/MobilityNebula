# name: MEOS_SPANSET_END_SPAN
# description: spanset_end_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spansetendspans(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spansetendspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'
2|'{[3.5, 7.5)}'

CREATE SINK spansetendspans_out(spansetendspans.id UINT64, r VARSIZED) TYPE File;
SELECT id, SPANSET_END_SPAN(a) AS r FROM spansetendspans INTO spansetendspans_out;
----
1,[10.5,15.5)
2,[3.5,7.5)

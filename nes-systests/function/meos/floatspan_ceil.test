# name: MEOS_FLOATSPAN_CEIL
# description: floatspan_ceil — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspanceils(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatspanceils TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'
2|'[3.5, 9.5)'

CREATE SINK floatspanceils_out(floatspanceils.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSPAN_CEIL(a) AS r FROM floatspanceils INTO floatspanceils_out;
----
1,[2, 6)
2,[4, 10)

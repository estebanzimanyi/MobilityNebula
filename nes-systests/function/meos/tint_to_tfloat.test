# name: MEOS_TINT_TO_TFLOAT
# groups: [Function, MEOS, TemporalNumber, Codegen]
CREATE LOGICAL SOURCE ti2f(id UINT64, value INT32, ts UINT64);
CREATE PHYSICAL SOURCE FOR ti2f TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|3|1609459200
2|10|1609545600

CREATE SINK ti2f_out(ti2f.id UINT64, r FLOAT64) TYPE File;
SELECT id, TINT_TO_TFLOAT(value, ts) AS r FROM ti2f INTO ti2f_out;
----
1,3.0
2,10.0

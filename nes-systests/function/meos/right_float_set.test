# name: MEOS_RIGHT_FLOAT_SET
# description: right_float_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightfloatsets(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR rightfloatsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|3.5
2|'{3.5, 5.5, 9.5}'|7.5

CREATE SINK rightfloatsets_out(rightfloatsets.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_FLOAT_SET(a, b) AS r FROM rightfloatsets INTO rightfloatsets_out;
----
1,0
2,0

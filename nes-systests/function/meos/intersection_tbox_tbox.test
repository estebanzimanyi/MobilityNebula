# name: MEOS_INTERSECTION_TBOX_TBOX
# description: intersection_tbox_tbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectiontboxtbs(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR intersectiontboxtbs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'

CREATE SINK intersectiontboxtbs_out(intersectiontboxtbs.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERSECTION_TBOX_TBOX(a, b) AS r FROM intersectiontboxtbs INTO intersectiontboxtbs_out;
----
1,TBOXFLOAT XT([3, 5],[2020-01-03 00:00:00+00, 2020-01-05 00:00:00+00])
2,TBOXFLOAT XT([3, 5],[2020-01-03 00:00:00+00, 2020-01-05 00:00:00+00])

# name: MEOS_TFLOAT_VALUE_BINS
# description: tfloat_value_bins — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tfloatvaluebinss(id UINT64, value FLOAT64, ts UINT64, x0 FLOAT64, x1 FLOAT64);
CREATE PHYSICAL SOURCE FOR tfloatvaluebinss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200|5.0|0.0
2|8.5|1609545600|5.0|0.0

CREATE SINK tfloatvaluebinss_out(tfloatvaluebinss.id UINT64, r VARSIZED) TYPE File;
SELECT id, TFLOAT_VALUE_BINS(value, ts, x0, x1) AS r FROM tfloatvaluebinss INTO tfloatvaluebinss_out;

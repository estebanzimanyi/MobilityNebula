# name: MEOS_TimestamptzExtent_Aggregation
# description: Windowed TIMESTAMPTZ_EXTENT_TRANSFN — time extent (TSTZSPAN) over an event-time field via timestamptz_extent_transfn (W28 scalar-fold box-output aggregation).
# groups: [Function, MEOS, Time, Aggregation]
CREATE LOGICAL SOURCE te(vehicle_id UINT64, value UINT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR te TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1609459200|1609459200
1|1609459320|1609459320
1|1609459260|1609459260

CREATE SINK te_out(te.vehicle_id UINT64, te.extent VARSIZED) TYPE File;
SELECT vehicle_id, TIMESTAMPTZ_EXTENT_TRANSFN(value, timestamp) AS extent FROM te GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO te_out;
----
1,[2021-01-01 00:00:00+00, 2021-01-01 00:02:00+00]

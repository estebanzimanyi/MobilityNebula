# name: MEOS_GEOM_DWITHIN2D
# description: geom_dwithin2d — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomdwithin2ds(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geomdwithin2ds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(0 0)'|'SRID=4326;Point(1 1)'
2|'SRID=4326;Point(0 0)'|'SRID=4326;Point(0 0)'

CREATE SINK geomdwithin2ds_out(geomdwithin2ds.id UINT64, r INT32) TYPE File;
SELECT id, GEOM_DWITHIN2D(a, arg) AS r FROM geomdwithin2ds INTO geomdwithin2ds_out;
----
1,1
2,1

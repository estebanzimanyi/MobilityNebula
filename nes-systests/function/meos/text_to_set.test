# name: MEOS_TEXT_TO_SET
# description: text_to_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE texttosets(id UINT64, t1 VARSIZED);
CREATE PHYSICAL SOURCE FOR texttosets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'AAA'
2|'BBB'

CREATE SINK texttosets_out(texttosets.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXT_TO_SET(t1) AS r FROM texttosets INTO texttosets_out;
----
1,{"AAA"}
2,{"BBB"}

# name: MEOS_GEOM_INTERSECTS3D
# description: geom_intersects3d — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomintersects3ds(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geomintersects3ds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(0 0, 2 2)'|'SRID=4326;Linestring(0 2, 2 0)'
2|'SRID=4326;Linestring(0 0, 3 3)'|'SRID=4326;Linestring(1 0, 1 3)'

CREATE SINK geomintersects3ds_out(geomintersects3ds.id UINT64, r INT32) TYPE File;
SELECT id, GEOM_INTERSECTS3D(a, arg) AS r FROM geomintersects3ds INTO geomintersects3ds_out;
----
1,1
2,1

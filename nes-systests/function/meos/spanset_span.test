# name: MEOS_SPANSET_SPAN
# description: spanset_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spansetspans(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spansetspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'
2|'{[3.5, 7.5)}'

CREATE SINK spansetspans_out(spansetspans.id UINT64, r VARSIZED) TYPE File;
SELECT id, SPANSET_SPAN(a) AS r FROM spansetspans INTO spansetspans_out;
----
1,[1.5,15.5)
2,[3.5,7.5)

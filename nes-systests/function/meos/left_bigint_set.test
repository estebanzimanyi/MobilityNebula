# name: MEOS_LEFT_BIGINT_SET
# description: left_bigint_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE leftbigintsets(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR leftbigintsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK leftbigintsets_out(leftbigintsets.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_BIGINT_SET(a, b) AS r FROM leftbigintsets INTO leftbigintsets_out;

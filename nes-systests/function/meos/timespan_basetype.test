# name: MEOS_TIMESPAN_BASETYPE
# description: timespan_basetype — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE timespanbasetypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR timespanbasetypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 20)'
2|'[3, 25)'

CREATE SINK timespanbasetypes_out(timespanbasetypes.id UINT64, r INT32) TYPE File;
SELECT id, TIMESPAN_BASETYPE(a) AS r FROM timespanbasetypes INTO timespanbasetypes_out;
----
1,0
2,0

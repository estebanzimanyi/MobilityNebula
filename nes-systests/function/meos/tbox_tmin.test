# name: MEOS_TBOX_TMIN
# description: tbox_tmin — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxtmins(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxtmins TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'

CREATE SINK tboxtmins_out(tboxtmins.id UINT64, r INT64) TYPE File;
SELECT id, TBOX_TMIN(a) AS r FROM tboxtmins INTO tboxtmins_out;
----
1,631152000000000
2,631324800000000

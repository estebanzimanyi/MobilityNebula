# name: MEOS_TEQ_TEXT_TTEXT
# description: teq_text_ttext — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE teqtextttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR teqtextttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'XYZ'
2|'DEF'|1609545600|'XYZ'

CREATE SINK teqtextttexts_out(teqtextttexts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEQ_TEXT_TTEXT(value, ts, arg) AS r FROM teqtextttexts INTO teqtextttexts_out;
----
1,f@2021-01-01,00:00:00+00
2,f@2021-01-02,00:00:00+00

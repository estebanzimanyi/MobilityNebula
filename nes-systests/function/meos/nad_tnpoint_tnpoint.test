# name: MEOS_NAD_TNPOINT_TNPOINT_hex
# description: Per-event nad_tnpoint_tnpoint over two hex-WKB temporals (FLOAT64 nearest-approach distance).
# groups: [Function, MEOS, Npoint, CrossStream, Codegen]
CREATE LOGICAL SOURCE hxsrc(id UINT64, ta VARSIZED, tb VARSIZED);
CREATE PHYSICAL SOURCE FOR hxsrc TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|0133000E0200000003010100000000000000000000000000000000A0AD30CA5A0200010100000000000000000000000000E03F00444107CB5A0200|0133000E02000000030101000000000000009A9999999999C93F00A0AD30CA5A0200010100000000000000666666666666E63F00444107CB5A0200

CREATE SINK hxsrc_out(hxsrc.id UINT64, r FLOAT64) TYPE File;
SELECT id, NAD_TNPOINT_TNPOINT(ta, tb) AS r FROM hxsrc INTO hxsrc_out;

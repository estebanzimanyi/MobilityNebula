# name: MEOS_NSEGMENT_MAKE
# description: nsegment_make — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE nsegmentmakes(id UINT64, value INT64, arg0 FLOAT64, arg1 FLOAT64);
CREATE PHYSICAL SOURCE FOR nsegmentmakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1|0.2|0.8
2|2|0.3|0.9

CREATE SINK nsegmentmakes_out(nsegmentmakes.id UINT64, r VARSIZED) TYPE File;
SELECT id, NSEGMENT_MAKE(value, arg0, arg1) AS r FROM nsegmentmakes INTO nsegmentmakes_out;
----
1,NSegment(1 0.2 0.8)
2,NSegment(2 0.3 0.9)

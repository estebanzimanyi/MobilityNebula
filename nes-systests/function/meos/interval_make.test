# name: MEOS_INTERVAL_MAKE
# description: interval_make — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intervalmakes(id UINT64, value INT32, arg0 INT32, arg1 INT32, arg2 INT32, arg3 INT32, arg4 INT32, arg5 FLOAT64);
CREATE PHYSICAL SOURCE FOR intervalmakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1|2|0|3|4|5|6.5
2|2|3|0|4|5|6|7.5

CREATE SINK intervalmakes_out(intervalmakes.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERVAL_MAKE(value, arg0, arg1, arg2, arg3, arg4, arg5) AS r FROM intervalmakes INTO intervalmakes_out;
----
1,1,year,2,mons,3,days,04:05:06.5
2,2,years,3,mons,4,days,05:06:07.5

# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overleftsetbigints(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR overleftsetbigints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK overleftsetbigints_out(overleftsetbigints.id UINT64, r INT32) TYPE File;
SELECT id, OVERLEFT_SET_BIGINT(a, b) AS r FROM overleftsetbigints INTO overleftsetbigints_out;

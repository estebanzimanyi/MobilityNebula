# name: MEOS_POSE_SET_SRID
# description: POSE_SET_SRID sets the SRID of a pose (a static Pose literal) and returns the result.
# groups: [Function, MEOS, Pose]
CREATE LOGICAL SOURCE posesetsrids(id UINT64, a VARSIZED, arg0 INT32);
CREATE PHYSICAL SOURCE FOR posesetsrids TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1),0.5)'|4326
2|'Pose(Point(2 2),1.0)'|4326

CREATE SINK posesetsrids_out(posesetsrids.id UINT64, r VARSIZED) TYPE File;
SELECT id, POSE_SET_SRID(a, arg0) AS r FROM posesetsrids INTO posesetsrids_out;
----
1,POSE,(0101000020E6100000000000000000F03F000000000000F03F,0.5)
2,POSE,(0101000020E610000000000000000000400000000000000040,1)

# name: MEOS_AddTnumberTnumberCrossVehicle
# description: Cross-vehicle TDISTANCE_TNUMBER_TNUMBER over two per-vehicle tfloat aggregate outputs (each a VARSIZED hex-WKB tfloat), returning the temporal sum as a VARSIZED hex-WKB tfloat. P=1->3, Q=10->20 over the same time -> 11->23.
# groups: [Function, MEOS, TemporalNumber, CrossStream]
CREATE LOGICAL SOURCE tdnn(id UINT64, ta VARSIZED, tb VARSIZED);
CREATE PHYSICAL SOURCE FOR tdnn TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|0121000E0200000003000000000000F03F00A0AD30CA5A020000000000000008408024CC30CA5A0200|0121000E0200000003000000000000244000A0AD30CA5A020000000000000034408024CC30CA5A0200

CREATE SINK tdnn_out(tdnn.id UINT64, r VARSIZED) TYPE File;
SELECT id, TDISTANCE_TNUMBER_TNUMBER(ta, tb) AS r FROM tdnn INTO tdnn_out;

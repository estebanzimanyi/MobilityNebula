# name: MEOS_RIGHT_INT_SPANSET
# description: right_int_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightintspansets(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR rightintspansets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|3
2|'{[3, 7)}'|7

CREATE SINK rightintspansets_out(rightintspansets.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_INT_SPANSET(a, b) AS r FROM rightintspansets INTO rightintspansets_out;
----
1,0
2,1

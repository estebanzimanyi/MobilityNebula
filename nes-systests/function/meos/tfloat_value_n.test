# name: MEOS_TFLOAT_VALUE_N
# description: tfloat_value_n — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tfloatvaluens(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tfloatvaluens TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200
2|8.5|1609545600

CREATE SINK tfloatvaluens_out(tfloatvaluens.id UINT64, r FLOAT64) TYPE File;
SELECT id, TFLOAT_VALUE_N(value, ts) AS r FROM tfloatvaluens INTO tfloatvaluens_out;

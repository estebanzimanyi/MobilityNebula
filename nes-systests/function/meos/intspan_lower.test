# name: MEOS_INTSPAN_LOWER
# description: intspan_lower — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intspanlowers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR intspanlowers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'
2|'[3, 9)'

CREATE SINK intspanlowers_out(intspanlowers.id UINT64, r INT32) TYPE File;
SELECT id, INTSPAN_LOWER(a) AS r FROM intspanlowers INTO intspanlowers_out;
----
1,1
2,3

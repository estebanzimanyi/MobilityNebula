CREATE LOGICAL SOURCE tspatialtransforms(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tspatialtransforms TYPE File SET('|' AS PARSER.FIELD_DELIMITER);

# name: MEOS_LEFT_SET_FLOAT
# description: left_set_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE leftsetfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR leftsetfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|3.5
2|'{3.5, 5.5, 9.5}'|7.5

CREATE SINK leftsetfloats_out(leftsetfloats.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_SET_FLOAT(a, b) AS r FROM leftsetfloats INTO leftsetfloats_out;
----
1,0
2,0

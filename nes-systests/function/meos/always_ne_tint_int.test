# name: MEOS_ALWAYS_NE_TINT_INT
# groups: [Function, MEOS, TemporalNumber, Comparison, Codegen]
CREATE LOGICAL SOURCE tii01(id UINT64, value INT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tii01 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

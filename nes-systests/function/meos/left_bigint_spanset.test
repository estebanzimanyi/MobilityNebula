# name: MEOS_LEFT_BIGINT_SPANSET
# description: left_bigint_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE leftbigintspansets(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR leftbigintspansets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|3
2|'{[3, 7)}'|7

CREATE SINK leftbigintspansets_out(leftbigintspansets.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_BIGINT_SPANSET(a, b) AS r FROM leftbigintspansets INTO leftbigintspansets_out;

# name: MEOS_CBUFFER_TO_GEOM
# description: cbuffer_to_geom — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbuffertogeoms(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR cbuffertogeoms TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'
2|'Cbuffer(Point(2 2),0.5)'

CREATE SINK cbuffertogeoms_out(cbuffertogeoms.id UINT64, r VARSIZED) TYPE File;
SELECT id, CBUFFER_TO_GEOM(a) AS r FROM cbuffertogeoms INTO cbuffertogeoms_out;
----
1,010A000000010000000108000000030000000000000000000000000000000000F03F0000000000000040000000000000F03F0000000000000000000000000000F03F
2,010A00000001000000010800000003000000000000000000F83F000000000000004000000000000004400000000000000040000000000000F83F0000000000000040

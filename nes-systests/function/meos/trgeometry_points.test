# name: MEOS_TRGEOMETRY_POINTS
# description: trgeometry_points — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE trgeometrypointss(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR trgeometrypointss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|0.0|0.0|0.0|1609459200
2|1.0|1.0|0.5|1609545600

CREATE SINK trgeometrypointss_out(trgeometrypointss.id UINT64, r VARSIZED) TYPE File;
SELECT id, TRGEOMETRY_POINTS(x, y, theta, ts) AS r FROM trgeometrypointss INTO trgeometrypointss_out;

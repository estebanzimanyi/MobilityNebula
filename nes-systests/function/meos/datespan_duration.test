# name: MEOS_DATESPAN_DURATION
# description: datespan_duration — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE datespandurations(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR datespandurations TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01, 2020-01-10)'
2|'[2020-01-05, 2020-01-20)'

CREATE SINK datespandurations_out(datespandurations.id UINT64, r VARSIZED) TYPE File;
SELECT id, DATESPAN_DURATION(a) AS r FROM datespandurations INTO datespandurations_out;
----
1,9,days
2,15,days

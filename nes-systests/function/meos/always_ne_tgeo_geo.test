# name: function/spatiotemporal/MEOS_EDisjoint_Temporal_Geometry_Static_Geometry.test
# description: Per-event ever-r between a single-instant tgeompoint built from event fields and a static geometry. Exercises the 4-arg one-temporal-point codegen shape (W1).
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, StaticGeometry, EDisjoint, Codegen]

CREATE LOGICAL SOURCE eqgg1(id UINT32, lon FLOAT64, lat FLOAT64, timestamp UINT64, geom_wkt VARSIZED);
CREATE PHYSICAL SOURCE FOR eqgg1 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200|'SRID=4326;POINT(4.3658 50.6456)'
2|4.1000|50.8000|1609459200|'SRID=4326;POINT(4.3658 50.6456)'

CREATE SINK er_results(eqgg1.id UINT32, r INT32) TYPE File;
SELECT id,
       ALWAYS_NE_TGEO_GEO(lon, lat, timestamp, geom_wkt) AS r
FROM eqgg1
INTO er_results;
----
1,0
2,1

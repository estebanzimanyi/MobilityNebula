# name: MEOS_ALWAYS_EQ_TBOOL_BOOL
# groups: [Function, MEOS, TemporalBoolean, Comparison, Codegen]
CREATE LOGICAL SOURCE tbfeq(id UINT64, value BOOLEAN, ts UINT64, flag BOOLEAN);
CREATE PHYSICAL SOURCE FOR tbfeq TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|true|1609459200|true
2|false|1609545600|true

CREATE SINK tbfeq_out(tbfeq.id UINT64, r INT32) TYPE File;
SELECT id, ALWAYS_EQ_TBOOL_BOOL(value, ts, flag) AS r FROM tbfeq INTO tbfeq_out;
----
1,1
2,0

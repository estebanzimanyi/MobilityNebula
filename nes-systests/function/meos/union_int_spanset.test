# name: MEOS_UNION_INT_SPANSET
# description: union_int_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionintspansets(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR unionintspansets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|3
2|'{[3, 7)}'|7

CREATE SINK unionintspansets_out(unionintspansets.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_INT_SPANSET(a, b) AS r FROM unionintspansets INTO unionintspansets_out;

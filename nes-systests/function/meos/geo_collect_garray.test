# name: MEOS_GEO_COLLECT_GARRAY_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE gcg(gid UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR gcg TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'010100000000004C0AC9B24E400000D8DE3D984340'|1609459200
1|'01010000000000902F231C4540000052BBD7545640'|1609459201

CREATE SINK gcg_out(gcg.gid UINT64, gcg.r VARSIZED) TYPE File;
SELECT gid, GEO_COLLECT_GARRAY(value, ts) AS r FROM gcg GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO gcg_out;

# name: MEOS_EverNeTnpointTnpointCrossVehicle
# description: Cross-vehicle EVER_NE_TNPOINT_TNPOINT over two per-vehicle tnpoint aggregate outputs (each a VARSIZED hex-WKB tnpoint). A=NPoint(1,0.5..0.7); C=NPoint(2,0.3..0.4) (different route). ever_ne(A,A)=0, ever_ne(A,C)=1.
# groups: [Function, MEOS, TemporalNetworkPoint, CrossStream]
CREATE LOGICAL SOURCE evn(id UINT64, ta VARSIZED, tb VARSIZED);
CREATE PHYSICAL SOURCE FOR evn TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|0133000E0200000003010100000000000000000000000000E03F00A0AD30CA5A0200010100000000000000666666666666E63F8024CC30CA5A0200|0133000E0200000003010100000000000000000000000000E03F00A0AD30CA5A0200010100000000000000666666666666E63F8024CC30CA5A0200
2|0133000E0200000003010100000000000000000000000000E03F00A0AD30CA5A0200010100000000000000666666666666E63F8024CC30CA5A0200|0133000E0200000003010200000000000000333333333333D33F00A0AD30CA5A02000102000000000000009A9999999999D93F8024CC30CA5A0200

CREATE SINK evn_out(evn.id UINT64, r INT32) TYPE File;
SELECT id, EVER_NE_TNPOINT_TNPOINT(ta, tb) AS r FROM evn INTO evn_out;
----
1,0
2,1

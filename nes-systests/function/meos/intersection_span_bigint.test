CREATE LOGICAL SOURCE intersectionspanbis(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR intersectionspanbis TYPE File SET('|' AS PARSER.FIELD_DELIMITER);

# name: MEOS_TBOX_HASH_EXTENDED
# description: tbox_hash_extended — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxhashextendeds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxhashextendeds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 3],[2020-01-01, 2020-01-02])'
2|'TBOXFLOAT XT([2, 4],[2020-01-03, 2020-01-04])'

CREATE SINK tboxhashextendeds_out(tboxhashextendeds.id UINT64, r INT64) TYPE File;
SELECT id, TBOX_HASH_EXTENDED(a) AS r FROM tboxhashextendeds INTO tboxhashextendeds_out;
----
1,-703652632721270619
2,-3958039083580713737

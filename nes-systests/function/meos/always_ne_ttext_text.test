CREATE LOGICAL SOURCE alwaysnettexttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR alwaysnettexttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

# name: MEOS_OVERRIGHT_SET_TEXT
# description: overright_set_text — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overrightsettexts(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR overrightsettexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'|'AAA'
2|'{"BBB", "DDD"}'|'BBB'

CREATE SINK overrightsettexts_out(overrightsettexts.id UINT64, r INT32) TYPE File;
SELECT id, OVERRIGHT_SET_TEXT(a, arg) AS r FROM overrightsettexts INTO overrightsettexts_out;
----
1,1
2,1

# name: MEOS_FLOATSET_TO_INTSET
# description: floatset_to_intset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatsettointsets(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatsettointsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'
2|'{3.5, 5.5, 9.5}'

CREATE SINK floatsettointsets_out(floatsettointsets.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSET_TO_INTSET(a) AS r FROM floatsettointsets INTO floatsettointsets_out;
----
1,{1,3,5}
2,{3,5,9}

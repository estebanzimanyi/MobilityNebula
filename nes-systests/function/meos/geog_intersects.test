# name: MEOS_GEOG_INTERSECTS
# description: geog_intersects — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geogintersectss(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geogintersectss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(0 0)'|'SRID=4326;Point(1 1)'
2|'SRID=4326;Point(0 0)'|'SRID=4326;Point(0 0)'

CREATE SINK geogintersectss_out(geogintersectss.id UINT64, r INT32) TYPE File;
SELECT id, GEOG_INTERSECTS(a, arg) AS r FROM geogintersectss INTO geogintersectss_out;
----
1,0
2,1

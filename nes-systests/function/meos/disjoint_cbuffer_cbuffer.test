# name: MEOS_DISJOINT_CBUFFER_CBUFFER
# description: disjoint_cbuffer_cbuffer — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE disjointcbuffercbus(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR disjointcbuffercbus TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'|'Cbuffer(Point(2 2),0.5)'
2|'Cbuffer(Point(2 2),0.5)'|'Cbuffer(Point(1 1),1.0)'

CREATE SINK disjointcbuffercbus_out(disjointcbuffercbus.id UINT64, r INT32) TYPE File;
SELECT id, DISJOINT_CBUFFER_CBUFFER(a, b) AS r FROM disjointcbuffercbus INTO disjointcbuffercbus_out;
----
1,0
2,0

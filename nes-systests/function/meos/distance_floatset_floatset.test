# name: MEOS_DISTANCE_FLOATSET_FLOATSET
# description: distance_floatset_floatset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancefloatsetfls(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR distancefloatsetfls TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|'{1.5, 3.5, 5.5}'
2|'{3.5, 5.5, 9.5}'|'{3.5, 5.5, 9.5}'

CREATE SINK distancefloatsetfls_out(distancefloatsetfls.id UINT64, r FLOAT64) TYPE File;
SELECT id, DISTANCE_FLOATSET_FLOATSET(a, b) AS r FROM distancefloatsetfls INTO distancefloatsetfls_out;
----
1,0.0
2,0.0

CREATE SINK eqtt1_out(eqtt1.id UINT32, r INT32) TYPE File;
SELECT id, ALWAYS_NE_TGEO_TGEO(lonA, latA, tsA, lonB, latB, tsB) AS r FROM eqtt1 INTO eqtt1_out;

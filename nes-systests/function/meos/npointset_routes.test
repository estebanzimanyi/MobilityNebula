# name: MEOS_NPOINTSET_ROUTES
# description: npointset_routes — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointsetroutess(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR npointsetroutess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Npoint(1,0.5)", "Npoint(2,0.5)"}'
2|'{"Npoint(1,0.7)", "Npoint(3,0.5)"}'

CREATE SINK npointsetroutess_out(npointsetroutess.id UINT64, r VARSIZED) TYPE File;
SELECT id, NPOINTSET_ROUTES(a) AS r FROM npointsetroutess INTO npointsetroutess_out;
----
1,{1, 2}
2,{1, 3}

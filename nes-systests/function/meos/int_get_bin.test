# name: MEOS_INT_GET_BIN
# description: int_get_bin — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intgetbins(id UINT64, value INT32, arg0 INT32, arg1 INT32);
CREATE PHYSICAL SOURCE FOR intgetbins TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|7|5|0
2|12|5|0

CREATE SINK intgetbins_out(intgetbins.id UINT64, r INT32) TYPE File;
SELECT id, INT_GET_BIN(value, arg0, arg1) AS r FROM intgetbins INTO intgetbins_out;
----
1,5
2,10

# name: MEOS_TEXTSET_VALUE_N
# description: textset_value_n — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textsetvaluens(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR textsetvaluens TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'
2|'{"BBB", "DDD"}'

CREATE SINK textsetvaluens_out(textsetvaluens.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXTSET_VALUE_N(a) AS r FROM textsetvaluens INTO textsetvaluens_out;
----
1,"AAA"
2,"BBB"

# name: MEOS_TBOX_LE
# description: tbox_le — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxles(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxles TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'

CREATE SINK tboxles_out(tboxles.id UINT64, r INT32) TYPE File;
SELECT id, TBOX_LE(a, b) AS r FROM tboxles INTO tboxles_out;
----
1,1
2,0

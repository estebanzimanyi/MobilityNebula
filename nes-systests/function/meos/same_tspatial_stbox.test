# name: MEOS_SAME_TSPATIAL_STBOX
# groups: [Function, MEOS, SpatioTemporal, Box, Codegen]
CREATE LOGICAL SOURCE tsb20(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tsb20 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200
2|2.0|2.0|1577836800

CREATE SINK tsb20_out(tsb20.id UINT64, r BOOLEAN) TYPE File;
SELECT id, SAME_TSPATIAL_STBOX(lon, lat, ts, 'SRID=4326;STBOX XT(((1,1),(3,3)),[2020-01-01,2020-01-02])') AS r FROM tsb20 INTO tsb20_out;
----
1,0
2,0

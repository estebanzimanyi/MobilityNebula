# name: MEOS_NPOINT_HASH
# description: npoint_hash — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointhashs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR npointhashs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NPoint(1, 0.5)'
2|'NPoint(1, 0.7)'

CREATE SINK npointhashs_out(npointhashs.id UINT64, r INT32) TYPE File;
SELECT id, NPOINT_HASH(a) AS r FROM npointhashs INTO npointhashs_out;
----
1,443333991
2,2111056230

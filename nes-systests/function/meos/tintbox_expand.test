# name: MEOS_TINTBOX_EXPAND
# description: tintbox_expand — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tintboxexpands(id UINT64, box VARSIZED, dist INT32);
CREATE PHYSICAL SOURCE FOR tintboxexpands TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXINT XT([1, 5],[2020-01-01, 2020-01-05])'|1
2|'TBOXINT XT([3, 7],[2020-01-03, 2020-01-07])'|2

CREATE SINK tintboxexpands_out(tintboxexpands.id UINT64, r VARSIZED) TYPE File;
SELECT id, TINTBOX_EXPAND(box, dist) AS r FROM tintboxexpands INTO tintboxexpands_out;
----
1,TBOXINT,XT([0,7),[2020-01-01,00:00:00+00,2020-01-05,00:00:00+00])
2,TBOXINT,XT([1,10),[2020-01-03,00:00:00+00,2020-01-07,00:00:00+00])

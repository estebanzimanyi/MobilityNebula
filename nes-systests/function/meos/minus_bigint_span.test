# name: MEOS_MINUS_BIGINT_SPAN
# description: minus_bigint_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minusbigintspans(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR minusbigintspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|7
2|'[10, 15)'|2

CREATE SINK minusbigintspans_out(minusbigintspans.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_BIGINT_SPAN(a, b) AS r FROM minusbigintspans INTO minusbigintspans_out;

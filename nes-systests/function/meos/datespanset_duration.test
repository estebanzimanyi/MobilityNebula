# name: MEOS_DATESPANSET_DURATION
# description: datespanset_duration — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE datespansetduratios(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR datespansetduratios TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01, 2020-01-10)}'
2|'{[2020-01-05, 2020-01-20)}'

CREATE SINK datespansetduratios_out(datespansetduratios.id UINT64, r VARSIZED) TYPE File;
SELECT id, DATESPANSET_DURATION(a) AS r FROM datespansetduratios INTO datespansetduratios_out;
----
1,9,days
2,15,days

# name: MEOS_POSESET_VALUE_N
# description: poseset_value_n — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posesetvaluens(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR posesetvaluens TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Pose(Point(1 1),0.5)", "Pose(Point(2 2),1.0)"}'
2|'{"Pose(Point(3 3),0.3)", "Pose(Point(4 4),0.5)"}'

CREATE SINK posesetvaluens_out(posesetvaluens.id UINT64, r VARSIZED) TYPE File;
SELECT id, POSESET_VALUE_N(a) AS r FROM posesetvaluens INTO posesetvaluens_out;
----
1,POSE (010100000000000000000000400000000000000040, 1)
2,POSE (010100000000000000000008400000000000000840, 0.3)

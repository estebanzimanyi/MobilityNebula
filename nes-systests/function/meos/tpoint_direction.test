# name: MEOS_TPOINT_DIRECTION_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE tpd(gid UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tpd TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200
1|2.0|2.0|1609459201
1|3.0|3.0|1609459202
2|5.0|5.0|1609459200
2|6.0|6.0|1609459201

CREATE SINK tpd_out(tpd.gid UINT64, tpd.r FLOAT64) TYPE File;
SELECT gid, TPOINT_DIRECTION(lon, lat, ts) AS r FROM tpd GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tpd_out;

# name: MEOS_SPANSET_GT
# description: spanset_gt — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spansetgts(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR spansetgts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|'{[1, 5), [10, 15)}'
2|'{[3, 7)}'|'{[3, 7)}'

CREATE SINK spansetgts_out(spansetgts.id UINT64, r INT32) TYPE File;
SELECT id, SPANSET_GT(a, b) AS r FROM spansetgts INTO spansetgts_out;
----
1,0
2,0

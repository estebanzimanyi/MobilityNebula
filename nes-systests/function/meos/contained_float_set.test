# name: MEOS_CONTAINED_FLOAT_SET
# description: contained_float_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containedfloatsets(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR containedfloatsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|3.5
2|'{3.5, 5.5, 9.5}'|7.5

CREATE SINK containedfloatsets_out(containedfloatsets.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_FLOAT_SET(a, b) AS r FROM containedfloatsets INTO containedfloatsets_out;
----
1,1
2,0

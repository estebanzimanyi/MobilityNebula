# name: MEOS_NPOINT_LE
# description: npoint_le — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointles(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR npointles TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NPoint(1, 0.5)'|'NPoint(1, 0.7)'
2|'NPoint(1, 0.7)'|'NPoint(1, 0.5)'

CREATE SINK npointles_out(npointles.id UINT64, r INT32) TYPE File;
SELECT id, NPOINT_LE(a, b) AS r FROM npointles INTO npointles_out;
----
1,1
2,0

# name: MEOS_SET_BASETYPE
# description: set_basetype — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE setbasetypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR setbasetypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{2, 4}'

CREATE SINK setbasetypes_out(setbasetypes.id UINT64, r INT32) TYPE File;
SELECT id, SET_BASETYPE(a) AS r FROM setbasetypes INTO setbasetypes_out;
----
1,0
2,0

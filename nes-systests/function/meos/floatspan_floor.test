# name: MEOS_FLOATSPAN_FLOOR
# description: floatspan_floor — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspanfloors(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatspanfloors TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'
2|'[3.5, 9.5)'

CREATE SINK floatspanfloors_out(floatspanfloors.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSPAN_FLOOR(a) AS r FROM floatspanfloors INTO floatspanfloors_out;
----
1,[1, 5)
2,[3, 9)

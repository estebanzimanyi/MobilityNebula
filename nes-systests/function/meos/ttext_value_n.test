# name: MEOS_TTEXT_VALUE_N
# description: ttext_value_n — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE ttextvaluens(id UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR ttextvaluens TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200
2|'DEF'|1609545600

CREATE SINK ttextvaluens_out(ttextvaluens.id UINT64, r VARSIZED) TYPE File;
SELECT id, TTEXT_VALUE_N(value, ts) AS r FROM ttextvaluens INTO ttextvaluens_out;
----
1,"ABC"
2,"DEF"

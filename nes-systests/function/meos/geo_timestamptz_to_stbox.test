# name: MEOS_GEO_TIMESTAMPTZ_TO_STBOX
# description: geo_timestamptz_to_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geotimestamptztosts(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geotimestamptztosts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(1 1)'|'2020-01-01 00:00:00+00'
2|'SRID=4326;Point(2 2)'|'2020-01-01 00:00:00+00'

CREATE SINK geotimestamptztosts_out(geotimestamptztosts.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEO_TIMESTAMPTZ_TO_STBOX(a, arg) AS r FROM geotimestamptztosts INTO geotimestamptztosts_out;
----
1,SRID=4326;STBOX XT(((1,1),(1,1)),[2020-01-01 00:00:00+00, 2020-01-01 00:00:00+00])
2,SRID=4326;STBOX XT(((2,2),(2,2)),[2020-01-01 00:00:00+00, 2020-01-01 00:00:00+00])

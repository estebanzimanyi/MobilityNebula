# name: MEOS_TLT_TTEXT_TEXT
# description: tlt_ttext_text — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tltttexttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tltttexttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'XYZ'
2|'DEF'|1609545600|'XYZ'

CREATE SINK tltttexttexts_out(tltttexttexts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TLT_TTEXT_TEXT(value, ts, arg) AS r FROM tltttexttexts INTO tltttexttexts_out;
----
1,t@2021-01-01,00:00:00+00
2,t@2021-01-02,00:00:00+00

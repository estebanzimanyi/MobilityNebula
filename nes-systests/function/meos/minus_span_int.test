# name: MEOS_MINUS_SPAN_INT
# description: minus_span_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minusspanints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR minusspanints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK minusspanints_out(minusspanints.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_SPAN_INT(a, b) AS r FROM minusspanints INTO minusspanints_out;
----
1,{[1,3),[4,5)}
2,{[3,7),[8,9)}

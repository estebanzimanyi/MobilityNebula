# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxgettimetiles(id UINT64, value INT64, arg0 VARSIZED, arg1 VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxgettimetiles TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|631152000000000|'1 day'|'2020-01-01 00:00:00+00'
2|631238400000000|'2 days'|'2020-01-01 00:00:00+00'

CREATE SINK stboxgettimetiles_out(stboxgettimetiles.id UINT64, r VARSIZED) TYPE File;
SELECT id, STBOX_GET_TIME_TILE(value, arg0, arg1) AS r FROM stboxgettimetiles INTO stboxgettimetiles_out;

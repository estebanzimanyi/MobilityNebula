# name: MEOS_RIGHT_TEXT_SET
# description: right_text_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE righttextsets(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR righttextsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'|'AAA'
2|'{"BBB", "DDD"}'|'BBB'

CREATE SINK righttextsets_out(righttextsets.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_TEXT_SET(a, arg) AS r FROM righttextsets INTO righttextsets_out;
----
1,0
2,0

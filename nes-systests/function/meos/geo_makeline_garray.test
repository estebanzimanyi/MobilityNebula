# name: MEOS_GEO_MAKELINE_GARRAY_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE gmg(gid UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR gmg TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'010100000000004C0AC9B24E400000D8DE3D984340'|1609459200
1|'01010000000000902F231C4540000052BBD7545640'|1609459201

CREATE SINK gmg_out(gmg.gid UINT64, gmg.r VARSIZED) TYPE File;
SELECT gid, GEO_MAKELINE_GARRAY(value, ts) AS r FROM gmg GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO gmg_out;

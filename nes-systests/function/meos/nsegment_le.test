# name: MEOS_NSEGMENT_LE
# description: nsegment_le — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE nsegmentles(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR nsegmentles TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NSegment(1, 0.2, 0.8)'|'NSegment(1, 0.5, 0.7)'
2|'NSegment(1, 0.5, 0.7)'|'NSegment(1, 0.2, 0.8)'

CREATE SINK nsegmentles_out(nsegmentles.id UINT64, r INT32) TYPE File;
SELECT id, NSEGMENT_LE(a, b) AS r FROM nsegmentles INTO nsegmentles_out;
----
1,1
2,0

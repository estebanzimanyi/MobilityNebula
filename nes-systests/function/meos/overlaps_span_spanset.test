# name: MEOS_OVERLAPS_SPAN_SPANSET
# description: overlaps_span_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overlapsspanspanses(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR overlapsspanspanses TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|'{[1, 5), [10, 15)}'
2|'[3, 9)'|'{[3, 7)}'

CREATE SINK overlapsspanspanses_out(overlapsspanspanses.id UINT64, r INT32) TYPE File;
SELECT id, OVERLAPS_SPAN_SPANSET(a, b) AS r FROM overlapsspanspanses INTO overlapsspanspanses_out;

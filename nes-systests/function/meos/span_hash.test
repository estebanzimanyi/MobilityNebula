# name: MEOS_SPAN_HASH
# description: span_hash — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spanhashs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spanhashs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'
2|'[3, 9)'

CREATE SINK spanhashs_out(spanhashs.id UINT64, r INT32) TYPE File;
SELECT id, SPAN_HASH(a) AS r FROM spanhashs INTO spanhashs_out;
----
1,905877803
2,111516203

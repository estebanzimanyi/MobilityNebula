# name: MEOS_RIGHT_SPAN_SPANSET
# description: right_span_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightspanspansets(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR rightspanspansets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|'{[1, 5), [10, 15)}'
2|'[3, 9)'|'{[3, 7)}'

CREATE SINK rightspanspansets_out(rightspanspansets.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_SPAN_SPANSET(a, b) AS r FROM rightspanspansets INTO rightspanspansets_out;
----
1,0
2,0

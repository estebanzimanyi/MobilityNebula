# name: MEOS_TEXTSET_MAKE_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE tsm(gid UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR tsm TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'WXK'|1609459200
1|'CUMRKQGA'|1609459201
2|'AAA'|1609459200
2|'BBB'|1609459201

CREATE SINK tsm_out(tsm.gid UINT64, tsm.r VARSIZED) TYPE File;
SELECT gid, TEXTSET_MAKE(value, ts) AS r FROM tsm GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tsm_out;
----
1,{"CUMRKQGA","WXK"}
2,{"AAA","BBB"}

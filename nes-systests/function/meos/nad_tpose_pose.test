# name: MEOS_NAD_TPOSE_POSE
# description: nad_tpose_pose — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE nadtposeposes(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR nadtposeposes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|0.5|1609459200|'Pose(Point(1 1), 0.5)'
2|2.0|2.0|1.0|1609545600|'Pose(Point(2 2), 1.0)'

CREATE SINK nadtposeposes_out(nadtposeposes.id UINT64, r FLOAT64) TYPE File;
SELECT id, NAD_TPOSE_POSE(x, y, theta, ts, arg) AS r FROM nadtposeposes INTO nadtposeposes_out;

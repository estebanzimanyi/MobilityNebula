# name: MEOS_TEXTSET_UPPER
# description: textset_upper — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textsetuppers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR textsetuppers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'
2|'{"BBB", "DDD"}'

CREATE SINK textsetuppers_out(textsetuppers.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXTSET_UPPER(a) AS r FROM textsetuppers INTO textsetuppers_out;
----
1,{"AAA","BBB","CCC"}
2,{"BBB","DDD"}

# name: MEOS_TSTZSET_VALUE_N
# description: tstzset_value_n — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzsetvaluens(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzsetvaluens TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01 00:00:00+00, 2020-01-05 00:00:00+00}'
2|'{2020-01-03 00:00:00+00, 2020-01-08 00:00:00+00}'

CREATE SINK tstzsetvaluens_out(tstzsetvaluens.id UINT64, r INT64) TYPE File;
SELECT id, TSTZSET_VALUE_N(a) AS r FROM tstzsetvaluens INTO tstzsetvaluens_out;

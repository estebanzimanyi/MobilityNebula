# name: MEOS_SPATIALSET_TO_STBOX
# description: spatialset_to_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spatialsettostboxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spatialsettostboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"SRID=4326;Point(1 1)", "SRID=4326;Point(2 2)"}'
2|'{"SRID=4326;Point(3 3)", "SRID=4326;Point(4 4)"}'

CREATE SINK spatialsettostboxs_out(spatialsettostboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, SPATIALSET_TO_STBOX(a) AS r FROM spatialsettostboxs INTO spatialsettostboxs_out;
----
1,SRID=4326;STBOX X((1,1),(2,2))
2,SRID=4326;STBOX X((3,3),(4,4))

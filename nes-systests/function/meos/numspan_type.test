# name: MEOS_NUMSPAN_TYPE
# description: numspan_type — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE numspantypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR numspantypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 20)'
2|'[3, 25)'

CREATE SINK numspantypes_out(numspantypes.id UINT64, r INT32) TYPE File;
SELECT id, NUMSPAN_TYPE(a) AS r FROM numspantypes INTO numspantypes_out;
----
1,1
2,1

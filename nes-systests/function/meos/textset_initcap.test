# name: MEOS_TEXTSET_INITCAP
# description: textset_initcap — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textsetinitcaps(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR textsetinitcaps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'
2|'{"BBB", "DDD"}'

CREATE SINK textsetinitcaps_out(textsetinitcaps.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXTSET_INITCAP(a) AS r FROM textsetinitcaps INTO textsetinitcaps_out;
----
1,{"Aaa","Bbb","Ccc"}
2,{"Bbb","Ddd"}

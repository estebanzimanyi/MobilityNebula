# name: MEOS_STBOX_CMP
# groups: [Function, MEOS, SpatioTemporal, Box, Codegen]
CREATE LOGICAL SOURCE scmp(id UINT64, boxa VARSIZED, boxb VARSIZED);
CREATE PHYSICAL SOURCE FOR scmp TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|STBOX X((1,1),(3,3))|STBOX X((2,2),(4,4))
2|STBOX X((1,1),(3,3))|STBOX X((10,10),(11,11))

CREATE SINK scmp_out(scmp.id UINT64, r INT32) TYPE File;
SELECT id, STBOX_CMP(boxa, boxb) AS r FROM scmp INTO scmp_out;
----
1,-1
2,-1

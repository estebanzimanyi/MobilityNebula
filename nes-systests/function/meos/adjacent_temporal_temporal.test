2|4.3658|50.6456|1609459200|4.3658|50.6456|1609459200

CREATE SINK tt00_out(tt00.id UINT32, r BOOLEAN) TYPE File;
SELECT id, ADJACENT_TEMPORAL_TEMPORAL(lonA, latA, tsA, lonB, latB, tsB) AS r FROM tt00 INTO tt00_out;

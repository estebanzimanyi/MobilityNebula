# name: MEOS_ADJACENT_TEMPORAL_TEMPORAL
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, EDisjoint]
CREATE LOGICAL SOURCE tt00(id UINT32, lonA FLOAT64, latA FLOAT64, tsA UINT64, lonB FLOAT64, latB FLOAT64, tsB UINT64);
CREATE PHYSICAL SOURCE FOR tt00 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

# name: MEOS_OVERRIGHT_SPAN_SPANSET
# description: overright_span_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overrightspanspanss(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR overrightspanspanss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|'{[1, 5), [10, 15)}'
2|'[3, 9)'|'{[3, 7)}'

CREATE SINK overrightspanspanss_out(overrightspanspanss.id UINT64, r INT32) TYPE File;
SELECT id, OVERRIGHT_SPAN_SPANSET(a, b) AS r FROM overrightspanspanss INTO overrightspanspanss_out;
----
1,1
2,1

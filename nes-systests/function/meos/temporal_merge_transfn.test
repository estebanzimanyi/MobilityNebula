# name: MEOS_TEMPORAL_MERGE_TRANSFN
# description: Windowed TEMPORAL_MERGE_TRANSFN -> aggregate Temporal (hex-WKB) via the per-op SkipList tagg transfn; VARSIZED value, timestamp windowing-only.
# groups: [Function, MEOS, Aggregation]
CREATE LOGICAL SOURCE ctm(vehicle_id UINT64, value VARSIZED, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR ctm TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.5@2020-01-01 00:00:00+00|1609459200
1|3.5@2020-01-01 00:30:00+00|1609462800

CREATE SINK ctm_out(ctm.vehicle_id UINT64, ctm.r VARSIZED) TYPE File;
SELECT vehicle_id, TEMPORAL_MERGE_TRANSFN(value, timestamp) AS r FROM ctm GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO ctm_out;

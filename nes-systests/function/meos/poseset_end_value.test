# name: MEOS_POSESET_END_VALUE
# description: poseset_end_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posesetendvalues(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR posesetendvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Pose(Point(1 1),0.5)", "Pose(Point(2 2),1.0)"}'
2|'{"Pose(Point(3 3),0.3)", "Pose(Point(4 4),0.5)"}'

CREATE SINK posesetendvalues_out(posesetendvalues.id UINT64, r VARSIZED) TYPE File;
SELECT id, POSESET_END_VALUE(a) AS r FROM posesetendvalues INTO posesetendvalues_out;
----
1,POSE (0101000000000000000000F03F000000000000F03F, 0.5)
2,POSE (010100000000000000000010400000000000001040, 0.5)

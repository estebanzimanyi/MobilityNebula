# name: MEOS_LEFT_TEXT_SET
# description: left_text_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE lefttextsets(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR lefttextsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'|'AAA'
2|'{"BBB", "DDD"}'|'BBB'

CREATE SINK lefttextsets_out(lefttextsets.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_TEXT_SET(a, arg) AS r FROM lefttextsets INTO lefttextsets_out;
----
1,0
2,0

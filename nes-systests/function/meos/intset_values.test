# name: MEOS_INTSET_VALUES
# description: intset_values — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intsetvaluess(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR intsetvaluess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{2, 4}'

CREATE SINK intsetvaluess_out(intsetvaluess.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTSET_VALUES(a) AS r FROM intsetvaluess INTO intsetvaluess_out;
----
1,{1,3,5}
2,{2,4}

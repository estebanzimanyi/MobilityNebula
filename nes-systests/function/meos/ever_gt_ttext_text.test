CREATE LOGICAL SOURCE evergtttexttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR evergtttexttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

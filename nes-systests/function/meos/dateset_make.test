1|7307|1609459202
2|7400|1609459200
2|7401|1609459201

CREATE SINK datesetmakes_out(datesetmakes.gid UINT64, datesetmakes.r VARSIZED) TYPE File;
SELECT gid, DATESET_MAKE(value, ts) AS r FROM datesetmakes GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO datesetmakes_out;

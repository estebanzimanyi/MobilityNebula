# name: MEOS_DATESET_MAKE_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE datesetmakes(gid UINT64, value INT32, ts UINT64);
CREATE PHYSICAL SOURCE FOR datesetmakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|7305|1609459200

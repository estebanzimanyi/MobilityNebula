# name: MEOS_GEO_CLUSTER_DBSCAN
# description: geo_cluster_dbscan — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geoclusterdbscans(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geoclusterdbscans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(1 1)'
2|'SRID=4326;Point(2 2)'

CREATE SINK geoclusterdbscans_out(geoclusterdbscans.id UINT64, r INT32) TYPE File;
SELECT id, GEO_CLUSTER_DBSCAN(a) AS r FROM geoclusterdbscans INTO geoclusterdbscans_out;
----
1,0
2,0

# name: MEOS_TEMPORAL_SCALE_TIME
# description: temporal_scale_time — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE temporalscaletimes(id UINT64, value FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR temporalscaletimes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200|'2 days'
2|8.5|1609545600|'2 days'

CREATE SINK temporalscaletimes_out(temporalscaletimes.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEMPORAL_SCALE_TIME(value, ts, arg) AS r FROM temporalscaletimes INTO temporalscaletimes_out;
----
1,5.5@2021-01-01,00:00:00+00
2,8.5@2021-01-02,00:00:00+00

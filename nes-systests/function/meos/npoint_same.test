# name: MEOS_NPOINT_SAME
# description: npoint_same — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointsames(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR npointsames TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NPoint(1, 0.5)'|'NPoint(1, 0.7)'
2|'NPoint(1, 0.7)'|'NPoint(1, 0.5)'

CREATE SINK npointsames_out(npointsames.id UINT64, r INT32) TYPE File;
SELECT id, NPOINT_SAME(a, b) AS r FROM npointsames INTO npointsames_out;
----
1,0
2,0

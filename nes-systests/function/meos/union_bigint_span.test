# name: MEOS_UNION_BIGINT_SPAN
# description: union_bigint_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionbigintspans(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR unionbigintspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK unionbigintspans_out(unionbigintspans.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_BIGINT_SPAN(a, b) AS r FROM unionbigintspans INTO unionbigintspans_out;

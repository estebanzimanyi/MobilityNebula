# name: MEOS_CBUFFER_HASH_EXTENDED
# description: cbuffer_hash_extended — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbufferhashextendes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR cbufferhashextendes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),0.5)'
2|'Cbuffer(Point(2 2),0.5)'

CREATE SINK cbufferhashextendes_out(cbufferhashextendes.id UINT64, r INT64) TYPE File;
SELECT id, CBUFFER_HASH_EXTENDED(a) AS r FROM cbufferhashextendes INTO cbufferhashextendes_out;

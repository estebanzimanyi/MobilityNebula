# name: MEOS_SET_SPLIT_N_SPANS
# description: set_split_n_spans — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE setsplitnspanss(id UINT64, a VARSIZED, x0 INT32);
CREATE PHYSICAL SOURCE FOR setsplitnspanss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5, 7, 9}'|2
2|'{2, 4, 6, 8}'|2

CREATE SINK setsplitnspanss_out(setsplitnspanss.id UINT64, r VARSIZED) TYPE File;
SELECT id, SET_SPLIT_N_SPANS(a, x0) AS r FROM setsplitnspanss INTO setsplitnspanss_out;
----
1,{[1,6),[7,10)}
2,{[2,5),[6,9)}

# name: MEOS_NSEGMENT_LT
# description: nsegment_lt — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE nsegmentlts(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR nsegmentlts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NSegment(1, 0.2, 0.8)'|'NSegment(1, 0.5, 0.7)'
2|'NSegment(1, 0.5, 0.7)'|'NSegment(1, 0.2, 0.8)'

CREATE SINK nsegmentlts_out(nsegmentlts.id UINT64, r INT32) TYPE File;
SELECT id, NSEGMENT_LT(a, b) AS r FROM nsegmentlts INTO nsegmentlts_out;
----
1,1
2,0

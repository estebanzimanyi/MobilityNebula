# name: MEOS_SET_SPLIT_EACH_N_SPANS
# description: set_split_each_n_spans — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE setspliteachnspanss(id UINT64, a VARSIZED, x0 INT32);
CREATE PHYSICAL SOURCE FOR setspliteachnspanss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5, 7, 9}'|2
2|'{2, 4, 6, 8}'|2

CREATE SINK setspliteachnspanss_out(setspliteachnspanss.id UINT64, r VARSIZED) TYPE File;
SELECT id, SET_SPLIT_EACH_N_SPANS(a, x0) AS r FROM setspliteachnspanss INTO setspliteachnspanss_out;
----
1,{[1,4),[5,8),[9,10)}
2,{[2,5),[6,9)}

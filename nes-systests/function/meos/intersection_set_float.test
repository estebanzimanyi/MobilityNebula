# name: MEOS_INTERSECTION_SET_FLOAT
# description: intersection_set_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectionsetflos(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR intersectionsetflos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|3.5
2|'{2.5, 4.5, 6.5}'|4.5

CREATE SINK intersectionsetflos_out(intersectionsetflos.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERSECTION_SET_FLOAT(a, b) AS r FROM intersectionsetflos INTO intersectionsetflos_out;
----
1,{3.5}
2,{4.5}

# name: MEOS_INTERPTYPE_NAME
# description: INTERPTYPE_NAME maps an interpType (LINEAR=3, DISCRETE=1) to its name.
# groups: [Function, MEOS, Catalog]
CREATE LOGICAL SOURCE itn(id UINT64, value INT32);
CREATE PHYSICAL SOURCE FOR itn TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|3
2|1

CREATE SINK itn_out(itn.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERPTYPE_NAME(value) AS r FROM itn INTO itn_out;
----
1,Linear
2,Discrete

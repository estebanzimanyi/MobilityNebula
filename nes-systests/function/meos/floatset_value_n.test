# name: MEOS_FLOATSET_VALUE_N
# description: floatset_value_n — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatsetvaluens(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatsetvaluens TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'
2|'{3.5, 5.5, 9.5}'

CREATE SINK floatsetvaluens_out(floatsetvaluens.id UINT64, r FLOAT64) TYPE File;
SELECT id, FLOATSET_VALUE_N(a) AS r FROM floatsetvaluens INTO floatsetvaluens_out;
----
1,1.5
2,3.5

# name: MEOS_TEMPORAL_UPDATE
# description: temporal_update — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE temporalupdates(id UINT64, value INT32, ts UINT64, value2 INT32, ts2 UINT64, flag BOOLEAN);
CREATE PHYSICAL SOURCE FOR temporalupdates TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5|1609459200|7|1609462800|false
2|8|1609545600|2|1609549200|false

CREATE SINK temporalupdates_out(temporalupdates.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEMPORAL_UPDATE(value, ts, value2, ts2, flag) AS r FROM temporalupdates INTO temporalupdates_out;

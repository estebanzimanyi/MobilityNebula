# name: MEOS_UNION_INT_SET
# description: union_int_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionintsets(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR unionintsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK unionintsets_out(unionintsets.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_INT_SET(a, b) AS r FROM unionintsets INTO unionintsets_out;
----
1,{1,3,5}
2,{3,5,7,9}

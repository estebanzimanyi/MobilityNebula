# name: MEOS_TTEXT_VALUES
# description: ttext_values — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE ttextvaluess(id UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR ttextvaluess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200
2|'DEF'|1609545600

CREATE SINK ttextvaluess_out(ttextvaluess.id UINT64, r VARSIZED) TYPE File;
SELECT id, TTEXT_VALUES(value, ts) AS r FROM ttextvaluess INTO ttextvaluess_out;
----
1,{"ABC"}
2,{"DEF"}

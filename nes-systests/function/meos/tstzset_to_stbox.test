CREATE LOGICAL SOURCE tstzsettostboxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzsettostboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01 00:00:00+00, 2020-01-05 00:00:00+00}'
2|'{2020-01-03 00:00:00+00, 2020-01-08 00:00:00+00}'

CREATE SINK tstzsettostboxs_out(tstzsettostboxs.id UINT64, r VARSIZED) TYPE File;

# name: MEOS_TemporalNumInstants_Aggregation
# description: Windowed TEMPORAL_NUM_INSTANTS over per-(window,group) tgeo trajectory (W7 aggregation).
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, Aggregation]
CREATE LOGICAL SOURCE nin(vehicle_id UINT64, lon FLOAT64, lat FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR nin TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200
1|4.3700|50.6500|1609459201
1|4.3750|50.6550|1609459202
2|5.0000|51.0000|1609459200
2|5.0100|51.0100|1609459201

CREATE SINK nin_out(nin.vehicle_id UINT64, nin.n_instants INT32) TYPE File;
SELECT vehicle_id, TEMPORAL_NUM_INSTANTS(lon, lat, timestamp) AS n_instants FROM nin GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO nin_out;
----
1,3
2,2

# name: MEOS_NAD_TFloat_TFloat
# groups: [Function, MEOS, TNumber, TFloat, NAD]
CREATE LOGICAL SOURCE ntf(id UINT32, vA FLOAT64, tsA UINT64, vB FLOAT64, tsB UINT64);
CREATE PHYSICAL SOURCE FOR ntf TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|42.5|1609459200|40.0|1609459200
2|10.0|1609459200|10.0|1609459200

CREATE SINK ntf_out(ntf.id UINT32, distance FLOAT64) TYPE File;
SELECT id, NAD_TFLOAT_TFLOAT(vA, tsA, vB, tsB) AS distance FROM ntf INTO ntf_out;

# name: MEOS_FLOAT_GET_BIN
# description: float_get_bin — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatgetbins(id UINT64, value FLOAT64, arg0 FLOAT64, arg1 FLOAT64);
CREATE PHYSICAL SOURCE FOR floatgetbins TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|7.5|5.0|0.0
2|12.5|5.0|0.0

CREATE SINK floatgetbins_out(floatgetbins.id UINT64, r FLOAT64) TYPE File;
SELECT id, FLOAT_GET_BIN(value, arg0, arg1) AS r FROM floatgetbins INTO floatgetbins_out;
----
1,5.0
2,10.0

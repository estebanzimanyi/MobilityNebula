CREATE LOGICAL SOURCE posetimestamptztoss(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR posetimestamptztoss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'|'2020-01-01 00:00:00+00'
2|'Pose(Point(2 2), 1.0)'|'2020-01-01 00:00:00+00'

CREATE SINK posetimestamptztoss_out(posetimestamptztoss.id UINT64, r VARSIZED) TYPE File;
SELECT id, POSE_TIMESTAMPTZ_TO_STBOX(a, arg) AS r FROM posetimestamptztoss INTO posetimestamptztoss_out;

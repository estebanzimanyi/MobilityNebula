# name: MEOS_OVERRIGHT_TBOX_TNUMBER
# groups: [Function, MEOS, TemporalNumber, Box, Codegen]
CREATE LOGICAL SOURCE tbn10(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tbn10 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|2.0|1577880000
2|100.0|1735689600

CREATE SINK tbn10_out(tbn10.id UINT64, r BOOLEAN) TYPE File;
SELECT id, OVERRIGHT_TBOX_TNUMBER('TBOXFLOAT XT([1, 3],[2020-01-01, 2020-01-02])', value, ts) AS r FROM tbn10 INTO tbn10_out;

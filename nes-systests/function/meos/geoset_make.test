# name: MEOS_GEOSET_MAKE_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE gsm(gid UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR gsm TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'010100000000004C0AC9B24E400000D8DE3D984340'|1609459200
1|'01010000000000902F231C4540000052BBD7545640'|1609459201

CREATE SINK gsm_out(gsm.gid UINT64, gsm.r VARSIZED) TYPE File;
SELECT gid, GEOSET_MAKE(value, ts) AS r FROM gsm GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO gsm_out;
----
1,{"POINT(61.39676,39.189388)","POINT(42.219824,89.325667)"}

# name: MEOS_TINT_TSUM_TRANSFN
# description: Windowed TINT_TSUM_TRANSFN -> aggregate Temporal (hex-WKB) via the per-op tagg transfn (tSum); same-timestamp events merged by the aggregation fn.
# groups: [Function, MEOS, TemporalNumber, Aggregation]
CREATE LOGICAL SOURCE tis(vehicle_id UINT64, value INT32, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR tis TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5|1609459200
1|3|1609459200
1|2|1609462800

CREATE SINK tis_out(tis.vehicle_id UINT64, tis.r VARSIZED) TYPE File;
SELECT vehicle_id, TINT_TSUM_TRANSFN(value, timestamp) AS r FROM tis GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO tis_out;

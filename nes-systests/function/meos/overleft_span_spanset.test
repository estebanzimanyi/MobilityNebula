# name: MEOS_OVERLEFT_SPAN_SPANSET
# description: overleft_span_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overleftspanspanses(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR overleftspanspanses TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|'{[1, 5), [10, 15)}'
2|'[3, 9)'|'{[3, 7)}'

CREATE SINK overleftspanspanses_out(overleftspanspanses.id UINT64, r INT32) TYPE File;
SELECT id, OVERLEFT_SPAN_SPANSET(a, b) AS r FROM overleftspanspanses INTO overleftspanspanses_out;
----
1,1

# name: MEOS_MUL_INTERVAL_DOUBLE
# description: mul_interval_double — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE mulintervaldoubles(id UINT64, a VARSIZED, arg FLOAT64);
CREATE PHYSICAL SOURCE FOR mulintervaldoubles TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'1 day'|2.0
2|'2 days 3 hours'|3.0

CREATE SINK mulintervaldoubles_out(mulintervaldoubles.id UINT64, r VARSIZED) TYPE File;
SELECT id, MUL_INTERVAL_DOUBLE(a, arg) AS r FROM mulintervaldoubles INTO mulintervaldoubles_out;
----
1,2,days
2,6,days,09:00:00

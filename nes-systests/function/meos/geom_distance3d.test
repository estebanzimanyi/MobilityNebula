# name: MEOS_GEOM_DISTANCE3D
# description: geom_distance3d — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomdistance3ds(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geomdistance3ds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(0 0, 2 2)'|'SRID=4326;Linestring(0 2, 2 0)'
2|'SRID=4326;Linestring(0 0, 3 3)'|'SRID=4326;Linestring(1 0, 1 3)'

CREATE SINK geomdistance3ds_out(geomdistance3ds.id UINT64, r FLOAT64) TYPE File;
SELECT id, GEOM_DISTANCE3D(a, arg) AS r FROM geomdistance3ds INTO geomdistance3ds_out;
----
1,0.0
2,0.0

# name: MEOS_STBOX_VOLUME
# description: stbox_volume — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxvolumes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxvolumes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX Z((1,1,1),(5,5,5))'
2|'STBOX Z((3,3,3),(7,7,7))'

CREATE SINK stboxvolumes_out(stboxvolumes.id UINT64, r FLOAT64) TYPE File;
SELECT id, STBOX_VOLUME(a) AS r FROM stboxvolumes INTO stboxvolumes_out;
----
1,64.0
2,64.0

# name: MEOS_INTERSECTION_STBOX_STBOX
# description: intersection_stbox_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectionstboxss(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR intersectionstboxss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'|'STBOX X((3,3),(7,7))'
2|'STBOX X((3,3),(7,7))'|'STBOX X((1,1),(5,5))'

CREATE SINK intersectionstboxss_out(intersectionstboxss.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERSECTION_STBOX_STBOX(a, b) AS r FROM intersectionstboxss INTO intersectionstboxss_out;
----
1,STBOX X((3,3),(5,5))
2,STBOX X((3,3),(5,5))

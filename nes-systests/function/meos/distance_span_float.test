# name: MEOS_DISTANCE_SPAN_FLOAT
# description: distance_span_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancespanfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR distancespanfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'|3.5
2|'[3.5, 9.5)'|7.5

CREATE SINK distancespanfloats_out(distancespanfloats.id UINT64, r FLOAT64) TYPE File;
SELECT id, DISTANCE_SPAN_FLOAT(a, b) AS r FROM distancespanfloats INTO distancespanfloats_out;
----
1,0.0
2,0.0

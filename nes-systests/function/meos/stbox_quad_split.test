# name: MEOS_STBOX_QUAD_SPLIT
# description: stbox_quad_split — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxquadsplits(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxquadsplits TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((0,0),(10,10))'
2|'STBOX X((0,0),(8,8))'

CREATE SINK stboxquadsplits_out(stboxquadsplits.id UINT64, r VARSIZED) TYPE File;
SELECT id, STBOX_QUAD_SPLIT(a) AS r FROM stboxquadsplits INTO stboxquadsplits_out;
----
1,{STBOX X((0 0) (5 5)) STBOX X((5 0) (10 5)) STBOX X((0 5) (5 10)) STBOX X((5 5) (10 10))}
2,{STBOX X((0 0) (4 4)) STBOX X((4 0) (8 4)) STBOX X((0 4) (4 8)) STBOX X((4 4) (8 8))}

# name: MEOS_SAME_TNUMBER_TBOX
# groups: [Function, MEOS, TemporalNumber, Box, Codegen]
CREATE LOGICAL SOURCE tnb12(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tnb12 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|2.0|1577880000
2|100.0|1735689600

CREATE SINK tnb12_out(tnb12.id UINT64, r BOOLEAN) TYPE File;
SELECT id, SAME_TNUMBER_TBOX(value, ts, 'TBOXFLOAT XT([1, 3],[2020-01-01, 2020-01-02])') AS r FROM tnb12 INTO tnb12_out;
----
1,0
2,0

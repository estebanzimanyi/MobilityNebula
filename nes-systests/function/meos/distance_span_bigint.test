# name: MEOS_DISTANCE_SPAN_BIGINT
# description: distance_span_bigint — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancespanbigints(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR distancespanbigints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK distancespanbigints_out(distancespanbigints.id UINT64, r INT64) TYPE File;
SELECT id, DISTANCE_SPAN_BIGINT(a, b) AS r FROM distancespanbigints INTO distancespanbigints_out;

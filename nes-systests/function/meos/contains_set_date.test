# name: MEOS_CONTAINS_SET_DATE
# description: contains_set_date — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containssetdates(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR containssetdates TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01, 2020-01-05, 2020-01-10}'|'2020-01-03'
2|'{2020-01-03, 2020-01-08}'|'2020-06-15'

CREATE SINK containssetdates_out(containssetdates.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINS_SET_DATE(a, b) AS r FROM containssetdates INTO containssetdates_out;
----
1,0
2,0

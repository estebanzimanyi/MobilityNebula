# name: MEOS_AFTER_STBOX_TSPATIAL
# groups: [Function, MEOS, SpatioTemporal, Box, Codegen]
CREATE LOGICAL SOURCE stp02(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR stp02 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200
2|2.0|2.0|1577836800

CREATE SINK stp02_out(stp02.id UINT64, r BOOLEAN) TYPE File;
SELECT id, AFTER_STBOX_TSPATIAL('SRID=4326;STBOX XT(((1,1),(3,3)),[2020-01-01,2020-01-02])', lon, lat, ts) AS r FROM stp02 INTO stp02_out;
----
1,0
2,0

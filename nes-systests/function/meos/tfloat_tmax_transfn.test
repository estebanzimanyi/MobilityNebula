# name: MEOS_TFLOAT_TMAX_TRANSFN
# description: Windowed TFLOAT_TMAX_TRANSFN -> aggregate Temporal (hex-WKB) via the per-op tagg transfn (tMax); same-timestamp events merged by the aggregation fn.
# groups: [Function, MEOS, TemporalNumber, Aggregation]
CREATE LOGICAL SOURCE tfx(vehicle_id UINT64, value FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR tfx TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200
1|3.5|1609459200
1|7.0|1609462800

CREATE SINK tfx_out(tfx.vehicle_id UINT64, tfx.r VARSIZED) TYPE File;
SELECT vehicle_id, TFLOAT_TMAX_TRANSFN(value, timestamp) AS r FROM tfx GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO tfx_out;

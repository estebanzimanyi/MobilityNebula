# name: MEOS_NPOINT_POSITION
# description: npoint_position — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointpositions(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR npointpositions TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NPoint(1, 0.5)'
2|'NPoint(1, 0.7)'

CREATE SINK npointpositions_out(npointpositions.id UINT64, r FLOAT64) TYPE File;
SELECT id, NPOINT_POSITION(a) AS r FROM npointpositions INTO npointpositions_out;
----
1,0.5
2,0.7

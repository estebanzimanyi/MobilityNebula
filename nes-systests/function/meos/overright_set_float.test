# name: MEOS_OVERRIGHT_SET_FLOAT
# description: overright_set_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overrightsetfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR overrightsetfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|3.5
2|'{3.5, 5.5, 9.5}'|7.5

CREATE SINK overrightsetfloats_out(overrightsetfloats.id UINT64, r INT32) TYPE File;
SELECT id, OVERRIGHT_SET_FLOAT(a, b) AS r FROM overrightsetfloats INTO overrightsetfloats_out;
----
1,0
2,0

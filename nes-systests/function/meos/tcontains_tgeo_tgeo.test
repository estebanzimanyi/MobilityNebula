# name: MEOS_TdistanceTgeoTgeoCrossVehicle
# description: Cross-vehicle TCONTAINS_TGEO_TGEO over two per-vehicle tgeompoint aggregate outputs (each a VARSIZED hex-WKB tgeompoint), returning the temporal distance as a VARSIZED hex-WKB tfloat. A at x=0, B at x=3 (both y 0->2 over the same time) -> constant distance 3.0.
# groups: [Function, MEOS, TemporalGeometry, CrossStream]
CREATE LOGICAL SOURCE tcng(id UINT64, ta VARSIZED, tb VARSIZED);
CREATE PHYSICAL SOURCE FOR tcng TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|012E000E020000000301010000000000000000000000000000000000000000A0AD30CA5A02000101000000000000000000000000000000000000408024CC30CA5A0200|012E000E020000000301010000000000000000000840000000000000000000A0AD30CA5A02000101000000000000000000084000000000000000408024CC30CA5A0200

CREATE SINK tcng_out(tcng.id UINT64, r VARSIZED) TYPE File;
SELECT id, TCONTAINS_TGEO_TGEO(ta, tb) AS r FROM tcng INTO tcng_out;
----
1,011A000A02000000030000A0AD30CA5A0200008024CC30CA5A0200

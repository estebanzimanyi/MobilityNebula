# name: MEOS_BEFORE_SPANSET_DATE
# description: before_spanset_date — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE beforespansetdates(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR beforespansetdates TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01, 2020-01-10)}'|'2020-01-03'
2|'{[2020-01-05, 2020-01-20)}'|'2020-06-15'

CREATE SINK beforespansetdates_out(beforespansetdates.id UINT64, r INT32) TYPE File;
SELECT id, BEFORE_SPANSET_DATE(a, b) AS r FROM beforespansetdates INTO beforespansetdates_out;
----
1,0
2,1

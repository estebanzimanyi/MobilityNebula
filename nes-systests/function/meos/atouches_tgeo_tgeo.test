# name: MEOS_TemporalAtouchesTgeometry
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, EDisjoint]
CREATE LOGICAL SOURCE att(id UINT32, lonA FLOAT64, latA FLOAT64, tsA UINT64, lonB FLOAT64, latB FLOAT64, tsB UINT64);
CREATE PHYSICAL SOURCE FOR att TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200|4.4000|50.7000|1609459200
2|4.3658|50.6456|1609459200|4.3658|50.6456|1609459200

CREATE SINK att_out(att.id UINT32, r INT32) TYPE File;
SELECT id, TEMPORAL_ATOUCHES_TGEOMETRY(lonA, latA, tsA, lonB, latB, tsB) AS r FROM att INTO att_out;

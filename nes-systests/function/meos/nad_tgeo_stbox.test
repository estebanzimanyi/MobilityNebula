# name: MEOS_NAD_TGEO_STBOX
# groups: [Function, MEOS, Codegen]
CREATE LOGICAL SOURCE ndgs(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR ndgs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.0|50.0|1609459200
2|5.0|51.0|1609459200

CREATE SINK ndgs_out(ndgs.id UINT64, r FLOAT64) TYPE File;
SELECT id, NAD_TGEO_STBOX(lon, lat, ts, 'SRID=4326;STBOX X((1,1),(3,3))') AS r FROM ndgs INTO ndgs_out;
----
1,47.010637
2,48.041649

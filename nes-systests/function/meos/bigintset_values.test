# name: MEOS_BIGINTSET_VALUES
# description: bigintset_values — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE bigintsetvaluess(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR bigintsetvaluess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{2, 4}'

CREATE SINK bigintsetvaluess_out(bigintsetvaluess.id UINT64, r VARSIZED) TYPE File;
SELECT id, BIGINTSET_VALUES(a) AS r FROM bigintsetvaluess INTO bigintsetvaluess_out;
----
1,{1,3,5}
2,{2,4}

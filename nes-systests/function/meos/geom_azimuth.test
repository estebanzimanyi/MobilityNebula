# name: MEOS_GEOM_AZIMUTH
# description: geom_azimuth — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomazimuths(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geomazimuths TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(0 0)'|'SRID=4326;Point(1 1)'
2|'SRID=4326;Point(0 0)'|'SRID=4326;Point(2 2)'

CREATE SINK geomazimuths_out(geomazimuths.id UINT64, r FLOAT64) TYPE File;
SELECT id, GEOM_AZIMUTH(a, arg) AS r FROM geomazimuths INTO geomazimuths_out;
----
1,0.785398
2,0.785398

# name: MEOS_STBOX_XMAX
# description: stbox_xmax — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxxmaxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxxmaxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'
2|'STBOX X((3,3),(7,7))'

CREATE SINK stboxxmaxs_out(stboxxmaxs.id UINT64, r FLOAT64) TYPE File;
SELECT id, STBOX_XMAX(a) AS r FROM stboxxmaxs INTO stboxxmaxs_out;
----
1,5.0
2,7.0

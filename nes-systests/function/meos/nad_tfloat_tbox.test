# name: MEOS_NAD_TFLOAT_TBOX
# groups: [Function, MEOS, Codegen]
CREATE LOGICAL SOURCE ndft(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR ndft TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|2.5|1577836800
2|10.0|1577836900

CREATE SINK ndft_out(ndft.id UINT64, r FLOAT64) TYPE File;
SELECT id, NAD_TFLOAT_TBOX(value, ts, 'TBOXFLOAT XT([1, 3],[2020-01-01, 2020-01-02])') AS r FROM ndft INTO ndft_out;
----
1,0.0
2,9.0

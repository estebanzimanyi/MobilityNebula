# name: MEOS_TIMESPAN_TYPE
# description: timespan_type — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE timespantypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR timespantypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 20)'
2|'[3, 25)'

CREATE SINK timespantypes_out(timespantypes.id UINT64, r INT32) TYPE File;
SELECT id, TIMESPAN_TYPE(a) AS r FROM timespantypes INTO timespantypes_out;
----
1,0
2,0

# name: MEOS_TEMPORAL_STOPS_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE tst(gid UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tst TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200
1|1.0|1.0|1609459230
1|5.0|5.0|1609459260
1|5.0|5.0|1609459290
2|2.0|2.0|1609459200
2|2.0|2.0|1609459260

CREATE SINK tst_out(tst.gid UINT64, tst.r VARSIZED) TYPE File;
SELECT gid, TEMPORAL_STOPS(lon, lat, ts, 0.5, '30 seconds') AS r FROM tst GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tst_out;

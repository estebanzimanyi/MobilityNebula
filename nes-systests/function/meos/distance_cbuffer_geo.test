# name: MEOS_DISTANCE_CBUFFER_GEO
# description: distance_cbuffer_geo — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancecbuffergeos(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR distancecbuffergeos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'|'Point(1 1)'
2|'Cbuffer(Point(2 2),0.5)'|'Point(2 2)'

CREATE SINK distancecbuffergeos_out(distancecbuffergeos.id UINT64, r FLOAT64) TYPE File;
SELECT id, DISTANCE_CBUFFER_GEO(a, arg) AS r FROM distancecbuffergeos INTO distancecbuffergeos_out;
----
1,0.0
2,0.0

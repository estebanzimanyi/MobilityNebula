# name: MEOS_CONTAINED_TNUMBER_TBOX
# groups: [Function, MEOS, TemporalNumber, Box, Codegen]
CREATE LOGICAL SOURCE tnb03(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tnb03 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|2.0|1577880000
2|100.0|1735689600

CREATE SINK tnb03_out(tnb03.id UINT64, r BOOLEAN) TYPE File;
SELECT id, CONTAINED_TNUMBER_TBOX(value, ts, 'TBOXFLOAT XT([1, 3],[2020-01-01, 2020-01-02])') AS r FROM tnb03 INTO tnb03_out;
----
1,1
2,0

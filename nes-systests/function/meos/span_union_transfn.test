# name: MEOS_SPAN_UNION_TRANSFN
# description: Windowed SPAN_UNION_TRANSFN -> aggregate container (text) over a stream of VARSIZED literals; timestamp is windowing-only.
# groups: [Function, MEOS, Set, Span, Aggregation]
CREATE LOGICAL SOURCE cspu(vehicle_id UINT64, value VARSIZED, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR cspu TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|[1.5, 5.5)|1609459200
1|[3.5, 9.5)|1609462800

CREATE SINK cspu_out(cspu.vehicle_id UINT64, cspu.r VARSIZED) TYPE File;
SELECT vehicle_id, SPAN_UNION_TRANSFN(value, timestamp) AS r FROM cspu GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO cspu_out;
----
1,{[1.5, 9.5)}

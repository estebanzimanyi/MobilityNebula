# name: MEOS_TEMPORAL_SIMPLIFY_MIN_DIST_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE tsmd(gid UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tsmd TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200
1|2.0|2.05|1609459201
1|3.0|3.0|1609459202
1|4.0|4.0|1609459203
2|5.0|5.0|1609459200
2|6.0|6.0|1609459201

CREATE SINK tsmd_out(tsmd.gid UINT64, tsmd.r VARSIZED) TYPE File;
SELECT gid, TEMPORAL_SIMPLIFY_MIN_DIST(lon, lat, ts, 0.5) AS r FROM tsmd GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tsmd_out;

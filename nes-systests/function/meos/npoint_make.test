# name: MEOS_NPOINT_MAKE
# description: npoint_make — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointmakes(id UINT64, value INT64, arg0 FLOAT64);
CREATE PHYSICAL SOURCE FOR npointmakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1|0.5
2|2|0.7

CREATE SINK npointmakes_out(npointmakes.id UINT64, r VARSIZED) TYPE File;
SELECT id, NPOINT_MAKE(value, arg0) AS r FROM npointmakes INTO npointmakes_out;
----
1,NPoint(1,0.5)
2,NPoint(2,0.7)

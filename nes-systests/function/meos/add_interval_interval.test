# name: MEOS_ADD_INTERVAL_INTERVAL
# description: add_interval_interval — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE addintervalintervas(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR addintervalintervas TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'1 day'|'1 day'
2|'2 days 3 hours'|'2 days 3 hours'

CREATE SINK addintervalintervas_out(addintervalintervas.id UINT64, r VARSIZED) TYPE File;
SELECT id, ADD_INTERVAL_INTERVAL(a, arg) AS r FROM addintervalintervas INTO addintervalintervas_out;
----
1,2,days
2,4,days,06:00:00

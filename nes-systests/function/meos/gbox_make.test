# name: MEOS_GBOX_MAKE
# description: GBOX_MAKE builds a PostGIS GBOX from hasz and its bounds (xmin,xmax,ymin,ymax,zmin,zmax). Row 1 carries a Z dimension; row 2 is planar.
# groups: [Function, MEOS, Box]
CREATE LOGICAL SOURCE gboxmakes(id UINT64, value BOOLEAN, arg0 FLOAT64, arg1 FLOAT64, arg2 FLOAT64, arg3 FLOAT64, arg4 FLOAT64, arg5 FLOAT64);
CREATE PHYSICAL SOURCE FOR gboxmakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|true|1.0|3.0|1.0|3.0|0.0|5.0
2|false|1.0|3.0|1.0|3.0|0.0|0.0

CREATE SINK gboxmakes_out(gboxmakes.id UINT64, r VARSIZED) TYPE File;
SELECT id, GBOX_MAKE(value, arg0, arg1, arg2, arg3, arg4, arg5) AS r FROM gboxmakes INTO gboxmakes_out;
----
1,GBOX,Z((1,1,0),(3,3,5))
2,GBOX,X((1,1),(3,3))

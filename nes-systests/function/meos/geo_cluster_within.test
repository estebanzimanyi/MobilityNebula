# name: MEOS_GEO_CLUSTER_WITHIN
# description: geo_cluster_within — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geoclusterwithins(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geoclusterwithins TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(1 1)'
2|'SRID=4326;Point(2 2)'

CREATE SINK geoclusterwithins_out(geoclusterwithins.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEO_CLUSTER_WITHIN(a) AS r FROM geoclusterwithins INTO geoclusterwithins_out;
----
1,{0107000020E6100000010000000101000000000000000000F03F000000000000F03F}
2,{0107000020E610000001000000010100000000000000000000400000000000000040}

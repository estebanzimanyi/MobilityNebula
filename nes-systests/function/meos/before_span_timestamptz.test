# name: MEOS_BEFORE_SPAN_TIMESTAMPTZ
# description: before_span_timestamptz — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE beforespantimestams(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR beforespantimestams TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)'|'2020-01-03 00:00:00+00'
2|'[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)'|'2020-06-15 12:00:00+00'

CREATE SINK beforespantimestams_out(beforespantimestams.id UINT64, r INT32) TYPE File;
SELECT id, BEFORE_SPAN_TIMESTAMPTZ(a, b) AS r FROM beforespantimestams INTO beforespantimestams_out;

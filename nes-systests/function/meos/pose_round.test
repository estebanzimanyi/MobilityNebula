# name: MEOS_POSE_ROUND
# description: pose_round — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE poserounds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR poserounds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'
2|'Pose(Point(2 2), 1.0)'

CREATE SINK poserounds_out(poserounds.id UINT64, r VARSIZED) TYPE File;
SELECT id, POSE_ROUND(a) AS r FROM poserounds INTO poserounds_out;
----
1,POSE (0101000000000000000000F03F000000000000F03F, 0.5)
2,POSE (010100000000000000000000400000000000000040, 1)

# name: MEOS_CONTAINS_SPAN_SPANSET
# description: contains_span_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containsspanspanses(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR containsspanspanses TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|'{[1, 5), [10, 15)}'
2|'[3, 9)'|'{[3, 7)}'

CREATE SINK containsspanspanses_out(containsspanspanses.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINS_SPAN_SPANSET(a, b) AS r FROM containsspanspanses INTO containsspanspanses_out;
----
1,0
2,1

# name: MEOS_TEMPORAL_TIME_BINS
# description: temporal_time_bins — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE temporaltimebinss(id UINT64, value FLOAT64, ts UINT64, x0 VARSIZED, x1 VARSIZED);
CREATE PHYSICAL SOURCE FOR temporaltimebinss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200|'1 day'|'2020-01-01 00:00:00+00'
2|8.5|1609545600|'2 days'|'2020-01-01 00:00:00+00'

CREATE SINK temporaltimebinss_out(temporaltimebinss.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEMPORAL_TIME_BINS(value, ts, x0, x1) AS r FROM temporaltimebinss INTO temporaltimebinss_out;
----
1,{[2021-01-01,00:00:00+00,2021-01-02,00:00:00+00)}
2,{[2021-01-01,00:00:00+00,2021-01-03,00:00:00+00)}

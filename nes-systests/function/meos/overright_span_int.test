# name: MEOS_OVERRIGHT_SPAN_INT
# description: overright_span_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overrightspanints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR overrightspanints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK overrightspanints_out(overrightspanints.id UINT64, r INT32) TYPE File;
SELECT id, OVERRIGHT_SPAN_INT(a, b) AS r FROM overrightspanints INTO overrightspanints_out;
----
1,0
2,0

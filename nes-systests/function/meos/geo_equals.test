# name: MEOS_GEO_EQUALS
# description: geo_equals — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geoequalss(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geoequalss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(0 0, 2 2)'|'SRID=4326;Linestring(0 2, 2 0)'
2|'SRID=4326;Linestring(0 0, 3 3)'|'SRID=4326;Linestring(1 0, 1 3)'

CREATE SINK geoequalss_out(geoequalss.id UINT64, r INT32) TYPE File;
SELECT id, GEO_EQUALS(a, arg) AS r FROM geoequalss INTO geoequalss_out;
----
1,0
2,0

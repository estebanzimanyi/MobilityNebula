# name: MEOS_CONTAINS_SET_FLOAT
# description: contains_set_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containssetfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR containssetfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|3.5
2|'{3.5, 5.5, 9.5}'|7.5

CREATE SINK containssetfloats_out(containssetfloats.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINS_SET_FLOAT(a, b) AS r FROM containssetfloats INTO containssetfloats_out;
----
1,1
2,0

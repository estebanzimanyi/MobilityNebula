# name: MEOS_TINT_WMIN_TRANSFN
# description: Windowed TINT_WMIN_TRANSFN -> aggregate Temporal (hex-WKB) via the per-op windowed tagg transfn (1-hour radius).
# groups: [Function, MEOS, TemporalNumber, Aggregation]
CREATE LOGICAL SOURCE wmn(vehicle_id UINT64, value INT32, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR wmn TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5|1609459200
1|3|1609459200
1|7|1609462800

CREATE SINK wmn_out(wmn.vehicle_id UINT64, wmn.r VARSIZED) TYPE File;
SELECT vehicle_id, TINT_WMIN_TRANSFN(value, timestamp) AS r FROM wmn GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO wmn_out;

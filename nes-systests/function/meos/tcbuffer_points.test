CREATE LOGICAL SOURCE tcbufferpointss(id UINT64, lon FLOAT64, lat FLOAT64, radius FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tcbufferpointss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1.0|1609459200

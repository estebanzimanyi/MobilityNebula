# name: MEOS_TTEXT_END_VALUE
# description: ttext_end_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE ttextendvalues(id UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR ttextendvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200
2|'DEF'|1609545600

CREATE SINK ttextendvalues_out(ttextendvalues.id UINT64, r VARSIZED) TYPE File;
SELECT id, TTEXT_END_VALUE(value, ts) AS r FROM ttextendvalues INTO ttextendvalues_out;
----
1,"ABC"
2,"DEF"

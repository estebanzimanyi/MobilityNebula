# name: MEOS_TRGEOMETRY_TO_TPOSE
# description: trgeometry_to_tpose — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE trgeometrytotposes(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR trgeometrytotposes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|0.0|0.0|0.0|1609459200
2|1.0|1.0|0.5|1609545600

CREATE SINK trgeometrytotposes_out(trgeometrytotposes.id UINT64, r VARSIZED) TYPE File;
SELECT id, TRGEOMETRY_TO_TPOSE(x, y, theta, ts) AS r FROM trgeometrytotposes INTO trgeometrytotposes_out;

# name: MEOS_TEXTSET_VALUES
# description: textset_values — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textsetvaluess(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR textsetvaluess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'
2|'{"BBB", "DDD"}'

CREATE SINK textsetvaluess_out(textsetvaluess.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXTSET_VALUES(a) AS r FROM textsetvaluess INTO textsetvaluess_out;
----
1,{"AAA","BBB","CCC"}
2,{"BBB","DDD"}

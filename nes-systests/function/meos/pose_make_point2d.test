# name: MEOS_POSE_MAKE_POINT2D
# description: pose_make_point2d — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posemakepoint2ds(id UINT64, a VARSIZED, arg0 FLOAT64);
CREATE PHYSICAL SOURCE FOR posemakepoint2ds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Point(1 1)'|0.5
2|'Point(2 2)'|1.0

CREATE SINK posemakepoint2ds_out(posemakepoint2ds.id UINT64, r VARSIZED) TYPE File;
SELECT id, POSE_MAKE_POINT2D(a, arg0) AS r FROM posemakepoint2ds INTO posemakepoint2ds_out;
----
1,POSE (0101000000000000000000F03F000000000000F03F, 0.5)
2,POSE (010100000000000000000000400000000000000040, 1)

# name: MEOS_TSEQUENCESET_MAKE_GAPS_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE tsmg(gid UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR tsmg TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Point(1 1)@2021-01-01'|1609459200
1|'Point(2 2)@2021-01-01 00:00:01'|1609459201

CREATE SINK tsmg_out(tsmg.gid UINT64, tsmg.r VARSIZED) TYPE File;
SELECT gid, TSEQUENCESET_MAKE_GAPS(value, ts) AS r FROM tsmg GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tsmg_out;

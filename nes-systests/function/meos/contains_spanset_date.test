# name: MEOS_CONTAINS_SPANSET_DATE
# description: contains_spanset_date — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containsspansetdats(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR containsspansetdats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01, 2020-01-10)}'|'2020-01-03'
2|'{[2020-01-05, 2020-01-20)}'|'2020-06-15'

CREATE SINK containsspansetdats_out(containsspansetdats.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINS_SPANSET_DATE(a, b) AS r FROM containsspansetdats INTO containsspansetdats_out;
----
1,1
2,0

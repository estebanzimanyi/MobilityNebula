# name: MEOS_NPOINTSET_START_VALUE
# description: npointset_start_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointsetstartvalus(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR npointsetstartvalus TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Npoint(1,0.5)", "Npoint(2,0.5)"}'
2|'{"Npoint(1,0.7)", "Npoint(3,0.5)"}'

CREATE SINK npointsetstartvalus_out(npointsetstartvalus.id UINT64, r VARSIZED) TYPE File;
SELECT id, NPOINTSET_START_VALUE(a) AS r FROM npointsetstartvalus INTO npointsetstartvalus_out;
----
1,NPoint(1,0.5)
2,NPoint(1,0.7)

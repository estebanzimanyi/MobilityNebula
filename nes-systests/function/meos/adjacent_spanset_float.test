# name: MEOS_ADJACENT_SPANSET_FLOAT
# description: adjacent_spanset_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE adjacentspansetflos(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR adjacentspansetflos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'|3.5
2|'{[3.5, 7.5)}'|7.5

CREATE SINK adjacentspansetflos_out(adjacentspansetflos.id UINT64, r INT32) TYPE File;
SELECT id, ADJACENT_SPANSET_FLOAT(a, b) AS r FROM adjacentspansetflos INTO adjacentspansetflos_out;

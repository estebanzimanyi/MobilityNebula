# name: MEOS_CONTAINS_SET_INT
# description: contains_set_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containssetints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR containssetints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK containssetints_out(containssetints.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINS_SET_INT(a, b) AS r FROM containssetints INTO containssetints_out;
----
1,1
2,0

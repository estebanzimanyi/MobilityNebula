# name: MEOS_TBOX_HASH
# description: tbox_hash — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxhashs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxhashs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'

CREATE SINK tboxhashs_out(tboxhashs.id UINT64, r INT32) TYPE File;
SELECT id, TBOX_HASH(a) AS r FROM tboxhashs INTO tboxhashs_out;
----
1,1501582155
2,96473237

# name: MEOS_GEO_POINTS
# description: geo_points — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geopointss(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geopointss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(1 1, 2 2)'
2|'SRID=4326;Linestring(3 3, 4 4, 5 5)'

CREATE SINK geopointss_out(geopointss.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEO_POINTS(a) AS r FROM geopointss INTO geopointss_out;
----
1,0104000020E6100000020000000101000000000000000000F03F000000000000F03F010100000000000000000000400000000000000040
2,0104000020E610000003000000010100000000000000000008400000000000000840010100000000000000000010400000000000001040010100000000000000000014400000000000001440

# name: MEOS_TINT_MIN_VALUE_Aggregation
# description: Windowed TEMPORAL_TINT_MIN_VALUE over per-(window,group) temporal.
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE aimin(gid UINT64, reading INT32, ts UINT64);
CREATE PHYSICAL SOURCE FOR aimin TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|10|1609459200
1|22|1609459201
1|18|1609459202
2|5|1609459200
2|99|1609459201

CREATE SINK aimin_out(aimin.gid UINT64, aimin.r INT32) TYPE File;
SELECT gid, TEMPORAL_TINT_MIN_VALUE(reading, ts) AS r FROM aimin GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO aimin_out;

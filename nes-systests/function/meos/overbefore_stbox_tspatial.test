# name: MEOS_OVERBEFORE_STBOX_TSPATIAL
# groups: [Function, MEOS, SpatioTemporal, Box, Codegen]
CREATE LOGICAL SOURCE stp13(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR stp13 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200
2|2.0|2.0|1577836800

CREATE SINK stp13_out(stp13.id UINT64, r BOOLEAN) TYPE File;
SELECT id, OVERBEFORE_STBOX_TSPATIAL('SRID=4326;STBOX XT(((1,1),(3,3)),[2020-01-01,2020-01-02])', lon, lat, ts) AS r FROM stp13 INTO stp13_out;
----
1,1
2,0

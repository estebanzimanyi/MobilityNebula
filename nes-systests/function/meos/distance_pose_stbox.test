# name: MEOS_DISTANCE_POSE_STBOX
# description: distance_pose_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distanceposestboxs(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR distanceposestboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'|'STBOX X((0,0),(3,3))'
2|'Pose(Point(2 2), 1.0)'|'STBOX X((1,1),(4,4))'

CREATE SINK distanceposestboxs_out(distanceposestboxs.id UINT64, r FLOAT64) TYPE File;
SELECT id, DISTANCE_POSE_STBOX(a, arg) AS r FROM distanceposestboxs INTO distanceposestboxs_out;
----
1,0.0
2,0.0

# name: MEOS_POSE_SRID
# description: pose_srid — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posesrids(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR posesrids TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'
2|'Pose(Point(2 2), 1.0)'

CREATE SINK posesrids_out(posesrids.id UINT64, r INT32) TYPE File;
SELECT id, POSE_SRID(a) AS r FROM posesrids INTO posesrids_out;
----
1,0
2,0

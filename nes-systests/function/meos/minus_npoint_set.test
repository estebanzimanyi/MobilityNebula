# name: MEOS_MINUS_NPOINT_SET
# description: minus_npoint_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minusnpointsets(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR minusnpointsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Npoint(1,0.5)", "Npoint(2,0.5)"}'|'Npoint(9,0.5)'
2|'{"Npoint(1,0.7)", "Npoint(3,0.5)"}'|'Npoint(8,0.5)'

CREATE SINK minusnpointsets_out(minusnpointsets.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_NPOINT_SET(a, arg) AS r FROM minusnpointsets INTO minusnpointsets_out;
----
1,{"NPoint(9,0.5)"}
2,{"NPoint(8,0.5)"}

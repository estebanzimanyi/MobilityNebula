# name: MEOS_CBUFFER_TO_STBOX
# description: cbuffer_to_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbuffertostboxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR cbuffertostboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'
2|'Cbuffer(Point(2 2),0.5)'

CREATE SINK cbuffertostboxs_out(cbuffertostboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, CBUFFER_TO_STBOX(a) AS r FROM cbuffertostboxs INTO cbuffertostboxs_out;
----
1,STBOX X((0,0),(2,2))
2,STBOX X((1.5,1.5),(2.5,2.5))

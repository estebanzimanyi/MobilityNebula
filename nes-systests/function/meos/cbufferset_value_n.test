# name: MEOS_CBUFFERSET_VALUE_N
# description: cbufferset_value_n — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbuffersetvaluens(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR cbuffersetvaluens TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Cbuffer(Point(1 1),0.5)", "Cbuffer(Point(2 2),0.5)"}'
2|'{"Cbuffer(Point(3 3),1.0)", "Cbuffer(Point(4 4),0.5)"}'

CREATE SINK cbuffersetvaluens_out(cbuffersetvaluens.id UINT64, r VARSIZED) TYPE File;
SELECT id, CBUFFERSET_VALUE_N(a) AS r FROM cbuffersetvaluens INTO cbuffersetvaluens_out;
----
1,Cbuffer(0101000000000000000000F03F000000000000F03F,0.5)
2,Cbuffer(010100000000000000000008400000000000000840,1)

# name: MEOS_TSTZSPAN_MAKE
# description: tstzspan_make — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzspanmakes(id UINT64, value INT64, arg0 INT64, arg1 BOOLEAN, arg2 BOOLEAN);
CREATE PHYSICAL SOURCE FOR tstzspanmakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1000000|5000000|true|false
2|2000000|8000000|true|false

CREATE SINK tstzspanmakes_out(tstzspanmakes.id UINT64, r VARSIZED) TYPE File;
SELECT id, TSTZSPAN_MAKE(value, arg0, arg1, arg2) AS r FROM tstzspanmakes INTO tstzspanmakes_out;

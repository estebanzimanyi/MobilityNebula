# name: MEOS_TSPATIAL_SRID
# description: tspatial_srid — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tspatialsrids(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tspatialsrids TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200
2|2.0|2.0|1609545600

CREATE SINK tspatialsrids_out(tspatialsrids.id UINT64, r INT32) TYPE File;
SELECT id, TSPATIAL_SRID(lon, lat, ts) AS r FROM tspatialsrids INTO tspatialsrids_out;

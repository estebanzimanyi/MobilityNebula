# name: MEOS_TEMPORAL_SEQUENCE_N_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE tsn(gid UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tsn TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200
1|2.0|2.0|1609459201
1|3.0|3.0|1609459202
2|5.0|5.0|1609459200
2|6.0|6.0|1609459201

CREATE SINK tsn_out(tsn.gid UINT64, tsn.r VARSIZED) TYPE File;
SELECT gid, TEMPORAL_SEQUENCE_N(lon, lat, ts) AS r FROM tsn GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tsn_out;

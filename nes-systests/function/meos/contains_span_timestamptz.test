# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containsspantimests(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR containsspantimests TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)'|'2020-01-03 00:00:00+00'
2|'[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)'|'2020-06-15 12:00:00+00'

CREATE SINK containsspantimests_out(containsspantimests.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINS_SPAN_TIMESTAMPTZ(a, b) AS r FROM containsspantimests INTO containsspantimests_out;

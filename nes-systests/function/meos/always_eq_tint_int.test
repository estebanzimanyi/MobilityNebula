# name: MEOS_ALWAYS_EQ_TINT_INT
# groups: [Function, MEOS, TemporalNumber, Comparison, Codegen]
CREATE LOGICAL SOURCE tii00(id UINT64, value INT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tii00 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|2|1609459200

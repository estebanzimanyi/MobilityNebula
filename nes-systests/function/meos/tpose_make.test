# name: MEOS_TPOSE_MAKE
# description: TPOSE_MAKE builds a temporal pose from a temporal point (ta, a hex-WKB tgeompoint) and a temporal float orientation (tb, a hex-WKB tfloat), returning the temporal pose as a hex-WKB temporal.
# groups: [Function, MEOS, Pose, CrossStream]
CREATE LOGICAL SOURCE tposemakes(id UINT64, ta VARSIZED, tb VARSIZED);
CREATE PHYSICAL SOURCE FOR tposemakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|012E004EE610000002000000030101000020E6100000000000000000F03F000000000000F03F00A0AD30CA5A02000101000020E6100000000000000000004000000000000000400000854EDE5A0200|0121000E0200000003000000000000F03F00A0AD30CA5A020000000000000000400000854EDE5A0200

CREATE SINK tposemakes_out(tposemakes.id UINT64, r VARSIZED) TYPE File;
SELECT id, TPOSE_MAKE(ta, tb) AS r FROM tposemakes INTO tposemakes_out;

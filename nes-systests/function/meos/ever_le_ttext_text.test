# name: MEOS_EVER_LE_TTEXT_TEXT
# description: ever_le_ttext_text — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE everlettexttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR everlettexttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'ABC'
2|'DEF'|1609545600|'DEF'

CREATE SINK everlettexttexts_out(everlettexttexts.id UINT64, r INT32) TYPE File;
SELECT id, EVER_LE_TTEXT_TEXT(value, ts, arg) AS r FROM everlettexttexts INTO everlettexttexts_out;

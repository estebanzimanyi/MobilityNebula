# name: MEOS_OVERLEFT_SET_TEXT
# description: overleft_set_text — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overleftsettexts(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR overleftsettexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'|'AAA'
2|'{"BBB", "DDD"}'|'BBB'

CREATE SINK overleftsettexts_out(overleftsettexts.id UINT64, r INT32) TYPE File;
SELECT id, OVERLEFT_SET_TEXT(a, arg) AS r FROM overleftsettexts INTO overleftsettexts_out;
----
1,0
2,0

# name: MEOS_SET_NUM_VALUES
# description: set_num_values — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE setnumvaluess(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR setnumvaluess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{3, 5, 9}'

CREATE SINK setnumvaluess_out(setnumvaluess.id UINT64, r INT32) TYPE File;
SELECT id, SET_NUM_VALUES(a) AS r FROM setnumvaluess INTO setnumvaluess_out;
----
1,3
2,3

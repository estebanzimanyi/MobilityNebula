# name: MEOS_CBUFFER_COPY
# description: cbuffer_copy — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbuffercopys(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR cbuffercopys TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'
2|'Cbuffer(Point(2 2),0.5)'

CREATE SINK cbuffercopys_out(cbuffercopys.id UINT64, r VARSIZED) TYPE File;
SELECT id, CBUFFER_COPY(a) AS r FROM cbuffercopys INTO cbuffercopys_out;
----
1,Cbuffer(0101000000000000000000F03F000000000000F03F,1)
2,Cbuffer(010100000000000000000000400000000000000040,0.5)

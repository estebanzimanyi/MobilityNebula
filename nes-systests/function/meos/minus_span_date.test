# name: MEOS_MINUS_SPAN_DATE
# description: minus_span_date value-mixed set/span/spanset algebra.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minusspandate(id UINT64, lit VARSIZED, val INT32);
CREATE PHYSICAL SOURCE FOR minusspandate TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01, 2020-01-10)'|7307

CREATE SINK minusspandate_out(minusspandate.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_SPAN_DATE(lit, val) AS r FROM minusspandate INTO minusspandate_out;
----
1,{[2020-01-01,2020-01-03),[2020-01-04,2020-01-10)}

# name: MEOS_DISTANCE_CBUFFER_STBOX
# description: distance_cbuffer_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancecbufferstbs(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR distancecbufferstbs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'|'STBOX X((0,0),(3,3))'
2|'Cbuffer(Point(2 2),0.5)'|'STBOX X((1,1),(4,4))'

CREATE SINK distancecbufferstbs_out(distancecbufferstbs.id UINT64, r FLOAT64) TYPE File;
SELECT id, DISTANCE_CBUFFER_STBOX(a, arg) AS r FROM distancecbufferstbs INTO distancecbufferstbs_out;
----
1,0.0
2,0.0

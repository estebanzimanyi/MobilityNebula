# name: MEOS_CONTAINS_SET_CBUFFER
# description: contains_set_cbuffer — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containssetcbuffers(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR containssetcbuffers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Cbuffer(Point(1 1),0.5)", "Cbuffer(Point(2 2),0.5)"}'|'Cbuffer(Point(1 1),0.5)'
2|'{"Cbuffer(Point(3 3),1.0)", "Cbuffer(Point(4 4),0.5)"}'|'Cbuffer(Point(3 3),1.0)'

CREATE SINK containssetcbuffers_out(containssetcbuffers.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINS_SET_CBUFFER(a, arg) AS r FROM containssetcbuffers INTO containssetcbuffers_out;
----
1,1
2,1

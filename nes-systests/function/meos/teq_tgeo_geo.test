# name: MEOS_TEQ_TGEO_GEO
# description: teq_tgeo_geo — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE teqtgeogeos(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR teqtgeogeos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200|'SRID=4326;Point(1 1)'
2|2.0|2.0|1609545600|'SRID=4326;Point(2 2)'

CREATE SINK teqtgeogeos_out(teqtgeogeos.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEQ_TGEO_GEO(lon, lat, ts, arg) AS r FROM teqtgeogeos INTO teqtgeogeos_out;
----
1,t@2021-01-01,00:00:00+00
2,t@2021-01-02,00:00:00+00

# name: MEOS_TSTZSPAN_TCOUNT_TRANSFN
# description: Windowed TSTZSPAN_TCOUNT_TRANSFN -> aggregate Temporal (hex-WKB) via the per-op SkipList tagg transfn; VARSIZED value, timestamp windowing-only.
# groups: [Function, MEOS, Aggregation]
CREATE LOGICAL SOURCE ctpc(vehicle_id UINT64, value VARSIZED, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR ctpc TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|[2020-01-01 00:00:00+00, 2020-01-01 01:00:00+00)|1609459200
1|[2020-01-01 00:30:00+00, 2020-01-01 01:30:00+00)|1609462800

CREATE SINK ctpc_out(ctpc.vehicle_id UINT64, ctpc.r VARSIZED) TYPE File;
SELECT vehicle_id, TSTZSPAN_TCOUNT_TRANSFN(value, timestamp) AS r FROM ctpc GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO ctpc_out;

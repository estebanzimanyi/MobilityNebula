# name: MEOS_UNION_SET_NPOINT
# description: union_set_npoint — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionsetnpoints(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR unionsetnpoints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Npoint(1,0.5)", "Npoint(2,0.5)"}'|'Npoint(1,0.5)'
2|'{"Npoint(1,0.7)", "Npoint(3,0.5)"}'|'Npoint(1,0.7)'

CREATE SINK unionsetnpoints_out(unionsetnpoints.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_SET_NPOINT(a, arg) AS r FROM unionsetnpoints INTO unionsetnpoints_out;
----
1,{"NPoint(1,0.5)", "NPoint(2,0.5)"}
2,{"NPoint(1,0.7)", "NPoint(3,0.5)"}

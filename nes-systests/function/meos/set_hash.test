# name: MEOS_SET_HASH
# description: set_hash — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE sethashs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR sethashs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{3, 5, 9}'

CREATE SINK sethashs_out(sethashs.id UINT64, r INT32) TYPE File;
SELECT id, SET_HASH(a) AS r FROM sethashs INTO sethashs_out;
----
1,987183850
2,-2140169192

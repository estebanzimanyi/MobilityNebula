# name: MEOS_INT32_CMP
# description: int32_cmp — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE int32cmps(id UINT64, value INT32, arg0 INT32);
CREATE PHYSICAL SOURCE FOR int32cmps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|3|5
2|5|3

CREATE SINK int32cmps_out(int32cmps.id UINT64, r INT32) TYPE File;
SELECT id, INT32_CMP(value, arg0) AS r FROM int32cmps INTO int32cmps_out;
----
1,-1
2,1

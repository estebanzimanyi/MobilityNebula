# name: MEOS_STBOX_YMAX
# description: stbox_ymax — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxymaxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxymaxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'
2|'STBOX X((3,3),(7,7))'

CREATE SINK stboxymaxs_out(stboxymaxs.id UINT64, r FLOAT64) TYPE File;
SELECT id, STBOX_YMAX(a) AS r FROM stboxymaxs INTO stboxymaxs_out;
----
1,5.0
2,7.0

# name: MEOS_UNION_SET_BIGINT
# description: union_set_bigint — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionsetbigints(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR unionsetbigints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK unionsetbigints_out(unionsetbigints.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_SET_BIGINT(a, b) AS r FROM unionsetbigints INTO unionsetbigints_out;

2|4.3658|50.6456|1609459200|4.3658|50.6456|1609459200

CREATE SINK ts04_out(ts04.id UINT32, r BOOLEAN) TYPE File;
SELECT id, BEFORE_TSPATIAL_TSPATIAL(lonA, latA, tsA, lonB, latB, tsB) AS r FROM ts04 INTO ts04_out;

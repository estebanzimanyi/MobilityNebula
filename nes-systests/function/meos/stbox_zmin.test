# name: MEOS_STBOX_ZMIN
# description: stbox_zmin — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxzmins(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxzmins TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'
2|'STBOX X((3,3),(7,7))'

CREATE SINK stboxzmins_out(stboxzmins.id UINT64, r FLOAT64) TYPE File;
SELECT id, STBOX_ZMIN(a) AS r FROM stboxzmins INTO stboxzmins_out;
----
1,0.0
2,0.0

# name: MEOS_CBUFFER_GE
# description: cbuffer_ge — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbufferges(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR cbufferges TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'|'Cbuffer(Point(2 2),0.5)'
2|'Cbuffer(Point(2 2),0.5)'|'Cbuffer(Point(1 1),1.0)'

CREATE SINK cbufferges_out(cbufferges.id UINT64, r INT32) TYPE File;
SELECT id, CBUFFER_GE(a, b) AS r FROM cbufferges INTO cbufferges_out;
----
1,0
2,1

CREATE LOGICAL SOURCE spansetnumspanss(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spansetnumspanss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

# name: MEOS_TPOSE_VALUES
# description: tpose_values — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tposevaluess(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tposevaluess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|0.5|1609459200
2|2.0|2.0|1.0|1609545600

CREATE SINK tposevaluess_out(tposevaluess.id UINT64, r VARSIZED) TYPE File;
SELECT id, TPOSE_VALUES(x, y, theta, ts) AS r FROM tposevaluess INTO tposevaluess_out;
----
1,{POSE (0101000000000000000000F03F000000000000F03F, 0.5)}
2,{POSE (010100000000000000000000400000000000000040, 1)}

# name: MEOS_TEXTSET_END_VALUE
# description: textset_end_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textsetendvalues(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR textsetendvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'
2|'{"BBB", "DDD"}'

CREATE SINK textsetendvalues_out(textsetendvalues.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXTSET_END_VALUE(a) AS r FROM textsetendvalues INTO textsetendvalues_out;
----
1,"CCC"
2,"DDD"

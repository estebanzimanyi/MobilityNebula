# name: MEOS_POSE_NSAME
# description: pose_nsame — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posensames(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR posensames TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'|'Pose(Point(2 2), 1.0)'
2|'Pose(Point(2 2), 1.0)'|'Pose(Point(1 1), 0.5)'

CREATE SINK posensames_out(posensames.id UINT64, r INT32) TYPE File;
SELECT id, POSE_NSAME(a, b) AS r FROM posensames INTO posensames_out;
----
1,1
2,1

# name: MEOS_TEXT_LOWER
# description: text_lower — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textlowers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR textlowers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Hello World'
2|'foo bar'

CREATE SINK textlowers_out(textlowers.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXT_LOWER(a) AS r FROM textlowers INTO textlowers_out;
----
1,"hello world"
2,"foo bar"

# name: MEOS_SET_TYPE
# description: set_type — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE settypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR settypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{2, 4}'

CREATE SINK settypes_out(settypes.id UINT64, r INT32) TYPE File;
SELECT id, SET_TYPE(a) AS r FROM settypes INTO settypes_out;
----
1,1
2,1

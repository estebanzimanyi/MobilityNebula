# name: MEOS_ALWAYS_GT_TFLOAT_FLOAT
# groups: [Function, MEOS, TemporalNumber, Comparison, Codegen]
CREATE LOGICAL SOURCE tff03(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tff03 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|2.0|1609459200
2|10.0|1609545600

CREATE SINK tff03_out(tff03.id UINT64, r INT32) TYPE File;
SELECT id, ALWAYS_GT_TFLOAT_FLOAT(value, ts, 5.0) AS r FROM tff03 INTO tff03_out;
----
1,0
2,1

# name: MEOS_FLOATSET_VALUES
# description: floatset_values — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatsetvaluess(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatsetvaluess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'
2|'{2.5, 4.5}'

CREATE SINK floatsetvaluess_out(floatsetvaluess.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSET_VALUES(a) AS r FROM floatsetvaluess INTO floatsetvaluess_out;
----
1,{1.500000,3.500000,5.500000}
2,{2.500000,4.500000}

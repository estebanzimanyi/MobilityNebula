# name: MEOS_FLOATSPAN_TO_INTSPAN
# description: floatspan_to_intspan — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspantointspans(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatspantointspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'
2|'[3.5, 9.5)'

CREATE SINK floatspantointspans_out(floatspantointspans.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSPAN_TO_INTSPAN(a) AS r FROM floatspantointspans INTO floatspantointspans_out;
----
1,[1,5)
2,[3,9)

# name: MEOS_FLOAT_TO_TBOX
# description: float_to_tbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floattotboxs(id UINT64, value FLOAT64);
CREATE PHYSICAL SOURCE FOR floattotboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5
2|8.5

CREATE SINK floattotboxs_out(floattotboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOAT_TO_TBOX(value) AS r FROM floattotboxs INTO floattotboxs_out;
----
1,TBOXFLOAT X([5.5, 5.5])
2,TBOXFLOAT X([8.5, 8.5])

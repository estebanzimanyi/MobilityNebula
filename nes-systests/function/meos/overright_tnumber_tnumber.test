# name: MEOS_OverrightTnumberTnumber_CrossVehicle
# description: Cross-vehicle OVERRIGHT_TNUMBER_TNUMBER over two per-vehicle tnumber aggregate outputs (each a VARSIZED hex-WKB tfloat). A=value[1,3]×time[t0,t2]; B=value[2,4]×time[t1,t3] (overlaps A); C=value[10,11]×time[t5,t6] (disjoint, right/after of A).
# groups: [Function, MEOS, TemporalNumber, CrossStream]
CREATE LOGICAL SOURCE orfn(id UINT64, ta VARSIZED, tb VARSIZED);
CREATE PHYSICAL SOURCE FOR orfn TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|0121000E0200000003000000000000F03F00A0AD30CA5A020000000000000008408024CC30CA5A0200|0121000E0200000003000000000000004040E2BC30CA5A02000000000000001040C066DB30CA5A0200
2|0121000E0200000003000000000000F03F00A0AD30CA5A020000000000000008408024CC30CA5A0200|0121000E0200000003000000000000244040EBF930CA5A02000000000000002640802D0931CA5A0200

CREATE SINK orfn_out(orfn.id UINT64, r BOOLEAN) TYPE File;
SELECT id, OVERRIGHT_TNUMBER_TNUMBER(ta, tb) AS r FROM orfn INTO orfn_out;

CREATE SINK ts01_out(ts01.id UINT32, r BOOLEAN) TYPE File;
SELECT id, ADJACENT_TSPATIAL_TSPATIAL(lonA, latA, tsA, lonB, latB, tsB) AS r FROM ts01 INTO ts01_out;

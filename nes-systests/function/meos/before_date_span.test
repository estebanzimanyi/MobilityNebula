# name: MEOS_BEFORE_DATE_SPAN
# description: before_date_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE beforedatespans(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR beforedatespans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01, 2020-01-10)'|'2020-01-03'
2|'[2020-01-05, 2020-01-20)'|'2020-06-15'

CREATE SINK beforedatespans_out(beforedatespans.id UINT64, r INT32) TYPE File;
SELECT id, BEFORE_DATE_SPAN(a, b) AS r FROM beforedatespans INTO beforedatespans_out;
----
1,0
2,0

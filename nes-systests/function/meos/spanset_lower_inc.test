# name: MEOS_SPANSET_LOWER_INC
# description: spanset_lower_inc — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spansetlowerincs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spansetlowerincs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'
2|'{[3, 7)}'

CREATE SINK spansetlowerincs_out(spansetlowerincs.id UINT64, r BOOLEAN) TYPE File;
SELECT id, SPANSET_LOWER_INC(a) AS r FROM spansetlowerincs INTO spansetlowerincs_out;

# name: MEOS_TBOX_GE
# description: tbox_ge — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxges(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxges TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'

CREATE SINK tboxges_out(tboxges.id UINT64, r INT32) TYPE File;
SELECT id, TBOX_GE(a, b) AS r FROM tboxges INTO tboxges_out;
----
1,0
2,1

# name: MEOS_MINUS_CBUFFER_SET
# description: minus_cbuffer_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minuscbuffersets(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR minuscbuffersets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Cbuffer(Point(1 1),0.5)", "Cbuffer(Point(2 2),0.5)"}'|'Cbuffer(Point(9 9),0.5)'
2|'{"Cbuffer(Point(3 3),1.0)", "Cbuffer(Point(4 4),0.5)"}'|'Cbuffer(Point(8 8),0.5)'

CREATE SINK minuscbuffersets_out(minuscbuffersets.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_CBUFFER_SET(a, arg) AS r FROM minuscbuffersets INTO minuscbuffersets_out;
----
1,{"Cbuffer(010100000000000000000022400000000000002240,0.5)"}
2,{"Cbuffer(010100000000000000000020400000000000002040,0.5)"}

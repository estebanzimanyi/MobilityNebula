# name: MEOS_CONTAINED_BIGINT_SPAN
# description: contained_bigint_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containedbigintspas(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR containedbigintspas TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK containedbigintspas_out(containedbigintspas.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_BIGINT_SPAN(a, b) AS r FROM containedbigintspas INTO containedbigintspas_out;

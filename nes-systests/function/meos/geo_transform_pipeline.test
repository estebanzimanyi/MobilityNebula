# name: MEOS_GEO_TRANSFORM_PIPELINE
# description: geo_transform_pipeline — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geotransformpipelis(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geotransformpipelis TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(4.35 50.85)'
2|'SRID=4326;Point(4.36 50.86)'

CREATE SINK geotransformpipelis_out(geotransformpipelis.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEO_TRANSFORM_PIPELINE(a) AS r FROM geotransformpipelis INTO geotransformpipelis_out;

# name: MEOS_TEXT_UPPER
# description: text_upper — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textuppers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR textuppers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Hello World'
2|'foo bar'

CREATE SINK textuppers_out(textuppers.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXT_UPPER(a) AS r FROM textuppers INTO textuppers_out;
----
1,"HELLO WORLD"
2,"FOO BAR"

# name: MEOS_STBOX_TMAX
# description: stbox_tmax — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxtmaxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxtmaxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX XT(((1,1),(5,5)),[2020-01-01, 2020-01-05])'
2|'STBOX XT(((3,3),(7,7)),[2020-01-03, 2020-01-07])'

CREATE SINK stboxtmaxs_out(stboxtmaxs.id UINT64, r INT64) TYPE File;
SELECT id, STBOX_TMAX(a) AS r FROM stboxtmaxs INTO stboxtmaxs_out;
----
1,631497600000000
2,631670400000000

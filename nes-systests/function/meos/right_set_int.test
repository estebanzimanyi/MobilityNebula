# name: MEOS_RIGHT_SET_INT
# description: right_set_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightsetints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR rightsetints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK rightsetints_out(rightsetints.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_SET_INT(a, b) AS r FROM rightsetints INTO rightsetints_out;
----
1,0
2,0

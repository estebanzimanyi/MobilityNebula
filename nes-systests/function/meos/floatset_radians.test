# name: MEOS_FLOATSET_RADIANS
# description: floatset_radians — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatsetradianss(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatsetradianss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'
2|'{3.5, 5.5, 9.5}'

CREATE SINK floatsetradianss_out(floatsetradianss.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSET_RADIANS(a) AS r FROM floatsetradianss INTO floatsetradianss_out;
----
1,{0.026179938779915,0.061086523819802,0.095993108859688}
2,{0.061086523819802,0.095993108859688,0.165806278939461}

# name: MEOS_TSTZSPAN_TO_DATESPAN
# description: tstzspan_to_datespan — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzspantodatespans(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzspantodatespans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)'
2|'[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)'

CREATE SINK tstzspantodatespans_out(tstzspantodatespans.id UINT64, r VARSIZED) TYPE File;
SELECT id, TSTZSPAN_TO_DATESPAN(a) AS r FROM tstzspantodatespans INTO tstzspantodatespans_out;
----
1,[2020-01-01,2020-01-10)
2,[2020-01-05,2020-01-20)

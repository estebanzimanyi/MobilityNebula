CREATE LOGICAL SOURCE tgeoscales(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tgeoscales TYPE File SET('|' AS PARSER.FIELD_DELIMITER);

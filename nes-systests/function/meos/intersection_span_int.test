# name: MEOS_INTERSECTION_SPAN_INT
# description: intersection_span_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectionspanins(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR intersectionspanins TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK intersectionspanins_out(intersectionspanins.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERSECTION_SPAN_INT(a, b) AS r FROM intersectionspanins INTO intersectionspanins_out;

# name: MEOS_OVERLEFT_FLOAT_SPANSET
# description: overleft_float_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overleftfloatspanss(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR overleftfloatspanss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'|3.5
2|'{[3.5, 7.5)}'|7.5

CREATE SINK overleftfloatspanss_out(overleftfloatspanss.id UINT64, r INT32) TYPE File;
SELECT id, OVERLEFT_FLOAT_SPANSET(a, b) AS r FROM overleftfloatspanss INTO overleftfloatspanss_out;
----
1,1
2,0

# name: MEOS_OVERRIGHT_TSPATIAL_STBOX
# groups: [Function, MEOS, SpatioTemporal, Box, Codegen]
CREATE LOGICAL SOURCE tsb18(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tsb18 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200
2|2.0|2.0|1577836800

CREATE SINK tsb18_out(tsb18.id UINT64, r BOOLEAN) TYPE File;
SELECT id, OVERRIGHT_TSPATIAL_STBOX(lon, lat, ts, 'SRID=4326;STBOX XT(((1,1),(3,3)),[2020-01-01,2020-01-02])') AS r FROM tsb18 INTO tsb18_out;
----
1,1
2,1

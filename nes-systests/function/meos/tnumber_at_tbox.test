# name: MEOS_TNUMBER_AT_TBOX
# description: tnumber_at_tbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tnumberattboxs(id UINT64, value INT32, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tnumberattboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5|1609459200|'TBOXINT XT([1, 10],[2020-01-01, 2022-01-01])'
2|8|1609545600|'TBOXINT XT([1, 10],[2020-01-01, 2022-01-01])'

CREATE SINK tnumberattboxs_out(tnumberattboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, TNUMBER_AT_TBOX(value, ts, arg) AS r FROM tnumberattboxs INTO tnumberattboxs_out;

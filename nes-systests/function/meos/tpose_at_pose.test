# name: MEOS_TPOSE_AT_POSE
# description: tpose_at_pose — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tposeatposes(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tposeatposes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|0.5|1609459200|'Pose(Point(1 1), 0.5)'
2|2.0|2.0|1.0|1609545600|'Pose(Point(2 2), 1.0)'

CREATE SINK tposeatposes_out(tposeatposes.id UINT64, r VARSIZED) TYPE File;
SELECT id, TPOSE_AT_POSE(x, y, theta, ts, arg) AS r FROM tposeatposes INTO tposeatposes_out;
----
1,Pose(POINT(1 1),0.5)@2021-01-01 00:00:00+00
2,Pose(POINT(2 2),1)@2021-01-02 00:00:00+00

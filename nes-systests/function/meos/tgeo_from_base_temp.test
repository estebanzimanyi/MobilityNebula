# name: MEOS_TGEO_FROM_BASE_TEMP
# description: TGEO_FROM_BASE_TEMP builds a temporal geo holding a fixed geometry value over the time frame of a temporal (a hex-WKB tfloat), emitted as hex-WKB.
# groups: [Function, MEOS, SpatioTemporal]
CREATE LOGICAL SOURCE tgeofrombasetemps(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR tgeofrombasetemps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Polygon((0 0,1 0,1 1,0 1,0 0))'|0121000E0200000003000000000000F03F00A0AD30CA5A020000000000000000400000854EDE5A0200

CREATE SINK tgeofrombasetemps_out(tgeofrombasetemps.id UINT64, r VARSIZED) TYPE File;
SELECT id, TGEO_FROM_BASE_TEMP(a, b) AS r FROM tgeofrombasetemps INTO tgeofrombasetemps_out;
----
1,

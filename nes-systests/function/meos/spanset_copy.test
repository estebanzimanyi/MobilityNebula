# name: MEOS_SPANSET_COPY
# description: spanset_copy — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spansetcopys(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spansetcopys TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'
2|'{[3.5, 7.5)}'

CREATE SINK spansetcopys_out(spansetcopys.id UINT64, r VARSIZED) TYPE File;
SELECT id, SPANSET_COPY(a) AS r FROM spansetcopys INTO spansetcopys_out;
----
1,{[1.5,5.5),[10.5,15.5)}
2,{[3.5,7.5)}

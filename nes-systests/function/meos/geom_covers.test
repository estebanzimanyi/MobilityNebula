# name: MEOS_GEOM_COVERS
# description: geom_covers — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomcoverss(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geomcoverss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(0 0, 2 2)'|'SRID=4326;Linestring(0 2, 2 0)'
2|'SRID=4326;Linestring(0 0, 3 3)'|'SRID=4326;Linestring(1 0, 1 3)'

CREATE SINK geomcoverss_out(geomcoverss.id UINT64, r INT32) TYPE File;
SELECT id, GEOM_COVERS(a, arg) AS r FROM geomcoverss INTO geomcoverss_out;
----
1,0
2,0

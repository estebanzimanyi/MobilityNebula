# name: MEOS_TEMPORAL_LE
# groups: [Function, MEOS, Codegen]
CREATE LOGICAL SOURCE tempora6(id UINT64, lonA FLOAT64, latA FLOAT64, tsA UINT64, lonB FLOAT64, latB FLOAT64, tsB UINT64);
CREATE PHYSICAL SOURCE FOR tempora6 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.0|50.0|1609459200|5.0|51.0|1609459200
2|4.0|50.0|1609459200|4.0|50.0|1609459200

CREATE SINK tempora6_out(tempora6.id UINT64, r BOOLEAN) TYPE File;
SELECT id, TEMPORAL_LE(lonA, latA, tsA, lonB, latB, tsB) AS r FROM tempora6 INTO tempora6_out;

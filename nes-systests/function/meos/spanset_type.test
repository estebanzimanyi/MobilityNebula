# name: MEOS_SPANSET_TYPE
# description: spanset_type — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spansettypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spansettypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 20)}'
2|'{[3, 25)}'

CREATE SINK spansettypes_out(spansettypes.id UINT64, r INT32) TYPE File;
SELECT id, SPANSET_TYPE(a) AS r FROM spansettypes INTO spansettypes_out;
----
1,0
2,0

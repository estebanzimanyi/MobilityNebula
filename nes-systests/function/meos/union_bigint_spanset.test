CREATE LOGICAL SOURCE unionbigintspansets(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR unionbigintspansets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);

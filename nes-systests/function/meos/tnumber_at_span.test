CREATE SINK tnumberatspans_out(tnumberatspans.id UINT64, r VARSIZED) TYPE File;
SELECT id, TNUMBER_AT_SPAN(value, ts, arg) AS r FROM tnumberatspans INTO tnumberatspans_out;

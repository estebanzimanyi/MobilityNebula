# name: MEOS_TNUMBER_AT_SPAN
# description: tnumber_at_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tnumberatspans(id UINT64, value INT32, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tnumberatspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

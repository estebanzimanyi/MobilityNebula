CREATE LOGICAL SOURCE tgeospacetimesplits(id UINT64, lon FLOAT64, lat FLOAT64, z FLOAT64, ts UINT64, x0 FLOAT64, x1 FLOAT64, x2 FLOAT64, x3 VARSIZED);
CREATE PHYSICAL SOURCE FOR tgeospacetimesplits TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|3.0|3.0|3.0|1609459200|5.0|5.0|5.0|'1 day'
2|6.0|6.0|6.0|1609545600|5.0|5.0|5.0|'2 days'

CREATE SINK tgeospacetimesplits_out(tgeospacetimesplits.id UINT64, r VARSIZED) TYPE File;
SELECT id, TGEO_SPACE_TIME_SPLIT(lon, lat, z, ts, x0, x1, x2, x3) AS r FROM tgeospacetimesplits INTO tgeospacetimesplits_out;

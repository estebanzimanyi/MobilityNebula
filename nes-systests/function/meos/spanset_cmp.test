# name: MEOS_SPANSET_CMP
# description: spanset_cmp — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spansetcmps(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR spansetcmps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|'{[1, 5), [10, 15)}'
2|'{[3, 7)}'|'{[3, 7)}'

CREATE SINK spansetcmps_out(spansetcmps.id UINT64, r INT32) TYPE File;
SELECT id, SPANSET_CMP(a, b) AS r FROM spansetcmps INTO spansetcmps_out;
----
1,0
2,0

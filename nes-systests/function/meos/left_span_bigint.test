# name: MEOS_LEFT_SPAN_BIGINT
# description: left_span_bigint — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE leftspanbigints(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR leftspanbigints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK leftspanbigints_out(leftspanbigints.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_SPAN_BIGINT(a, b) AS r FROM leftspanbigints INTO leftspanbigints_out;

# name: MEOS_NAI_TPOSE_TPOSE
# description: nai_tpose_tpose — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE naitposetposes(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64, x2 FLOAT64, y2 FLOAT64, theta2 FLOAT64, ts2 UINT64);
CREATE PHYSICAL SOURCE FOR naitposetposes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);

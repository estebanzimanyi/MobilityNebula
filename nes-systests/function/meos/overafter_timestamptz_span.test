# name: MEOS_OVERAFTER_TIMESTAMPTZ_SPAN
# description: overafter_timestamptz_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overaftertimestamps(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR overaftertimestamps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)'|'2020-01-03 00:00:00+00'
2|'[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)'|'2020-06-15 12:00:00+00'

CREATE SINK overaftertimestamps_out(overaftertimestamps.id UINT64, r INT32) TYPE File;
SELECT id, OVERAFTER_TIMESTAMPTZ_SPAN(a, b) AS r FROM overaftertimestamps INTO overaftertimestamps_out;
----
1,1
2,1

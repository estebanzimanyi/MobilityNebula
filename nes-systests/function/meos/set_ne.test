# name: MEOS_SET_NE
# description: set_ne — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE setnes(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR setnes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|'{1, 3, 5}'
2|'{3, 5, 9}'|'{3, 5, 9}'

CREATE SINK setnes_out(setnes.id UINT64, r INT32) TYPE File;
SELECT id, SET_NE(a, b) AS r FROM setnes INTO setnes_out;
----
1,0
2,0

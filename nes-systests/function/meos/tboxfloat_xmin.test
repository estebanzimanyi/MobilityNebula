# name: MEOS_TBOXFLOAT_XMIN
# description: tboxfloat_xmin — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxfloatxmins(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxfloatxmins TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'

CREATE SINK tboxfloatxmins_out(tboxfloatxmins.id UINT64, r FLOAT64) TYPE File;
SELECT id, TBOXFLOAT_XMIN(a) AS r FROM tboxfloatxmins INTO tboxfloatxmins_out;
----
1,1.0
2,3.0

# name: MEOS_POSE_LT
# description: pose_lt — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE poselts(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR poselts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'|'Pose(Point(2 2), 1.0)'
2|'Pose(Point(2 2), 1.0)'|'Pose(Point(1 1), 0.5)'

CREATE SINK poselts_out(poselts.id UINT64, r INT32) TYPE File;
SELECT id, POSE_LT(a, b) AS r FROM poselts INTO poselts_out;
----
1,0
2,1

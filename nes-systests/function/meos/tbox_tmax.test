# name: MEOS_TBOX_TMAX
# description: tbox_tmax — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxtmaxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxtmaxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'

CREATE SINK tboxtmaxs_out(tboxtmaxs.id UINT64, r INT64) TYPE File;
SELECT id, TBOX_TMAX(a) AS r FROM tboxtmaxs INTO tboxtmaxs_out;
----
1,631497600000000
2,631670400000000

# name: MEOS_GEOM_CENTROID
# description: geom_centroid — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomcentroids(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geomcentroids TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(1 1, 2 2)'
2|'SRID=4326;Linestring(3 3, 4 4, 5 5)'

CREATE SINK geomcentroids_out(geomcentroids.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEOM_CENTROID(a) AS r FROM geomcentroids INTO geomcentroids_out;
----
1,0101000020E6100000000000000000F83F000000000000F83F
2,0101000020E610000000000000000010400000000000001040

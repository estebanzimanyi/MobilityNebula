# name: MEOS_GEOM_INTERSECTS2D
# description: geom_intersects2d — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomintersects2ds(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geomintersects2ds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(0 0, 2 2)'|'SRID=4326;Linestring(0 2, 2 0)'
2|'SRID=4326;Linestring(0 0, 3 3)'|'SRID=4326;Linestring(1 0, 1 3)'

CREATE SINK geomintersects2ds_out(geomintersects2ds.id UINT64, r INT32) TYPE File;
SELECT id, GEOM_INTERSECTS2D(a, arg) AS r FROM geomintersects2ds INTO geomintersects2ds_out;
----
1,1
2,1

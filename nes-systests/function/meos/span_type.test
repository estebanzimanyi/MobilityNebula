# name: MEOS_SPAN_TYPE
# description: span_type — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spantypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spantypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 20)'
2|'[3, 25)'

CREATE SINK spantypes_out(spantypes.id UINT64, r INT32) TYPE File;
SELECT id, SPAN_TYPE(a) AS r FROM spantypes INTO spantypes_out;
----
1,1
2,1

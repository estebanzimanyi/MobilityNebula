# name: MEOS_EContains_TCbuffer_Geo
# description: TEMPORAL_EDWITHIN_TCBUFFER: single-instant tcbuffer (lon,lat,radius) r a static geometry constant.
# groups: [Function, MEOS, SpatioTemporal, TCbuffer, EContains]
CREATE LOGICAL SOURCE edcg(id UINT32, lon FLOAT64, lat FLOAT64, radius FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR edcg TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1.0|1609459200
2|10.0|10.0|0.5|1609459200

CREATE SINK edcg_out(edcg.id UINT32, r INT32) TYPE File;
SELECT id, TEMPORAL_EDWITHIN_TCBUFFER_GEOMETRY(lon, lat, radius, timestamp, 'POINT(4.3658 50.6456)', FLOAT64(0.5)) AS r FROM edcg INTO edcg_out;
----
1,1
2,0

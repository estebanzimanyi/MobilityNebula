# name: MEOS_TLE_TEXT_TTEXT
# description: tle_text_ttext — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tletextttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tletextttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'XYZ'
2|'DEF'|1609545600|'XYZ'

CREATE SINK tletextttexts_out(tletextttexts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TLE_TEXT_TTEXT(value, ts, arg) AS r FROM tletextttexts INTO tletextttexts_out;
----
1,f@2021-01-01,00:00:00+00
2,f@2021-01-02,00:00:00+00

# name: MEOS_DATE_GET_BIN
# description: date_get_bin — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE dategetbins(id UINT64, value INT32, arg0 VARSIZED, arg1 VARSIZED);
CREATE PHYSICAL SOURCE FOR dategetbins TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|100|'1 day'|'2020-01-01'
2|200|'2 days'|'2020-01-01'

CREATE SINK dategetbins_out(dategetbins.id UINT64, r INT32) TYPE File;
SELECT id, DATE_GET_BIN(value, arg0, arg1) AS r FROM dategetbins INTO dategetbins_out;
----
1,100
2,199

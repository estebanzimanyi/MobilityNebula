# name: MEOS_SPANSET_TO_TBOX
# description: spanset_to_tbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spansettotboxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spansettotboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'
2|'{[3.5, 7.5)}'

CREATE SINK spansettotboxs_out(spansettotboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, SPANSET_TO_TBOX(a) AS r FROM spansettotboxs INTO spansettotboxs_out;
----
1,TBOXFLOAT X([1.5, 15.5))
2,TBOXFLOAT X([3.5, 7.5))

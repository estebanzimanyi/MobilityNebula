# name: MEOS_FRONT_STBOX_STBOX
# description: Cross-vehicle FRONT_STBOX_STBOX over two per-vehicle extent STBoxes (each a VARSIZED stbox text, e.g. two TSPATIAL_EXTENT_TRANSFN outputs in a self-join). Box A=((1,1),(3,3)); B=((2,2),(4,4)) overlaps A; C=((10,10),(11,11)) is disjoint and to the right of A.
# groups: [Function, MEOS, SpatioTemporal, Box, CrossStream]
CREATE LOGICAL SOURCE sbz05(id UINT64, boxa VARSIZED, boxb VARSIZED);
CREATE PHYSICAL SOURCE FOR sbz05 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|STBOX Z((1,1,1),(3,3,3))|STBOX Z((2,2,2),(4,4,4))
2|STBOX Z((1,1,1),(3,3,3))|STBOX Z((10,10,10),(11,11,11))

CREATE SINK sbz05_out(sbz05.id UINT64, r BOOLEAN) TYPE File;
SELECT id, FRONT_STBOX_STBOX(boxa, boxb) AS r FROM sbz05 INTO sbz05_out;
----
1,0
2,1

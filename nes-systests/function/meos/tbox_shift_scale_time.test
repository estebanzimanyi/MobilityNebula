# name: MEOS_TBOX_SHIFT_SCALE_TIME
# description: tbox_shift_scale_time — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxshiftscaletimes(id UINT64, a VARSIZED, arg0 VARSIZED, arg1 VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxshiftscaletimes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'|'1 day'|'1 day'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'|'2 days'|'2 days'

CREATE SINK tboxshiftscaletimes_out(tboxshiftscaletimes.id UINT64, r VARSIZED) TYPE File;
SELECT id, TBOX_SHIFT_SCALE_TIME(a, arg0, arg1) AS r FROM tboxshiftscaletimes INTO tboxshiftscaletimes_out;
----
1,TBOXFLOAT XT([1, 5],[2020-01-02 00:00:00+00, 2020-01-03 00:00:00+00])
2,TBOXFLOAT XT([3, 7],[2020-01-05 00:00:00+00, 2020-01-07 00:00:00+00])

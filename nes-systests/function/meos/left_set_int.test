# name: MEOS_LEFT_SET_INT
# description: left_set_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE leftsetints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR leftsetints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK leftsetints_out(leftsetints.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_SET_INT(a, b) AS r FROM leftsetints INTO leftsetints_out;
----
1,0
2,0

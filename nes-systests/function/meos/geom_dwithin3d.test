# name: MEOS_GEOM_DWITHIN3D
# description: geom_dwithin3d — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomdwithin3ds(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geomdwithin3ds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(0 0)'|'SRID=4326;Point(1 1)'
2|'SRID=4326;Point(0 0)'|'SRID=4326;Point(0 0)'

CREATE SINK geomdwithin3ds_out(geomdwithin3ds.id UINT64, r INT32) TYPE File;
SELECT id, GEOM_DWITHIN3D(a, arg) AS r FROM geomdwithin3ds INTO geomdwithin3ds_out;
----
1,1
2,1

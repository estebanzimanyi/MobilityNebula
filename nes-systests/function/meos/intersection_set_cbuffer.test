# name: MEOS_INTERSECTION_SET_CBUFFER
# description: intersection_set_cbuffer — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectionsetcbus(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR intersectionsetcbus TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Cbuffer(Point(1 1),0.5)", "Cbuffer(Point(2 2),0.5)"}'|'Cbuffer(Point(1 1),0.5)'
2|'{"Cbuffer(Point(3 3),1.0)", "Cbuffer(Point(4 4),0.5)"}'|'Cbuffer(Point(3 3),1.0)'

CREATE SINK intersectionsetcbus_out(intersectionsetcbus.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERSECTION_SET_CBUFFER(a, arg) AS r FROM intersectionsetcbus INTO intersectionsetcbus_out;
----
1,{"Cbuffer(0101000000000000000000F03F000000000000F03F,0.5)"}
2,{"Cbuffer(010100000000000000000008400000000000000840,1)"}

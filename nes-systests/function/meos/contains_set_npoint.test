# name: MEOS_CONTAINS_SET_NPOINT
# description: contains_set_npoint — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containssetnpoints(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR containssetnpoints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Npoint(1,0.5)", "Npoint(2,0.5)"}'|'Npoint(1,0.5)'
2|'{"Npoint(1,0.7)", "Npoint(3,0.5)"}'|'Npoint(1,0.7)'

CREATE SINK containssetnpoints_out(containssetnpoints.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINS_SET_NPOINT(a, arg) AS r FROM containssetnpoints INTO containssetnpoints_out;
----
1,1
2,1

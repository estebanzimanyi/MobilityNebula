# name: MEOS_STBOX_TO_GEO
# description: stbox_to_geo — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxtogeos(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxtogeos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'
2|'STBOX X((3,3),(7,7))'

CREATE SINK stboxtogeos_out(stboxtogeos.id UINT64, r VARSIZED) TYPE File;
SELECT id, STBOX_TO_GEO(a) AS r FROM stboxtogeos INTO stboxtogeos_out;

# name: MEOS_TRGEOMETRY_INSTANTS_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE trinst(gid UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR trinst TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|0.1|1609459200
1|2.0|2.0|0.2|1609459201
1|3.0|3.0|0.3|1609459202
2|5.0|5.0|0.5|1609459200
2|6.0|6.0|0.6|1609459201

CREATE SINK trinst_out(trinst.gid UINT64, trinst.r VARSIZED) TYPE File;
SELECT gid, TRGEOMETRY_INSTANTS(x, y, theta, ts) AS r FROM trinst GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO trinst_out;

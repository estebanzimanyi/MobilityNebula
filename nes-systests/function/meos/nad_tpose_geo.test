# name: MEOS_NAD_TPOSE_GEO
# groups: [Function, MEOS, Codegen]
CREATE LOGICAL SOURCE ndpg(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR ndpg TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.0|50.0|0.5|1609459200
2|5.0|51.0|0.3|1609459200

CREATE SINK ndpg_out(ndpg.id UINT64, r FLOAT64) TYPE File;
SELECT id, TEMPORAL_NAD_TPOSE_GEOMETRY(x, y, theta, ts, 'POINT(0 0)') AS r FROM ndpg INTO ndpg_out;

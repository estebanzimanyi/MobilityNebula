# name: MEOS_TIMESPANSET_TYPE
# description: timespanset_type — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE timespansettypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR timespansettypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 20)}'
2|'{[3, 25)}'

CREATE SINK timespansettypes_out(timespansettypes.id UINT64, r INT32) TYPE File;
SELECT id, TIMESPANSET_TYPE(a) AS r FROM timespansettypes INTO timespansettypes_out;

# name: MEOS_SET_TO_SPANSET
# description: set_to_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE settospansets(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR settospansets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'
2|'{3.5, 5.5, 9.5}'

CREATE SINK settospansets_out(settospansets.id UINT64, r VARSIZED) TYPE File;
SELECT id, SET_TO_SPANSET(a) AS r FROM settospansets INTO settospansets_out;
----
1,{[1.5,1.5],[3.5,3.5],[5.5,5.5]}
2,{[3.5,3.5],[5.5,5.5],[9.5,9.5]}

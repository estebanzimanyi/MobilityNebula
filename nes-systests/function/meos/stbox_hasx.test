# name: MEOS_STBOX_HASX
# description: stbox_hasx — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxhasxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxhasxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'
2|'STBOX X((3,3),(7,7))'

CREATE SINK stboxhasxs_out(stboxhasxs.id UINT64, r BOOLEAN) TYPE File;
SELECT id, STBOX_HASX(a) AS r FROM stboxhasxs INTO stboxhasxs_out;
----
1,1
2,1

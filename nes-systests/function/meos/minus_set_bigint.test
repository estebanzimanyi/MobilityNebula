# name: MEOS_MINUS_SET_BIGINT
# description: minus_set_bigint — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minussetbigints(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR minussetbigints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK minussetbigints_out(minussetbigints.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_SET_BIGINT(a, b) AS r FROM minussetbigints INTO minussetbigints_out;

# name: MEOS_SET_TO_SPAN
# description: set_to_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE settospans(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR settospans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'
2|'{3.5, 5.5, 9.5}'

CREATE SINK settospans_out(settospans.id UINT64, r VARSIZED) TYPE File;
SELECT id, SET_TO_SPAN(a) AS r FROM settospans INTO settospans_out;
----
1,[1.5,5.5]
2,[3.5,9.5]

# name: MEOS_SPANSET_UNION_TRANSFN
# description: Windowed SPANSET_UNION_TRANSFN -> aggregate container (text) over a stream of VARSIZED literals; timestamp is windowing-only.
# groups: [Function, MEOS, Set, Span, Aggregation]
CREATE LOGICAL SOURCE cssu(vehicle_id UINT64, value VARSIZED, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR cssu TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|{[1.5, 5.5)}|1609459200
1|{[10.5, 15.5)}|1609462800

CREATE SINK cssu_out(cssu.vehicle_id UINT64, cssu.r VARSIZED) TYPE File;
SELECT vehicle_id, SPANSET_UNION_TRANSFN(value, timestamp) AS r FROM cssu GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO cssu_out;
----
1,{[1.5, 5.5), [10.5, 15.5)}

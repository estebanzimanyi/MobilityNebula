# name: MEOS_NPOINTSET_END_VALUE
# description: npointset_end_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointsetendvalues(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR npointsetendvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Npoint(1,0.5)", "Npoint(2,0.5)"}'
2|'{"Npoint(1,0.7)", "Npoint(3,0.5)"}'

CREATE SINK npointsetendvalues_out(npointsetendvalues.id UINT64, r VARSIZED) TYPE File;
SELECT id, NPOINTSET_END_VALUE(a) AS r FROM npointsetendvalues INTO npointsetendvalues_out;
----
1,NPoint(2,0.5)
2,NPoint(3,0.5)

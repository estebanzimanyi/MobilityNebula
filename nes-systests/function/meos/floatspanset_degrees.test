# name: MEOS_FLOATSPANSET_DEGREES
# description: floatspanset_degrees — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspansetdegrees(id UINT64, a VARSIZED, norm BOOLEAN);
CREATE PHYSICAL SOURCE FOR floatspansetdegrees TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'|false
2|'{[3.5, 7.5)}'|false

CREATE SINK floatspansetdegrees_out(floatspansetdegrees.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSPANSET_DEGREES(a, norm) AS r FROM floatspansetdegrees INTO floatspansetdegrees_out;
----
1,{[85.94366926962348, 315.12678732195275), [601.6056848873644, 888.084582452776)}

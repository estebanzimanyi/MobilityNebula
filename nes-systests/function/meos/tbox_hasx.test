# name: MEOS_TBOX_HASX
# description: tbox_hasx — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxhasxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxhasxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'

CREATE SINK tboxhasxs_out(tboxhasxs.id UINT64, r BOOLEAN) TYPE File;
SELECT id, TBOX_HASX(a) AS r FROM tboxhasxs INTO tboxhasxs_out;
----
1,1
2,1

# name: MEOS_CONTAINS_SPAN_INT
# description: contains_span_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containsspanints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR containsspanints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK containsspanints_out(containsspanints.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINS_SPAN_INT(a, b) AS r FROM containsspanints INTO containsspanints_out;

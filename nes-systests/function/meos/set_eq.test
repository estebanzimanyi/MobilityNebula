# name: MEOS_SET_EQ
# description: set_eq — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE seteqs(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR seteqs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|'{1, 3, 5}'
2|'{3, 5, 9}'|'{3, 5, 9}'

CREATE SINK seteqs_out(seteqs.id UINT64, r INT32) TYPE File;
SELECT id, SET_EQ(a, b) AS r FROM seteqs INTO seteqs_out;
----
1,1
2,1

# name: MEOS_TIMESET_TYPE
# description: timeset_type — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE timesettypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR timesettypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{2, 4}'

CREATE SINK timesettypes_out(timesettypes.id UINT64, r INT32) TYPE File;
SELECT id, TIMESET_TYPE(a) AS r FROM timesettypes INTO timesettypes_out;
----
1,0
2,0

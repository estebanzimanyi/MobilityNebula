# name: MEOS_INTSPANSET_BINS
# description: intspanset_bins — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intspansetbinss(id UINT64, a VARSIZED, x0 INT32, x1 INT32);
CREATE PHYSICAL SOURCE FOR intspansetbinss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 20)}'|5|0
2|'{[3, 25)}'|5|0

CREATE SINK intspansetbinss_out(intspansetbinss.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTSPANSET_BINS(a, x0, x1) AS r FROM intspansetbinss INTO intspansetbinss_out;
----
1,{[1,5),[5,10),[10,15),[15,20)}
2,{[3,5),[5,10),[10,15),[15,20),[20,25)}

# name: MEOS_FLOATSET_MAKE_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE floatsetmakes(gid UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR floatsetmakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.5|1609459200
1|2.5|1609459201
1|3.5|1609459202
2|5.5|1609459200
2|6.5|1609459201

CREATE SINK floatsetmakes_out(floatsetmakes.gid UINT64, floatsetmakes.r VARSIZED) TYPE File;
SELECT gid, FLOATSET_MAKE(value, ts) AS r FROM floatsetmakes GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO floatsetmakes_out;

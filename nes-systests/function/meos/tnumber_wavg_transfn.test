# name: MEOS_TNUMBER_WAVG_TRANSFN
# description: Windowed TNUMBER_WAVG_TRANSFN -> aggregate Temporal (hex-WKB) via the per-op windowed tagg transfn (1-hour radius).
# groups: [Function, MEOS, TemporalNumber, Aggregation]
CREATE LOGICAL SOURCE wav(vehicle_id UINT64, value FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR wav TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.0|1609459200
1|6.0|1609459200
1|9.0|1609462800

CREATE SINK wav_out(wav.vehicle_id UINT64, wav.r VARSIZED) TYPE File;
SELECT vehicle_id, TNUMBER_WAVG_TRANSFN(value, timestamp) AS r FROM wav GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO wav_out;

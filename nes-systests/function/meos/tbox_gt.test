# name: MEOS_TBOX_GT
# description: tbox_gt — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxgts(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxgts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'

CREATE SINK tboxgts_out(tboxgts.id UINT64, r INT32) TYPE File;
SELECT id, TBOX_GT(a, b) AS r FROM tboxgts INTO tboxgts_out;
----
1,0
2,1

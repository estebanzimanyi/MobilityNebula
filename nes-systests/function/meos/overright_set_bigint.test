# name: MEOS_OVERRIGHT_SET_BIGINT
# description: overright_set_bigint — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overrightsetbigints(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR overrightsetbigints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK overrightsetbigints_out(overrightsetbigints.id UINT64, r INT32) TYPE File;
SELECT id, OVERRIGHT_SET_BIGINT(a, b) AS r FROM overrightsetbigints INTO overrightsetbigints_out;

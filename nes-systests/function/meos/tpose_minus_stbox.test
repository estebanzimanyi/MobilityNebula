# name: MEOS_TPOSE_MINUS_STBOX
# description: tpose_minus_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tposeminusstboxs(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tposeminusstboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|0.5|1609459200|'STBOX X((40,40),(60,60))'
2|2.0|2.0|1.0|1609545600|'STBOX X((40,40),(60,60))'

CREATE SINK tposeminusstboxs_out(tposeminusstboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, TPOSE_MINUS_STBOX(x, y, theta, ts, arg) AS r FROM tposeminusstboxs INTO tposeminusstboxs_out;

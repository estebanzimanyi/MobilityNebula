CREATE LOGICAL SOURCE adtt(id UINT32, lonA FLOAT64, latA FLOAT64, tsA UINT64, lonB FLOAT64, latB FLOAT64, tsB UINT64);
CREATE PHYSICAL SOURCE FOR adtt TYPE File SET('|' AS PARSER.FIELD_DELIMITER);

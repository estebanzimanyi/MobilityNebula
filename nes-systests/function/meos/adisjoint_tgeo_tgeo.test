CREATE SINK adtt_out(adtt.id UINT32, r INT32) TYPE File;
SELECT id, ADISJOINT_TGEO_TGEO(lonA, latA, tsA, lonB, latB, tsB) AS r FROM adtt INTO adtt_out;

# name: MEOS_SET_CMP
# description: set_cmp — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE setcmps(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR setcmps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|'{1, 3, 5}'
2|'{3, 5, 9}'|'{3, 5, 9}'

CREATE SINK setcmps_out(setcmps.id UINT64, r INT32) TYPE File;
SELECT id, SET_CMP(a, b) AS r FROM setcmps INTO setcmps_out;
----
1,0
2,0

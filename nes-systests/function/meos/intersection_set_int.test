# name: MEOS_INTERSECTION_SET_INT
# description: intersection_set_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectionsetints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR intersectionsetints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{2, 4, 6}'|4

CREATE SINK intersectionsetints_out(intersectionsetints.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERSECTION_SET_INT(a, b) AS r FROM intersectionsetints INTO intersectionsetints_out;

# name: function/spatiotemporal/MEOS_ETOUCHES_TCBUFFER_TCBUFFER
# description: Per-event ever-r between two single-instant tcbuffers (lonA, latA, radiusA, tsA, lonB, latB, radiusB, tsB). Exercises the W12 codegen shape — new 8-arg lift template with two tcbuffer_in() per-event constructions.
# groups: [Function, MEOS, SpatioTemporal, TCbuffer, EIntersects, Codegen]

CREATE LOGICAL SOURCE tct04(id UINT32, lonA FLOAT64, latA FLOAT64, radiusA FLOAT64, tsA UINT64, lonB FLOAT64, latB FLOAT64, radiusB FLOAT64, tsB UINT64);
CREATE PHYSICAL SOURCE FOR tct04 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|10.0|1609459200|4.3658|50.6456|5.0|1609459200
2|4.3658|50.6456|0.0001|1609459200|4.5000|50.8000|0.0001|1609459200

CREATE SINK tct04_out(tct04.id UINT32, r INT32) TYPE File;
SELECT id,
       ETOUCHES_TCBUFFER_TCBUFFER(lonA, latA, radiusA, tsA, lonB, latB, radiusB, tsB) AS r
FROM tct04
INTO tct04_out;
----
1,0
2,0

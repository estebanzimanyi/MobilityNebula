# name: MEOS_OVERLEFT_SET_INT
# description: overleft_set_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overleftsetints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR overleftsetints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK overleftsetints_out(overleftsetints.id UINT64, r INT32) TYPE File;
SELECT id, OVERLEFT_SET_INT(a, b) AS r FROM overleftsetints INTO overleftsetints_out;
----
1,0
2,0

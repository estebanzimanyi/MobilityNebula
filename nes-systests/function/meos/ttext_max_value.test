# name: MEOS_TTEXT_MAX_VALUE
# description: ttext_max_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE ttextmaxvalues(id UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR ttextmaxvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200
2|'DEF'|1609545600

CREATE SINK ttextmaxvalues_out(ttextmaxvalues.id UINT64, r VARSIZED) TYPE File;
SELECT id, TTEXT_MAX_VALUE(value, ts) AS r FROM ttextmaxvalues INTO ttextmaxvalues_out;
----
1,"ABC"
2,"DEF"

# name: MEOS_INTERSECTION_FLOAT_SET
# description: intersection_float_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectionfloatss(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR intersectionfloatss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|3.5
2|'{2.5, 4.5, 6.5}'|4.5

CREATE SINK intersectionfloatss_out(intersectionfloatss.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERSECTION_FLOAT_SET(a, b) AS r FROM intersectionfloatss INTO intersectionfloatss_out;
----
1,{3.5}
2,{4.5}

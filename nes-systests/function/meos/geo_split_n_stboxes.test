# name: MEOS_GEO_SPLIT_N_STBOXES
# description: geo_split_n_stboxes — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geosplitnstboxess(id UINT64, a VARSIZED, x0 INT32);
CREATE PHYSICAL SOURCE FOR geosplitnstboxess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(0 0, 2 2, 4 4)'|2
2|'SRID=4326;Linestring(1 1, 3 3)'|2

CREATE SINK geosplitnstboxess_out(geosplitnstboxess.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEO_SPLIT_N_STBOXES(a, x0) AS r FROM geosplitnstboxess INTO geosplitnstboxess_out;
----
1,{SRID=4326;STBOX X((0,0),(2,2)), SRID=4326;STBOX X((2,2),(4,4))}
2,{SRID=4326;STBOX X((1,1),(3,3))}

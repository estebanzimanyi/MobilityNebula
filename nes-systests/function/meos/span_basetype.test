# name: MEOS_SPAN_BASETYPE
# description: span_basetype — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spanbasetypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spanbasetypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 20)'
2|'[3, 25)'

CREATE SINK spanbasetypes_out(spanbasetypes.id UINT64, r INT32) TYPE File;
SELECT id, SPAN_BASETYPE(a) AS r FROM spanbasetypes INTO spanbasetypes_out;
----
1,0
2,0

# name: MEOS_LEFT_INT_SET
# description: left_int_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE leftintsets(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR leftintsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK leftintsets_out(leftintsets.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_INT_SET(a, b) AS r FROM leftintsets INTO leftintsets_out;
----
1,0
2,0

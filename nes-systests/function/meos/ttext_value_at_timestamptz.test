# name: MEOS_TTEXT_VALUE_AT_TIMESTAMPTZ
# description: ttext_value_at_timestamptz — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE ttextvalueattimests(id UINT64, value VARSIZED, ts UINT64, qts VARSIZED, strict BOOLEAN);
CREATE PHYSICAL SOURCE FOR ttextvalueattimests TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'2021-01-01 00:00:00+00'|false
2|'DEF'|1609545600|'2021-01-02 00:00:00+00'|false

CREATE SINK ttextvalueattimests_out(ttextvalueattimests.id UINT64, r VARSIZED) TYPE File;
SELECT id, TTEXT_VALUE_AT_TIMESTAMPTZ(value, ts, qts, strict) AS r FROM ttextvalueattimests INTO ttextvalueattimests_out;

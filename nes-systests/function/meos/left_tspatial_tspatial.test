2|4.3658|50.6456|1609459200|4.3658|50.6456|1609459200

CREATE SINK ts09_out(ts09.id UINT32, r BOOLEAN) TYPE File;
SELECT id, LEFT_TSPATIAL_TSPATIAL(lonA, latA, tsA, lonB, latB, tsB) AS r FROM ts09 INTO ts09_out;

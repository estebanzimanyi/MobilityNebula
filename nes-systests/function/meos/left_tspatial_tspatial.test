# name: MEOS_LEFT_TSPATIAL_TSPATIAL
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, EDisjoint]
CREATE LOGICAL SOURCE ts09(id UINT32, lonA FLOAT64, latA FLOAT64, tsA UINT64, lonB FLOAT64, latB FLOAT64, tsB UINT64);
CREATE PHYSICAL SOURCE FOR ts09 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

# name: MEOS_GEOM_BUFFER
# description: geom_buffer — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geombuffers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geombuffers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(1 1)'
2|'SRID=4326;Point(2 2)'

CREATE SINK geombuffers_out(geombuffers.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEOM_BUFFER(a) AS r FROM geombuffers INTO geombuffers_out;
----
1,
2,

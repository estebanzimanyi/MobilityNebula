CREATE LOGICAL SOURCE floatspansetlowers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatspansetlowers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

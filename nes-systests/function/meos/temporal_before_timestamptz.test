# name: MEOS_TEMPORAL_BEFORE_TIMESTAMPTZ
# description: temporal_before_timestamptz — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE temporalbeforetimes(id UINT64, value FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR temporalbeforetimes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200|'2025-01-01 00:00:00+00'
2|8.5|1609545600|'2025-01-01 00:00:00+00'

CREATE SINK temporalbeforetimes_out(temporalbeforetimes.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEMPORAL_BEFORE_TIMESTAMPTZ(value, ts, arg) AS r FROM temporalbeforetimes INTO temporalbeforetimes_out;

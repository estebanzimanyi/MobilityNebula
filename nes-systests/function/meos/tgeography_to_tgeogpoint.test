# name: MEOS_TGEOGRAPHY_TO_TGEOGPOINT
# description: tgeography_to_tgeogpoint — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tgeographytotgeogps(id UINT64, geomWkt VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR tgeographytotgeogps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(4.35 50.85)'|1609459200
2|'SRID=4326;Point(4.36 50.86)'|1609545600

CREATE SINK tgeographytotgeogps_out(tgeographytotgeogps.id UINT64, r VARSIZED) TYPE File;
SELECT id, TGEOGRAPHY_TO_TGEOGPOINT(geomWkt, ts) AS r FROM tgeographytotgeogps INTO tgeographytotgeogps_out;

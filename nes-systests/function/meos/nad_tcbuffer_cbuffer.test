# name: MEOS_NAD_TCBUFFER_CBUFFER
# groups: [Function, MEOS, Codegen]
CREATE LOGICAL SOURCE ndcc(id UINT64, lon FLOAT64, lat FLOAT64, radius FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR ndcc TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.0|50.0|10.0|1609459200
2|5.0|51.0|5.0|1609459200

CREATE SINK ndcc_out(ndcc.id UINT64, r FLOAT64) TYPE File;
SELECT id, TEMPORAL_NAD_TCBUFFER_CBUFFER(lon, lat, radius, ts, 'Cbuffer(Point(1 1),0.5)') AS r FROM ndcc INTO ndcc_out;

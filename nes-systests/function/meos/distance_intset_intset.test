# name: MEOS_DISTANCE_INTSET_INTSET
# description: distance_intset_intset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distanceintsetintss(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR distanceintsetintss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|'{1, 3, 5}'
2|'{3, 5, 9}'|'{3, 5, 9}'

CREATE SINK distanceintsetintss_out(distanceintsetintss.id UINT64, r INT32) TYPE File;
SELECT id, DISTANCE_INTSET_INTSET(a, b) AS r FROM distanceintsetintss INTO distanceintsetintss_out;

# name: MEOS_FLOAT_LN
# description: float_ln — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatlns(id UINT64, value FLOAT64);
CREATE PHYSICAL SOURCE FOR floatlns TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|2.0
2|10.0

CREATE SINK floatlns_out(floatlns.id UINT64, r FLOAT64) TYPE File;
SELECT id, FLOAT_LN(value) AS r FROM floatlns INTO floatlns_out;
----
1,0.693147
2,2.302585

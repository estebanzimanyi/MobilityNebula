# name: MEOS_NSEGMENT_GT
# description: nsegment_gt — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE nsegmentgts(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR nsegmentgts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NSegment(1, 0.2, 0.8)'|'NSegment(1, 0.5, 0.7)'
2|'NSegment(1, 0.5, 0.7)'|'NSegment(1, 0.2, 0.8)'

CREATE SINK nsegmentgts_out(nsegmentgts.id UINT64, r INT32) TYPE File;
SELECT id, NSEGMENT_GT(a, b) AS r FROM nsegmentgts INTO nsegmentgts_out;
----
1,0
2,1

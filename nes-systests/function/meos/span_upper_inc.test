# name: MEOS_SPAN_UPPER_INC
# description: span_upper_inc — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spanupperincs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spanupperincs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'
2|'[3, 9)'

CREATE SINK spanupperincs_out(spanupperincs.id UINT64, r BOOLEAN) TYPE File;
SELECT id, SPAN_UPPER_INC(a) AS r FROM spanupperincs INTO spanupperincs_out;
----
1,0
2,0

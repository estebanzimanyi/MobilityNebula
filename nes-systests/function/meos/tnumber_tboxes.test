# name: MEOS_TNUMBER_TBOXES
# description: tnumber_tboxes — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tnumbertboxess(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tnumbertboxess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200
2|8.5|1609545600

CREATE SINK tnumbertboxess_out(tnumbertboxess.id UINT64, r VARSIZED) TYPE File;
SELECT id, TNUMBER_TBOXES(value, ts) AS r FROM tnumbertboxess INTO tnumbertboxess_out;

# name: MEOS_STBOX_EXPAND_TIME
# description: stbox_expand_time — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxexpandtimes(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxexpandtimes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX XT(((1,1),(5,5)),[2020-01-01, 2020-01-05])'|'1 day'
2|'STBOX XT(((3,3),(7,7)),[2020-01-03, 2020-01-07])'|'2 days 3 hours'

CREATE SINK stboxexpandtimes_out(stboxexpandtimes.id UINT64, r VARSIZED) TYPE File;
SELECT id, STBOX_EXPAND_TIME(a, arg) AS r FROM stboxexpandtimes INTO stboxexpandtimes_out;
----
1,STBOX XT(((1,1),(5,5)),[2019-12-31 00:00:00+00, 2020-01-06 00:00:00+00])
2,STBOX XT(((3,3),(7,7)),[2019-12-31 21:00:00+00, 2020-01-09 03:00:00+00])

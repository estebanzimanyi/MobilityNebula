# name: MEOS_MINUS_SET_NPOINT
# description: minus_set_npoint — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minussetnpoints(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR minussetnpoints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Npoint(1,0.5)", "Npoint(2,0.5)"}'|'Npoint(1,0.5)'
2|'{"Npoint(1,0.7)", "Npoint(3,0.5)"}'|'Npoint(1,0.7)'

CREATE SINK minussetnpoints_out(minussetnpoints.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_SET_NPOINT(a, arg) AS r FROM minussetnpoints INTO minussetnpoints_out;
----
1,{"NPoint(2,0.5)"}
2,{"NPoint(3,0.5)"}

# name: MEOS_TEQ_TPOSE_POSE
# description: teq_tpose_pose — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE teqtposeposes(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR teqtposeposes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|0.5|1609459200|'Pose(Point(1 1), 0.5)'
2|2.0|2.0|1.0|1609545600|'Pose(Point(2 2), 1.0)'

CREATE SINK teqtposeposes_out(teqtposeposes.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEQ_TPOSE_POSE(x, y, theta, ts, arg) AS r FROM teqtposeposes INTO teqtposeposes_out;

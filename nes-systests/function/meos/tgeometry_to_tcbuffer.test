# name: MEOS_TGEOMETRY_TO_TCBUFFER
# description: TGEOMETRY_TO_TCBUFFER converts a temporal geometry (a hex-WKB tgeometry instant) to its temporal circular buffer, emitted as hex-WKB.
# groups: [Function, MEOS, Cbuffer]
CREATE LOGICAL SOURCE tgeometrytotcbuffers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tgeometrytotcbuffers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|013C00010103000000010000000500000000000000000000000000000000000000000000000000004000000000000000000000000000000040000000000000004000000000000000000000000000000040000000000000000000000000000000000060C286073E0200

CREATE SINK tgeometrytotcbuffers_out(tgeometrytotcbuffers.id UINT64, r VARSIZED) TYPE File;
SELECT id, TGEOMETRY_TO_TCBUFFER(a) AS r FROM tgeometrytotcbuffers INTO tgeometrytotcbuffers_out;
----
1,013B0001000000000000F03F000000000000F03FCD3B7F669EA0F63F0060C286073E0200

# name: MEOS_MINUS_POSE_SET
# description: minus_pose_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minusposesets(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR minusposesets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Pose(Point(1 1),0.5)", "Pose(Point(2 2),1.0)"}'|'Pose(Point(9 9),0.5)'
2|'{"Pose(Point(3 3),0.3)", "Pose(Point(4 4),0.5)"}'|'Pose(Point(8 8),0.5)'

CREATE SINK minusposesets_out(minusposesets.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_POSE_SET(a, arg) AS r FROM minusposesets INTO minusposesets_out;
----
1,{"POSE (010100000000000000000022400000000000002240, 0.5)"}
2,{"POSE (010100000000000000000020400000000000002040, 0.5)"}

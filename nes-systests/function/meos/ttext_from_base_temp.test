# name: MEOS_TTEXT_FROM_BASE_TEMP
# description: ttext_from_base_temp — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE ttextfrombasetemps(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR ttextfrombasetemps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'XYZ'
2|'DEF'|1609545600|'XYZ'

CREATE SINK ttextfrombasetemps_out(ttextfrombasetemps.id UINT64, r VARSIZED) TYPE File;
SELECT id, TTEXT_FROM_BASE_TEMP(value, ts, arg) AS r FROM ttextfrombasetemps INTO ttextfrombasetemps_out;

# name: MEOS_TSTZSET_MAKE_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE tstzsetmakes(gid UINT64, value INT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tstzsetmakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|631152000000000|1609459200
1|631152000001000|1609459201
2|631152000002000|1609459200
2|631152000003000|1609459201

CREATE SINK tstzsetmakes_out(tstzsetmakes.gid UINT64, tstzsetmakes.r VARSIZED) TYPE File;
SELECT gid, TSTZSET_MAKE(value, ts) AS r FROM tstzsetmakes GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tstzsetmakes_out;

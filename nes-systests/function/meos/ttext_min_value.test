# name: MEOS_TTEXT_MIN_VALUE
# description: ttext_min_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE ttextminvalues(id UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR ttextminvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200
2|'DEF'|1609545600

CREATE SINK ttextminvalues_out(ttextminvalues.id UINT64, r VARSIZED) TYPE File;
SELECT id, TTEXT_MIN_VALUE(value, ts) AS r FROM ttextminvalues INTO ttextminvalues_out;
----
1,"ABC"
2,"DEF"

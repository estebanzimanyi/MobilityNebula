# name: MEOS_TpointCumulativeLengthExp_Aggregation
# description: Windowed tgeompoint mini-trip grown on the in-process expandable Temporal* (appendInstant); TPOINT_CUMULATIVE_LENGTH applied to the live sequence, emitted as hex-WKB.
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, Aggregation]
CREATE LOGICAL SOURCE tpcl(vehicle_id UINT64, lon FLOAT64, lat FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR tpcl TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200
1|4.3700|50.6500|1609459201
1|4.3750|50.6550|1609459202

CREATE SINK tpcl_out(tpcl.vehicle_id UINT64, tpcl.cumlen VARSIZED) TYPE File;
SELECT vehicle_id, TPOINT_CUMULATIVE_LENGTH(lon, lat, timestamp) AS cumlen FROM tpcl GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO tpcl_out;

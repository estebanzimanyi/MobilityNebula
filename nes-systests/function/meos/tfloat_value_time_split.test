CREATE LOGICAL SOURCE tfloatvaluetimespls(id UINT64, value FLOAT64, ts UINT64, x0 FLOAT64, x1 VARSIZED, x2 FLOAT64, x3 VARSIZED);
CREATE PHYSICAL SOURCE FOR tfloatvaluetimespls TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200|5.0|'1 day'|0.0|'2020-01-01 00:00:00+00'
2|8.5|1609545600|5.0|'2 days'|0.0|'2020-01-01 00:00:00+00'

CREATE SINK tfloatvaluetimespls_out(tfloatvaluetimespls.id UINT64, r VARSIZED) TYPE File;
SELECT id, TFLOAT_VALUE_TIME_SPLIT(value, ts, x0, x1, x2, x3) AS r FROM tfloatvaluetimespls INTO tfloatvaluetimespls_out;

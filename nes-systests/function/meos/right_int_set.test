# name: MEOS_RIGHT_INT_SET
# description: right_int_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightintsets(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR rightintsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK rightintsets_out(rightintsets.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_INT_SET(a, b) AS r FROM rightintsets INTO rightintsets_out;
----
1,0
2,0

# name: MEOS_FLOATSPAN_EXPAND
# description: floatspan_expand — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspanexpands(id UINT64, a VARSIZED, v FLOAT64);
CREATE PHYSICAL SOURCE FOR floatspanexpands TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'|2.5
2|'[3.5, 9.5)'|2.5

CREATE SINK floatspanexpands_out(floatspanexpands.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSPAN_EXPAND(a, v) AS r FROM floatspanexpands INTO floatspanexpands_out;
----
1,[-1, 8)
2,[1, 12)

# name: MEOS_GEOSET_START_VALUE
# description: geoset_start_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geosetstartvalues(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geosetstartvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Point(1 1)", "Point(2 2)"}'
2|'{"Point(3 3)", "Point(4 4)"}'

CREATE SINK geosetstartvalues_out(geosetstartvalues.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEOSET_START_VALUE(a) AS r FROM geosetstartvalues INTO geosetstartvalues_out;
----
1,0101000000000000000000F03F000000000000F03F
2,010100000000000000000008400000000000000840

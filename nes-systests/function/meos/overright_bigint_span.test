# name: MEOS_OVERRIGHT_BIGINT_SPAN
# description: overright_bigint_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overrightbigintspas(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR overrightbigintspas TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK overrightbigintspas_out(overrightbigintspas.id UINT64, r INT32) TYPE File;
SELECT id, OVERRIGHT_BIGINT_SPAN(a, b) AS r FROM overrightbigintspas INTO overrightbigintspas_out;

# name: MEOS_GEO_NUM_GEOS
# description: geo_num_geos — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geonumgeoss(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geonumgeoss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(1 1, 2 2)'
2|'SRID=4326;Linestring(3 3, 4 4, 5 5)'

CREATE SINK geonumgeoss_out(geonumgeoss.id UINT64, r INT32) TYPE File;
SELECT id, GEO_NUM_GEOS(a) AS r FROM geonumgeoss INTO geonumgeoss_out;
----
1,1
2,1

# name: MEOS_TPOINT_AZIMUTH_EXP
# groups: [Function, MEOS, Aggregation]
CREATE LOGICAL SOURCE tpoint_w(gid UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tpoint_w TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.0|50.0|1609459200
1|4.1|50.1|1609459201
2|5.0|51.0|1609459200
2|5.1|51.1|1609459201

CREATE SINK tpoint_w_out(tpoint_w.gid UINT64, tpoint_w.r VARSIZED) TYPE File;
SELECT gid, TPOINT_AZIMUTH_EXP(lon, lat, ts) AS r FROM tpoint_w GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tpoint_w_out;

# name: MEOS_TEMPORAL_START_SEQUENCE_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE tss(gid UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200
1|2.0|2.0|1609459201
1|3.0|3.0|1609459202
2|5.0|5.0|1609459200
2|6.0|6.0|1609459201

CREATE SINK tss_out(tss.gid UINT64, tss.r VARSIZED) TYPE File;
SELECT gid, TEMPORAL_START_SEQUENCE(lon, lat, ts) AS r FROM tss GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tss_out;

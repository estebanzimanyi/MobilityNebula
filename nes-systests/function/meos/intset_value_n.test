# name: MEOS_INTSET_VALUE_N
# description: intset_value_n — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intsetvaluens(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR intsetvaluens TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{3, 5, 9}'

CREATE SINK intsetvaluens_out(intsetvaluens.id UINT64, r INT32) TYPE File;
SELECT id, INTSET_VALUE_N(a) AS r FROM intsetvaluens INTO intsetvaluens_out;
----
1,1
2,3

# name: MEOS_NAD_TRGEOMETRY_STBOX
# description: nad_trgeometry_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE nadtrgeometrystboxs(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR nadtrgeometrystboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|0.0|0.0|0.0|1609459200|'STBOX X((0,0),(10,10))'
2|1.0|1.0|0.5|1609545600|'STBOX X((5,5),(20,20))'

CREATE SINK nadtrgeometrystboxs_out(nadtrgeometrystboxs.id UINT64, r FLOAT64) TYPE File;
SELECT id, NAD_TRGEOMETRY_STBOX(x, y, theta, ts, arg) AS r FROM nadtrgeometrystboxs INTO nadtrgeometrystboxs_out;

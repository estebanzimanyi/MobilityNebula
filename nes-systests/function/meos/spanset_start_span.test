# name: MEOS_SPANSET_START_SPAN
# description: spanset_start_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spansetstartspans(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spansetstartspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'
2|'{[3.5, 7.5)}'

CREATE SINK spansetstartspans_out(spansetstartspans.id UINT64, r VARSIZED) TYPE File;
SELECT id, SPANSET_START_SPAN(a) AS r FROM spansetstartspans INTO spansetstartspans_out;
----
1,[1.5,5.5)
2,[3.5,7.5)

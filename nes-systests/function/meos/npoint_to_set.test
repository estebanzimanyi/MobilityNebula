# name: MEOS_NPOINT_TO_SET
# description: npoint_to_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointtosets(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR npointtosets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NPoint(1, 0.5)'
2|'NPoint(1, 0.7)'

CREATE SINK npointtosets_out(npointtosets.id UINT64, r VARSIZED) TYPE File;
SELECT id, NPOINT_TO_SET(a) AS r FROM npointtosets INTO npointtosets_out;
----
1,{"NPoint(1,0.5)"}
2,{"NPoint(1,0.7)"}

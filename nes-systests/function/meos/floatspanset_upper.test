# name: MEOS_FLOATSPANSET_UPPER
# description: floatspanset_upper — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspansetuppers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatspansetuppers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'

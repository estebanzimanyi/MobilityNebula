# name: MEOS_OVERAFTER_SPAN_DATE
# description: overafter_span_date — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overafterspandates(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR overafterspandates TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01, 2020-01-10)'|'2020-01-03'
2|'[2020-01-05, 2020-01-20)'|'2020-06-15'

CREATE SINK overafterspandates_out(overafterspandates.id UINT64, r INT32) TYPE File;
SELECT id, OVERAFTER_SPAN_DATE(a, b) AS r FROM overafterspandates INTO overafterspandates_out;
----
1,0
2,0

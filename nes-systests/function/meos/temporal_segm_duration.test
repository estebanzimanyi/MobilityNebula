# name: MEOS_TEMPORAL_SEGM_DURATION_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE tsegd(gid UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tsegd TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200
1|2.0|2.0|1609459230
1|3.0|3.0|1609459260
1|4.0|4.0|1609459290
2|5.0|5.0|1609459200
2|6.0|6.0|1609459260

CREATE SINK tsegd_out(tsegd.gid UINT64, tsegd.r VARSIZED) TYPE File;
SELECT gid, TEMPORAL_SEGM_DURATION(lon, lat, ts, '30 seconds', 1, 0) AS r FROM tsegd GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tsegd_out;

CREATE LOGICAL SOURCE frontstboxtspatials(id UINT64, lon FLOAT64, lat FLOAT64, z FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR frontstboxtspatials TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|2.0|1609459200|'SRID=4326;STBOX Z((0 0 0),(5 5 5))'

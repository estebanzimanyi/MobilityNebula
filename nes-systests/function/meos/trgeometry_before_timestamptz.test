CREATE LOGICAL SOURCE trgeometrybeforetis(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR trgeometrybeforetis TYPE File SET('|' AS PARSER.FIELD_DELIMITER);

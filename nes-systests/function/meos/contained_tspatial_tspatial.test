# name: MEOS_CONTAINED_TSPATIAL_TSPATIAL
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, EDisjoint]
CREATE LOGICAL SOURCE ts06(id UINT32, lonA FLOAT64, latA FLOAT64, tsA UINT64, lonB FLOAT64, latB FLOAT64, tsB UINT64);
CREATE PHYSICAL SOURCE FOR ts06 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200|4.4000|50.7000|1609459200
2|4.3658|50.6456|1609459200|4.3658|50.6456|1609459200

CREATE SINK ts06_out(ts06.id UINT32, r BOOLEAN) TYPE File;
SELECT id, CONTAINED_TSPATIAL_TSPATIAL(lonA, latA, tsA, lonB, latB, tsB) AS r FROM ts06 INTO ts06_out;

# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intspansettofloatss(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR intspansettofloatss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'
2|'{[3, 7)}'

CREATE SINK intspansettofloatss_out(intspansettofloatss.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTSPANSET_TO_FLOATSPANSET(a) AS r FROM intspansettofloatss INTO intspansettofloatss_out;

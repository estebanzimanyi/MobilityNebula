# name: MEOS_TPOINT_FROM_BASE_TEMP
# description: TPOINT_FROM_BASE_TEMP builds a temporal point holding a fixed geometry value over the time frame of a temporal (a hex-WKB tfloat), emitted as hex-WKB.
# groups: [Function, MEOS, SpatioTemporal]
CREATE LOGICAL SOURCE tpointfrombasetemps(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR tpointfrombasetemps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'POINT(1 1)'|0121000E0200000003000000000000F03F00A0AD30CA5A020000000000000000400000854EDE5A0200

CREATE SINK tpointfrombasetemps_out(tpointfrombasetemps.id UINT64, r VARSIZED) TYPE File;
SELECT id, TPOINT_FROM_BASE_TEMP(a, b) AS r FROM tpointfrombasetemps INTO tpointfrombasetemps_out;
----
1,012E000E02000000030101000000000000000000F03F000000000000F03F00A0AD30CA5A02000101000000000000000000F03F000000000000F03F0000854EDE5A0200

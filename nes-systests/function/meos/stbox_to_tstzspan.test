# name: MEOS_STBOX_TO_TSTZSPAN
# description: stbox_to_tstzspan — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxtotstzspans(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxtotstzspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX XT(((1,1),(5,5)),[2020-01-01,2020-01-05])'
2|'STBOX XT(((3,3),(7,7)),[2020-01-03,2020-01-07])'

CREATE SINK stboxtotstzspans_out(stboxtotstzspans.id UINT64, r VARSIZED) TYPE File;
SELECT id, STBOX_TO_TSTZSPAN(a) AS r FROM stboxtotstzspans INTO stboxtotstzspans_out;

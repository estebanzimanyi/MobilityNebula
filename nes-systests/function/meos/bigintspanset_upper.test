# name: MEOS_BIGINTSPANSET_UPPER
# description: bigintspanset_upper — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE bigintspansetuppers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR bigintspansetuppers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'
2|'{[3, 7)}'

CREATE SINK bigintspansetuppers_out(bigintspansetuppers.id UINT64, r INT64) TYPE File;
SELECT id, BIGINTSPANSET_UPPER(a) AS r FROM bigintspansetuppers INTO bigintspansetuppers_out;
----
1,15
2,7

# name: MEOS_GEO_CLUSTER_KMEANS
# description: geo_cluster_kmeans — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geoclusterkmeanss(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geoclusterkmeanss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(1 1)'
2|'SRID=4326;Point(2 2)'

CREATE SINK geoclusterkmeanss_out(geoclusterkmeanss.id UINT64, r INT32) TYPE File;
SELECT id, GEO_CLUSTER_KMEANS(a) AS r FROM geoclusterkmeanss INTO geoclusterkmeanss_out;
----
1,0
2,0

# name: MEOS_TINT_WMAX_TRANSFN
# description: Windowed TINT_WMAX_TRANSFN -> aggregate Temporal (hex-WKB) via the per-op windowed tagg transfn (1-hour radius).
# groups: [Function, MEOS, TemporalNumber, Aggregation]
CREATE LOGICAL SOURCE wmx(vehicle_id UINT64, value INT32, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR wmx TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5|1609459200
1|3|1609459200
1|7|1609462800

CREATE SINK wmx_out(wmx.vehicle_id UINT64, wmx.r VARSIZED) TYPE File;
SELECT vehicle_id, TINT_WMAX_TRANSFN(value, timestamp) AS r FROM wmx GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO wmx_out;

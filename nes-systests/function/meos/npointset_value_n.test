# name: MEOS_NPOINTSET_VALUE_N
# description: npointset_value_n — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointsetvaluens(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR npointsetvaluens TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Npoint(1,0.5)", "Npoint(2,0.5)"}'
2|'{"Npoint(1,0.7)", "Npoint(3,0.5)"}'

CREATE SINK npointsetvaluens_out(npointsetvaluens.id UINT64, r VARSIZED) TYPE File;
SELECT id, NPOINTSET_VALUE_N(a) AS r FROM npointsetvaluens INTO npointsetvaluens_out;
----
1,NPoint(1,0.5)
2,NPoint(1,0.7)

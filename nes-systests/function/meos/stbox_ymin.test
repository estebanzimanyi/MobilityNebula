# name: MEOS_STBOX_YMIN
# description: stbox_ymin — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxymins(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxymins TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'
2|'STBOX X((3,3),(7,7))'

CREATE SINK stboxymins_out(stboxymins.id UINT64, r FLOAT64) TYPE File;
SELECT id, STBOX_YMIN(a) AS r FROM stboxymins INTO stboxymins_out;
----
1,1.0
2,3.0

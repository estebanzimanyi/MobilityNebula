# name: MEOS_GEO_NUM_POINTS
# description: geo_num_points — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geonumpointss(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geonumpointss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(1 1, 2 2)'
2|'SRID=4326;Linestring(3 3, 4 4, 5 5)'

CREATE SINK geonumpointss_out(geonumpointss.id UINT64, r INT32) TYPE File;
SELECT id, GEO_NUM_POINTS(a) AS r FROM geonumpointss INTO geonumpointss_out;
----
1,2
2,3

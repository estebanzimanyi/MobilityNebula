# name: MEOS_GEO_TSTZSPAN_TO_STBOX
# description: geo_tstzspan_to_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geotstzspantostboxs(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geotstzspantostboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(1 1)'|'[2020-01-01 00:00:00+00, 2020-01-05 00:00:00+00)'
2|'SRID=4326;Point(2 2)'|'[2020-01-01 00:00:00+00, 2020-01-05 00:00:00+00)'

CREATE SINK geotstzspantostboxs_out(geotstzspantostboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEO_TSTZSPAN_TO_STBOX(a, arg) AS r FROM geotstzspantostboxs INTO geotstzspantostboxs_out;

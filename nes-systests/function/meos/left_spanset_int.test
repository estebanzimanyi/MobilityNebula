# name: MEOS_LEFT_SPANSET_INT
# description: left_spanset_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE leftspansetints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR leftspansetints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|3
2|'{[3, 7)}'|7

CREATE SINK leftspansetints_out(leftspansetints.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_SPANSET_INT(a, b) AS r FROM leftspansetints INTO leftspansetints_out;

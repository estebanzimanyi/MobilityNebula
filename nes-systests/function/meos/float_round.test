# name: MEOS_FLOAT_ROUND
# description: float_round — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatrounds(id UINT64, value FLOAT64);
CREATE PHYSICAL SOURCE FOR floatrounds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.567
2|8.123

CREATE SINK floatrounds_out(floatrounds.id UINT64, r FLOAT64) TYPE File;
SELECT id, FLOAT_ROUND(value) AS r FROM floatrounds INTO floatrounds_out;
----
1,5.57
2,8.12

# name: MEOS_CONTAINED_GEO_SET
# description: contained_geo_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containedgeosets(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR containedgeosets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Point(1 1)", "Point(2 2)"}'|'Point(1 1)'
2|'{"Point(3 3)", "Point(4 4)"}'|'Point(3 3)'

CREATE SINK containedgeosets_out(containedgeosets.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_GEO_SET(a, arg) AS r FROM containedgeosets INTO containedgeosets_out;
----
1,1
2,1

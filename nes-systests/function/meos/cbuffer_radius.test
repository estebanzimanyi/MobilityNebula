# name: MEOS_CBUFFER_RADIUS
# description: cbuffer_radius — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbufferradiuss(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR cbufferradiuss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'
2|'Cbuffer(Point(2 2),0.5)'

CREATE SINK cbufferradiuss_out(cbufferradiuss.id UINT64, r FLOAT64) TYPE File;
SELECT id, CBUFFER_RADIUS(a) AS r FROM cbufferradiuss INTO cbufferradiuss_out;
----
1,1.0
2,0.5

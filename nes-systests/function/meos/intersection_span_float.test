# name: MEOS_INTERSECTION_SPAN_FLOAT
# description: intersection_span_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectionspanfls(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR intersectionspanfls TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'|3.5
2|'[3.5, 9.5)'|7.5

CREATE SINK intersectionspanfls_out(intersectionspanfls.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERSECTION_SPAN_FLOAT(a, b) AS r FROM intersectionspanfls INTO intersectionspanfls_out;
----
1,[3.5,3.5]
2,[7.5,7.5]

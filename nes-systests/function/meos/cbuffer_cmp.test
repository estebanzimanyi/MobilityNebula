# name: MEOS_CBUFFER_CMP
# description: cbuffer_cmp — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbuffercmps(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR cbuffercmps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'|'Cbuffer(Point(2 2),0.5)'
2|'Cbuffer(Point(2 2),0.5)'|'Cbuffer(Point(1 1),1.0)'

CREATE SINK cbuffercmps_out(cbuffercmps.id UINT64, r INT32) TYPE File;
SELECT id, CBUFFER_CMP(a, b) AS r FROM cbuffercmps INTO cbuffercmps_out;
----
1,-1
2,1

# name: MEOS_OVERLEFT_SPAN_INT
# description: overleft_span_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overleftspanints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR overleftspanints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK overleftspanints_out(overleftspanints.id UINT64, r INT32) TYPE File;
SELECT id, OVERLEFT_SPAN_INT(a, b) AS r FROM overleftspanints INTO overleftspanints_out;
----
1,0
2,0

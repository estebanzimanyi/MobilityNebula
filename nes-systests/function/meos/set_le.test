# name: MEOS_SET_LE
# description: set_le — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE setles(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR setles TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|'{1, 3, 5}'
2|'{3, 5, 9}'|'{3, 5, 9}'

CREATE SINK setles_out(setles.id UINT64, r INT32) TYPE File;
SELECT id, SET_LE(a, b) AS r FROM setles INTO setles_out;
----
1,1
2,1

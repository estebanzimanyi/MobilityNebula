# name: MEOS_SPANSET_EQ
# description: spanset_eq — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spanseteqs(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR spanseteqs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|'{[1, 5), [10, 15)}'
2|'{[3, 7)}'|'{[3, 7)}'

CREATE SINK spanseteqs_out(spanseteqs.id UINT64, r INT32) TYPE File;
SELECT id, SPANSET_EQ(a, b) AS r FROM spanseteqs INTO spanseteqs_out;
----
1,1
2,1

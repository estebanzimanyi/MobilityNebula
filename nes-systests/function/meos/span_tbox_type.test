# name: MEOS_SPAN_TBOX_TYPE
# description: span_tbox_type — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spantboxtypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spantboxtypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 20)'
2|'[3, 25)'

CREATE SINK spantboxtypes_out(spantboxtypes.id UINT64, r INT32) TYPE File;
SELECT id, SPAN_TBOX_TYPE(a) AS r FROM spantboxtypes INTO spantboxtypes_out;
----
1,1
2,1

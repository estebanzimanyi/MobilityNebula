# name: MEOS_OVERBEFORE_DATE_SPAN
# description: overbefore_date_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overbeforedatespans(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR overbeforedatespans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01, 2020-01-10)'|'2020-01-03'
2|'[2020-01-05, 2020-01-20)'|'2020-06-15'

CREATE SINK overbeforedatespans_out(overbeforedatespans.id UINT64, r INT32) TYPE File;
SELECT id, OVERBEFORE_DATE_SPAN(a, b) AS r FROM overbeforedatespans INTO overbeforedatespans_out;
----
1,1
2,0

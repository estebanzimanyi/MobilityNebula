# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzspansetbinss(id UINT64, a VARSIZED, x0 VARSIZED, x1 VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzspansetbinss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)}'|'1 day'|'2020-01-01 00:00:00+00'
2|'{[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)}'|'2 days'|'2020-01-01 00:00:00+00'

CREATE SINK tstzspansetbinss_out(tstzspansetbinss.id UINT64, r VARSIZED) TYPE File;
SELECT id, TSTZSPANSET_BINS(a, x0, x1) AS r FROM tstzspansetbinss INTO tstzspansetbinss_out;

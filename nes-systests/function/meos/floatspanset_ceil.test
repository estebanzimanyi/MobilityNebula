# name: MEOS_FLOATSPANSET_CEIL
# description: floatspanset_ceil — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspansetceils(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatspansetceils TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'
2|'{[3.5, 7.5)}'

CREATE SINK floatspansetceils_out(floatspansetceils.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSPANSET_CEIL(a) AS r FROM floatspansetceils INTO floatspansetceils_out;
----
1,{[2, 6), [11, 16)}
2,{[4, 8)}

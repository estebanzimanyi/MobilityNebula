# name: MEOS_RIGHT_SPAN_FLOAT
# description: right_span_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightspanfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR rightspanfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'|3.5
2|'[3.5, 9.5)'|7.5

CREATE SINK rightspanfloats_out(rightspanfloats.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_SPAN_FLOAT(a, b) AS r FROM rightspanfloats INTO rightspanfloats_out;
----
1,0
2,0

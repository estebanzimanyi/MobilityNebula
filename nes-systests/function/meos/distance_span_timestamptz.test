# name: MEOS_DISTANCE_SPAN_TIMESTAMPTZ
# description: distance_span_timestamptz — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancespantimests(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR distancespantimests TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)'|'2020-01-03 00:00:00+00'
2|'[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)'|'2020-06-15 12:00:00+00'

CREATE SINK distancespantimests_out(distancespantimests.id UINT64, r FLOAT64) TYPE File;
SELECT id, DISTANCE_SPAN_TIMESTAMPTZ(a, b) AS r FROM distancespantimests INTO distancespantimests_out;

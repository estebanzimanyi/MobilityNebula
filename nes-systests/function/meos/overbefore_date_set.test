# name: MEOS_OVERBEFORE_DATE_SET
# description: overbefore_date_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overbeforedatesets(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR overbeforedatesets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01, 2020-01-05, 2020-01-10}'|'2020-01-03'
2|'{2020-01-03, 2020-01-08}'|'2020-06-15'

CREATE SINK overbeforedatesets_out(overbeforedatesets.id UINT64, r INT32) TYPE File;
SELECT id, OVERBEFORE_DATE_SET(a, b) AS r FROM overbeforedatesets INTO overbeforedatesets_out;
----
1,1
2,0

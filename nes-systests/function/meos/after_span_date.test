# name: MEOS_AFTER_SPAN_DATE
# description: after_span_date — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE afterspandates(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR afterspandates TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01, 2020-01-10)'|'2020-01-03'
2|'[2020-01-05, 2020-01-20)'|'2020-06-15'

CREATE SINK afterspandates_out(afterspandates.id UINT64, r INT32) TYPE File;
SELECT id, AFTER_SPAN_DATE(a, b) AS r FROM afterspandates INTO afterspandates_out;
----
1,0
2,0

# name: MEOS_TEXTCAT_TEXT_TEXT
# description: textcat_text_text — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textcattexttexts(id UINT64, t1 VARSIZED, t2 VARSIZED);
CREATE PHYSICAL SOURCE FOR textcattexttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'AAA'|'BBB'
2|'CC'|'DD'

CREATE SINK textcattexttexts_out(textcattexttexts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXTCAT_TEXT_TEXT(t1, t2) AS r FROM textcattexttexts INTO textcattexttexts_out;
----
1,"AAABBB"
2,"CCDD"

# name: MEOS_SPAN_NE
# description: span_ne — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spannes(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR spannes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|'[1, 5)'
2|'[3, 9)'|'[3, 9)'

CREATE SINK spannes_out(spannes.id UINT64, r INT32) TYPE File;
SELECT id, SPAN_NE(a, b) AS r FROM spannes INTO spannes_out;
----
1,0
2,0

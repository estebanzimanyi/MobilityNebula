# name: MEOS_GEOSET_VALUES
# description: geoset_values — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geosetvaluess(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geosetvaluess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Point(1 1)", "Point(2 2)"}'
2|'{"Point(3 3)", "Point(4 4)"}'

CREATE SINK geosetvaluess_out(geosetvaluess.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEOSET_VALUES(a) AS r FROM geosetvaluess INTO geosetvaluess_out;
----
1,{0101000000000000000000F03F000000000000F03F,010100000000000000000000400000000000000040}
2,{010100000000000000000008400000000000000840,010100000000000000000010400000000000001040}

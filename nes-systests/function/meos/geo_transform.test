# name: MEOS_GEO_TRANSFORM
# description: geo_transform — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geotransforms(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geotransforms TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(1 1)'
2|'SRID=4326;Point(2 2)'

CREATE SINK geotransforms_out(geotransforms.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEO_TRANSFORM(a) AS r FROM geotransforms INTO geotransforms_out;
----
1,0101000020110F0000310C4ADA772DFB403B432E49D22DFB40
2,0101000020110F0000310C4ADA772D0B4166F404ABE12E0B41

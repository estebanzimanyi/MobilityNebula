# name: MEOS_OVERRIGHT_FLOAT_SET
# description: overright_float_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overrightfloatsets(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR overrightfloatsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|3.5
2|'{3.5, 5.5, 9.5}'|7.5

CREATE SINK overrightfloatsets_out(overrightfloatsets.id UINT64, r INT32) TYPE File;
SELECT id, OVERRIGHT_FLOAT_SET(a, b) AS r FROM overrightfloatsets INTO overrightfloatsets_out;
----
1,1
2,1

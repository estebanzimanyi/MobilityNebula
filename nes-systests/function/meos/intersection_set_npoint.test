# name: MEOS_INTERSECTION_SET_NPOINT
# description: intersection_set_npoint — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectionsetnpos(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR intersectionsetnpos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Npoint(1,0.5)", "Npoint(2,0.5)"}'|'Npoint(1,0.5)'
2|'{"Npoint(1,0.7)", "Npoint(3,0.5)"}'|'Npoint(1,0.7)'

CREATE SINK intersectionsetnpos_out(intersectionsetnpos.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERSECTION_SET_NPOINT(a, arg) AS r FROM intersectionsetnpos INTO intersectionsetnpos_out;
----
1,{"NPoint(1,0.5)"}
2,{"NPoint(1,0.7)"}

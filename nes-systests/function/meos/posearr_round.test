# name: MEOS_POSEARR_ROUND
# description: posearr_round — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posearrrounds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR posearrrounds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1.234567 2.345678),0.5)'
2|'Pose(Point(2.345678 3.456789),0.3)'

CREATE SINK posearrrounds_out(posearrrounds.id UINT64, r VARSIZED) TYPE File;
SELECT id, POSEARR_ROUND(a) AS r FROM posearrrounds INTO posearrrounds_out;
----
1,POSE (010100000087889B53C9C0F33FD192C7D3F2C30240 0.5)
2,POSE (0101000000D192C7D3F2C302405F61C1FD80A70B40 0.3)

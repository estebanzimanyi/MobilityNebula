# name: MEOS_DivTnumberTnumber
# description: DIV_TNUMBER_TNUMBER over two per-vehicle tfloat hex-WKB inputs (P=1->3, Q=10->20), returning the temporal quotient P/Q as a VARSIZED hex-WKB tfloat.
# groups: [Function, MEOS, TemporalNumber, CrossStream]
CREATE LOGICAL SOURCE dvn(id UINT64, ta VARSIZED, tb VARSIZED);
CREATE PHYSICAL SOURCE FOR dvn TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|0121000E0200000003000000000000F03F00A0AD30CA5A020000000000000008408024CC30CA5A0200|0121000E0200000003000000000000244000A0AD30CA5A020000000000000034408024CC30CA5A0200

CREATE SINK dvn_out(dvn.id UINT64, r VARSIZED) TYPE File;
SELECT id, DIV_TNUMBER_TNUMBER(ta, tb) AS r FROM dvn INTO dvn_out;

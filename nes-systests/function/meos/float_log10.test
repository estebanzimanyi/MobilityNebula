# name: MEOS_FLOAT_LOG10
# description: float_log10 — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatlog10s(id UINT64, value FLOAT64);
CREATE PHYSICAL SOURCE FOR floatlog10s TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|10.0
2|100.0

CREATE SINK floatlog10s_out(floatlog10s.id UINT64, r FLOAT64) TYPE File;
SELECT id, FLOAT_LOG10(value) AS r FROM floatlog10s INTO floatlog10s_out;
----
1,1.0
2,2.0

# name: MEOS_TIMESTAMPTZ_SHIFT
# description: timestamptz_shift — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE timestamptzshifts(id UINT64, value INT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR timestamptzshifts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1609459200|'1 day'
2|1609545600|'2 days 3 hours'

CREATE SINK timestamptzshifts_out(timestamptzshifts.id UINT64, r INT64) TYPE File;
SELECT id, TIMESTAMPTZ_SHIFT(value, arg) AS r FROM timestamptzshifts INTO timestamptzshifts_out;

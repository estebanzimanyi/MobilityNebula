# name: MEOS_STBOX_HASH
# description: stbox_hash — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxhashs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxhashs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'
2|'STBOX X((3,3),(7,7))'

CREATE SINK stboxhashs_out(stboxhashs.id UINT64, r INT32) TYPE File;
SELECT id, STBOX_HASH(a) AS r FROM stboxhashs INTO stboxhashs_out;
----
1,537495394
2,-1499569692

# name: MEOS_FLOATSPANSET_TO_INTSPANSET
# description: floatspanset_to_intspanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspansettointss(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatspansettointss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'
2|'{[3.5, 7.5)}'

CREATE SINK floatspansettointss_out(floatspansettointss.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSPANSET_TO_INTSPANSET(a) AS r FROM floatspansettointss INTO floatspansettointss_out;

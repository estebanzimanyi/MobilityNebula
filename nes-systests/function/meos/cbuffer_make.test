# name: MEOS_CBUFFER_MAKE
# description: cbuffer_make — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbuffermakes(id UINT64, a VARSIZED, arg0 FLOAT64);
CREATE PHYSICAL SOURCE FOR cbuffermakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Point(1 1)'|1.0
2|'Point(2 2)'|0.5

CREATE SINK cbuffermakes_out(cbuffermakes.id UINT64, r VARSIZED) TYPE File;
SELECT id, CBUFFER_MAKE(a, arg0) AS r FROM cbuffermakes INTO cbuffermakes_out;
----
1,Cbuffer(0101000000000000000000F03F000000000000F03F,1)
2,Cbuffer(010100000000000000000000400000000000000040,0.5)

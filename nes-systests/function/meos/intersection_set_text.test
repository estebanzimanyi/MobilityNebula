# name: MEOS_INTERSECTION_SET_TEXT
# description: intersection_set_text value-mixed set/span/spanset algebra.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectionsettex(id UINT64, lit VARSIZED, val VARSIZED);
CREATE PHYSICAL SOURCE FOR intersectionsettex TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"a", "b"}'|'a'

CREATE SINK intersectionsettex_out(intersectionsettex.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERSECTION_SET_TEXT(lit, val) AS r FROM intersectionsettex INTO intersectionsettex_out;
----
1,{"a"}

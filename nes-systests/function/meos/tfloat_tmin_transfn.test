# name: MEOS_TFLOAT_TMIN_TRANSFN
# description: Windowed TFLOAT_TMIN_TRANSFN -> aggregate Temporal (hex-WKB) via the per-op tagg transfn (tMin); same-timestamp events merged by the aggregation fn.
# groups: [Function, MEOS, TemporalNumber, Aggregation]
CREATE LOGICAL SOURCE tfn(vehicle_id UINT64, value FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR tfn TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200
1|3.5|1609459200
1|7.0|1609462800

CREATE SINK tfn_out(tfn.vehicle_id UINT64, tfn.r VARSIZED) TYPE File;
SELECT vehicle_id, TFLOAT_TMIN_TRANSFN(value, timestamp) AS r FROM tfn GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO tfn_out;

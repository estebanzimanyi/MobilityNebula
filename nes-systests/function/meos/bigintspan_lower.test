# name: MEOS_BIGINTSPAN_LOWER
# description: bigintspan_lower — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE bigintspanlowers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR bigintspanlowers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'
2|'[3, 9)'

CREATE SINK bigintspanlowers_out(bigintspanlowers.id UINT64, r INT64) TYPE File;
SELECT id, BIGINTSPAN_LOWER(a) AS r FROM bigintspanlowers INTO bigintspanlowers_out;
----
1,1
2,3

# name: MEOS_LEFT_SET_BIGINT
# description: left_set_bigint — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE leftsetbigints(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR leftsetbigints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK leftsetbigints_out(leftsetbigints.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_SET_BIGINT(a, b) AS r FROM leftsetbigints INTO leftsetbigints_out;
----

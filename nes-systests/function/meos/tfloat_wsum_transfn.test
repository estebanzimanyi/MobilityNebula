# name: MEOS_TFLOAT_WSUM_TRANSFN
# description: Windowed TFLOAT_WSUM_TRANSFN -> aggregate Temporal (hex-WKB) via the per-op windowed tagg transfn (1-hour radius).
# groups: [Function, MEOS, TemporalNumber, Aggregation]
CREATE LOGICAL SOURCE wfs(vehicle_id UINT64, value FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR wfs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200
1|3.5|1609459200
1|2.0|1609462800

CREATE SINK wfs_out(wfs.vehicle_id UINT64, wfs.r VARSIZED) TYPE File;
SELECT vehicle_id, TFLOAT_WSUM_TRANSFN(value, timestamp) AS r FROM wfs GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO wfs_out;

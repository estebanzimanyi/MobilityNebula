# name: MEOS_BIGINTSET_START_VALUE
# description: bigintset_start_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE bigintsetstartvalus(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR bigintsetstartvalus TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{3, 5, 9}'

CREATE SINK bigintsetstartvalus_out(bigintsetstartvalus.id UINT64, r INT64) TYPE File;
SELECT id, BIGINTSET_START_VALUE(a) AS r FROM bigintsetstartvalus INTO bigintsetstartvalus_out;
----
1,1
2,3

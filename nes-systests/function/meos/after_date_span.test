# name: MEOS_AFTER_DATE_SPAN
# description: after_date_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE afterdatespans(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR afterdatespans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01, 2020-01-10)'|'2020-01-03'
2|'[2020-01-05, 2020-01-20)'|'2020-06-15'

CREATE SINK afterdatespans_out(afterdatespans.id UINT64, r INT32) TYPE File;
SELECT id, AFTER_DATE_SPAN(a, b) AS r FROM afterdatespans INTO afterdatespans_out;
----
1,0
2,1

# name: MEOS_RIGHT_SPANSET_FLOAT
# description: right_spanset_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightspansetfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR rightspansetfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'|3.5
2|'{[3.5, 7.5)}'|7.5

CREATE SINK rightspansetfloats_out(rightspansetfloats.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_SPANSET_FLOAT(a, b) AS r FROM rightspansetfloats INTO rightspansetfloats_out;

# name: MEOS_OVERBEFORE_TIMESTAMPTZ_SPAN
# description: overbefore_timestamptz_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overbeforetimestams(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR overbeforetimestams TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)'|'2020-01-03 00:00:00+00'
2|'[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)'|'2020-06-15 12:00:00+00'

CREATE SINK overbeforetimestams_out(overbeforetimestams.id UINT64, r INT32) TYPE File;
SELECT id, OVERBEFORE_TIMESTAMPTZ_SPAN(a, b) AS r FROM overbeforetimestams INTO overbeforetimestams_out;

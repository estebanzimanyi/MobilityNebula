# name: MEOS_TNUMBER_SPANTYPE
# description: tnumber_spantype — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tnumberspantypes(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tnumberspantypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200
2|8.5|1609545600

CREATE SINK tnumberspantypes_out(tnumberspantypes.id UINT64, r INT32) TYPE File;
SELECT id, TNUMBER_SPANTYPE(value, ts) AS r FROM tnumberspantypes INTO tnumberspantypes_out;

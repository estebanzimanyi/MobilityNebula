# name: MEOS_POSE_NE
# description: pose_ne — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posenes(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR posenes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'|'Pose(Point(2 2), 1.0)'
2|'Pose(Point(2 2), 1.0)'|'Pose(Point(1 1), 0.5)'

CREATE SINK posenes_out(posenes.id UINT64, r INT32) TYPE File;
SELECT id, POSE_NE(a, b) AS r FROM posenes INTO posenes_out;
----
1,1
2,1

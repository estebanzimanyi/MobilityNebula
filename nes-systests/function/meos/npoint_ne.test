# name: MEOS_NPOINT_NE
# description: npoint_ne — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointnes(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR npointnes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NPoint(1, 0.5)'|'NPoint(1, 0.7)'
2|'NPoint(1, 0.7)'|'NPoint(1, 0.5)'

CREATE SINK npointnes_out(npointnes.id UINT64, r INT32) TYPE File;
SELECT id, NPOINT_NE(a, b) AS r FROM npointnes INTO npointnes_out;
----
1,1
2,1

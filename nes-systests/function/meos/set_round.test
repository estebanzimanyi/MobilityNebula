# name: MEOS_SET_ROUND
# description: set_round — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE setrounds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR setrounds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'
2|'{3.5, 5.5, 9.5}'

CREATE SINK setrounds_out(setrounds.id UINT64, r VARSIZED) TYPE File;
SELECT id, SET_ROUND(a) AS r FROM setrounds INTO setrounds_out;
----
1,{1.5,3.5,5.5}
2,{3.5,5.5,9.5}

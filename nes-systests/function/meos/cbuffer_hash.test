# name: MEOS_CBUFFER_HASH
# description: cbuffer_hash — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbufferhashs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR cbufferhashs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'
2|'Cbuffer(Point(2 2),0.5)'

CREATE SINK cbufferhashs_out(cbufferhashs.id UINT64, r INT32) TYPE File;
SELECT id, CBUFFER_HASH(a) AS r FROM cbufferhashs INTO cbufferhashs_out;
----
1,107165682
2,-1698313227

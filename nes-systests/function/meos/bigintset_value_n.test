# name: MEOS_BIGINTSET_VALUE_N
# description: bigintset_value_n — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE bigintsetvaluens(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR bigintsetvaluens TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{3, 5, 9}'

CREATE SINK bigintsetvaluens_out(bigintsetvaluens.id UINT64, r INT64) TYPE File;
SELECT id, BIGINTSET_VALUE_N(a) AS r FROM bigintsetvaluens INTO bigintsetvaluens_out;
----
1,1
2,3

# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE bigintspanwidths(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR bigintspanwidths TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'

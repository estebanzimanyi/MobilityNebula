# name: MEOS_TEXT_COPY
# description: text_copy — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textcopys(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR textcopys TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Hello World'
2|'foo bar'

CREATE SINK textcopys_out(textcopys.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXT_COPY(a) AS r FROM textcopys INTO textcopys_out;
----
1,"Hello World"
2,"foo bar"

# name: MEOS_STBOX_XMIN
# description: stbox_xmin — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxxmins(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxxmins TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'
2|'STBOX X((3,3),(7,7))'

CREATE SINK stboxxmins_out(stboxxmins.id UINT64, r FLOAT64) TYPE File;
SELECT id, STBOX_XMIN(a) AS r FROM stboxxmins INTO stboxxmins_out;
----
1,1.0
2,3.0

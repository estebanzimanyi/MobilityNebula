# name: MEOS_TNE_TEXT_TTEXT
# description: tne_text_ttext — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tnetextttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tnetextttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'XYZ'
2|'DEF'|1609545600|'XYZ'

CREATE SINK tnetextttexts_out(tnetextttexts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TNE_TEXT_TTEXT(value, ts, arg) AS r FROM tnetextttexts INTO tnetextttexts_out;
----
1,t@2021-01-01,00:00:00+00
2,t@2021-01-02,00:00:00+00

# name: MEOS_STBOX_ROUND
# description: stbox_round — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxrounds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxrounds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'
2|'STBOX X((3,3),(7,7))'

CREATE SINK stboxrounds_out(stboxrounds.id UINT64, r VARSIZED) TYPE File;
SELECT id, STBOX_ROUND(a) AS r FROM stboxrounds INTO stboxrounds_out;
----
1,STBOX X((1,1),(5,5))
2,STBOX X((3,3),(7,7))

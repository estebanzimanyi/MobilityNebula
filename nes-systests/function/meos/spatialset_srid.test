# name: MEOS_SPATIALSET_SRID
# description: spatialset_srid — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spatialsetsrids(id UINT64, s VARSIZED);
CREATE PHYSICAL SOURCE FOR spatialsetsrids TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"SRID=4326;Point(1 1)", "SRID=4326;Point(2 2)"}'
2|'{"SRID=4326;Point(3 3)"}'

CREATE SINK spatialsetsrids_out(spatialsetsrids.id UINT64, r INT32) TYPE File;
SELECT id, SPATIALSET_SRID(s) AS r FROM spatialsetsrids INTO spatialsetsrids_out;
----
1,4326
2,4326

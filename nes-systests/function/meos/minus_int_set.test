# name: MEOS_MINUS_INT_SET
# description: minus_int_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minusintsets(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR minusintsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|7
2|'{2, 4, 6}'|9

CREATE SINK minusintsets_out(minusintsets.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_INT_SET(a, b) AS r FROM minusintsets INTO minusintsets_out;

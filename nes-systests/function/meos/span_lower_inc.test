# name: MEOS_SPAN_LOWER_INC
# description: span_lower_inc — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spanlowerincs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spanlowerincs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'
2|'[3, 9)'

CREATE SINK spanlowerincs_out(spanlowerincs.id UINT64, r BOOLEAN) TYPE File;
SELECT id, SPAN_LOWER_INC(a) AS r FROM spanlowerincs INTO spanlowerincs_out;
----
1,1

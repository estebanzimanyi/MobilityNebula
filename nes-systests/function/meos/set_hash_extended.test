# name: MEOS_SET_HASH_EXTENDED
# description: set_hash_extended — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE sethashextendeds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR sethashextendeds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{2, 4}'

CREATE SINK sethashextendeds_out(sethashextendeds.id UINT64, r INT64) TYPE File;
SELECT id, SET_HASH_EXTENDED(a) AS r FROM sethashextendeds INTO sethashextendeds_out;

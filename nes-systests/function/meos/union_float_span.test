# name: MEOS_UNION_FLOAT_SPAN
# description: union_float_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionfloatspans(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR unionfloatspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'|3.5
2|'[3.5, 9.5)'|7.5

CREATE SINK unionfloatspans_out(unionfloatspans.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_FLOAT_SPAN(a, b) AS r FROM unionfloatspans INTO unionfloatspans_out;
----
1,{[1.5,5.5)}
2,{[3.5,9.5)}

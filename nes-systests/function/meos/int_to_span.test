# name: MEOS_INT_TO_SPAN
# description: int_to_span — construct a span from a single int value.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE inttospan(id UINT64, value INT32);
CREATE PHYSICAL SOURCE FOR inttospan TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5

CREATE SINK inttospan_out(inttospan.id UINT64, r VARSIZED) TYPE File;
SELECT id, INT_TO_SPAN(value) AS r FROM inttospan INTO inttospan_out;
----
1,[5,6)

# name: MEOS_DISTANCE_SPAN_DATE
# description: distance_span_date — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancespandates(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR distancespandates TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01, 2020-01-10)'|'2020-01-03'
2|'[2020-01-05, 2020-01-20)'|'2020-06-15'

CREATE SINK distancespandates_out(distancespandates.id UINT64, r INT32) TYPE File;
SELECT id, DISTANCE_SPAN_DATE(a, b) AS r FROM distancespandates INTO distancespandates_out;
----
1,0
2,148

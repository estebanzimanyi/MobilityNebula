# name: MEOS_STBOXARR_ROUND
# description: stboxarr_round — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxarrrounds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxarrrounds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1.234567 2.345678),(5.5 5.5))'
2|'STBOX X((2.345678 3.456789),(6.6 6.6))'

CREATE SINK stboxarrrounds_out(stboxarrrounds.id UINT64, r VARSIZED) TYPE File;
SELECT id, STBOXARR_ROUND(a) AS r FROM stboxarrrounds INTO stboxarrrounds_out;
----
1,STBOX X((1.234567,2.345678),(5.5,5.5))
2,STBOX X((2.345678,3.456789),(6.6,6.6))

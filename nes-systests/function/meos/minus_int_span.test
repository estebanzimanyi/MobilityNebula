# name: MEOS_MINUS_INT_SPAN
# description: minus_int_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minusintspans(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR minusintspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|7
2|'[10, 15)'|2

CREATE SINK minusintspans_out(minusintspans.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_INT_SPAN(a, b) AS r FROM minusintspans INTO minusintspans_out;
----
1,{[7,8)}
2,{[2,3)}

2|4.3658|50.6456|1609459200|4.3658|50.6456|1609459200

CREATE SINK act_out(act.id UINT32, r INT32) TYPE File;
SELECT id, ACONTAINS_TGEO_TGEO(lonA, latA, tsA, lonB, latB, tsB) AS r FROM act INTO act_out;

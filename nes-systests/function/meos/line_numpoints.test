# name: MEOS_LINE_NUMPOINTS
# description: line_numpoints — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE linenumpointss(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR linenumpointss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(1 1, 2 2)'
2|'SRID=4326;Linestring(3 3, 4 4, 5 5)'

CREATE SINK linenumpointss_out(linenumpointss.id UINT64, r INT32) TYPE File;
SELECT id, LINE_NUMPOINTS(a) AS r FROM linenumpointss INTO linenumpointss_out;
----
1,2
2,3

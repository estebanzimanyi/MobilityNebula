# name: MEOS_GEO_SRID
# description: geo_srid — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geosrids(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geosrids TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(1 1, 2 2)'
2|'SRID=4326;Linestring(3 3, 4 4, 5 5)'

CREATE SINK geosrids_out(geosrids.id UINT64, r INT32) TYPE File;
SELECT id, GEO_SRID(a) AS r FROM geosrids INTO geosrids_out;
----
1,4326
2,4326

# name: MEOS_TFLOAT_TIME_BOXES
# description: tfloat_time_boxes — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tfloattimeboxess(id UINT64, value FLOAT64, ts UINT64, x0 VARSIZED, x1 VARSIZED);
CREATE PHYSICAL SOURCE FOR tfloattimeboxess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200|'1 day'|'2020-01-01 00:00:00+00'
2|8.5|1609545600|'2 days'|'2020-01-01 00:00:00+00'

CREATE SINK tfloattimeboxess_out(tfloattimeboxess.id UINT64, r VARSIZED) TYPE File;
SELECT id, TFLOAT_TIME_BOXES(value, ts, x0, x1) AS r FROM tfloattimeboxess INTO tfloattimeboxess_out;

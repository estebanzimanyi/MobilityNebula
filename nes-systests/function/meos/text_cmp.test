# name: MEOS_TEXT_CMP
# description: text_cmp — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textcmps(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR textcmps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'AAA'|'BBB'
2|'DDD'|'CCC'

CREATE SINK textcmps_out(textcmps.id UINT64, r INT32) TYPE File;
SELECT id, TEXT_CMP(a, arg) AS r FROM textcmps INTO textcmps_out;
----
1,-1
2,1

# name: MEOS_TEMPORAL_MERGE_ARRAY_Aggregation
# groups: [Function, MEOS, Aggregation, Codegen]
CREATE LOGICAL SOURCE tma(gid UINT64, value VARSIZED, ts UINT64);
CREATE PHYSICAL SOURCE FOR tma TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'01210001000000000000F83F00A0AD30CA5A0200'|1609459200
1|'0121000100000000000004400000854EDE5A0200'|1609459201

CREATE SINK tma_out(tma.gid UINT64, tma.r VARSIZED) TYPE File;
SELECT gid, TEMPORAL_MERGE_ARRAY(value, ts) AS r FROM tma GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tma_out;

# name: MEOS_DISTANCE_POSE_POSE
# description: distance_pose_pose — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distanceposeposes(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR distanceposeposes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'|'Pose(Point(2 2), 1.0)'
2|'Pose(Point(2 2), 1.0)'|'Pose(Point(1 1), 0.5)'

CREATE SINK distanceposeposes_out(distanceposeposes.id UINT64, r FLOAT64) TYPE File;
SELECT id, DISTANCE_POSE_POSE(a, b) AS r FROM distanceposeposes INTO distanceposeposes_out;
----
1,4609047870845172736.0
2,4609047870845172736.0

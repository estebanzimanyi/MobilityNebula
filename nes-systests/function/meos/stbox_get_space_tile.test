# name: MEOS_STBOX_GET_SPACE_TILE
# description: stbox_get_space_tile — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxgetspacetiles(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxgetspacetiles TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Point(7 7 7)'
2|'Point(2 2 2)'

CREATE SINK stboxgetspacetiles_out(stboxgetspacetiles.id UINT64, r VARSIZED) TYPE File;
SELECT id, STBOX_GET_SPACE_TILE(a) AS r FROM stboxgetspacetiles INTO stboxgetspacetiles_out;
----
1,STBOX Z((5 5 5) (10 10 10))
2,STBOX Z((0 0 0) (5 5 5))

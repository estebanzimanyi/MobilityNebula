# name: MEOS_AFTER_DATE_SET
# description: after_date_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE afterdatesets(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR afterdatesets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01, 2020-01-05, 2020-01-10}'|'2020-01-03'
2|'{2020-01-03, 2020-01-08}'|'2020-06-15'

CREATE SINK afterdatesets_out(afterdatesets.id UINT64, r INT32) TYPE File;
SELECT id, AFTER_DATE_SET(a, b) AS r FROM afterdatesets INTO afterdatesets_out;
----
1,0
2,1

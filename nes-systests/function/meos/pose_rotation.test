# name: MEOS_POSE_ROTATION
# description: pose_rotation — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE poserotations(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR poserotations TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'
2|'Pose(Point(2 2), 1.0)'

CREATE SINK poserotations_out(poserotations.id UINT64, r FLOAT64) TYPE File;
SELECT id, POSE_ROTATION(a) AS r FROM poserotations INTO poserotations_out;
----
1,0.5
2,1.0

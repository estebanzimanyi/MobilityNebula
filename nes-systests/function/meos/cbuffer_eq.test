# name: MEOS_CBUFFER_EQ
# description: cbuffer_eq — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbuffereqs(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR cbuffereqs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'|'Cbuffer(Point(2 2),0.5)'
2|'Cbuffer(Point(2 2),0.5)'|'Cbuffer(Point(1 1),1.0)'

CREATE SINK cbuffereqs_out(cbuffereqs.id UINT64, r INT32) TYPE File;
SELECT id, CBUFFER_EQ(a, b) AS r FROM cbuffereqs INTO cbuffereqs_out;
----
1,0
2,0

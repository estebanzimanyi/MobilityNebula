# name: MEOS_SPAN_HASH_EXTENDED
# description: span_hash_extended — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spanhashextendeds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR spanhashextendeds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 20)'
2|'[3, 25)'

CREATE SINK spanhashextendeds_out(spanhashextendeds.id UINT64, r INT64) TYPE File;
SELECT id, SPAN_HASH_EXTENDED(a) AS r FROM spanhashextendeds INTO spanhashextendeds_out;

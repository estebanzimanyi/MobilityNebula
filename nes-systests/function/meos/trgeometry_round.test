# name: MEOS_TRGEOMETRY_ROUND
# description: trgeometry_round — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE trgeometryrounds(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR trgeometryrounds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|0.123|0.456|0.5|1609459200
2|1.789|1.234|0.25|1609545600

CREATE SINK trgeometryrounds_out(trgeometryrounds.id UINT64, r VARSIZED) TYPE File;
SELECT id, TRGEOMETRY_ROUND(x, y, theta, ts) AS r FROM trgeometryrounds INTO trgeometryrounds_out;

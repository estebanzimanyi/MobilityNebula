# name: MEOS_POSE_GE
# description: pose_ge — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE poseges(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR poseges TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'|'Pose(Point(2 2), 1.0)'
2|'Pose(Point(2 2), 1.0)'|'Pose(Point(1 1), 0.5)'

CREATE SINK poseges_out(poseges.id UINT64, r INT32) TYPE File;
SELECT id, POSE_GE(a, b) AS r FROM poseges INTO poseges_out;
----
1,1
2,0

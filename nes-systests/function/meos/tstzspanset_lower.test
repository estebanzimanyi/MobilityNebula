CREATE PHYSICAL SOURCE FOR tstzspansetlowers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)}'
2|'{[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)}'

CREATE SINK tstzspansetlowers_out(tstzspansetlowers.id UINT64, r INT64) TYPE File;

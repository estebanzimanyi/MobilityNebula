# name: MEOS_TrajectoryWkb_Aggregation
# description: Windowed mini-trip trajectory materialized as a hex-WKB sequence value — the value the MEOS function library composes over (the efficient materialize-once mechanism). Its output is exactly the input TPOINT_LENGTH consumes.
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, Aggregation]
CREATE LOGICAL SOURCE trw(vehicle_id UINT64, lon FLOAT64, lat FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR trw TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200
1|4.3700|50.6500|1609459201
1|4.3750|50.6550|1609459202

CREATE SINK trw_out(trw.vehicle_id UINT64, trw.traj VARSIZED) TYPE File;
SELECT vehicle_id, TPOINT_TRAJECTORY(lon, lat, timestamp) AS traj FROM trw GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO trw_out;

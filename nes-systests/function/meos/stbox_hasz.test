# name: MEOS_STBOX_HASZ
# description: stbox_hasz — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxhaszs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxhaszs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'
2|'STBOX X((3,3),(7,7))'

CREATE SINK stboxhaszs_out(stboxhaszs.id UINT64, r BOOLEAN) TYPE File;
SELECT id, STBOX_HASZ(a) AS r FROM stboxhaszs INTO stboxhaszs_out;
----
1,0
2,0

# name: MEOS_OVERRIGHT_INT_SET
# description: overright_int_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overrightintsets(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR overrightintsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK overrightintsets_out(overrightintsets.id UINT64, r INT32) TYPE File;
SELECT id, OVERRIGHT_INT_SET(a, b) AS r FROM overrightintsets INTO overrightintsets_out;
----
1,1
2,1

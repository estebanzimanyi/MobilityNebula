# name: MEOS_ALWAYS_LE_TEXT_TTEXT
# description: always_le_text_ttext — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE alwaysletextttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR alwaysletextttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'ABC'
2|'DEF'|1609545600|'DEF'

CREATE SINK alwaysletextttexts_out(alwaysletextttexts.id UINT64, r INT32) TYPE File;
SELECT id, ALWAYS_LE_TEXT_TTEXT(value, ts, arg) AS r FROM alwaysletextttexts INTO alwaysletextttexts_out;

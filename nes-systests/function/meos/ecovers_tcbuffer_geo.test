# name: MEOS_ECOVERS_TCBUFFER_GEO
# description: ECOVERS_TCBUFFER_GEO: single-instant tcbuffer (lon,lat,radius) r a static geometry constant.
# groups: [Function, MEOS, SpatioTemporal, TCbuffer, EContains]
CREATE LOGICAL SOURCE tcg05(id UINT32, lon FLOAT64, lat FLOAT64, radius FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR tcg05 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1.0|1609459200
2|10.0|10.0|0.5|1609459200

CREATE SINK tcg05_out(tcg05.id UINT32, r INT32) TYPE File;
SELECT id, ECOVERS_TCBUFFER_GEO(lon, lat, radius, timestamp, 'POINT(4.3658 50.6456)') AS r FROM tcg05 INTO tcg05_out;
----
1,1
2,0

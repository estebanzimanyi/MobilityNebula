# name: MEOS_SPAN_LE
# description: span_le — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spanles(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR spanles TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|'[1, 5)'
2|'[3, 9)'|'[3, 9)'

CREATE SINK spanles_out(spanles.id UINT64, r INT32) TYPE File;
SELECT id, SPAN_LE(a, b) AS r FROM spanles INTO spanles_out;
----
1,1
2,1

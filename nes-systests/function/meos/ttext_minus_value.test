# name: MEOS_TTEXT_MINUS_VALUE
# description: ttext_minus_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE ttextminusvalues(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR ttextminusvalues TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'XYZ'
2|'DEF'|1609545600|'XYZ'

CREATE SINK ttextminusvalues_out(ttextminusvalues.id UINT64, r VARSIZED) TYPE File;
SELECT id, TTEXT_MINUS_VALUE(value, ts, arg) AS r FROM ttextminusvalues INTO ttextminusvalues_out;
----
1,"ABC"@2021-01-01,00:00:00+00
2,"DEF"@2021-01-02,00:00:00+00

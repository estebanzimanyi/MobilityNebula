# name: MEOS_ADJACENT_SPANSET_DATE
# description: adjacent_spanset_date — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE adjacentspansetdats(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR adjacentspansetdats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01, 2020-01-10)}'|'2020-01-03'
2|'{[2020-01-05, 2020-01-20)}'|'2020-06-15'

CREATE SINK adjacentspansetdats_out(adjacentspansetdats.id UINT64, r INT32) TYPE File;
SELECT id, ADJACENT_SPANSET_DATE(a, b) AS r FROM adjacentspansetdats INTO adjacentspansetdats_out;
----
1,0
2,0

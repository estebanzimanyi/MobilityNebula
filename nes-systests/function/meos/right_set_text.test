# name: MEOS_RIGHT_SET_TEXT
# description: right_set_text — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightsettexts(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR rightsettexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'|'AAA'
2|'{"BBB", "DDD"}'|'BBB'

CREATE SINK rightsettexts_out(rightsettexts.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_SET_TEXT(a, arg) AS r FROM rightsettexts INTO rightsettexts_out;
----
1,0
2,0

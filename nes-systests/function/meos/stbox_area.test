# name: MEOS_STBOX_AREA
# description: stbox_area — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxareas(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxareas TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'
2|'STBOX X((3,3),(7,7))'

CREATE SINK stboxareas_out(stboxareas.id UINT64, r FLOAT64) TYPE File;
SELECT id, STBOX_AREA(a) AS r FROM stboxareas INTO stboxareas_out;
----
1,16.0
2,16.0

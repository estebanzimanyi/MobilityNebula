# name: MEOS_GEOM_UNARY_UNION
# description: geom_unary_union — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomunaryunions(id UINT64, a VARSIZED, arg FLOAT64);
CREATE PHYSICAL SOURCE FOR geomunaryunions TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(0 0, 2 2)'|0.0
2|'SRID=4326;Linestring(0 0, 3 3)'|0.0

CREATE SINK geomunaryunions_out(geomunaryunions.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEOM_UNARY_UNION(a, arg) AS r FROM geomunaryunions INTO geomunaryunions_out;

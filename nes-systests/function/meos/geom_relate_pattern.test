# name: MEOS_GEOM_RELATE_PATTERN
# description: geom_relate_pattern — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geomrelatepatterns(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR geomrelatepatterns TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(0 0)'|'SRID=4326;Point(1 1)'
2|'SRID=4326;Point(0 0)'|'SRID=4326;Point(0 0)'

CREATE SINK geomrelatepatterns_out(geomrelatepatterns.id UINT64, r INT32) TYPE File;
SELECT id, GEOM_RELATE_PATTERN(a, arg) AS r FROM geomrelatepatterns INTO geomrelatepatterns_out;
----
1,0
2,1

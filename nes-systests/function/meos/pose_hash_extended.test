# name: MEOS_POSE_HASH_EXTENDED
# description: pose_hash_extended — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posehashextendeds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR posehashextendeds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1),0.5)'
2|'Pose(Point(2 2),0.5)'

CREATE SINK posehashextendeds_out(posehashextendeds.id UINT64, r INT64) TYPE File;
SELECT id, POSE_HASH_EXTENDED(a) AS r FROM posehashextendeds INTO posehashextendeds_out;
----
1,-861185957588014182
2,-1891176920763096196

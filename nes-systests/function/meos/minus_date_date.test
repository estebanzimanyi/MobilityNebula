# name: MEOS_MINUS_DATE_DATE
# description: MINUS_DATE_DATE over two DateADT values (days since 2000-01-01, e.g. 7305=2020-01-01, 7309=2020-01-05) returning the number of days between them.
# groups: [Function, MEOS, DateTime]
CREATE LOGICAL SOURCE minusdatedates(id UINT64, value INT32, arg0 INT32);
CREATE PHYSICAL SOURCE FOR minusdatedates TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|7309|7305
2|7320|7305

CREATE SINK minusdatedates_out(minusdatedates.id UINT64, r INT32) TYPE File;
SELECT id, MINUS_DATE_DATE(value, arg0) AS r FROM minusdatedates INTO minusdatedates_out;
----
1,4
2,15

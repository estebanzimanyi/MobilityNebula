# name: MEOS_NSEGMENT_SRID
# description: nsegment_srid — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE nsegmentsrids(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR nsegmentsrids TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NSegment(1, 0.2, 0.8)'
2|'NSegment(1, 0.5, 0.7)'

CREATE SINK nsegmentsrids_out(nsegmentsrids.id UINT64, r INT32) TYPE File;
SELECT id, NSEGMENT_SRID(a) AS r FROM nsegmentsrids INTO nsegmentsrids_out;
----
1,5676
2,5676

# name: MEOS_CONTAINED_TIMESTAMPTZ_SPANSET
# description: contained_timestamptz_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containedtimestamps(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR containedtimestamps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)}'|'2020-01-03 00:00:00+00'
2|'{[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)}'|'2020-06-15 12:00:00+00'

CREATE SINK containedtimestamps_out(containedtimestamps.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_TIMESTAMPTZ_SPANSET(a, b) AS r FROM containedtimestamps INTO containedtimestamps_out;
----
1,1
2,0

# name: MEOS_LEFT_SPAN_SPANSET
# description: left_span_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE leftspanspansets(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR leftspanspansets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|'{[1, 5), [10, 15)}'
2|'[3, 9)'|'{[3, 7)}'

CREATE SINK leftspanspansets_out(leftspanspansets.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_SPAN_SPANSET(a, b) AS r FROM leftspanspansets INTO leftspanspansets_out;
----
1,0
2,0

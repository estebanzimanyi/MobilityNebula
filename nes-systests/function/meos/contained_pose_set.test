# name: MEOS_CONTAINED_POSE_SET
# description: contained_pose_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containedposesets(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR containedposesets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Pose(Point(1 1),0.5)", "Pose(Point(2 2),1.0)"}'|'Pose(Point(1 1),0.5)'
2|'{"Pose(Point(3 3),0.3)", "Pose(Point(4 4),0.5)"}'|'Pose(Point(3 3),0.3)'

CREATE SINK containedposesets_out(containedposesets.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_POSE_SET(a, arg) AS r FROM containedposesets INTO containedposesets_out;
----
1,1
2,1

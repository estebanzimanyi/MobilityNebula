# name: MEOS_DISTANCE_SET_INT
# description: distance_set_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancesetints(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR distancesetints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'|3
2|'{3, 5, 9}'|7

CREATE SINK distancesetints_out(distancesetints.id UINT64, r INT32) TYPE File;
SELECT id, DISTANCE_SET_INT(a, b) AS r FROM distancesetints INTO distancesetints_out;
----
1,0
2,0

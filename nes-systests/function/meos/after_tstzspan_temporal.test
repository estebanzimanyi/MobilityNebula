# name: MEOS_AFTER_TSTZSPAN_TEMPORAL
# description: after_tstzspan_temporal (temporal, tstzspan) time topological relationship.
# groups: [Function, MEOS, Temporal, Topological, Codegen]
CREATE LOGICAL SOURCE aftertstzsp(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR aftertstzsp TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.0|1609459200
2|5.0|1609632000

CREATE SINK aftertstzsp_out(aftertstzsp.id UINT64, r BOOLEAN) TYPE File;
SELECT id, AFTER_TSTZSPAN_TEMPORAL(value, ts, '[2021-01-01 00:00:00+00, 2021-01-02 00:00:00+00)') AS r FROM aftertstzsp INTO aftertstzsp_out;
----
1,0
2,0

# name: MEOS_LEFT_TSPATIAL_STBOX
# groups: [Function, MEOS, SpatioTemporal, Box, Codegen]
CREATE LOGICAL SOURCE tsb09(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tsb09 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200
2|2.0|2.0|1577836800

CREATE SINK tsb09_out(tsb09.id UINT64, r BOOLEAN) TYPE File;
SELECT id, LEFT_TSPATIAL_STBOX(lon, lat, ts, 'SRID=4326;STBOX XT(((1,1),(3,3)),[2020-01-01,2020-01-02])') AS r FROM tsb09 INTO tsb09_out;
----
1,0
2,0

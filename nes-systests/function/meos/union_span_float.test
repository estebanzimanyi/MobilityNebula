# name: MEOS_UNION_SPAN_FLOAT
# description: union_span_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionspanfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR unionspanfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'|3.5
2|'[3.5, 9.5)'|7.5

CREATE SINK unionspanfloats_out(unionspanfloats.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_SPAN_FLOAT(a, b) AS r FROM unionspanfloats INTO unionspanfloats_out;
----
1,{[1.5,5.5)}
2,{[3.5,9.5)}

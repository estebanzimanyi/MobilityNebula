# name: MEOS_INTERSECTION_SPANSET_INT
# description: intersection_spanset_int — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectionspanses(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR intersectionspanses TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|3
2|'{[20, 25), [30, 35)}'|22

CREATE SINK intersectionspanses_out(intersectionspanses.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERSECTION_SPANSET_INT(a, b) AS r FROM intersectionspanses INTO intersectionspanses_out;

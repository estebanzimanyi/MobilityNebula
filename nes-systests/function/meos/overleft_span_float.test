# name: MEOS_OVERLEFT_SPAN_FLOAT
# description: overleft_span_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overleftspanfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR overleftspanfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'|3.5
2|'[3.5, 9.5)'|7.5

CREATE SINK overleftspanfloats_out(overleftspanfloats.id UINT64, r INT32) TYPE File;
SELECT id, OVERLEFT_SPAN_FLOAT(a, b) AS r FROM overleftspanfloats INTO overleftspanfloats_out;
----
1,0
2,0

# name: MEOS_TSTZSPANSET_TIMESTAMPS
# description: tstzspanset_timestamps — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzspansettimestas(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzspansettimestas TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)}'
2|'{[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)}'

CREATE SINK tstzspansettimestas_out(tstzspansettimestas.id UINT64, r VARSIZED) TYPE File;
SELECT id, TSTZSPANSET_TIMESTAMPS(a) AS r FROM tstzspansettimestas INTO tstzspansettimestas_out;
----
1,{"2020-01-01,00:00:00+00","2020-01-10,00:00:00+00"}
2,{"2020-01-05,00:00:00+00","2020-01-20,00:00:00+00"}

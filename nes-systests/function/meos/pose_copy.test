# name: MEOS_POSE_COPY
# description: pose_copy — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posecopys(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR posecopys TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'
2|'Pose(Point(2 2), 1.0)'

CREATE SINK posecopys_out(posecopys.id UINT64, r VARSIZED) TYPE File;
SELECT id, POSE_COPY(a) AS r FROM posecopys INTO posecopys_out;
----
1,POSE (0101000000000000000000F03F000000000000F03F, 0.5)
2,POSE (010100000000000000000000400000000000000040, 1)

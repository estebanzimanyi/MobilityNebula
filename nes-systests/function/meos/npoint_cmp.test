# name: MEOS_NPOINT_CMP
# description: npoint_cmp — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointcmps(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR npointcmps TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NPoint(1, 0.5)'|'NPoint(1, 0.7)'
2|'NPoint(1, 0.7)'|'NPoint(1, 0.5)'

CREATE SINK npointcmps_out(npointcmps.id UINT64, r INT32) TYPE File;
SELECT id, NPOINT_CMP(a, b) AS r FROM npointcmps INTO npointcmps_out;
----
1,-1
2,1

# name: MEOS_FRONT_TSPATIAL_STBOX
# description: front_tspatial_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE fronttspatialstboxs(id UINT64, lon FLOAT64, lat FLOAT64, z FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR fronttspatialstboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|2.0|1609459200|'SRID=4326;STBOX Z((0 0 0),(5 5 5))'
2|2.0|2.0|3.0|1609545600|'SRID=4326;STBOX Z((1 1 1),(6 6 6))'

CREATE SINK fronttspatialstboxs_out(fronttspatialstboxs.id UINT64, r INT32) TYPE File;
SELECT id, FRONT_TSPATIAL_STBOX(lon, lat, z, ts, arg) AS r FROM fronttspatialstboxs INTO fronttspatialstboxs_out;

# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distanceintspansets(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR distanceintspansets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|'{[1, 5), [10, 15)}'
2|'{[3, 7)}'|'{[3, 7)}'

CREATE SINK distanceintspansets_out(distanceintspansets.id UINT64, r INT32) TYPE File;

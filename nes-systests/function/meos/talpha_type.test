# name: MEOS_TALPHA_TYPE
# description: talpha_type — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE talphatypes(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR talphatypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

# name: MEOS_GEO_IS_EMPTY
# description: geo_is_empty — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geoisemptys(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geoisemptys TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(1 1, 2 2)'
2|'SRID=4326;Linestring(3 3, 4 4, 5 5)'

CREATE SINK geoisemptys_out(geoisemptys.id UINT64, r BOOLEAN) TYPE File;
SELECT id, GEO_IS_EMPTY(a) AS r FROM geoisemptys INTO geoisemptys_out;
----
1,0
2,0

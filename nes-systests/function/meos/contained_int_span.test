# name: MEOS_CONTAINED_INT_SPAN
# description: contained_int_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containedintspans(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR containedintspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK containedintspans_out(containedintspans.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_INT_SPAN(a, b) AS r FROM containedintspans INTO containedintspans_out;
----
1,1
2,1

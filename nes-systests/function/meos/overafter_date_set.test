# name: MEOS_OVERAFTER_DATE_SET
# description: overafter_date_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overafterdatesets(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR overafterdatesets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01, 2020-01-05, 2020-01-10}'|'2020-01-03'
2|'{2020-01-03, 2020-01-08}'|'2020-06-15'

CREATE SINK overafterdatesets_out(overafterdatesets.id UINT64, r INT32) TYPE File;
SELECT id, OVERAFTER_DATE_SET(a, b) AS r FROM overafterdatesets INTO overafterdatesets_out;
----
1,1
2,1

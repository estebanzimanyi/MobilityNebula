# name: MEOS_TCBUFFER_EXPAND
# description: tcbuffer_expand — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tcbufferexpands(id UINT64, lon FLOAT64, lat FLOAT64, radius FLOAT64, ts UINT64, dist FLOAT64);
CREATE PHYSICAL SOURCE FOR tcbufferexpands TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1.0|1609459200|2.0
2|2.0|2.0|0.5|1609545600|1.0

CREATE SINK tcbufferexpands_out(tcbufferexpands.id UINT64, r VARSIZED) TYPE File;
SELECT id, TCBUFFER_EXPAND(lon, lat, radius, ts, dist) AS r FROM tcbufferexpands INTO tcbufferexpands_out;

# name: MEOS_FLOATSPAN_RADIANS
# description: floatspan_radians — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspanradianss(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatspanradianss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'
2|'[3.5, 9.5)'

CREATE SINK floatspanradianss_out(floatspanradianss.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSPAN_RADIANS(a) AS r FROM floatspanradianss INTO floatspanradianss_out;
----
1,[0.026179938779915, 0.095993108859688)
2,[0.061086523819802, 0.165806278939461)

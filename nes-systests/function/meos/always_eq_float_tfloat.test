# name: MEOS_ALWAYS_EQ_FLOAT_TFLOAT
# groups: [Function, MEOS, TemporalNumber, Comparison, Codegen]
CREATE LOGICAL SOURCE ftf00(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR ftf00 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|2.0|1609459200
2|10.0|1609545600

CREATE SINK ftf00_out(ftf00.id UINT64, r INT32) TYPE File;
SELECT id, ALWAYS_EQ_FLOAT_TFLOAT(5.0, value, ts) AS r FROM ftf00 INTO ftf00_out;

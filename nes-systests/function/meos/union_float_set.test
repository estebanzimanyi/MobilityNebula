# name: MEOS_UNION_FLOAT_SET
# description: union_float_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionfloatsets(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR unionfloatsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|3.5
2|'{3.5, 5.5, 9.5}'|7.5

CREATE SINK unionfloatsets_out(unionfloatsets.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_FLOAT_SET(a, b) AS r FROM unionfloatsets INTO unionfloatsets_out;
----
1,{1.5,3.5,5.5}
2,{3.5,5.5,7.5,9.5}

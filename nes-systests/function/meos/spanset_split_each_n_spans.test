# name: MEOS_SPANSET_SPLIT_EACH_N_SPANS
# description: spanset_split_each_n_spans — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spansetspliteachnss(id UINT64, a VARSIZED, x0 INT32);
CREATE PHYSICAL SOURCE FOR spansetspliteachnss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15), [20, 25)}'|2
2|'{[3, 7), [12, 18)}'|2

CREATE SINK spansetspliteachnss_out(spansetspliteachnss.id UINT64, r VARSIZED) TYPE File;
SELECT id, SPANSET_SPLIT_EACH_N_SPANS(a, x0) AS r FROM spansetspliteachnss INTO spansetspliteachnss_out;
----
1,{[1,15),[20,25)}
2,{[3,18)}

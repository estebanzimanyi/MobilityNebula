# name: MEOS_BEFORE_SET_DATE
# description: before_set_date — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE beforesetdates(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR beforesetdates TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01, 2020-01-05, 2020-01-10}'|'2020-01-03'
2|'{2020-01-03, 2020-01-08}'|'2020-06-15'

CREATE SINK beforesetdates_out(beforesetdates.id UINT64, r INT32) TYPE File;
SELECT id, BEFORE_SET_DATE(a, b) AS r FROM beforesetdates INTO beforesetdates_out;
----
1,0
2,1

# name: MEOS_TBOX_TO_FLOATSPAN
# description: tbox_to_floatspan — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxtofloatspans(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxtofloatspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'

CREATE SINK tboxtofloatspans_out(tboxtofloatspans.id UINT64, r VARSIZED) TYPE File;
SELECT id, TBOX_TO_FLOATSPAN(a) AS r FROM tboxtofloatspans INTO tboxtofloatspans_out;
----
1,[1,5]
2,[3,7]

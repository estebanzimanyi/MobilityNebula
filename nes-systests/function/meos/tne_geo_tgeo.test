# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tnegeotgeos(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tnegeotgeos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200|'SRID=4326;Point(1 1)'
2|2.0|2.0|1609545600|'SRID=4326;Point(2 2)'

CREATE SINK tnegeotgeos_out(tnegeotgeos.id UINT64, r VARSIZED) TYPE File;
SELECT id, TNE_GEO_TGEO(lon, lat, ts, arg) AS r FROM tnegeotgeos INTO tnegeotgeos_out;

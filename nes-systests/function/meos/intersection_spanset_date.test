# name: MEOS_INTERSECTION_SPANSET_DATE
# description: intersection_spanset_date value-mixed set/span/spanset algebra.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectionspanse(id UINT64, lit VARSIZED, val INT32);
CREATE PHYSICAL SOURCE FOR intersectionspanse TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01, 2020-01-10)}'|7307

CREATE SINK intersectionspanse_out(intersectionspanse.id UINT64, r VARSIZED) TYPE File;
SELECT id, INTERSECTION_SPANSET_DATE(lit, val) AS r FROM intersectionspanse INTO intersectionspanse_out;
----
1,{[2020-01-03,2020-01-04)}

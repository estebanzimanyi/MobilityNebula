# name: MEOS_TEMPORAL_HASH
# description: temporal_hash — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE temporalhashs(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR temporalhashs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200
2|8.5|1609545600

CREATE SINK temporalhashs_out(temporalhashs.id UINT64, r INT32) TYPE File;
SELECT id, TEMPORAL_HASH(value, ts) AS r FROM temporalhashs INTO temporalhashs_out;

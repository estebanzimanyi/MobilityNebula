# name: MEOS_SET_COPY
# description: set_copy — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE setcopys(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR setcopys TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'
2|'{3.5, 5.5, 9.5}'

CREATE SINK setcopys_out(setcopys.id UINT64, r VARSIZED) TYPE File;
SELECT id, SET_COPY(a) AS r FROM setcopys INTO setcopys_out;
----
1,{1.5,3.5,5.5}
2,{3.5,5.5,9.5}

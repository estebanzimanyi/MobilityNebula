# name: MEOS_ALPHANUMSET_TYPE
# description: alphanumset_type — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE alphanumsettypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR alphanumsettypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{2, 4}'

CREATE SINK alphanumsettypes_out(alphanumsettypes.id UINT64, r INT32) TYPE File;
SELECT id, ALPHANUMSET_TYPE(a) AS r FROM alphanumsettypes INTO alphanumsettypes_out;
----
1,1
2,1

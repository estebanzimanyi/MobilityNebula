# name: MEOS_NAD_TINT_INT
# groups: [Function, MEOS, Codegen]
CREATE LOGICAL SOURCE nti(id UINT64, value INT32, ts UINT64);
CREATE PHYSICAL SOURCE FOR nti TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|10|1609459200
2|3|1609459200

CREATE SINK nti_out(nti.id UINT64, r INT32) TYPE File;
SELECT id, NAD_TINT_INT(value, ts, 5) AS r FROM nti INTO nti_out;

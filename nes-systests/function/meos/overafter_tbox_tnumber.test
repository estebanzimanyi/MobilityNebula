# name: MEOS_OVERAFTER_TBOX_TNUMBER
# groups: [Function, MEOS, TemporalNumber, Box, Codegen]
CREATE LOGICAL SOURCE tbn06(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tbn06 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|2.0|1577880000
2|100.0|1735689600

CREATE SINK tbn06_out(tbn06.id UINT64, r BOOLEAN) TYPE File;
SELECT id, OVERAFTER_TBOX_TNUMBER('TBOXFLOAT XT([1, 3],[2020-01-01, 2020-01-02])', value, ts) AS r FROM tbn06 INTO tbn06_out;
----
1,0
2,0

# name: MEOS_TBOX_MAKE
# description: tbox_make — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxmakes(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxmakes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'|'[2020-01-01 00:00:00+00, 2020-01-05 00:00:00+00)'
2|'[3.5, 9.5)'|'[2020-01-03 00:00:00+00, 2020-01-07 00:00:00+00)'

CREATE SINK tboxmakes_out(tboxmakes.id UINT64, r VARSIZED) TYPE File;
SELECT id, TBOX_MAKE(a, arg) AS r FROM tboxmakes INTO tboxmakes_out;
----
1,TBOXFLOAT XT([1.5, 5.5),[2020-01-01 00:00:00+00, 2020-01-05 00:00:00+00))
2,TBOXFLOAT XT([3.5, 9.5),[2020-01-03 00:00:00+00, 2020-01-07 00:00:00+00))

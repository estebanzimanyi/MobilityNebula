# name: MEOS_STBOX_TRANSFORM
# description: stbox_transform — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxtransforms(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxtransforms TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;STBOX X((4.3 50.8),(4.4 50.9))'
2|'SRID=4326;STBOX X((4.1 50.7),(4.2 50.8))'

CREATE SINK stboxtransforms_out(stboxtransforms.id UINT64, r VARSIZED) TYPE File;
SELECT id, STBOX_TRANSFORM(a) AS r FROM stboxtransforms INTO stboxtransforms_out;
----
1,SRID=3857;STBOX X((478673.8104110763,6585991.99809962),(489805.75949040375,6603623.906655206))
2,SRID=3857;STBOX X((456409.91225242155,6568397.781293055),(467541.861331749,6585991.99809962))

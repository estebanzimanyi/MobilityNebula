# name: MEOS_CBUFFER_LT
# description: cbuffer_lt — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbufferlts(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR cbufferlts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'|'Cbuffer(Point(2 2),0.5)'
2|'Cbuffer(Point(2 2),0.5)'|'Cbuffer(Point(1 1),1.0)'

CREATE SINK cbufferlts_out(cbufferlts.id UINT64, r INT32) TYPE File;
SELECT id, CBUFFER_LT(a, b) AS r FROM cbufferlts INTO cbufferlts_out;
----
1,1
2,0

# name: MEOS_TSTZSPAN_LOWER
# description: tstzspan_lower — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzspanlowers(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzspanlowers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)'
2|'[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)'

CREATE SINK tstzspanlowers_out(tstzspanlowers.id UINT64, r INT64) TYPE File;
SELECT id, TSTZSPAN_LOWER(a) AS r FROM tstzspanlowers INTO tstzspanlowers_out;

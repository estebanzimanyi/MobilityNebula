# name: MEOS_STBOX_SRID
# description: stbox_srid — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxsrids(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxsrids TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'
2|'STBOX X((3,3),(7,7))'

CREATE SINK stboxsrids_out(stboxsrids.id UINT64, r INT32) TYPE File;
SELECT id, STBOX_SRID(a) AS r FROM stboxsrids INTO stboxsrids_out;
----
1,0
2,0

# name: MEOS_TFLOAT_WMAX_TRANSFN
# description: Windowed TFLOAT_WMAX_TRANSFN -> aggregate Temporal (hex-WKB) via the per-op windowed tagg transfn (1-hour radius).
# groups: [Function, MEOS, TemporalNumber, Aggregation]
CREATE LOGICAL SOURCE wfx(vehicle_id UINT64, value FLOAT64, timestamp UINT64);
CREATE PHYSICAL SOURCE FOR wfx TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200
1|3.5|1609459200
1|7.0|1609462800

CREATE SINK wfx_out(wfx.vehicle_id UINT64, wfx.r VARSIZED) TYPE File;
SELECT vehicle_id, TFLOAT_WMAX_TRANSFN(value, timestamp) AS r FROM wfx GROUP BY vehicle_id WINDOW TUMBLING(timestamp, size 1 hour) INTO wfx_out;

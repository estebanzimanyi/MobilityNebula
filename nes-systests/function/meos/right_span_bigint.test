# name: MEOS_RIGHT_SPAN_BIGINT
# description: right_span_bigint — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightspanbigints(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR rightspanbigints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK rightspanbigints_out(rightspanbigints.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_SPAN_BIGINT(a, b) AS r FROM rightspanbigints INTO rightspanbigints_out;

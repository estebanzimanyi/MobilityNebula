# name: MEOS_SPAN_EQ
# description: span_eq — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE spaneqs(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR spaneqs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|'[1, 5)'
2|'[3, 9)'|'[3, 9)'

CREATE SINK spaneqs_out(spaneqs.id UINT64, r INT32) TYPE File;
SELECT id, SPAN_EQ(a, b) AS r FROM spaneqs INTO spaneqs_out;
----
1,1
2,1

# name: MEOS_TSTZSPAN_TPRECISION
# description: tstzspan_tprecision — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzspantprecisions(id UINT64, a VARSIZED, arg0 VARSIZED, arg1 VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzspantprecisions TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)'|'1 day'|'2020-01-01 00:00:00+00'
2|'[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)'|'2 days'|'2020-01-01 00:00:00+00'

CREATE SINK tstzspantprecisions_out(tstzspantprecisions.id UINT64, r VARSIZED) TYPE File;
SELECT id, TSTZSPAN_TPRECISION(a, arg0, arg1) AS r FROM tstzspantprecisions INTO tstzspantprecisions_out;

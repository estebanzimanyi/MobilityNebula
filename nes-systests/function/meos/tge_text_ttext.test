# name: MEOS_TGE_TEXT_TTEXT
# description: tge_text_ttext — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tgetextttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tgetextttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'XYZ'
2|'DEF'|1609545600|'XYZ'

CREATE SINK tgetextttexts_out(tgetextttexts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TGE_TEXT_TTEXT(value, ts, arg) AS r FROM tgetextttexts INTO tgetextttexts_out;
----
1,t@2021-01-01,00:00:00+00
2,t@2021-01-02,00:00:00+00

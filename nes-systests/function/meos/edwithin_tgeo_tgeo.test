CREATE SINK ewt_out(ewt.id UINT32, within INT32) TYPE File;
SELECT id, EDWITHIN_TGEO_TGEO(lonA, latA, tsA, lonB, latB, tsB, FLOAT64(0.001)) AS within FROM ewt INTO ewt_out;

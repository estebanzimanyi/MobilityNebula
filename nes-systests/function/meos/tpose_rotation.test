# name: MEOS_TPOSE_ROTATION
# description: tpose_rotation — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tposerotations(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tposerotations TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|0.5|1609459200
2|2.0|2.0|1.0|1609545600

CREATE SINK tposerotations_out(tposerotations.id UINT64, r VARSIZED) TYPE File;
SELECT id, TPOSE_ROTATION(x, y, theta, ts) AS r FROM tposerotations INTO tposerotations_out;

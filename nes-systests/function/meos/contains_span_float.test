# name: MEOS_CONTAINS_SPAN_FLOAT
# description: contains_span_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containsspanfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR containsspanfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'|3.5
2|'[3.5, 9.5)'|7.5

CREATE SINK containsspanfloats_out(containsspanfloats.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINS_SPAN_FLOAT(a, b) AS r FROM containsspanfloats INTO containsspanfloats_out;
----
1,1
2,1

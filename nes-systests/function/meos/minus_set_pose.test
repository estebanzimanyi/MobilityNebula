# name: MEOS_MINUS_SET_POSE
# description: minus_set_pose — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minussetposes(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR minussetposes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Pose(Point(1 1),0.5)", "Pose(Point(2 2),1.0)"}'|'Pose(Point(1 1),0.5)'
2|'{"Pose(Point(3 3),0.3)", "Pose(Point(4 4),0.5)"}'|'Pose(Point(3 3),0.3)'

CREATE SINK minussetposes_out(minussetposes.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_SET_POSE(a, arg) AS r FROM minussetposes INTO minussetposes_out;
----
1,{"POSE (010100000000000000000000400000000000000040, 1)"}
2,{"POSE (010100000000000000000010400000000000001040, 0.5)"}

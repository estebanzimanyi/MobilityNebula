CREATE LOGICAL SOURCE touchescbuffercbufs(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR touchescbuffercbufs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'|'Cbuffer(Point(2 2),0.5)'
2|'Cbuffer(Point(2 2),0.5)'|'Cbuffer(Point(1 1),1.0)'

CREATE SINK touchescbuffercbufs_out(touchescbuffercbufs.id UINT64, r INT32) TYPE File;

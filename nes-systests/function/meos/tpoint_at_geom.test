# name: MEOS_TPOINT_AT_GEOM
# description: tpoint_at_geom — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tpointatgeoms(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tpointatgeoms TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200|'SRID=4326;Point(1 1)'
2|2.0|2.0|1609545600|'SRID=4326;Point(2 2)'

CREATE SINK tpointatgeoms_out(tpointatgeoms.id UINT64, r VARSIZED) TYPE File;
SELECT id, TPOINT_AT_GEOM(lon, lat, ts, arg) AS r FROM tpointatgeoms INTO tpointatgeoms_out;
----
1,POINT(1 1)@2021-01-01 00:00:00+00
2,POINT(2 2)@2021-01-02 00:00:00+00

# name: MEOS_CBUFFER_GT
# description: cbuffer_gt — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbuffergts(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR cbuffergts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'|'Cbuffer(Point(2 2),0.5)'
2|'Cbuffer(Point(2 2),0.5)'|'Cbuffer(Point(1 1),1.0)'

CREATE SINK cbuffergts_out(cbuffergts.id UINT64, r INT32) TYPE File;
SELECT id, CBUFFER_GT(a, b) AS r FROM cbuffergts INTO cbuffergts_out;
----
1,0
2,1

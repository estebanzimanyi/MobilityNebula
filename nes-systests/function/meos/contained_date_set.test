# name: MEOS_CONTAINED_DATE_SET
# description: contained_date_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containeddatesets(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR containeddatesets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01, 2020-01-05, 2020-01-10}'|'2020-01-03'
2|'{2020-01-03, 2020-01-08}'|'2020-06-15'

CREATE SINK containeddatesets_out(containeddatesets.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_DATE_SET(a, b) AS r FROM containeddatesets INTO containeddatesets_out;
----
1,0
2,0

# name: MEOS_CBUFFER_NE
# description: cbuffer_ne — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbuffernes(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR cbuffernes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'|'Cbuffer(Point(2 2),0.5)'
2|'Cbuffer(Point(2 2),0.5)'|'Cbuffer(Point(1 1),1.0)'

CREATE SINK cbuffernes_out(cbuffernes.id UINT64, r INT32) TYPE File;
SELECT id, CBUFFER_NE(a, b) AS r FROM cbuffernes INTO cbuffernes_out;
----
1,1
2,1

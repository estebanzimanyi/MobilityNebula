# name: MEOS_GEO_CLUSTER_INTERSECTING
# description: geo_cluster_intersecting — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geoclusterintersecs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geoclusterintersecs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(1 1)'
2|'SRID=4326;Point(2 2)'

CREATE SINK geoclusterintersecs_out(geoclusterintersecs.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEO_CLUSTER_INTERSECTING(a) AS r FROM geoclusterintersecs INTO geoclusterintersecs_out;
----
1,{0107000020E6100000010000000101000000000000000000F03F000000000000F03F}
2,{0107000020E610000001000000010100000000000000000000400000000000000040}

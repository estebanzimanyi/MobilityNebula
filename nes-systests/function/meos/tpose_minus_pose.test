# name: MEOS_TPOSE_MINUS_POSE
# description: tpose_minus_pose — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tposeminusposes(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tposeminusposes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|0.5|1609459200|'Pose(Point(40 40), 0.5)'
2|2.0|2.0|1.0|1609545600|'Pose(Point(50 50), 1.0)'

CREATE SINK tposeminusposes_out(tposeminusposes.id UINT64, r VARSIZED) TYPE File;
SELECT id, TPOSE_MINUS_POSE(x, y, theta, ts, arg) AS r FROM tposeminusposes INTO tposeminusposes_out;

# name: MEOS_GEOSET_TYPE
# description: geoset_type — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geosettypes(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geosettypes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1, 3, 5}'
2|'{2, 4}'

CREATE SINK geosettypes_out(geosettypes.id UINT64, r INT32) TYPE File;
SELECT id, GEOSET_TYPE(a) AS r FROM geosettypes INTO geosettypes_out;
----
1,0
2,0

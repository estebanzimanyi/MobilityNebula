# name: MEOS_OVERBEFORE_SPANSET_DATE
# description: overbefore_spanset_date — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overbeforespansetds(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR overbeforespansetds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01, 2020-01-10)}'|'2020-01-03'
2|'{[2020-01-05, 2020-01-20)}'|'2020-06-15'

CREATE SINK overbeforespansetds_out(overbeforespansetds.id UINT64, r INT32) TYPE File;
SELECT id, OVERBEFORE_SPANSET_DATE(a, b) AS r FROM overbeforespansetds INTO overbeforespansetds_out;
----
1,0
2,1

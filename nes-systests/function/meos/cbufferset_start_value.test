# name: MEOS_CBUFFERSET_START_VALUE
# description: cbufferset_start_value — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbuffersetstartvals(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR cbuffersetstartvals TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Cbuffer(Point(1 1),0.5)", "Cbuffer(Point(2 2),0.5)"}'
2|'{"Cbuffer(Point(3 3),1.0)", "Cbuffer(Point(4 4),0.5)"}'

CREATE SINK cbuffersetstartvals_out(cbuffersetstartvals.id UINT64, r VARSIZED) TYPE File;
SELECT id, CBUFFERSET_START_VALUE(a) AS r FROM cbuffersetstartvals INTO cbuffersetstartvals_out;
----
1,Cbuffer(0101000000000000000000F03F000000000000F03F,0.5)
2,Cbuffer(010100000000000000000008400000000000000840,1)

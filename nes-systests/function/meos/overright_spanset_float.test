# name: MEOS_OVERRIGHT_SPANSET_FLOAT
# description: overright_spanset_float — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overrightspansetfls(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR overrightspansetfls TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'|3.5
2|'{[3.5, 7.5)}'|7.5

CREATE SINK overrightspansetfls_out(overrightspansetfls.id UINT64, r INT32) TYPE File;
SELECT id, OVERRIGHT_SPANSET_FLOAT(a, b) AS r FROM overrightspansetfls INTO overrightspansetfls_out;

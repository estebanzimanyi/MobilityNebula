# name: MEOS_TBOOL_TO_TINT
# groups: [Function, MEOS, TemporalBoolean, Codegen]
CREATE LOGICAL SOURCE tb2i(id UINT64, value BOOLEAN, ts UINT64);
CREATE PHYSICAL SOURCE FOR tb2i TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|true|1609459200
2|false|1609545600

CREATE SINK tb2i_out(tb2i.id UINT64, r INT32) TYPE File;
SELECT id, TBOOL_TO_TINT(value, ts) AS r FROM tb2i INTO tb2i_out;
----
1,1
2,0

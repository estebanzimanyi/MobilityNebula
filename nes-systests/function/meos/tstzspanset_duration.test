# name: MEOS_TSTZSPANSET_DURATION
# description: tstzspanset_duration — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tstzspansetduratios(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tstzspansetduratios TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01 00:00:00+00, 2020-01-10 00:00:00+00)}'
2|'{[2020-01-05 00:00:00+00, 2020-01-20 00:00:00+00)}'

CREATE SINK tstzspansetduratios_out(tstzspansetduratios.id UINT64, r VARSIZED) TYPE File;
SELECT id, TSTZSPANSET_DURATION(a) AS r FROM tstzspansetduratios INTO tstzspansetduratios_out;
----
1,9,days
2,15,days

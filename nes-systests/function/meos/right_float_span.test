# name: MEOS_RIGHT_FLOAT_SPAN
# description: right_float_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE rightfloatspans(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR rightfloatspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 5.5)'|3.5
2|'[3.5, 9.5)'|7.5

CREATE SINK rightfloatspans_out(rightfloatspans.id UINT64, r INT32) TYPE File;
SELECT id, RIGHT_FLOAT_SPAN(a, b) AS r FROM rightfloatspans INTO rightfloatspans_out;
----
1,0
2,0

# name: MEOS_GEO_TO_SET
# description: geo_to_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE geotosets(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR geotosets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Point(1 1)'
2|'SRID=4326;Point(2 2)'

CREATE SINK geotosets_out(geotosets.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEO_TO_SET(a) AS r FROM geotosets INTO geotosets_out;
----
1,{"POINT(1 1)"}
2,{"POINT(2 2)"}

# name: MEOS_OVERRIGHT_FLOAT_SPANSET
# description: overright_float_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overrightfloatspans(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR overrightfloatspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'|3.5
2|'{[3.5, 7.5)}'|7.5

CREATE SINK overrightfloatspans_out(overrightfloatspans.id UINT64, r INT32) TYPE File;
SELECT id, OVERRIGHT_FLOAT_SPANSET(a, b) AS r FROM overrightfloatspans INTO overrightfloatspans_out;
----
1,1
2,1

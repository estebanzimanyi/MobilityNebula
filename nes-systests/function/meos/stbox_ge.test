# name: MEOS_STBOX_GE
# description: STBOX_GE over two per-vehicle extent STBoxes (VARSIZED stbox text). Box A=((1,1),(3,3)); B=((2,2),(4,4)).
# groups: [Function, MEOS, SpatioTemporal, Box, Codegen]
CREATE LOGICAL SOURCE sbcge(id UINT64, boxa VARSIZED, boxb VARSIZED);
CREATE PHYSICAL SOURCE FOR sbcge TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|STBOX X((1,1),(3,3))|STBOX X((2,2),(4,4))
2|STBOX X((1,1),(3,3))|STBOX X((10,10),(11,11))

CREATE SINK sbcge_out(sbcge.id UINT64, r BOOLEAN) TYPE File;
SELECT id, STBOX_GE(boxa, boxb) AS r FROM sbcge INTO sbcge_out;
----
1,0
2,0

# name: MEOS_TEMPORAL_ROUND
# description: temporal_round — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE temporalrounds(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR temporalrounds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);

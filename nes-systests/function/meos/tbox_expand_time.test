# name: MEOS_TBOX_EXPAND_TIME
# description: tbox_expand_time — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxexpandtimes(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxexpandtimes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'|'1 day'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'|'2 days 3 hours'

CREATE SINK tboxexpandtimes_out(tboxexpandtimes.id UINT64, r VARSIZED) TYPE File;
SELECT id, TBOX_EXPAND_TIME(a, arg) AS r FROM tboxexpandtimes INTO tboxexpandtimes_out;
----
1,TBOXFLOAT XT([1, 5],[2019-12-31 00:00:00+00, 2020-01-06 00:00:00+00])
2,TBOXFLOAT XT([3, 7],[2019-12-31 21:00:00+00, 2020-01-09 03:00:00+00])

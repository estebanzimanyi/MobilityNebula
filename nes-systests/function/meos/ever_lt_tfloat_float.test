# name: MEOS_EVER_LT_TFLOAT_FLOAT
# groups: [Function, MEOS, TemporalNumber, Comparison, Codegen]
CREATE LOGICAL SOURCE tff08(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tff08 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|2.0|1609459200
2|10.0|1609545600

CREATE SINK tff08_out(tff08.id UINT64, r INT32) TYPE File;
SELECT id, EVER_LT_TFLOAT_FLOAT(value, ts, 5.0) AS r FROM tff08 INTO tff08_out;

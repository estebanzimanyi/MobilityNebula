# name: MEOS_FLOATSPAN_BINS
# description: floatspan_bins — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspanbinss(id UINT64, a VARSIZED, x0 FLOAT64, x1 FLOAT64);
CREATE PHYSICAL SOURCE FOR floatspanbinss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1.5, 20.5)'|5.0|0.0
2|'[3.5, 25.5)'|5.0|0.0

CREATE SINK floatspanbinss_out(floatspanbinss.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSPAN_BINS(a, x0, x1) AS r FROM floatspanbinss INTO floatspanbinss_out;
----
1,{[0,5),[5,10),[10,15),[15,20),[20,25)}
2,{[0,5),[5,10),[10,15),[15,20),[20,25),[25,30)}

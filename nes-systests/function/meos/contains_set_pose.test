# name: MEOS_CONTAINS_SET_POSE
# description: contains_set_pose — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containssetposes(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR containssetposes TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Pose(Point(1 1),0.5)", "Pose(Point(2 2),1.0)"}'|'Pose(Point(1 1),0.5)'
2|'{"Pose(Point(3 3),0.3)", "Pose(Point(4 4),0.5)"}'|'Pose(Point(3 3),0.3)'

CREATE SINK containssetposes_out(containssetposes.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINS_SET_POSE(a, arg) AS r FROM containssetposes INTO containssetposes_out;
----
1,1
2,1

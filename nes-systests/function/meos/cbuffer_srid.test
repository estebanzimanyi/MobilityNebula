# name: MEOS_CBUFFER_SRID
# description: cbuffer_srid — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbuffersrids(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR cbuffersrids TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'
2|'Cbuffer(Point(2 2),0.5)'

CREATE SINK cbuffersrids_out(cbuffersrids.id UINT64, r INT32) TYPE File;
SELECT id, CBUFFER_SRID(a) AS r FROM cbuffersrids INTO cbuffersrids_out;
----
1,0
2,0

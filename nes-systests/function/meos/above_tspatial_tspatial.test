2|4.3658|50.6456|1609459200|4.3658|50.6456|1609459200

CREATE SINK ts00_out(ts00.id UINT32, r BOOLEAN) TYPE File;
SELECT id, ABOVE_TSPATIAL_TSPATIAL(lonA, latA, tsA, lonB, latB, tsB) AS r FROM ts00 INTO ts00_out;

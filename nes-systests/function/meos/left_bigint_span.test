# name: MEOS_LEFT_BIGINT_SPAN
# description: left_bigint_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE leftbigintspans(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR leftbigintspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK leftbigintspans_out(leftbigintspans.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_BIGINT_SPAN(a, b) AS r FROM leftbigintspans INTO leftbigintspans_out;
----
1,0
2,0

CREATE LOGICAL SOURCE minusspansetfloats(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR minusspansetfloats TYPE File SET('|' AS PARSER.FIELD_DELIMITER);

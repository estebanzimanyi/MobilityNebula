# name: MEOS_CONTAINED_DATE_SPANSET
# description: contained_date_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containeddatespanss(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR containeddatespanss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01, 2020-01-10)}'|'2020-01-03'
2|'{[2020-01-05, 2020-01-20)}'|'2020-06-15'

CREATE SINK containeddatespanss_out(containeddatespanss.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_DATE_SPANSET(a, b) AS r FROM containeddatespanss INTO containeddatespanss_out;
----
1,1
2,0

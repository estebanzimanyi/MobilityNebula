# name: MEOS_DISTANCE_POSE_GEO
# description: distance_pose_geo — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distanceposegeos(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR distanceposegeos TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'|'Point(1 1)'
2|'Pose(Point(2 2), 1.0)'|'Point(2 2)'

CREATE SINK distanceposegeos_out(distanceposegeos.id UINT64, r FLOAT64) TYPE File;
SELECT id, DISTANCE_POSE_GEO(a, arg) AS r FROM distanceposegeos INTO distanceposegeos_out;
----
1,0.0
2,0.0

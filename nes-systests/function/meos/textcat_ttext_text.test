# name: MEOS_TEXTCAT_TTEXT_TEXT
# description: textcat_ttext_text — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE textcatttexttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR textcatttexttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'ABC'|1609459200|'XYZ'
2|'DEF'|1609545600|'XYZ'

CREATE SINK textcatttexttexts_out(textcatttexttexts.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEXTCAT_TTEXT_TEXT(value, ts, arg) AS r FROM textcatttexttexts INTO textcatttexttexts_out;
----
1,"ABCXYZ"@2021-01-01,00:00:00+00
2,"DEFXYZ"@2021-01-02,00:00:00+00

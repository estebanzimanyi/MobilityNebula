# name: MEOS_TEMPORAL_INSTANTS
# description: temporal_instants — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE temporalinstantss(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR temporalinstantss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

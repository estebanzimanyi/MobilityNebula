# name: MEOS_TBOX_TO_INTSPAN
# description: tbox_to_intspan — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tboxtointspans(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR tboxtointspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXINT XT([1, 5],[2020-01-01, 2020-01-05])'
2|'TBOXINT XT([3, 7],[2020-01-03, 2020-01-07])'

CREATE SINK tboxtointspans_out(tboxtointspans.id UINT64, r VARSIZED) TYPE File;
SELECT id, TBOX_TO_INTSPAN(a) AS r FROM tboxtointspans INTO tboxtointspans_out;
----
1,[1,6)
2,[3,8)

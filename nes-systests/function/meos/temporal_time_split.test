# name: MEOS_TEMPORAL_TIME_SPLIT
# description: temporal_time_split — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE temporaltimesplits(id UINT64, value FLOAT64, ts UINT64, x0 VARSIZED, x1 VARSIZED);
CREATE PHYSICAL SOURCE FOR temporaltimesplits TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200|'1 day'|'2020-01-01 00:00:00+00'
2|8.5|1609545600|'2 days'|'2020-01-01 00:00:00+00'

CREATE SINK temporaltimesplits_out(temporaltimesplits.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEMPORAL_TIME_SPLIT(value, ts, x0, x1) AS r FROM temporaltimesplits INTO temporaltimesplits_out;
----
1,{5.5@2021-01-01,00:00:00+00}
2,{8.5@2021-01-02,00:00:00+00}

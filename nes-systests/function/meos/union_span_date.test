# name: MEOS_UNION_SPAN_DATE
# description: union_span_date value-mixed set/span/spanset algebra.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionspandate(id UINT64, lit VARSIZED, val INT32);
CREATE PHYSICAL SOURCE FOR unionspandate TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01, 2020-01-10)'|7307

CREATE SINK unionspandate_out(unionspandate.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_SPAN_DATE(lit, val) AS r FROM unionspandate INTO unionspandate_out;
----
1,{[2020-01-01,2020-01-10)}

# name: MEOS_CONTAINED_TEMPORAL_TEMPORAL
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, EDisjoint]
CREATE LOGICAL SOURCE tt09(id UINT32, lonA FLOAT64, latA FLOAT64, tsA UINT64, lonB FLOAT64, latB FLOAT64, tsB UINT64);
CREATE PHYSICAL SOURCE FOR tt09 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200|4.4000|50.7000|1609459200
2|4.3658|50.6456|1609459200|4.3658|50.6456|1609459200

CREATE SINK tt09_out(tt09.id UINT32, r BOOLEAN) TYPE File;
SELECT id, CONTAINED_TEMPORAL_TEMPORAL(lonA, latA, tsA, lonB, latB, tsB) AS r FROM tt09 INTO tt09_out;

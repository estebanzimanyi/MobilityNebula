# name: MEOS_MINUS_SET_CBUFFER
# description: minus_set_cbuffer — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minussetcbuffers(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR minussetcbuffers TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"Cbuffer(Point(1 1),0.5)", "Cbuffer(Point(2 2),0.5)"}'|'Cbuffer(Point(1 1),0.5)'
2|'{"Cbuffer(Point(3 3),1.0)", "Cbuffer(Point(4 4),0.5)"}'|'Cbuffer(Point(3 3),1.0)'

CREATE SINK minussetcbuffers_out(minussetcbuffers.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_SET_CBUFFER(a, arg) AS r FROM minussetcbuffers INTO minussetcbuffers_out;
----
1,{"Cbuffer(010100000000000000000000400000000000000040,0.5)"}
2,{"Cbuffer(010100000000000000000010400000000000001040,0.5)"}

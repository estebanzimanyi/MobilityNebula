# name: MEOS_TRGEOMETRY_ROTATION
# description: trgeometry_rotation — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE trgeometryrotations(id UINT64, x FLOAT64, y FLOAT64, theta FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR trgeometryrotations TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

# name: MEOS_POSE_GT
# description: pose_gt — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posegts(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR posegts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Pose(Point(1 1), 0.5)'|'Pose(Point(2 2), 1.0)'
2|'Pose(Point(2 2), 1.0)'|'Pose(Point(1 1), 0.5)'

CREATE SINK posegts_out(posegts.id UINT64, r INT32) TYPE File;
SELECT id, POSE_GT(a, b) AS r FROM posegts INTO posegts_out;
----
1,1
2,0

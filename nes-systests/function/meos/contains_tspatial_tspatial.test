# name: MEOS_CONTAINS_TSPATIAL_TSPATIAL
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, EDisjoint]
CREATE LOGICAL SOURCE ts07(id UINT32, lonA FLOAT64, latA FLOAT64, tsA UINT64, lonB FLOAT64, latB FLOAT64, tsB UINT64);
CREATE PHYSICAL SOURCE FOR ts07 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);

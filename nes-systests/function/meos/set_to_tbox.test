# name: MEOS_SET_TO_TBOX
# description: set_to_tbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE settotboxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR settotboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'
2|'{3.5, 5.5, 9.5}'

CREATE SINK settotboxs_out(settotboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, SET_TO_TBOX(a) AS r FROM settotboxs INTO settotboxs_out;
----
1,TBOXFLOAT X([1.5, 5.5])
2,TBOXFLOAT X([3.5, 9.5])

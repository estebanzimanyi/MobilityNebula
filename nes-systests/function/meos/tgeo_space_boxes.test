# name: MEOS_TGEO_SPACE_BOXES
# description: tgeo_space_boxes — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tgeospaceboxess(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64, x0 FLOAT64, x1 FLOAT64, x2 FLOAT64, x3 VARSIZED);
CREATE PHYSICAL SOURCE FOR tgeospaceboxess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200|5.0|5.0|5.0|'SRID=4326;Point(0 0)'
2|2.0|2.0|1609545600|5.0|5.0|5.0|'SRID=4326;Point(0 0)'

CREATE SINK tgeospaceboxess_out(tgeospaceboxess.id UINT64, r VARSIZED) TYPE File;
SELECT id, TGEO_SPACE_BOXES(lon, lat, ts, x0, x1, x2, x3) AS r FROM tgeospaceboxess INTO tgeospaceboxess_out;

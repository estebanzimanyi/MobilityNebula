# name: MEOS_CBUFFERARR_ROUND
# description: cbufferarr_round — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE cbufferarrrounds(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR cbufferarrrounds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1.234567 2.345678),0.5)'
2|'Cbuffer(Point(2.345678 3.456789),0.3)'

CREATE SINK cbufferarrrounds_out(cbufferarrrounds.id UINT64, r VARSIZED) TYPE File;
SELECT id, CBUFFERARR_ROUND(a) AS r FROM cbufferarrrounds INTO cbufferarrrounds_out;
----
1,Cbuffer(010100000087889B53C9C0F33FD192C7D3F2C30240 0.5)
2,Cbuffer(0101000000D192C7D3F2C302405F61C1FD80A70B40 0.3)

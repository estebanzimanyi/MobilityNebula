# name: MEOS_EINTERSECTS_TGEO_TGEO
# description: Per-event ever-intersects between two single-instant tgeompoints (genuine eintersects_tgeo_tgeo).
# groups: [Function, MEOS, SpatioTemporal, TemporalGeometry, EIntersects, Codegen]
CREATE LOGICAL SOURCE eit(id UINT32, lonA FLOAT64, latA FLOAT64, tsA UINT64, lonB FLOAT64, latB FLOAT64, tsB UINT64);
CREATE PHYSICAL SOURCE FOR eit TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|4.3658|50.6456|1609459200|4.3658|50.6456|1609459200
2|4.3658|50.6456|1609459200|4.4000|50.7000|1609459200

CREATE SINK eit_out(eit.id UINT32, intersects INT32) TYPE File;
SELECT id, EINTERSECTS_TGEO_TGEO(lonA, latA, tsA, lonB, latB, tsB) AS intersects FROM eit INTO eit_out;
----
1,1
2,0

# name: MEOS_ALWAYS_EQ_TFLOAT_FLOAT
# groups: [Function, MEOS, TemporalNumber, Comparison, Codegen]
CREATE LOGICAL SOURCE tff00(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tff00 TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|2.0|1609459200
2|10.0|1609545600

CREATE SINK tff00_out(tff00.id UINT64, r INT32) TYPE File;
SELECT id, ALWAYS_EQ_TFLOAT_FLOAT(value, ts, 5.0) AS r FROM tff00 INTO tff00_out;
----
1,0
2,0

# name: MEOS_UNION_FLOAT_SPANSET
# description: union_float_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionfloatspansets(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR unionfloatspansets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'|3.5
2|'{[3.5, 7.5)}'|7.5

CREATE SINK unionfloatspansets_out(unionfloatspansets.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_FLOAT_SPANSET(a, b) AS r FROM unionfloatspansets INTO unionfloatspansets_out;
----
1,{[1.5,5.5),[10.5,15.5)}
2,{[3.5,7.5]}

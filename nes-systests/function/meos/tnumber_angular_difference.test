# name: MEOS_TNUMBER_ANGULAR_DIFFERENCE_EXP
# groups: [Function, MEOS, Aggregation]
CREATE LOGICAL SOURCE tnumbev(gid UINT64, reading FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tnumbev TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|10.5|1609459200
1|22.7|1609459201
2|5.0|1609459200
2|7.5|1609459201

CREATE SINK tnumbev_out(tnumbev.gid UINT64, tnumbev.r VARSIZED) TYPE File;
SELECT gid, TNUMBER_ANGULAR_DIFFERENCE_EXP(reading, ts) AS r FROM tnumbev GROUP BY gid WINDOW TUMBLING(ts, size 1 hour) INTO tnumbev_out;

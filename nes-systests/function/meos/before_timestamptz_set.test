# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE beforetimestamptzss(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR beforetimestamptzss TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01 00:00:00+00, 2020-01-05 00:00:00+00}'|'2020-01-03 00:00:00+00'
2|'{2020-01-03 00:00:00+00, 2020-01-08 00:00:00+00}'|'2020-06-15 12:00:00+00'

CREATE SINK beforetimestamptzss_out(beforetimestamptzss.id UINT64, r INT32) TYPE File;
SELECT id, BEFORE_TIMESTAMPTZ_SET(a, b) AS r FROM beforetimestamptzss INTO beforetimestamptzss_out;

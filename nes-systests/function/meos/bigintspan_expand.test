# name: MEOS_BIGINTSPAN_EXPAND
# description: bigintspan_expand — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE bigintspanexpands(id UINT64, a VARSIZED, v INT64);
CREATE PHYSICAL SOURCE FOR bigintspanexpands TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|5
2|'[3, 9)'|5

CREATE SINK bigintspanexpands_out(bigintspanexpands.id UINT64, r VARSIZED) TYPE File;
SELECT id, BIGINTSPAN_EXPAND(a, v) AS r FROM bigintspanexpands INTO bigintspanexpands_out;
----
1,[-4, 10)
2,[-2, 14)

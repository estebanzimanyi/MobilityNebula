# name: MEOS_MINUS_FLOAT_SET
# description: minus_float_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE minusfloatsets(id UINT64, a VARSIZED, b FLOAT64);
CREATE PHYSICAL SOURCE FOR minusfloatsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{1.5, 3.5, 5.5}'|7.5
2|'{2.5, 4.5, 6.5}'|9.5

CREATE SINK minusfloatsets_out(minusfloatsets.id UINT64, r VARSIZED) TYPE File;
SELECT id, MINUS_FLOAT_SET(a, b) AS r FROM minusfloatsets INTO minusfloatsets_out;
----
1,{7.5}
2,{9.5}

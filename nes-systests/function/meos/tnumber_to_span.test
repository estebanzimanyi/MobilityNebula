# name: MEOS_TNUMBER_TO_SPAN
# description: tnumber_to_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tnumbertospans(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tnumbertospans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.5|1609459200
2|8.5|1609545600

CREATE SINK tnumbertospans_out(tnumbertospans.id UINT64, r VARSIZED) TYPE File;
SELECT id, TNUMBER_TO_SPAN(value, ts) AS r FROM tnumbertospans INTO tnumbertospans_out;
----
1,[5.5,5.5]
2,[8.5,8.5]

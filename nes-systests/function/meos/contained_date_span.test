# name: MEOS_CONTAINED_DATE_SPAN
# description: contained_date_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containeddatespans(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR containeddatespans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[2020-01-01, 2020-01-10)'|'2020-01-03'
2|'[2020-01-05, 2020-01-20)'|'2020-06-15'

CREATE SINK containeddatespans_out(containeddatespans.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_DATE_SPAN(a, b) AS r FROM containeddatespans INTO containeddatespans_out;
----
1,1
2,0

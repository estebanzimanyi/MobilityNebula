# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE alwaysgtttexttexts(id UINT64, value VARSIZED, ts UINT64, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR alwaysgtttexttexts TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

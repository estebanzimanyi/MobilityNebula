CREATE SINK alwaysgtttexttexts_out(alwaysgtttexttexts.id UINT64, r INT32) TYPE File;
SELECT id, ALWAYS_GT_TTEXT_TEXT(value, ts, arg) AS r FROM alwaysgtttexttexts INTO alwaysgtttexttexts_out;

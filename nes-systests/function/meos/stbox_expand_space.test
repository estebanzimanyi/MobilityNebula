# name: MEOS_STBOX_EXPAND_SPACE
# description: stbox_expand_space — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxexpandspaces(id UINT64, box VARSIZED, dist FLOAT64);
CREATE PHYSICAL SOURCE FOR stboxexpandspaces TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;STBOX X((1,1),(3,3))'|1.0
2|'SRID=4326;STBOX X((0,0),(10,10))'|2.0

CREATE SINK stboxexpandspaces_out(stboxexpandspaces.id UINT64, r VARSIZED) TYPE File;
SELECT id, STBOX_EXPAND_SPACE(box, dist) AS r FROM stboxexpandspaces INTO stboxexpandspaces_out;
----
1,SRID=4326;STBOX,X((0,0),(4,4))
2,SRID=4326;STBOX,X((-2,-2),(12,12))

# name: MEOS_TEMPORAL_INTERP
# description: TEMPORAL_INTERP returns the interpolation name (None/Discrete/Step/Linear) of a temporal value.
# groups: [Function, MEOS, Catalog, Temporal]
CREATE LOGICAL SOURCE tint(id UINT64, value FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tint TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|5.0|1609459200
2|7.5|1609545600

CREATE SINK tint_out(tint.id UINT64, r VARSIZED) TYPE File;
SELECT id, TEMPORAL_INTERP(value, ts) AS r FROM tint INTO tint_out;
----
1,None
2,None

# name: MEOS_TGEO_STBOXES
# description: tgeo_stboxes — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tgeostboxess(id UINT64, lon FLOAT64, lat FLOAT64, ts UINT64);
CREATE PHYSICAL SOURCE FOR tgeostboxess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|1.0|1609459200
2|2.0|2.0|1609545600

CREATE SINK tgeostboxess_out(tgeostboxess.id UINT64, r VARSIZED) TYPE File;
SELECT id, TGEO_STBOXES(lon, lat, ts) AS r FROM tgeostboxess INTO tgeostboxess_out;

# name: MEOS_GEO_REVERSE
# description: geo_reverse — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE georeverses(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR georeverses TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'SRID=4326;Linestring(1 1, 2 2)'
2|'SRID=4326;Linestring(3 3, 4 4, 5 5)'

CREATE SINK georeverses_out(georeverses.id UINT64, r VARSIZED) TYPE File;
SELECT id, GEO_REVERSE(a) AS r FROM georeverses INTO georeverses_out;
----
1,0102000020E61000000200000000000000000000400000000000000040000000000000F03F000000000000F03F
2,0102000020E610000003000000000000000000144000000000000014400000000000001040000000000000104000000000000008400000000000000840

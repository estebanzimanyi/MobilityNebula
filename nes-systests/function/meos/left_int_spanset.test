# name: MEOS_LEFT_INT_SPANSET
# description: left_int_spanset — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE leftintspansets(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR leftintspansets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1, 5), [10, 15)}'|3
2|'{[3, 7)}'|7

CREATE SINK leftintspansets_out(leftintspansets.id UINT64, r INT32) TYPE File;
SELECT id, LEFT_INT_SPANSET(a, b) AS r FROM leftintspansets INTO leftintspansets_out;

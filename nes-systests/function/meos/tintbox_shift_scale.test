# name: MEOS_TINTBOX_SHIFT_SCALE
# description: tintbox_shift_scale — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE tintboxshiftscales(id UINT64, a VARSIZED, arg0 INT32, arg1 INT32, arg2 BOOLEAN, arg3 BOOLEAN);
CREATE PHYSICAL SOURCE FOR tintboxshiftscales TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXINT XT([1, 5],[2020-01-01, 2020-01-05])'|2|2|true|true
2|'TBOXINT XT([3, 7],[2020-01-03, 2020-01-07])'|2|2|true|true

CREATE SINK tintboxshiftscales_out(tintboxshiftscales.id UINT64, r VARSIZED) TYPE File;
SELECT id, TINTBOX_SHIFT_SCALE(a, arg0, arg1, arg2, arg3) AS r FROM tintboxshiftscales INTO tintboxshiftscales_out;
----
1,TBOXINT XT([3 6) [2020-01-01 00:00:00+00 2020-01-05 00:00:00+00])
2,TBOXINT XT([5 8) [2020-01-03 00:00:00+00 2020-01-07 00:00:00+00])

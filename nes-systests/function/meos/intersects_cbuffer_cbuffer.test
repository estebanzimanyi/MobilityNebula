# name: MEOS_INTERSECTS_CBUFFER_CBUFFER
# description: intersects_cbuffer_cbuffer — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectscbuffercs(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR intersectscbuffercs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'Cbuffer(Point(1 1),1.0)'|'Cbuffer(Point(2 2),0.5)'
2|'Cbuffer(Point(2 2),0.5)'|'Cbuffer(Point(1 1),1.0)'

CREATE SINK intersectscbuffercs_out(intersectscbuffercs.id UINT64, r INT32) TYPE File;
SELECT id, INTERSECTS_CBUFFER_CBUFFER(a, b) AS r FROM intersectscbuffercs INTO intersectscbuffercs_out;
----
1,1
2,1

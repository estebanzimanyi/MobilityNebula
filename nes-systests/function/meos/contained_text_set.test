# name: MEOS_CONTAINED_TEXT_SET
# description: contained_text_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE containedtextsets(id UINT64, a VARSIZED, arg VARSIZED);
CREATE PHYSICAL SOURCE FOR containedtextsets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{"AAA", "BBB", "CCC"}'|'AAA'
2|'{"BBB", "DDD"}'|'BBB'

CREATE SINK containedtextsets_out(containedtextsets.id UINT64, r INT32) TYPE File;
SELECT id, CONTAINED_TEXT_SET(a, arg) AS r FROM containedtextsets INTO containedtextsets_out;
----
1,1
2,1

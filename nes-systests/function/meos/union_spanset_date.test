# name: MEOS_UNION_SPANSET_DATE
# description: union_spanset_date value-mixed set/span/spanset algebra.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionspansetdate(id UINT64, lit VARSIZED, val INT32);
CREATE PHYSICAL SOURCE FOR unionspansetdate TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[2020-01-01, 2020-01-10)}'|7307

CREATE SINK unionspansetdate_out(unionspansetdate.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_SPANSET_DATE(lit, val) AS r FROM unionspansetdate INTO unionspansetdate_out;
----
1,{[2020-01-01,2020-01-10)}

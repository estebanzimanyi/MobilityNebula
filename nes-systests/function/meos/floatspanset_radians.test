# name: MEOS_FLOATSPANSET_RADIANS
# description: floatspanset_radians — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatspansetradians(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR floatspansetradians TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{[1.5, 5.5), [10.5, 15.5)}'
2|'{[3.5, 7.5)}'

CREATE SINK floatspansetradians_out(floatspansetradians.id UINT64, r VARSIZED) TYPE File;
SELECT id, FLOATSPANSET_RADIANS(a) AS r FROM floatspansetradians INTO floatspansetradians_out;

# name: MEOS_UNION_INT_SPAN
# description: union_int_span — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE unionintspans(id UINT64, a VARSIZED, b INT32);
CREATE PHYSICAL SOURCE FOR unionintspans TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'[1, 5)'|3
2|'[3, 9)'|7

CREATE SINK unionintspans_out(unionintspans.id UINT64, r VARSIZED) TYPE File;
SELECT id, UNION_INT_SPAN(a, b) AS r FROM unionintspans INTO unionintspans_out;
----
1,{[1,5)}
2,{[3,9)}

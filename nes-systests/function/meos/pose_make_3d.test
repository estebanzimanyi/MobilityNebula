# name: MEOS_POSE_MAKE_3D
# description: pose_make_3d — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE posemake3ds(id UINT64, value FLOAT64, arg0 FLOAT64, arg1 FLOAT64, arg2 FLOAT64, arg3 FLOAT64, arg4 FLOAT64, arg5 FLOAT64, arg6 INT32);
CREATE PHYSICAL SOURCE FOR posemake3ds TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.0|2.0|3.0|1.0|0.0|0.0|0.0|4326
2|2.0|3.0|4.0|1.0|0.0|0.0|0.0|4326

CREATE SINK posemake3ds_out(posemake3ds.id UINT64, r VARSIZED) TYPE File;
SELECT id, POSE_MAKE_3D(value, arg0, arg1, arg2, arg3, arg4, arg5, arg6) AS r FROM posemake3ds INTO posemake3ds_out;

# name: MEOS_FLOAT_DEGREES
# description: float_degrees — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE floatdegreess(id UINT64, value FLOAT64, arg0 BOOLEAN);
CREATE PHYSICAL SOURCE FOR floatdegreess TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|1.5|false
2|0.5|false

CREATE SINK floatdegreess_out(floatdegreess.id UINT64, r FLOAT64) TYPE File;
SELECT id, FLOAT_DEGREES(value, arg0) AS r FROM floatdegreess INTO floatdegreess_out;
----
1,85.943669
2,28.64789

# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE intersectionsetbigs(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR intersectionsetbigs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

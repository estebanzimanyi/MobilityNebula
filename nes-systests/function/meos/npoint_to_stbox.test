# name: MEOS_NPOINT_TO_STBOX
# description: npoint_to_stbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE npointtostboxs(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR npointtostboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'NPoint(1, 0.5)'
2|'NPoint(1, 0.7)'

CREATE SINK npointtostboxs_out(npointtostboxs.id UINT64, r VARSIZED) TYPE File;
SELECT id, NPOINT_TO_STBOX(a) AS r FROM npointtostboxs INTO npointtostboxs_out;

# name: MEOS_DISTANCE_SET_TIMESTAMPTZ
# description: distance_set_timestamptz — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE distancesettimestas(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR distancesettimestas TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01 00:00:00+00, 2020-01-05 00:00:00+00}'|'2020-01-03 00:00:00+00'
2|'{2020-01-03 00:00:00+00, 2020-01-08 00:00:00+00}'|'2020-06-15 12:00:00+00'

CREATE SINK distancesettimestas_out(distancesettimestas.id UINT64, r FLOAT64) TYPE File;
SELECT id, DISTANCE_SET_TIMESTAMPTZ(a, b) AS r FROM distancesettimestas INTO distancesettimestas_out;

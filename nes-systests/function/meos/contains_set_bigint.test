CREATE LOGICAL SOURCE containssetbigints(id UINT64, a VARSIZED, b INT64);
CREATE PHYSICAL SOURCE FOR containssetbigints TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE

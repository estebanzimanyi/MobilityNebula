# name: MEOS_OVERBEFORE_TBOX_TBOX
# description: overbefore_tbox_tbox — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE overbeforetboxtboxs(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR overbeforetboxtboxs TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'
2|'TBOXFLOAT XT([3, 7],[2020-01-03, 2020-01-07])'|'TBOXFLOAT XT([1, 5],[2020-01-01, 2020-01-05])'

CREATE SINK overbeforetboxtboxs_out(overbeforetboxtboxs.id UINT64, r INT32) TYPE File;
SELECT id, OVERBEFORE_TBOX_TBOX(a, b) AS r FROM overbeforetboxtboxs INTO overbeforetboxtboxs_out;
----
1,1
2,0

# name: MEOS_STBOX_PERIMETER
# description: stbox_perimeter — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE stboxperimeters(id UINT64, a VARSIZED);
CREATE PHYSICAL SOURCE FOR stboxperimeters TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'STBOX X((1,1),(5,5))'
2|'STBOX X((3,3),(7,7))'

CREATE SINK stboxperimeters_out(stboxperimeters.id UINT64, r FLOAT64) TYPE File;
SELECT id, STBOX_PERIMETER(a) AS r FROM stboxperimeters INTO stboxperimeters_out;
----
1,16.0
2,16.0

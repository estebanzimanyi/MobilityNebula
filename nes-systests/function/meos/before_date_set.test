# name: MEOS_BEFORE_DATE_SET
# description: before_date_set — autogenerated algebra wave; result recorded.
# groups: [Function, MEOS, Algebra, Codegen]
CREATE LOGICAL SOURCE beforedatesets(id UINT64, a VARSIZED, b VARSIZED);
CREATE PHYSICAL SOURCE FOR beforedatesets TYPE File SET('|' AS PARSER.FIELD_DELIMITER);
ATTACH INLINE
1|'{2020-01-01, 2020-01-05, 2020-01-10}'|'2020-01-03'
2|'{2020-01-03, 2020-01-08}'|'2020-06-15'

CREATE SINK beforedatesets_out(beforedatesets.id UINT64, r INT32) TYPE File;
SELECT id, BEFORE_DATE_SET(a, b) AS r FROM beforedatesets INTO beforedatesets_out;
----
1,0
2,0
